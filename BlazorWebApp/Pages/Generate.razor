@page "/generate"
@page "/generate/{WorkflowId}"
@using BlazorWebApp.Events
@using BlazorWebApp.Components.Shared.Generation
@using BlazorWebApp.Components.Shared.Generation.Fragments
@using BlazorWebApp.Components.ImageEditor
@using static BlazorWebApp.Data.Enums
@inject IComfyUIService API
@inject IOrchestratorService Orchestrator
@inject IStateService State
@inject ISessionService Session
@inject IEventService Events
@inject IWorkflowService WorkflowService
@inject IImageService ImageService
@inject IGenerationParameterService ParameterService
@inject IComponentRegistry ComponentRegistry
@inject IBackendService Backend
@inject NavigationManager NavManager
@inject ILogger<Generate> Logger
@implements IDisposable

@if (_selectedWorkflow != null)
{
    @* Workflow Assets Panel - Full width before prompts *@
    <WorkflowAssetsPanel Mode="@_selectedWorkflow.Mode" 
                         Workflow="@_selectedWorkflow"
                         Columns="3"
                         IsInitiallyExpanded="false" />

    @* Prompts + Generate Button (full width) *@
    <PromptsForm 
        Prompt="@_prompt"
        PromptChanged="HandlePromptChanged"
        NegativePrompt="@_negativePrompt"
        NegativePromptChanged="HandleNegativePromptChanged"
        OnGenerate="GenerateAsync"
        OnSkip="SkipAsync"
        OnInterrupt="InterruptAsync"
        OnLoraSelected="HandleLoraAdded"
        OnStylesChanged="HandleStylesChanged"
        OnPromptTagAppended="HandlePromptTagAppended"
        OnNegativePromptTagAppended="HandleNegativePromptTagAppended"
        ButtonDisabled="@_isGenerating" />

    @* Two-column layout *@
    <MudGrid>
        @* Left Column - Parameters *@
        <MudItem xs="6">
            @* LoRAs *@
            <LoraForm Loras="Parameters.Loras" 
                      Backend="Data.Enums.Backend.ComfyUI" 
                      OnLorasUpdated="HandleLorasUpdated" />

            @* Sources (if workflow has sources) *@
            @if (HasSources)
            {
                <SourcesPanel Sources="@Parameters.Sources"
                              OnSourceChanged="HandleSourceChanged"
                              OnEditClicked="HandleEditClicked"
                              OnBlankCanvasClicked="HandleBlankCanvasClicked" />
            }

            @* Latent/Resolution (if present in pipeline) *@
            @if (_latentFragmentId != null)
            {
                <LatentForm 
                    FragmentId="@_latentFragmentId"
                    Width="@_width"
                    WidthChanged="HandleWidthChanged"
                    Height="@_height"
                    HeightChanged="HandleHeightChanged"
                    BatchSize="@_batchSize"
                    BatchSizeChanged="HandleBatchSizeChanged"
                    OnChanged="HandleFragmentValueChanged" />
            }

            @* Sampler (if present in pipeline) *@
            @if (_samplerFragmentId != null)
            {
                <SamplerForm 
                    FragmentId="@_samplerFragmentId"
                    SamplerName="@_samplerName"
                    SamplerNameChanged="HandleSamplerNameChanged"
                    Scheduler="@_scheduler"
                    SchedulerChanged="HandleSchedulerChanged"
                    Steps="@_steps"
                    StepsChanged="HandleStepsChanged"
                    Seed="@_seed"
                    SeedChanged="HandleSeedChanged"
                    CfgScale="@_cfgScale"
                    CfgScaleChanged="HandleCfgScaleChanged"
                    Denoise="@_denoise"
                    DenoiseChanged="HandleDenoiseChanged"
                    UseGuidance="@UseGuidance"
                    OnChanged="HandleFragmentValueChanged" />
            }

            @* Optional Features (wrapped in CollapsibleFeatureSection) *@
            @foreach (var optFrag in GetOptionalFragments())
            {
                <CollapsibleFeatureSection 
                    Title="@optFrag.Title"
                    Icon="@optFrag.Icon"
                    IsActive="@optFrag.Fragment.IsActive"
                    IsActiveChanged="@((active) => HandleFragmentActiveChanged(optFrag.Id, active))"
                    DefaultExpanded="false">
                    @RenderOptionalFragmentForm(optFrag.Id, optFrag.Fragment, optFrag.Schema)
                </CollapsibleFeatureSection>
            }
        </MudItem>

        @* Right Column - Output *@
        <MudItem xs="6">
            @if (IsVideoMode)
            {
                <GeneratedVideoTabs GeneratedVideos="@ImageService.GeneratedVideos" />
            }
            else
            {
                <GeneratedImageTabs />
            }
        </MudItem>
    </MudGrid>
}
else
{
    <MudAlert Severity="Severity.Info" Class="mt-4">
        Select a workflow from the navigation bar to begin generating.
    </MudAlert>
}

@* Image Editor Modal *@
<ImageEditorModal @ref="_editorModal"
                  OnApply="HandleEditorApply"
                  OnCancel="HandleEditorCancel" />

@code {
    [Parameter] public string? WorkflowId { get; set; }

    #region State & References
    
    private List<Workflow>? _workflows;
    private Workflow? _selectedWorkflow;
    private bool _isGenerating = false;
    
    /// <summary>
    /// Reference to the State.GenerationParameters for convenience.
    /// </summary>
    private GenerationParameters Parameters => State.GenerationParameters;
    
    // Editor
    private ImageEditorModal? _editorModal;
    private string? _editingSourceId;
    
    #endregion
    
    #region Local State (synced with fragments)
    
    // Prompts - local state synced to fragment
    private string _prompt = "";
    private string _negativePrompt = "";
    
    // Latent/Resolution fragment
    private string? _latentFragmentId;
    private int _width = 1024;
    private int _height = 1024;
    private int _batchSize = 1;
    
    // Sampler fragment
    private string? _samplerFragmentId;
    private string? _samplerName;
    private string? _scheduler;
    private int _steps = 20;
    private long _seed = -1;
    private float _cfgScale = 7.0f;
    private float _denoise = 1.0f;
    
    #endregion
    
    #region Computed Properties
    
    private bool HasSources => _selectedWorkflow?.Sources?.Count > 0;
    private bool IsVideoMode => _selectedWorkflow?.Mode == ModeType.Img2Vid;
    private bool UseGuidance => _selectedWorkflow?.Base == ModelBase.Flux;
    
    #endregion

    #region Lifecycle

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to events
        Events.Subscribe<StateChangedEventArgs>(OnStateChanged);
        Events.Subscribe<GenerationParametersChangedEventArgs>(OnParametersChanged);
        
        // Load all workflows
        _workflows = new List<Workflow>();
        foreach (var mode in new[] { ModeType.Txt2Img, ModeType.Img2Img, ModeType.Img2Vid })
        {
            var modeWorkflows = Orchestrator.GetWorkflowsForMode(mode);
            if (modeWorkflows != null)
            {
                _workflows.AddRange(modeWorkflows);
            }
        }
    }
    
    protected override async Task OnParametersSetAsync()
    {
        // Handle URL parameter changes
        await InitializeFromUrl();
    }
    
    private async Task InitializeFromUrl()
    {
        // Check if we have a workflow ID in the URL
        if (!string.IsNullOrEmpty(WorkflowId) && Guid.TryParse(WorkflowId, out var workflowGuid))
        {
            // Only reinitialize if workflow changed
            if (_selectedWorkflow?.Id != workflowGuid)
            {
                var workflow = _workflows?.FirstOrDefault(w => w.Id == workflowGuid);
                if (workflow != null)
                {
                    await OnWorkflowSelected(workflow);
                    return;
                }
            }
        }
        
        // If no URL parameter, try to restore from state
        if (_selectedWorkflow == null && Parameters.WorkflowId.HasValue)
        {
            var restoredWorkflow = _workflows?.FirstOrDefault(w => w.Id == Parameters.WorkflowId.Value);
            if (restoredWorkflow != null)
            {
                await OnWorkflowSelected(restoredWorkflow);
                return;
            }
        }
        
        // If still no workflow and we have some, select the first
        if (_selectedWorkflow == null && _workflows?.Count > 0)
        {
            // Don't auto-select - let user choose from navbar
        }
    }

    #endregion

    #region Workflow Selection

    private async Task OnWorkflowSelected(Workflow workflow)
    {
        if (workflow == null) return;
        
        _selectedWorkflow = workflow;
        
        // Update state
        if (State.State?.Generation != null)
        {
            State.State.Generation.CurrentWorkflowId = workflow.Id;
            State.State.Generation.WorkflowBase = workflow.Base;
        }
        
        // Initialize parameters from workflow
        await ParameterService.InitializeFromWorkflowAsync(workflow);
        
        // Find fragment IDs from pipeline
        DiscoverFragments();
        
        // Initialize local state from fragments
        InitializeLocalStateFromFragments();
        
        // Update URL without full navigation
        var newUrl = $"/generate/{workflow.Id}";
        NavManager.NavigateTo(newUrl, forceLoad: false, replace: true);
        
        StateHasChanged();
    }

    /// <summary>
    /// Discovers fragment IDs from the workflow pipeline using FragmentType metadata.
    /// This replaces the previous string-based heuristics with schema-based discovery.
    /// </summary>
    private void DiscoverFragments()
    {
        _latentFragmentId = null;
        _samplerFragmentId = null;
        
        foreach (var kvp in Parameters.Fragments)
        {
            var fragmentId = kvp.Key;
            var fragment = kvp.Value;
            
            // Get schema to access FragmentType
            var schema = WorkflowService.GetFragmentSchema(fragment.FragmentFile);
            if (schema == null) continue;
            
            switch (schema.Type)
            {
                case FragmentType.Sampler:
                    // Use first sampler found (for multi-sampler workflows, this gets the main one)
                    _samplerFragmentId ??= fragmentId;
                    break;
                    
                case FragmentType.Latent:
                    _latentFragmentId ??= fragmentId;
                    break;
                    
                case FragmentType.Loader:
                    // Loader fragments often contain width/height/batch_size but no dedicated latent
                    // Only use if we haven't found a dedicated latent fragment
                    if (_latentFragmentId == null && 
                        fragment.Values.ContainsKey("width") || 
                        fragment.Values.ContainsKey("height"))
                    {
                        _latentFragmentId = fragmentId;
                    }
                    break;
            }
        }
        
        // Fallback: If no latent fragment found by type, check for loader with resolution params
        if (_latentFragmentId == null)
        {
            foreach (var kvp in Parameters.Fragments)
            {
                if (kvp.Value.Values.ContainsKey("width") && kvp.Value.Values.ContainsKey("height"))
                {
                    _latentFragmentId = kvp.Key;
                    break;
                }
            }
        }
        
        Logger.LogDebug("Discovered fragments - Latent: {Latent}, Sampler: {Sampler}", 
            _latentFragmentId, _samplerFragmentId);
    }

    /// <summary>
    /// Initializes local state variables from fragment values.
    /// Also ensures fragment Values dictionary is populated with defaults.
    /// </summary>
    private void InitializeLocalStateFromFragments()
    {
        // Initialize prompts from fragment - create if doesn't exist
        var promptsFragment = Parameters.GetOrCreateFragment("prompts", "prompts.sbn");
        _prompt = promptsFragment.GetValueOrDefault<string>("positive", "") ?? "";
        _negativePrompt = promptsFragment.GetValueOrDefault<string>("negative", "") ?? "";
        
        // Ensure prompt values are set in fragment
        promptsFragment.SetValue("positive", _prompt);
        promptsFragment.SetValue("negative", _negativePrompt);
        
        // Initialize latent/resolution values from discovered fragment
        if (_latentFragmentId != null && Parameters.Fragments.TryGetValue(_latentFragmentId, out var latentFrag))
        {
            // Read existing values or use defaults
            _width = latentFrag.GetValueOrDefault("width", 1024);
            _height = latentFrag.GetValueOrDefault("height", 1024);
            _batchSize = latentFrag.GetValueOrDefault("batch_size", 1);
            
            // Always write back to ensure Values dictionary is populated
            latentFrag.SetValue("width", _width);
            latentFrag.SetValue("height", _height);
            latentFrag.SetValue("batch_size", _batchSize);
        }
        
        // Initialize sampler values from discovered fragment
        if (_samplerFragmentId != null && Parameters.Fragments.TryGetValue(_samplerFragmentId, out var samplerFrag))
        {
            // Read existing values or use defaults
            _samplerName = samplerFrag.GetValueOrDefault<string>("sampler_name", "euler") ?? "euler";
            _scheduler = samplerFrag.GetValueOrDefault<string>("scheduler", "normal") ?? "normal";
            _steps = samplerFrag.GetValueOrDefault("steps", 20);
            _seed = samplerFrag.GetValueOrDefault("seed", -1L);
            _cfgScale = samplerFrag.GetValueOrDefault("cfg", 7.0f);
            _denoise = samplerFrag.GetValueOrDefault("denoise", 1.0f);
            
            // Always write back to ensure Values dictionary is populated
            samplerFrag.SetValue("sampler_name", _samplerName);
            samplerFrag.SetValue("scheduler", _scheduler);
            samplerFrag.SetValue("steps", _steps);
            samplerFrag.SetValue("seed", _seed);
            samplerFrag.SetValue("cfg", _cfgScale);
            samplerFrag.SetValue("denoise", _denoise);
        }
        
        Logger.LogDebug("Initialized local state - Width: {Width}, Height: {Height}, Steps: {Steps}, Seed: {Seed}",
            _width, _height, _steps, _seed);
    }

    #endregion

    #region Fragment Value Helpers

    private T? GetFragmentValue<T>(string fragmentId, string key) where T : class
    {
        if (Parameters.Fragments.TryGetValue(fragmentId, out var fragment) &&
            fragment.Values.TryGetValue(key, out var value))
        {
            try
            {
                if (value is T typedValue) return typedValue;
                if (value is System.Text.Json.JsonElement jsonEl)
                {
                    return System.Text.Json.JsonSerializer.Deserialize<T>(jsonEl.GetRawText());
                }
                return (T)Convert.ChangeType(value, typeof(T));
            }
            catch
            {
                return default;
            }
        }
        return default;
    }
    
    private T? GetFragmentValueNullable<T>(string fragmentId, string key) where T : struct
    {
        if (Parameters.Fragments.TryGetValue(fragmentId, out var fragment) &&
            fragment.Values.TryGetValue(key, out var value))
        {
            try
            {
                if (value is T typedValue) return typedValue;
                if (value is System.Text.Json.JsonElement jsonEl)
                {
                    return System.Text.Json.JsonSerializer.Deserialize<T>(jsonEl.GetRawText());
                }
                return (T)Convert.ChangeType(value, typeof(T));
            }
            catch
            {
                return null;
            }
        }
        return null;
    }

    private void SetFragmentValue(string fragmentId, string key, object? value)
    {
        if (Parameters.Fragments.TryGetValue(fragmentId, out var fragment))
        {
            fragment.Values[key] = value;
        }
    }

    #endregion

    #region Prompt Handlers

    private async Task HandlePromptChanged(string value)
    {
        _prompt = value;
        SetFragmentValue("prompts", "positive", value);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleNegativePromptChanged(string value)
    {
        _negativePrompt = value;
        SetFragmentValue("prompts", "negative", value);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandlePromptTagAppended(AppendedTags tags)
    {
        if (tags.IsPrefix)
            _prompt = tags.Tags + (string.IsNullOrEmpty(_prompt) ? "" : ", " + _prompt);
        else
            _prompt += (string.IsNullOrEmpty(_prompt) ? "" : ", ") + tags.Tags;
        
        SetFragmentValue("prompts", "positive", _prompt);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleNegativePromptTagAppended(AppendedTags tags)
    {
        if (tags.IsPrefix)
            _negativePrompt = tags.Tags + (string.IsNullOrEmpty(_negativePrompt) ? "" : ", " + _negativePrompt);
        else
            _negativePrompt += (string.IsNullOrEmpty(_negativePrompt) ? "" : ", ") + tags.Tags;
        
        SetFragmentValue("prompts", "negative", _negativePrompt);
        await InvokeAsync(StateHasChanged);
    }

    #endregion

    #region LoRA Handlers

    private async Task HandleLoraAdded(Lora lora)
    {
        if (!Parameters.Loras.Any(l => l.Name.Equals(lora.Name, StringComparison.OrdinalIgnoreCase)))
        {
            Parameters.Loras.Add(lora);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleLorasUpdated()
    {
        await InvokeAsync(StateHasChanged);
    }

    #endregion

    #region Style Handlers

    private async Task HandleStylesChanged()
    {
        // Styles are managed by PromptsForm via State.State.Generation.Styles
        // Apply style LoRAs to our LoRA list
        foreach (var style in State.State.Generation.Styles ?? Enumerable.Empty<PromptStyle>())
        {
            foreach (var lora in style.Loras ?? Enumerable.Empty<Lora>())
            {
                if (!Parameters.Loras.Any(l => l.Name == lora.Name))
                {
                    Parameters.Loras.Add(lora);
                }
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    #endregion

    #region Latent/Resolution Handlers

    private async Task HandleWidthChanged(int value)
    {
        _width = value;
        if (_latentFragmentId != null)
            SetFragmentValue(_latentFragmentId, "width", value);
        // EventCallback automatically triggers StateHasChanged on parent
    }

    private async Task HandleHeightChanged(int value)
    {
        _height = value;
        if (_latentFragmentId != null)
            SetFragmentValue(_latentFragmentId, "height", value);
    }

    private async Task HandleBatchSizeChanged(int value)
    {
        _batchSize = value;
        if (_latentFragmentId != null)
            SetFragmentValue(_latentFragmentId, "batch_size", value);
    }

    #endregion

    #region Sampler Handlers

    private async Task HandleSamplerNameChanged(string? value)
    {
        _samplerName = value;
        if (_samplerFragmentId != null)
            SetFragmentValue(_samplerFragmentId, "sampler_name", value);
    }

    private async Task HandleSchedulerChanged(string? value)
    {
        _scheduler = value;
        if (_samplerFragmentId != null)
            SetFragmentValue(_samplerFragmentId, "scheduler", value);
    }

    private async Task HandleStepsChanged(int value)
    {
        _steps = value;
        if (_samplerFragmentId != null)
            SetFragmentValue(_samplerFragmentId, "steps", value);
    }

    private async Task HandleSeedChanged(long value)
    {
        _seed = value;
        if (_samplerFragmentId != null)
            SetFragmentValue(_samplerFragmentId, "seed", value);
    }

    private async Task HandleCfgScaleChanged(float value)
    {
        _cfgScale = value;
        if (_samplerFragmentId != null)
            SetFragmentValue(_samplerFragmentId, "cfg", value);
    }

    private async Task HandleDenoiseChanged(float value)
    {
        _denoise = value;
        if (_samplerFragmentId != null)
            SetFragmentValue(_samplerFragmentId, "denoise", value);
    }

    private async Task HandleFragmentValueChanged()
    {
        // Generic handler for when any fragment value changes
        await State.SaveState();
    }

    #endregion

    #region Optional Fragments

    /// <summary>
    /// Gets the optional fragments that should be rendered with CollapsibleFeatureSection.
    /// Uses FragmentType.Enhancement to identify optional features like upscale, detailer, etc.
    /// </summary>
    private IEnumerable<(string Id, string Title, string? Icon, FragmentSchema? Schema, FragmentParameters Fragment)> GetOptionalFragments()
    {
        foreach (var kvp in Parameters.Fragments)
        {
            var fragmentId = kvp.Key;
            var fragment = kvp.Value;
            
            // Get the fragment schema
            var schema = WorkflowService.GetFragmentSchema(fragment.FragmentFile);
            if (schema == null) continue;
            
            // A fragment is optional if:
            // 1. It's an Enhancement type (upscale, detailer, etc.)
            // 2. OR it has DefaultCollapsed = true (explicitly marked as optional)
            var isOptional = schema.Type == FragmentType.Enhancement || 
                             schema.DefaultCollapsed == true;
            
            if (isOptional)
            {
                var title = schema.Title ?? Path.GetFileNameWithoutExtension(fragment.FragmentFile);
                var icon = schema.Icon;
                yield return (fragmentId, title, icon, schema, fragment);
            }
        }
    }

    private async Task HandleFragmentActiveChanged(string fragmentId, bool active)
    {
        // Notify the parameter service so the change is tracked (this also sets fragment.IsActive)
        ParameterService.SetFragmentActive(fragmentId, active);
        
        Logger.LogDebug("Fragment '{FragmentId}' IsActive changed to {IsActive}", fragmentId, active);
        
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Dynamically renders a fragment form using the schema's Component property.
    /// Falls back to a placeholder if no component is registered.
    /// </summary>
    private RenderFragment RenderOptionalFragmentForm(string fragmentId, FragmentParameters fragment, FragmentSchema? schema)
    {
        // Get component name from schema, or derive from fragment file
        var componentName = schema?.Component;
        
        if (string.IsNullOrEmpty(componentName))
        {
            // Try to derive component name from fragment file: "upscale.sbn" -> "UpscaleForm"
            var baseName = Path.GetFileNameWithoutExtension(fragment.FragmentFile);
            componentName = ToPascalCase(baseName) + "Form";
        }
        
        // Look up component type in registry
        var componentType = ComponentRegistry.GetComponent(componentName);
        
        if (componentType != null)
        {
            return builder =>
            {
                builder.OpenComponent(0, componentType);
                builder.AddAttribute(1, "FragmentId", fragmentId);
                builder.CloseComponent();
            };
        }
        
        // Check if schema has dynamic fields defined
        if (schema?.UsesDynamicFields == true)
        {
            // TODO: Implement dynamic field rendering based on schema.Fields
            return builder => builder.AddContent(0, 
                $"Dynamic fields for '{schema.Title}' - field rendering not yet implemented");
        }
        
        // No component found and no dynamic fields
        Logger.LogWarning("No component found for fragment '{FragmentId}' (tried '{ComponentName}')", 
            fragmentId, componentName);
        
        return builder => builder.AddContent(0, 
            $"No form component registered for '{componentName}'");
    }
    
    /// <summary>
    /// Converts a kebab-case or snake_case string to PascalCase.
    /// </summary>
    private static string ToPascalCase(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        
        var parts = input.Split(new[] { '-', '_' }, StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Select(p => 
            char.ToUpperInvariant(p[0]) + (p.Length > 1 ? p.Substring(1).ToLowerInvariant() : "")));
    }

    #endregion

    #region Source Handlers

    private async Task HandleSourceChanged((string sourceId, SourceAsset source) args)
    {
        if (Parameters.Sources.ContainsKey(args.sourceId))
        {
            Parameters.Sources[args.sourceId] = args.source;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleEditClicked(string sourceId)
    {
        _editingSourceId = sourceId;
        if (_editorModal != null && Parameters.Sources.TryGetValue(sourceId, out var source))
        {
            await _editorModal.Open(source.Data);
        }
    }

    private async Task HandleBlankCanvasClicked(string sourceId)
    {
        _editingSourceId = sourceId;
        if (_editorModal != null)
        {
            await _editorModal.OpenBlank(_width, _height);
        }
    }

    private async Task HandleEditorApply((string image, string? mask) result)
    {
        if (!string.IsNullOrEmpty(_editingSourceId) && Parameters.Sources.TryGetValue(_editingSourceId, out var source))
        {
            source.Data = result.image;
            await InvokeAsync(StateHasChanged);
        }
        _editingSourceId = null;
    }

    private void HandleEditorCancel()
    {
        _editingSourceId = null;
    }

    #endregion

    #region Generation

    private bool CanGenerate()
    {
        if (_selectedWorkflow == null) return false;
        
        // Check if required sources are filled
        if (_selectedWorkflow.Sources != null)
        {
            foreach (var sourceDefinition in _selectedWorkflow.Sources)
            {
                if (sourceDefinition.Required && 
                    (!Parameters.Sources.TryGetValue(sourceDefinition.Id, out var source) || 
                     !source.HasData))
                {
                    return false;
                }
            }
        }
        
        return true;
    }

    private async Task GenerateAsync()
    {
        if (_selectedWorkflow == null || !CanGenerate()) return;

        try
        {
            _isGenerating = true;
            StateHasChanged();
            
            // Save state before generation
            await State.SaveState();

            // Use the new GenerationParameters-based methods
            switch (_selectedWorkflow.Mode)
            {
                case ModeType.Img2Vid:
                    var videos = await ImageService.GenerateVideoAsync(Parameters, _selectedWorkflow);
                    break;
                    
                default: // Txt2Img and Img2Img
                    var images = await ImageService.GenerateImagesAsync(Parameters, _selectedWorkflow);
                    if (images?.Images?.Count > 0)
                    {
                        ImageService.GeneratedImageEntities = images;
                    }
                    break;
            }

            // Save state after generation
            await State.SaveState();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during generation");
        }
        finally
        {
            _isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task SkipAsync()
    {
        try
        {
            await API.PostClearQueue();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error skipping generation");
        }
    }

    private async Task InterruptAsync()
    {
        try
        {
            State.State.Generation.IsInterrupted = true;
            await API.PostInterrupt();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error interrupting generation");
        }
    }

    #endregion

    #region Event Handlers

    private void OnStateChanged(StateChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    
    private void OnParametersChanged(GenerationParametersChangedEventArgs args)
    {
        // Reinitialize local state when parameters change externally
        if (args.ChangeType == GenerationParameterChangeType.ParametersLoaded ||
            args.ChangeType == GenerationParameterChangeType.WorkflowChanged)
        {
            DiscoverFragments();
            InitializeLocalStateFromFragments();
        }
        _ = InvokeAsync(StateHasChanged);
    }

    #endregion

    #region Dispose

    public void Dispose()
    {
        Events.Unsubscribe<StateChangedEventArgs>(OnStateChanged);
        Events.Unsubscribe<GenerationParametersChangedEventArgs>(OnParametersChanged);
        
        _ = Task.Run(async () =>
        {
            try
            {
                await State.SaveState();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to save state on dispose");
            }
        });
    }

    #endregion
}
