@page "/"
@using BlazorWebApp.Events
@inject DatabaseService DB
@inject IStateService State
@inject IGalleryService Gallery
@inject IEventService Events
@inject ProgressService ProgressService
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IAsyncDisposable
@using Microsoft.JSInterop

<PageTitle>Blazor Diffusion</PageTitle>

@if (_projects == null)
{
    <LoadingSpinner />
}
else if (_projects.Count() == 0 && State.State.Gallery.FolderId == 0)
{
    <MudContainer Class="d-flex flex-column align-items-center justify-content-center" Style="height: 50vh">
        <MudPaper Class="pa-10 d-flex flex-column align-items-center" MaxWidth="30vw" Elevation="5">
            <MudText Typo="Typo.h4" Class="mb-5" Style="text-align:center;">Create a new project to get started! 😎</MudText>
            <CreateProjectButton Color="Color.Info" Variant="Variant.Text" OnProjectCreated="async () => await RefreshProjects()">
                Lets Go
            </CreateProjectButton>
        </MudPaper>
    </MudContainer>
}
else
{
    <GallerySettings OnFilterImages="async () => await FilterImages(false)"
                     OnResetFilters="async () => await FilterImages(true)"
                     OnProjectDeleted="async () => await RefreshProjects()" 
                     OnPageChanged="HandlePageChanged"
                     OnNavigationModeChanged="HandleNavigationModeChanged"
                     OnPageSizeChanged="HandlePageSizeChanged"/>
    @if (images != null && images.Images != null && images.Images.Count > 0)
    {
        @if (State.State.Gallery.UseInfiniteScroll)
        {
            <InfiniteScrollMasonry Images="@images" 
                                   OnLoadNextPage="LoadNextPage"
                                   OnImagesChanged="async () => await InvokeAsync(StateHasChanged)"/>
        }
        else
        {
            <ImagesContainer @ref=_imagesContainer
                             Style="margin-bottom: 2rem; margin-top: 2rem;"
                             Images="@images"
                             OnPageSelected="async (page) => await LoadPage(page)"
                             OnDeleteImage="async () => await LoadImages(false)"
                             OnCoverChanged="async () => await InvokeAsync(StateHasChanged)"
                             CanSelect=true />
        }
    }
    else if (images != null && images.Images != null && images.Images.Count == 0)
    {
        <MudText Style="opacity: 0.4; text-align: center; margin-top: 10rem;" Typo="Typo.h5">Empty Project</MudText>
    }
    else
    {
        <MudStack Row Justify="Justify.Center" Style="margin-top: 10rem;">
            <MudProgressCircular Color="Color.Success" Indeterminate />
        </MudStack>
    }
}

@code {
    private BaseProgress prog = new() { BarColor = Color.Error };
    private ImagesDto images = new();
    private List<Project>? _projects;
    private int currentImgPage;
    private bool _isLoadingNext;
    private IJSObjectReference? _infiniteScrollModule;
    private DotNetObjectReference<Index>? _dotNetRef;
    private ImagesContainer _imagesContainer = new();

    protected override async Task OnInitializedAsync()
    {
        DB.PageSize = State.State.Gallery.PageSize;
        Events.Subscribe<ProjectChangedEventArgs>(OnProjectChanged);
        Events.Subscribe<StateChangedEventArgs>(OnStateChanged);
        Events.Subscribe<ImageSelectionChangedEventArgs>(OnImageSelectionChanged);
        await LoadProjects();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && State.State.Gallery.UseInfiniteScroll)
        {
            await InitializeInfiniteScroll();
        }
    }

    private async Task InitializeInfiniteScroll()
    {
        if (_infiniteScrollModule == null)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _infiniteScrollModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/InfiniteMasonry.js");
            await _infiniteScrollModule.InvokeAsync<IJSObjectReference>("attachWindowScroll", _dotNetRef, new { threshold = 500 });
        }
    }

    private async Task<ImagesDto> FetchImagesPage(int page)
    {
        if (Gallery.IsGalleryFiltered)
        {
            if (State.State.Gallery.IsSelectedOnly)
                return await DB.GetPagedImages(page, Gallery.SelectedImageIds);
            else
                return await DB.GetSortedImages(page, State.State.Gallery.ProjectId, State.State.Gallery);
        }
        return await DB.GetPagedImages(page, State.State.Gallery.ProjectId);
    }

    private async Task LoadProjects()
    {
        _projects = await DB.GetProjects(State.State.Gallery.FolderId);
        await Gallery.GetProjects(State.State.Gallery.FolderId);
        currentImgPage = 1;
        await LoadImages(false);
    }

    private async Task FilterImages(bool resetFilter)
    {
        Gallery.IsGalleryFiltered = !resetFilter;
        await State.SaveState();

        currentImgPage = 1;
        images = await FetchImagesPage(1);

        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        if (State.State.Gallery.UseInfiniteScroll)
        {
            await EnsureEnoughContent();
        }
    }

    private async Task LoadImages(bool append)
    {
        if (!append)
        {
            currentImgPage = 1;
            images = await FetchImagesPage(1);
        }

        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        if (!append && State.State.Gallery.UseInfiniteScroll)
        {
            await EnsureEnoughContent();
        }
    }

    private async Task EnsureEnoughContent()
    {
        await Task.Delay(300);

        // Prevent infinite loop by limiting the number of preloaded pages while checking for scrollbar
        const int MAX_PRELOAD_PAGES = 3;
        int loadedPages = 0;

        while (images != null && images.HasNext && !await HasScrollbar() && loadedPages < MAX_PRELOAD_PAGES)
        {
            await LoadNextPage();
            loadedPages++;
            await Task.Delay(200);
        }
    }

    private async Task<bool> HasScrollbar()
    {
        try
        {
            var hasScroll = await JS.InvokeAsync<bool>("eval",
                "document.documentElement.scrollHeight > window.innerHeight");
            return hasScroll;
        }
        catch
        {
            return false;
        }
    }

    [JSInvokable]
    public async Task LoadNextPage()
    {
        if (_isLoadingNext || images == null || !images.HasNext) return;

        _isLoadingNext = true;
        currentImgPage++;
        var nextPage = await FetchImagesPage(currentImgPage);
        if (nextPage?.Images != null && nextPage.Images.Count > 0)
        {
            images.Images.AddRange(nextPage.Images);
            images.CurrentPage = nextPage.CurrentPage;
            images.PageCount = nextPage.PageCount;
            images.HasNext = nextPage.HasNext;
            images.HasPrev = nextPage.HasPrev;
        }
        _isLoadingNext = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandlePageChanged(int page)
    {
        await LoadPage(page);
    }

    private async Task HandlePageSizeChanged()
    {
        currentImgPage = 1;
        await LoadImages(false);
    }

    private async Task LoadPage(int page)
    {
        currentImgPage = page;
        images = await FetchImagesPage(page);
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    private async Task HandleNavigationModeChanged()
    {
        if (State.State.Gallery.UseInfiniteScroll)
        {
            await InitializeInfiniteScroll();
            await EnsureEnoughContent();
        }
        else
        {
            await DisposeInfiniteScroll();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshProjects()
    {
        await LoadProjects();
        await InvokeAsync(StateHasChanged);
    }

    private void OnProjectChanged(ProjectChangedEventArgs args)
    {
        _ = HandleProjectChangedAsync();
    }

    private void OnStateChanged(StateChangedEventArgs args)
    {
        _ = RefreshAsync();
    }

    private void OnImageSelectionChanged(ImageSelectionChangedEventArgs args)
    {
        RefreshUI();
    }

    private async Task HandleProjectChangedAsync()
    {
        // Reload projects to ensure UI is in sync
        _projects = await DB.GetProjects(State.State.Gallery.FolderId);
        currentImgPage = 1;
        await LoadImages(false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        await InvokeAsync(async () => await LoadImages(false));
    }

    private void RefreshUI()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task DisposeInfiniteScroll()
    {
        if (_infiniteScrollModule != null)
        {
            try
            {
                await _infiniteScrollModule.InvokeVoidAsync("dispose");
                await _infiniteScrollModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
            _infiniteScrollModule = null;
        }
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    public async ValueTask DisposeAsync()
    {
        Events.Unsubscribe<ProjectChangedEventArgs>(OnProjectChanged);
        Events.Unsubscribe<StateChangedEventArgs>(OnStateChanged);
        Events.Unsubscribe<ImageSelectionChangedEventArgs>(OnImageSelectionChanged);

        await DisposeInfiniteScroll();
    }
}