@using BlazorWebApp.Components.Shared.Generation
@using BlazorWebApp.Data.Dtos.ComfyUI.Workflow
@using static BlazorWebApp.Data.Enums
@inject ComfyUIService API
@inject ManagerService M
@inject WorkflowService WorkflowService
@inject ImageService ImageService
@inject NavigationManager NavManager
@implements IDisposable

@page "/comfyui/img2img/{id}"

@* Workflow Assets Panel - Full width before prompts *@
<WorkflowAssetsPanel Mode="ModeType.Img2Img" 
                     Workflow="@GetCurrentWorkflow()"
                     Columns="3"
                     IsInitiallyExpanded="false" />

<PromptFieldsSimple Prompt="@M.ParametersImg2Img?.Prompt"
                    PromptChanged="HandlePromptChanged"
                    NegativePrompt="@M.ParametersImg2Img?.NegativePrompt"
                    NegativePromptChanged="HandleNegativePromptChanged"
                    OnGenerate="Generate"
                    OnSkip="Skip"
                    OnInterrupt="Interrupt"
                    IsGenerateDisabled="@(string.IsNullOrWhiteSpace(M.Img2ImgInputImage))" />

<MudGrid>
    <MudItem xs="6">
        <MudStack Spacing="3">
            @* TODO: Future Enhancement - Advanced Image Editor
                - Fullscreen modal for detailed editing
                - Canvas-based pixel manipulation with undo/redo history
                - Brush tools for masks and inpainting
                - Zoom and pan capabilities
                - Layer support for multiple inputs/masks
                - Support for future inpainting workflows (black/white mask input)
                Current ImageInput provides basic upload, paste, and drag-drop functionality
            *@
            <ImageInput ImageData="@M.Img2ImgInputImage" 
                        ImageDataChanged="HandleImageDataChanged"
                        Title="Input Image"
                        OnImageLoaded="HandleImageLoaded" />
            <GenerateFormImg2ImgComfyUI />
        </MudStack>
    </MudItem>
    <MudItem xs="6">
        <GeneratedImageTabs />
    </MudItem>
</MudGrid>

@code {
    [Parameter] public string Id { get; set; }

    protected override void OnInitialized()
    {
        M.OnWorkflowBaseChanged += Refresh;
        M.OnImg2ImgParametersChanged += Refresh;
        M.OnImg2ImgInputImageChanged += Refresh;
    }

    private Workflow? GetCurrentWorkflow()
    {
        if (!string.IsNullOrWhiteSpace(Id) && Guid.TryParse(Id, out var workflowId))
        {
            return M.GetWorkflowById(workflowId);
        }
        return M.GetCurrentWorkflow();
    }

    private void HandlePromptChanged(string value)
    {
        if (M.ParametersImg2Img != null)
        {
            M.ParametersImg2Img.Prompt = value;
        }
    }
    
    private void HandleNegativePromptChanged(string value)
    {
        if (M.ParametersImg2Img != null)
        {
            M.ParametersImg2Img.NegativePrompt = value;
        }
    }
    
    private void HandleImageDataChanged(string value)
    {
        M.Img2ImgInputImage = value;
        StateHasChanged();
    }

    private async void Generate()
    {
        if (string.IsNullOrWhiteSpace(M.Img2ImgInputImage) || M.ParametersImg2Img == null)
        {
            return;
        }

        // Update parameters with current values and input image
        M.ParametersImg2Img.Image = M.Img2ImgInputImage;
        M.ParametersImg2Img.Comfy.Workflow = M.GetWorkflowById(Guid.Parse(Id));
        
        // Save state before generation
        await M.SaveState();
        
        // Generate image
        var generated = await ImageService.GetImages(ModeType.Img2Img);
        if (generated != null && generated.Images != null && generated.Images.Count > 0)
        {
            M.GeneratedImageEntities = generated;
        }
        
        // Save state after generation (includes seed, etc.)
        await M.SaveState();
        await InvokeAsync(StateHasChanged);
    }

    private async void Skip() => await API.PostClearQueue();

    private async void Interrupt()
    {
        M.State.Generation.IsInterrupted = true;
        await API.PostInterrupt();
    }

    private void HandleImageLoaded((int width, int height) dimensions)
    {
        if (M.ParametersImg2Img == null) return;
        
        // Auto-set resolution based on input image while maintaining aspect ratio
        if (dimensions.width > 0 && dimensions.height > 0)
        {
            var maxDim = Math.Max(dimensions.width, dimensions.height);
            var scale = 1024.0 / maxDim; // Target max dimension of 1024
            
            if (scale < 1)
            {
                M.ParametersImg2Img.Width = (int)(dimensions.width * scale / 8) * 8; // Round to nearest 8
                M.ParametersImg2Img.Height = (int)(dimensions.height * scale / 8) * 8;
            }
            else
            {
                M.ParametersImg2Img.Width = (dimensions.width / 8) * 8;
                M.ParametersImg2Img.Height = (dimensions.height / 8) * 8;
            }
            StateHasChanged();
        }
    }

    private async void Refresh() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        M.OnWorkflowBaseChanged -= Refresh;
        M.OnImg2ImgParametersChanged -= Refresh;
        M.OnImg2ImgInputImageChanged -= Refresh;
        
        // Save state on dispose
        _ = M.SaveState();
    }
}
