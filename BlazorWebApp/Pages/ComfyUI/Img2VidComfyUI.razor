@using BlazorWebApp.Data.Dtos.ComfyUI.Workflow
@using static BlazorWebApp.Data.Enums
@inject ComfyUIService API
@inject ManagerService M
@inject WorkflowService WorkflowService
@inject ImageService ImageService
@inject NavigationManager NavManager
@implements IDisposable

@page "/comfyui/img2vid/{id}"

<PromptFieldsSimple Prompt="@M.ParametersImg2Vid?.Prompt"
                    PromptChanged="HandlePromptChanged"
                    NegativePrompt="@M.ParametersImg2Vid?.NegativePrompt"
                    NegativePromptChanged="HandleNegativePromptChanged"
                    OnGenerate="Generate"
                    OnSkip="Skip"
                    OnInterrupt="Interrupt"
                    IsGenerateDisabled="@(string.IsNullOrWhiteSpace(M.Img2VidInputImage))" />

<MudGrid>
    <MudItem xs="6">
        <MudStack Spacing="3">
            <ImageInput ImageData="@M.Img2VidInputImage" 
                        ImageDataChanged="HandleImageDataChanged"
                        Title="Input Image"
                        OnImageLoaded="HandleImageLoaded" />
            <GenerateFormImg2VidComfyUI />
        </MudStack>
    </MudItem>
    <MudItem xs="6">
        <GeneratedVideoTabs GeneratedVideos="@_generatedVideos" />
    </MudItem>
</MudGrid>

@code {
    [Parameter] public string Id { get; set; }
    
    private GeneratedVideos _generatedVideos;

    protected override void OnInitialized()
    {
        M.OnWorkflowBaseChanged += Refresh;
        M.OnImg2VidParametersChanged += Refresh;
        M.OnImg2VidInputImageChanged += Refresh;
    }

    private void HandlePromptChanged(string value)
    {
        if (M.ParametersImg2Vid != null)
        {
            M.ParametersImg2Vid.Prompt = value;
        }
    }
    
    private void HandleNegativePromptChanged(string value)
    {
        if (M.ParametersImg2Vid != null)
        {
            M.ParametersImg2Vid.NegativePrompt = value;
        }
    }
    
    private void HandleImageDataChanged(string value)
    {
        M.Img2VidInputImage = value;
        StateHasChanged();
    }

    private async void Generate()
    {
        if (string.IsNullOrWhiteSpace(M.Img2VidInputImage) || M.ParametersImg2Vid == null)
        {
            return;
        }

        // Update parameters with current values and input image
        M.ParametersImg2Vid.Image = M.Img2VidInputImage;
        M.ParametersImg2Vid.Comfy.Workflow = M.GetWorkflowById(Guid.Parse(Id));
        
        // Save state before generation
        await M.SaveState();
        
        // Generate video
        _generatedVideos = await ImageService.GetVideo();
        
        // Save state after generation (includes seed, etc.)
        await M.SaveState();
        await InvokeAsync(StateHasChanged);
    }

    private async void Skip() => await API.PostClearQueue();

    private async void Interrupt()
    {
        M.State.Generation.IsInterrupted = true;
        await API.PostInterrupt();
    }

    private void HandleImageLoaded((int width, int height) dimensions)
    {
        if (M.ParametersImg2Vid == null) return;
        
        // Auto-set resolution based on input image while maintaining aspect ratio
        if (dimensions.width > 0 && dimensions.height > 0)
        {
            var maxDim = Math.Max(dimensions.width, dimensions.height);
            var scale = 768.0 / maxDim; // Target max dimension of 768
            
            if (scale < 1)
            {
                M.ParametersImg2Vid.Width = (int)(dimensions.width * scale / 8) * 8; // Round to nearest 8
                M.ParametersImg2Vid.Height = (int)(dimensions.height * scale / 8) * 8;
            }
            else
            {
                M.ParametersImg2Vid.Width = (dimensions.width / 8) * 8;
                M.ParametersImg2Vid.Height = (dimensions.height / 8) * 8;
            }
            StateHasChanged();
        }
    }

    private async void Refresh() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        M.OnWorkflowBaseChanged -= Refresh;
        M.OnImg2VidParametersChanged -= Refresh;
        M.OnImg2VidInputImageChanged -= Refresh;
        
        // Save state on dispose
        _ = M.SaveState();
    }
}
