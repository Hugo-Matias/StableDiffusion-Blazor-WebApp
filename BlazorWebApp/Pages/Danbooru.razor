@page "/danbooru"
@using BlazorWebApp.Models
@using BlazorWebApp.Data.Repositories
@using BlazorWebApp.Events
@using System.Text.RegularExpressions
@inject DanbooruService Api
@inject IStateService State
@inject ISettingsService Settings
@inject IOrchestratorService M
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject IDanbooruLibraryService LibraryService
@inject ISnackbar Snackbar
@inject IEventService EventService
@implements IAsyncDisposable

<TabbedPageShell @bind-ActivePanelIndex="_activeTabIndex">
    <MudTabPanel Text="Search" Icon="@Icons.Material.Filled.Search">
        <TopbarLayout>
            <Topbar>
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudTextField Label="Search" @bind-Value="State.State.Danbooru.SearchString"
                                      OnAdornmentClick=@(() => SearchDrawer.Visible = true) T="string" Adornment="Adornment.End"
                                      AdornmentIcon="fa-solid fa-magnifying-glass" Clearable Style="flex-grow: 1;" />
                        <MudButton OnClick="Search" ButtonType="ButtonType.Button" Color="Color.Success"
                                   Variant="Variant.Text">Search</MudButton>
                    </MudStack>
                    <MudTextField Label="Black List Tags" ValueChanged="HandleBlacklistTagsChanged"
                                  Value="Settings.Settings.Resources.Danbooru.BlacklistTags" T="string" Lines="2" />
                </MudStack>
            </Topbar>
            <Content>
                @if (_initialLoading)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="mt-10">
                        <MudProgressCircular Color="Color.Primary" Indeterminate />
                        <MudText Typo="Typo.caption">Loading images...</MudText>
                    </MudStack>
                }
                else if (Posts != null && Posts.Count > 0)
                {
                    <div class="danbooru-masonry-wrapper">
                        <div class="danbooru-masonry">
                            @foreach (var post in Posts)
                            {
                                <div class="danbooru-item">
                                    <DanbooruImageCard Post="post" OnSendTags=@(isImg2Img => WriteDanbooruTags(post, isImg2Img))
                                                       OnShowImage=@(() => ShowImageViewerDialog(post)) OnSave=@(() => SaveToLibrary(post)) />
                                </div>
                            }
                        </div>

                        @if (_isLoadingMore)
                        {
                            <div class="load-more-spinner">
                                <MudProgressCircular Color="Color.Primary" Indeterminate />
                            </div>
                        }
                        else if (!_hasMore)
                        {
                            <div class="end-of-results">
                                <MudText Typo="Typo.caption">End of results</MudText>
                            </div>
                        }
                    </div>
                }
                else if (!_initialLoading && (Posts == null || Posts.Count == 0))
                {
                    <MudStack AlignItems="AlignItems.Center" Class="mt-10">
                        <MudText Typo="Typo.body1" Style="opacity: 0.6;">No results found</MudText>
                    </MudStack>
                }
            </Content>
        </TopbarLayout>
    </MudTabPanel>
    <MudTabPanel Text="Library" Icon="@Icons.Material.Filled.CollectionsBookmark">
        <TopbarLayout>
            <Topbar>
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudTextField Label="Search Tags" @bind-Value="_libraryTagSearch" T="string" Clearable
                                      Style="flex-grow: 1;" />
                        <MudSelect T="string" Label="Rating" @bind-Value="_libraryRatingFilter" ResetValue=null
                                   Clearable Style="min-width: 140px;">
                            <MudSelectItem Value="@("g")">General</MudSelectItem>
                            <MudSelectItem Value="@("s")">Sensitive</MudSelectItem>
                            <MudSelectItem Value="@("q")">Questionable</MudSelectItem>
                            <MudSelectItem Value="@("e")">Explicit</MudSelectItem>
                        </MudSelect>
                        <MudTextField Label="Min Score" @bind-Value="_libraryMinScore" T="int"
                                      Style="min-width: 100px;" />
                        <MudCheckBox Label="Videos Only" @bind-Value="_libraryVideoOnly" />
                        <MudButton OnClick="LoadLibrary" ButtonType="ButtonType.Button" Color="Color.Success"
                                   Variant="Variant.Text">Filter</MudButton>
                    </MudStack>
                </MudStack>
            </Topbar>
            <Content>
                @if (_libraryLoading)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="mt-10">
                        <MudProgressCircular Color="Color.Primary" Indeterminate />
                        <MudText Typo="Typo.caption">Loading library...</MudText>
                    </MudStack>
                }
                else if (_libraryItems.Count > 0)
                {
                    <div class="danbooru-masonry-wrapper">
                        <div class="danbooru-masonry">
                            @foreach (var item in _libraryItems)
                            {
                                <div class="danbooru-item">
                                    <SavedDanbooruMediaCard Media="item" OnCopyTags=@(() => WriteLibraryTags(item, false))
                                                            OnSendImg2Img=@(() => WriteLibraryTags(item, true)) OnShowImage=@(() =>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ShowLibraryViewer(item)) OnOpenSource=@(() => OpenSource(item)) OnDelete=@(() =>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                