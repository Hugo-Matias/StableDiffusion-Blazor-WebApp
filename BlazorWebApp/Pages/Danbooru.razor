                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="3" Class="py-12">
                        <MudIcon Icon="@Icons.Material.Filled.CollectionsBookmark" Size="Size.Large"
                                 Color="Color.Default" />
                        <MudText Typo="Typo.h6" Color="Color.Default">Library is empty</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Default" Align="Align.Center">
