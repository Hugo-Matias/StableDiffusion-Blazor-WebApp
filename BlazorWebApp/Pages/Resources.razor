@page "/resources"
@using BlazorWebApp.Events
@inject IStateService State
@inject IEventService Events
@inject IDatabaseService DB
@inject IResourcesService ResourcesService
@implements IDisposable

<TabbedPageShell @bind-ActivePanelIndex="State.State.Resources.ActiveTabIndex">
    @foreach (var resource in _resources)
    {
        <MudTabPanel Text=@(resource.Key.Name == "TextualInversion" ? "Embedding" : resource.Key.Name)>
            @if (_selectedResource != null && _selectedResourceTypeId == resource.Key.Id)
            {
                <ResourceDetailPanel Resource="_selectedResource" OnBack="ReturnToResults"
                                     OnResourceChanged="HandleResourceChanged" OnResourceDeleted="HandleResourceDeleted" />
            }
            else
            {
                <ResourcePanel Resources="resource.Value" OnLoad="ShowResourceDetail" />
            }
        </MudTabPanel>
    }
    
    <MudTabPanel Text="Import">
        <ImportResourcePanel />
    </MudTabPanel>
</TabbedPageShell>

@code {
    private Dictionary<ResourceType, List<LocalResource>> _resources = new();
    private LocalResource? _selectedResource;
    private int? _selectedResourceTypeId;

    protected async override Task OnInitializedAsync()
    {
        Events.Subscribe<BackendAvailabilityChangedEventArgs>(OnBackendStateChanged);
        Events.Subscribe<DownloadCompletedEventArgs>(OnDownloadCompleted);
        Events.Subscribe<ResourcesChangedEventArgs>(OnResourcesStateChanged);
        
        await InitializeResourceDictionary();
    }

    private async Task InitializeResourceDictionary()
    {
        var resourceTypes = await DB.GetResourceTypes(ordered: true);
        _resources = new();
        foreach (var type in resourceTypes)
        {
            _resources.Add(type, await ResourcesService.CreateLocalResourcesByType(type.Id));
        }
    }

    private void ShowResourceDetail(LocalResource resource)
    {
        _selectedResource = resource;
        _selectedResourceTypeId = resource.Type.Id;
    }

    private void ReturnToResults()
    {
        _selectedResource = null;
        _selectedResourceTypeId = null;
    }

    private async Task HandleResourceChanged()
    {
        var selectedResourceId = _selectedResource?.ResourceId;
        await RefreshAsync();
        if (selectedResourceId != null)
        {
            _selectedResource = _resources.Values
                .SelectMany(resources => resources)
                .FirstOrDefault(resource => resource.ResourceId == selectedResourceId || resource.Files.Any(file => file.ResourceId ==
selectedResourceId));
            _selectedResourceTypeId = _selectedResource?.Type.Id;
        }
    }

    private async Task HandleResourceDeleted()
    {
        ReturnToResults();
        await RefreshAsync();
    }

    private void OnBackendStateChanged(BackendAvailabilityChangedEventArgs args) => _ = RefreshAsync();
    private void OnDownloadCompleted(DownloadCompletedEventArgs args) => _ = RefreshAsync();
    private void OnResourcesStateChanged(ResourcesChangedEventArgs args) => _ = RefreshAsync();

    private async Task RefreshAsync()
    {
        await InitializeResourceDictionary();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Events.Unsubscribe<BackendAvailabilityChangedEventArgs>(OnBackendStateChanged);
        Events.Unsubscribe<DownloadCompletedEventArgs>(OnDownloadCompleted);
        Events.Unsubscribe<ResourcesChangedEventArgs>(OnResourcesStateChanged);
    }
}
