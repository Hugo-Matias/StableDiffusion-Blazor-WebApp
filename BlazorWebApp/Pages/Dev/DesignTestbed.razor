@page "/dev/design-testbed"
@namespace BlazorWebApp.Pages.Dev
@using Microsoft.AspNetCore.Hosting
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IWebHostEnvironment HostEnvironment

<PageTitle>Design Test Bed</PageTitle>

@*
    UI Design Test Bed.

    Living catalog of every primitive documented in
    Documentation/Architecture/04-UI-DESIGN-LANGUAGE.md plus a sandbox for design
    iteration. Inline styles and scoped CSS are allowed here for prototyping; any
    pattern validated in this page MUST be extracted into a shared primitive
    (token / class / component) before being adopted by production pages.

    Phase 1 scope: shell + Tokens & Variables tab + Layout System tab. Subsequent
    phases will populate Form Controls, Buttons, Surfaces, Dialogs, Navigation,
    Data Display, and the Audit Report.
*@

<TabbedPageShell @bind-ActivePanelIndex="_activeTabIndex">

    @* ============================== TOKENS ============================== *@
    <MudTabPanel Text="Tokens & Variables">
        <ContentOnlyLayout>
            <MudStack Spacing="3">
                <div>
                    <MudText Typo="Typo.h5">Tokens &amp; Variables</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Live <code>--app-*</code> values from <code>:root</code> &middot; source:
                        <code>wwwroot/site.css</code>.
                    </MudText>
                </div>

                @if (_tokensLoading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_tokens.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        No <code>--app-*</code> tokens discovered. <code>site.css</code> failed to load or stylesheets are
                        cross-origin.
                    </MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Bordered="true" Striped="true">
                        <thead>
                            <tr>
                                <th style="width: 28%;">Variable</th>
                                <th style="width: 18%;">Computed</th>
                                <th style="width: 14%;">Preview</th>
                                <th>Purpose</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var token in _tokens)
                            {
                                <tr>
                                    <td><code>@token.Name</code></td>
                                    <td><code>@token.Value</code></td>
                                    <td>
                                        @if (IsLengthToken(token))
                                        {
                                            <div class="dt-token-bar" style="@($"width: min({token.Value}, 240px);")"></div>
                                        }
                                        else
                                        {
                                            <span class="dt-muted">&mdash;</span>
                                        }
                                    </td>
                                    <td>@GetTokenDescription(token.Name)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @_tokens.Count token(s) &middot; refresh after editing <code>site.css</code>.
                    </MudText>
                }

                <div class="dt-section-head">
                    <span class="dt-section-title">Elevation constants</span>
                    <span class="dt-section-sub">int &mdash; not CSS vars &middot;
                        <code>Components/Layouts/LayoutDefaults.cs</code></span>
                    </div>
                    <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                        <thead>
                            <tr>
                                <th style="width: 28%;">Constant</th>
                                <th style="width: 12%;">Value</th>
                                <th>Purpose</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>LayoutDefaults.TabsElevation</code></td>
                                <td><code>@LayoutDefaults.TabsElevation</code></td>
                                <td><code>MudTabs</code> on tabbed pages (via <code>TabbedPageShell</code>).</td>
                            </tr>
                            <tr>
                                <td><code>LayoutDefaults.SurfaceElevation</code></td>
                                <td><code>@LayoutDefaults.SurfaceElevation</code></td>
                                <td>Layout slot surfaces (sidebar / topbar / content).</td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudStack>
            </ContentOnlyLayout>
        </MudTabPanel>

        @* ============================== LAYOUT ============================== *@
        <MudTabPanel Text="Layout System">
            <ContentOnlyLayout>
                <MudStack Spacing="3">
                    <div>
                        <MudText Typo="Typo.h5">Layout Variants</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            The three allowed layouts inside a tab panel &middot; source: <code>Components/Layouts/</code>.
                        </MudText>
                    </div>

                    @* --- Two-column --- *@
                    <div class="dt-variant-frame">
                        <div class="dt-variant-header">
                            <MudText Typo="Typo.h6"><code>TwoColumnLayout</code></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Sidebar + content &middot; Resources, CivitAI, Prompts.
                            </MudText>
                        </div>
                        <div class="dt-variant-stage">
                            <TwoColumnLayout>
                                <Sidebar>
                                    <MudText Typo="Typo.subtitle2">Sidebar slot</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Filters, browse tree, settings.
                                    </MudText>
                                </Sidebar>
                                <Content>
                                    <MudText Typo="Typo.subtitle2">Content slot</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Children render flush against
                                        surface padding.</MudText>
                                    </Content>
                                </TwoColumnLayout>
                            </div>
                        </div>

                        @* --- Topbar --- *@
                        <div class="dt-variant-frame">
                            <div class="dt-variant-header">
                                <MudText Typo="Typo.h6"><code>TopbarLayout</code></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Filter bar + content &middot; Danbooru, Scheduler Results.
                                </MudText>
                            </div>
                            <div class="dt-variant-stage">
                                <TopbarLayout>
                                    <Topbar>
                                        <MudText Typo="Typo.subtitle2">Topbar slot</MudText>
                                    </Topbar>
                                    <Content>
                                        <MudText Typo="Typo.subtitle2">Content slot</MudText>
                                    </Content>
                                </TopbarLayout>
                            </div>
                        </div>

                        @* --- Content-only --- *@
                        <div class="dt-variant-frame">
                            <div class="dt-variant-header">
                                <MudText Typo="Typo.h6"><code>ContentOnlyLayout</code></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Single full-width surface &middot; Scheduler Runs, this testbed.
                                </MudText>
                            </div>
                            <div class="dt-variant-stage">
                                <ContentOnlyLayout>
                                    <MudText Typo="Typo.subtitle2">Single content surface</MudText>
                                </ContentOnlyLayout>
                            </div>
                        </div>

                        @* --- Deviations placeholder --- *@
                        <div class="dt-section-head">
                            <span class="dt-section-title">Deviations</span>
                            <span class="dt-section-sub">populated by Audit Report (Phase 8)</span>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Direct <code>MudTabs</code> rendering, root <code>pa-*</code> on slot children,
                            <code>MudContainer MaxWidth</code> on tabbed pages, and <code>PanelClass</code>
                            overrides will be flagged here once the scanner ships.
                        </MudText>
                    </MudStack>
                </ContentOnlyLayout>
            </MudTabPanel>

            @* ============================== FORM CONTROLS ============================== *@
            <MudTabPanel Text="Form Controls">
                <ContentOnlyLayout>
                    <MudStack Spacing="4">
                        <div>
                            <MudText Typo="Typo.h5">Form Controls</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Inventory of input primitives, deviations, and a cascading-selector prototype.
                            </MudText>
                        </div>

                        @* ---------- INVENTORY ---------- *@
                        <div class="dt-section-head">
                            <span class="dt-section-title">Text inputs</span>
                            <span class="dt-section-sub"><code>MudTextField</code> &middot; <code>MudNumericField</code></span>
                        </div>
                        <div class="dt-inv">
                            <div class="dt-inv-row">
                                <div class="dt-inv-render">
                                    <MudTextField T="string" @bind-Value="_demoText" Label="Label" Variant="Variant.Text"
                                                  Dense="true" />
                                </div>
                                <div class="dt-inv-label">Variant.Text Dense (forms)</div>
                                <div class="dt-inv-src"><code>Components/Shared/Generation/PromptsForm.razor</code></div>
                            </div>
                            <div class="dt-inv-row">
                                <div class="dt-inv-render">
                                    <MudNumericField T="int" @bind-Value="_demoNumber" Label="Steps" Variant="Variant.Text"
                                                     Dense="true" />
                                </div>
                                <div class="dt-inv-label">Numeric &middot; Variant.Text</div>
                                <div class="dt-inv-src"><code>Components/Shared/Generation/LoraForm.razor</code></div>
                            </div>
                            <div class="dt-inv-row">
                                <div class="dt-inv-render">
                                    <MudTextField T="string" Label="Multi-line" Lines="3" Variant="Variant.Outlined" />
                                </div>
                                <div class="dt-inv-label">Variant.Outlined Lines=3 (LLM views &mdash; deviation candidate)</div>
                                <div class="dt-inv-src">
                                    <code>Prompts/LLM/Views/MixerView.razor:17 &middot; TagBuilderView.razor:137</code></div>
                                </div>
                            </div>

                            <div class="dt-section-head">
                                <span class="dt-section-title">Selectors</span>
                                <span class="dt-section-sub"><code>MudSelect</code> for bounded, <code>MudAutocomplete</code> for
                                    large</span>
                                </div>
                                <div class="dt-inv">
                                    <div class="dt-inv-row">
                                        <div class="dt-inv-render" style="min-width: 220px;">
                                            <MudSelect T="string" @bind-Value="_demoSelect" Label="Mode" Variant="Variant.Text"
                                                       Dense="true">
                                                @foreach (var opt in _selectOptions)
                                                {
                                                    <MudSelectItem Value="@opt">@opt</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </div>
                                        <div class="dt-inv-label">Small bounded list (3 items)</div>
                                        <div class="dt-inv-src"><code>Gallery/GallerySettings.razor</code></div>
                                    </div>
                                    <div class="dt-inv-row">
                                        <div class="dt-inv-render" style="min-width: 220px;">
                                            <MudAutocomplete T="string" @bind-Value="_demoLargeList" Label="LoRA" Variant="Variant.Text"
                                                             Dense="true" SearchFunc="SearchLargeList" MaxItems="20" ResetValueOnEmptyText="true"
                                                             Clearable="true" CoerceText="true" />
                                        </div>
                                        <div class="dt-inv-label">@_largeListSize options &middot; SearchFunc required</div>
                                        <div class="dt-inv-src"><code>Components/Shared/Generation/LoraForm.razor</code></div>
                                    </div>
                                </div>

                                @* ---------- DEVIATIONS ---------- *@
                                <div class="dt-section-head">
                                    <span class="dt-section-title">Deviations</span>
                                    <span class="dt-section-sub">forms using <code>Variant.Outlined</code> outside dialogs</span>
                                </div>
                                <ul class="dt-dev-list">
                                    <li><code>MudTextField Lines=3 Variant.Outlined</code> &mdash;
                                        <code>Prompts/LLM/Views/MixerView.razor:17,18</code></li>
                                        <li><code>MudTextField Lines=4 Variant.Outlined</code> readonly result panes &mdash;
                                            <code>MixerView.razor:47 &middot; SceneBuilderView.razor:65 &middot; InspirationView.razor:96 &middot; TagBuilderView.razor:137</code>
                                        </li>
                                        <li><code>MudTextField Variant.Outlined Lines=3</code> &mdash;
                                            <code>Shared/Generation/LLMPromptEnhancerForm.razor:12</code></li>
                                        </ul>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            The LLM views consistently chose <code>Variant.Outlined</code> for multi-line prompt
                                            inputs. Worth deciding whether multi-line is a documented exception or whether these
                                            should migrate to <code>Variant.Text</code>.
                                        </MudText>

                                        @* ---------- PROTOTYPE LAB ---------- *@
                                        <div class="dt-section-head">
                                            <span class="dt-section-title">Prototype: cascading Folder &rarr; Project</span>
                                            <span class="dt-section-sub">filter selector clears invalid downstream value</span>
                                        </div>
                                        <div class="dt-lab">
                                            <div class="dt-lab-stage" style="flex-direction: column; align-items: stretch; gap: 12px;">
                                                <MudGrid Spacing="2">
                                                    <MudItem xs="12" md="6">
                                                        <MudSelect T="string" Value="@_cascadeFolder" ValueChanged="OnCascadeFolderChanged"
                                                                   Label="Folder (filter)" Variant="Variant.Text" Dense="true">
                                                            <MudSelectItem Value="@CascadeAllFolders">All folders</MudSelectItem>
                                                            @foreach (var folder in _cascadeFolders)
                                                            {
                                                                <MudSelectItem Value="@folder">@folder</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </MudItem>
                                                    <MudItem xs="12" md="6">
                                                        <MudSelect T="string" @bind-Value="_cascadeProject"
                                                                   Label="Project (target &mdash; persisted)" Variant="Variant.Text" Dense="true">
                                                            @foreach (var project in _cascadeProjectsForFolder)
                                                            {
                                                                <MudSelectItem Value="@project">@project</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </MudItem>
                                                </MudGrid>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    Change Folder &rarr; Project list refreshes; invalid current Project clears. Only Project is
                                                    persisted.
                                                </MudText>
                                            </div>
                                        </div>

                                        @* ---------- COMPARE ---------- *@
                                        <div class="dt-section-head">
                                            <span class="dt-section-title">Compare: form variant</span>
                                            <span class="dt-section-sub">documented rule (<code>04-UI-DESIGN-LANGUAGE.md</code> &middot; Input
                                                variant)</span>
                                            </div>
                                            <div class="dt-compare-grid dt-compare-grid--two">
                                                <div class="dt-compare-col dt-compare-col--good">
                                                    <div class="dt-compare-tag dt-compare-tag--good">Use &middot; Variant.Text</div>
                                                    <MudStack Spacing="2">
                                                        <MudTextField T="string" Label="Label" Variant="Variant.Text" Dense="true" />
                                                        <MudSelect T="string" Label="Select" Variant="Variant.Text" Dense="true">
                                                            @foreach (var opt in _selectOptions)
                                                            {
                                                                <MudSelectItem Value="@opt">@opt</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </MudStack>
                                                </div>
                                                <div class="dt-compare-col dt-compare-col--bad">
                                                    <div class="dt-compare-tag dt-compare-tag--bad">Avoid &middot; Variant.Outlined (forms)</div>
                                                    <MudStack Spacing="2">
                                                        <MudTextField T="string" Label="Label" Variant="Variant.Outlined" />
                                                        <MudSelect T="string" Label="Select" Variant="Variant.Outlined">
                                                            @foreach (var opt in _selectOptions)
                                                            {
                                                                <MudSelectItem Value="@opt">@opt</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </MudStack>
                                                </div>
                                            </div>
                                        </MudStack>
                                    </ContentOnlyLayout>
                                </MudTabPanel>

                                <MudTabPanel Text="Buttons &amp; Actions">
                                    <ContentOnlyLayout>
                                        <MudStack Spacing="4">
                                            <div>
                                                <MudText Typo="Typo.h5">Buttons &amp; Actions</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                    Inventory of every button-like primitive in production, deviations, and a prototype lab to
                                                    converge them.
                                                    Rules live in <code>04-UI-DESIGN-LANGUAGE.md</code> &mdash; this page is a playground.
                                                </MudText>
                                            </div>

                                            @* ---------- INVENTORY: send-to-btn ---------- *@
                                            <div class="dt-section-head">
                                                <span class="dt-section-title"><code>.send-to-btn</code></span>
                                                <span class="dt-section-sub">plain HTML button + <code>send-to.css</code> &middot; mode tints via
                                                    <code>mode-*</code></span>
                                                </div>
                                                <div class="dt-inv">
                                                    <div class="dt-inv-row">
                                                        <div class="dt-inv-render">
                                                            <button class="send-to-btn mode-txt2img" type="button">
                                                                <MudIcon Icon="fa-solid fa-wand-magic-sparkles" Size="Size.Small" /><span>txt2img</span>
                                                            </button>
                                                            <button class="send-to-btn mode-img2img" type="button">
                                                                <MudIcon Icon="fa-solid fa-image" Size="Size.Small" /><span>img2img</span>
                                                            </button>
                                                            <button class="send-to-btn mode-img2vid" type="button">
                                                                <MudIcon Icon="fa-solid fa-film" Size="Size.Small" /><span>img2vid</span>
                                                            </button>
                                                            <button class="send-to-btn mode-extras" type="button">
                                                                <MudIcon Icon="fa-solid fa-sliders" Size="Size.Small" /><span>extras</span>
                                                            </button>
                                                        </div>
                                                        <div class="dt-inv-label">Workflow send-to row, all four modes</div>
                                                        <div class="dt-inv-src"><code>Components/Shared/Image/AssetInfoPanel.razor:51</code></div>
                                                    </div>
                                                    <div class="dt-inv-row">
                                                        <div class="dt-inv-render">
                                                            <button class="send-to-btn" type="button">
                                                                <MudIcon Icon="fa-solid fa-copy" Size="Size.Small" /><span>Copy</span>
                                                            </button>
                                                        </div>
                                                        <div class="dt-inv-label">Plain (no mode tint)</div>
                                                        <div class="dt-inv-src"><code>Components/Prompts/LLM/Views/TagBuilderView.razor:156</code></div>
                                                    </div>
                                                    <div class="dt-inv-row">
                                                        <div class="dt-inv-render">
                                                            <MudButton Class="send-to-btn" Variant="Variant.Text" StartIcon="fa-solid fa-share">Spawn
                                                            </MudButton>
                                                        </div>
                                                        <div class="dt-inv-label">Hybrid <code>MudButton Class="send-to-btn"</code> (deviation
                                                            candidate)</div>
                                                            <div class="dt-inv-src"><code>Components/Resources/CivitaiModelSpecCard.razor:45</code></div>
                                                        </div>
                                                    </div>

                                                    @* ---------- INVENTORY: MudButton ---------- *@
                                                    <div class="dt-section-head">
                                                        <span class="dt-section-title"><code>MudButton</code></span>
                                                        <span class="dt-section-sub">variants &times; colors actually used in production</span>
                                                    </div>
                                                    <div class="dt-inv">
                                                        <div class="dt-inv-row">
                                                            <div class="dt-inv-render">
                                                                <MudButton Variant="Variant.Filled" Color="Color.Primary">Apply</MudButton>
                                                                <MudButton Variant="Variant.Filled" Color="Color.Success">Save</MudButton>
                                                                <MudButton Variant="Variant.Filled" Color="Color.Error">Delete</MudButton>
                                                            </div>
                                                            <div class="dt-inv-label">Filled &middot; Primary / Success / Error</div>
                                                            <div class="dt-inv-src">
                                                                <code>Gallery/SelectionsDrawer.razor:14 &middot; Prompts/ArtistBrowserPanel.razor:134</code>
                                                            </div>
                                                        </div>
                                                        <div class="dt-inv-row">
                                                            <div class="dt-inv-render">
                                                                <MudButton Variant="Variant.Text" Color="Color.Primary">Cancel</MudButton>
                                                                <MudButton Variant="Variant.Text" Color="Color.Error">Discard</MudButton>
                                                                <MudButton Variant="Variant.Text">Default</MudButton>
                                                            </div>
                                                            <div class="dt-inv-label">Text &middot; Primary / Error / Default</div>
                                                            <div class="dt-inv-src">
                                                                <code>Gallery/GallerySettings.razor:45 &middot; Scheduler/SchedulerEditorTab.razor:211</code>
                                                            </div>
                                                        </div>
                                                        <div class="dt-inv-row">
                                                            <div class="dt-inv-render">
                                                                <MudButton Variant="Variant.Outlined" Color="Color.Primary">Open editor</MudButton>
                                                                <MudButton Variant="Variant.Outlined" Color="Color.Default">Reset</MudButton>
                                                            </div>
                                                            <div class="dt-inv-label">Outlined (rare; emphasis only)</div>
                                                            <div class="dt-inv-src"><code>ImageEditor/ImageEditorModal.razor:428</code></div>
                                                        </div>
                                                    </div>

                                                    @* ---------- INVENTORY: MudIconButton ---------- *@
                                                    <div class="dt-section-head">
                                                        <span class="dt-section-title"><code>MudIconButton</code></span>
                                                        <span class="dt-section-sub">toolbar icon-only</span>
                                                    </div>
                                                    <div class="dt-inv">
                                                        <div class="dt-inv-row">
                                                            <div class="dt-inv-render">
                                                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                                               Variant="Variant.Text" />
                                                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                                                               Variant="Variant.Text" />
                                                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                                               Variant="Variant.Text" />
                                                            </div>
                                                            <div class="dt-inv-label">Size.Small Variant.Text</div>
                                                            <div class="dt-inv-src">
                                                                <code>ImageEditor/LayerPanel.razor:21 &middot; ImageEditorModal.razor:33</code></div>
                                                            </div>
                                                        </div>

                                                        @* ---------- INVENTORY: MudButtonGroup ---------- *@
                                                        <div class="dt-section-head">
                                                            <span class="dt-section-title"><code>MudButtonGroup</code></span>
                                                            <span class="dt-section-sub">segmented control</span>
                                                        </div>
                                                        <div class="dt-inv">
                                                            <div class="dt-inv-row">
                                                                <div class="dt-inv-render">
                                                                    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                                                                        <MudButton>Brush</MudButton>
                                                                        <MudButton>Erase</MudButton>
                                                                        <MudButton>Color</MudButton>
                                                                    </MudButtonGroup>
                                                                </div>
                                                                <div class="dt-inv-label">Outlined / Small (tool selection)</div>
                                                                <div class="dt-inv-src"><code>ImageEditor/ImageEditorModal.razor:49</code></div>
                                                            </div>
                                                        </div>

                                                        @* ---------- INVENTORY: MudToggleIconButton + MudToggleGroup ---------- *@
                                                        <div class="dt-section-head">
                                                            <span class="dt-section-title"><code>MudToggleIconButton</code> + <code>MudToggleGroup</code></span>
                                                            <span class="dt-section-sub">stateful single &amp; multi toggles</span>
                                                        </div>
                                                        <div class="dt-inv">
                                                            <div class="dt-inv-row">
                                                                <div class="dt-inv-render">
                                                                    <MudToggleIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                                                                         ToggledIcon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" />
                                                                </div>
                                                                <div class="dt-inv-label">Order ascending / descending toggle</div>
                                                                <div class="dt-inv-src"><code>Gallery/GallerySettings.razor:136</code></div>
                                                            </div>
                                                            <div class="dt-inv-row">
                                                                <div class="dt-inv-render">
                                                                    <MudToggleGroup T="string" SelectionMode="SelectionMode.SingleSelection">
                                                                        <MudToggleItem Value="@("Save")">Save</MudToggleItem>
                                                                        <MudToggleItem Value="@("Load")">Load</MudToggleItem>
                                                                    </MudToggleGroup>
                                                                </div>
                                                                <div class="dt-inv-label">Single-selection mode toggle</div>
                                                                <div class="dt-inv-src"><code>Prompts/LLM/Views/ForgeSaveDialog.razor:13</code></div>
                                                            </div>
                                                            <div class="dt-inv-row">
                                                                <div class="dt-inv-render">
                                                                    <MudToggleGroup T="string" SelectionMode="SelectionMode.MultiSelection">
                                                                        <MudToggleItem Value="@("Low")">Low</MudToggleItem>
                                                                        <MudToggleItem Value="@("Med")">Med</MudToggleItem>
