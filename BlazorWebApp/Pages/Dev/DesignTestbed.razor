                                                                                                                                                                                                                    @* ---------- INVENTORY ---------- *@
                                                                                                                                                                                                                    <div class="dt-section-head">
                                                                                                                                                                                                                        <span class="dt-section-title">Card grid</span>
                                                                                                                                                                                                                        <span class="dt-section-sub"><code>repeat(auto-fill, minmax(...))</code> with token-driven card
                                                                                                                                                                                                                            width</span>
                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                        <div class="dt-inv">
                                                                                                                                                                                                                            <div class="dt-inv-row">
                                                                                                                                                                                                                                <div class="dt-inv-render" style="width: 100%;">
                                                                                                                                                                                                                                    <div class="app-grid" style="--app-card-min: 100px;">
                                                                                                                                                                                                                                        @for (var i = 1; i <= 8; i++)
                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                            <div class="dt-grid-cell">card @(i)</div>
                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                <div class="dt-inv-label">Auto-fill grid &middot; <code>.app-grid</code> primitive (min 100px
                                                                                                                                                                                                                                    override)</div>
                                                                                                                                                                                                                                    <div class="dt-inv-src"><code>Components/Prompts/ArtistBrowserPanel.razor.css:68</code> &middot;
                                                                                                                                                                                                                                        <code>ResourcePanel</code> &middot; <code>CivitaiModelsPanel</code></div>
                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                </div>

                                                                                                                                                                                                                                <div class="dt-section-head">
                                                                                                                                                                                                                                    <span class="dt-section-title">Pagination</span>
                                                                                                                                                                                                                                    <span class="dt-section-sub"><code>MudPagination</code> &middot; two consistent variants</span>
                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                <div class="dt-inv">
                                                                                                                                                                                                                                    <div class="dt-inv-row">
                                                                                                                                                                                                                                        <div class="dt-inv-render">
                                                                                                                                                                                                                                            <MudPagination BoundaryCount="2" MiddleCount="3" Count="12" @bind-Selected="_protoPage"
                                                                                                                                                                                                                                                           Size="Size.Small" />
                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                        <div class="dt-inv-label">Topbar style &middot; <code>Size.Small &middot; Middle=3</code></div>
                                                                                                                                                                                                                                        <div class="dt-inv-src"><code>Components/Img2Vid/GeneratedVideoTabs.razor:77</code></div>
                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                    <div class="dt-inv-row">
                                                                                                                                                                                                                                        <div class="dt-inv-render">
                                                                                                                                                                                                                                            <MudPagination BoundaryCount="2" MiddleCount="5" Count="12" @bind-Selected="_protoPage" />
                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                        <div class="dt-inv-label">Full pagination &middot; <code>Middle=5</code></div>
                                                                                                                                                                                                                                        <div class="dt-inv-src"><code>Components/Resources/ResourcePanel.razor:115</code></div>
                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                </div>

                                                                                                                                                                                                                                <div class="dt-section-head">
                                                                                                                                                                                                                                    <span class="dt-section-title">Scrollable container</span>
                                                                                                                                                                                                                                    <span class="dt-section-sub">viewport-relative max-height &middot;
                                                                                                                                                                                                                                        <code>--resources-scroll-offset</code> in one place</span>
                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                    <div class="dt-inv">
                                                                                                                                                                                                                                        <div class="dt-inv-row">
                                                                                                                                                                                                                                            <div class="dt-inv-render" style="width: 280px;">
                                                                                                                                                                                                                                                <div class="dt-scroll-frame" style="height: 160px;">
                                                                                                                                                                                                                                                    <div class="dt-scroll-body">
                                                                                                                                                                                                                                                        @for (var i = 1; i <= 30; i++)
                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                            <MudText Typo="Typo.caption" Class="d-block">Row @(i)</MudText>
                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                            </div>
                                                                                                                                                                                                                                            <div class="dt-inv-label"><code>overflow-y: auto</code> with bounded body height</div>
                                                                                                                                                                                                                                            <div class="dt-inv-src"><code>Components/Resources/ResourcePanel.razor.css:7</code> uses
                                                                                                                                                                                                                                                <code>--resources-scroll-offset</code></div>
                                                                                                                                                                                                                                            </div>
                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                        <div class="dt-section-head">
                                                                                                                                                                                                                                            <span class="dt-section-title">MudTable</span>
                                                                                                                                                                                                                                            <span class="dt-section-sub">data tables &mdash; no <code>MudDataGrid</code> in this app</span>
                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                        <div class="dt-inv">
                                                                                                                                                                                                                                            <div class="dt-inv-row">
                                                                                                                                                                                                                                                <div class="dt-inv-render" style="width: 100%;">
                                                                                                                                                                                                                                                    <MudTable Items="@_protoTableRows" Hover="true" Dense="true" Striped="true" Elevation="0">
                                                                                                                                                                                                                                                        <HeaderContent>
                                                                                                                                                                                                                                                            <MudTh>Job</MudTh>
                                                                                                                                                                                                                                                            <MudTh>Status</MudTh>
                                                                                                                                                                                                                                                            <MudTh>Started</MudTh>
                                                                                                                                                                                                                                                        </HeaderContent>
                                                                                                                                                                                                                                                        <RowTemplate>
                                                                                                                                                                                                                                                            <MudTd>@context.Job</MudTd>
                                                                                                                                                                                                                                                            <MudTd>@context.Status</MudTd>
                                                                                                                                                                                                                                                            <MudTd>@context.Started</MudTd>
                                                                                                                                                                                                                                                        </RowTemplate>
                                                                                                                                                                                                                                                    </MudTable>
                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                <div class="dt-inv-label">Hover + Dense + Striped + <code>Elevation=0</code></div>
                                                                                                                                                                                                                                                <div class="dt-inv-src"><code>Components/Scheduler/SchedulerRunsTab.razor:31</code></div>
                                                                                                                                                                                                                                            </div>
                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                        @* ---------- DEVIATIONS ---------- *@
                                                                                                                                                                                                                                        <div class="dt-section-head">
                                                                                                                                                                                                                                            <span class="dt-section-title">Deviations</span>
                                                                                                                                                                                                                                            <span class="dt-section-sub">inconsistent chrome offsets and hard-coded grid widths</span>
                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                        <ul class="dt-dev-list">
                                                                                                                                                                                                                                            <li>Hard-coded <code>grid-template-columns: repeat(auto-fill, minmax(120px, 1fr))</code> &mdash;
                                                                                                                                                                                                                                                <code>ArtistBrowserPanel.razor.css:68</code> (no <code>--app-card-*</code> token)</li>
                                                                                                                                                                                                                                                <li>Inconsistent scroll offsets: <code>calc(100vh - 180px)</code> in
                                                                                                                                                                                                                                                    <code>WildcardsTab.razor.css:9</code>, <code>200px</code> in
                                                                                                                                                                                                                                                    <code>CategoryBrowser.razor.css:48</code>, <code>280px</code> default in
                                                                                                                                                                                                                                                    <code>ResourcePanel.razor.css:7</code>, <code>300px</code> in
                                                                                                                                                                                                                                                    <code>CollectionBrowser.razor.css:2</code></li>
                                                                                                                                                                                                                                                    <li>Empty state markup variation: inline <code>Style="opacity: 0.6;"</code> vs inline
                                                                                                                                                                                                                                                        <code>Style="opacity: 0.4; text-align: center; margin-top: 10rem;"</code> &mdash;
                                                                                                                                                                                                                                                        <code>Pages/Danbooru.razor:71</code> &middot; <code>Pages/Index.razor:59</code></li>
                                                                                                                                                                                                                                                        <li>No <code>Virtualize</code> on any grid &mdash; large galleries render every card up to the page
                                                                                                                                                                                                                                                            slice</li>
                                                                                                                                                                                                                                                        </ul>
                                                                                                                                                                                                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                                                                                                                                                                                                            The four scroll-offset values represent four different chrome assumptions
                                                                                                                                                                                                                                                            (NavBar + WorkflowStrip + tabs + filter bar). A shared <code>--app-content-scroll-offset</code>
                                                                                                                                                                                                                                                            or wrapper component would unify these.
                                                                                                                                                                                                                                                        </MudText>

                                                                                                                                                                                                                                                        @* ---------- PROTOTYPE LAB ---------- *@
                                                                                                                                                                                                                                                        <div class="dt-section-head">
                                                                                                                                                                                                                                                            <span class="dt-section-title">Prototype: token-driven grid</span>
                                                                                                                                                                                                                                                            <span class="dt-section-sub">tune card min-width and gap live; no hard-coded pixel rules</span>
                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                        <div class="dt-lab">
                                                                                                                                                                                                                                                            <div class="dt-lab-controls">
                                                                                                                                                                                                                                                                <MudText Typo="Typo.caption" Class="me-2">card min-width</MudText>
                                                                                                                                                                                                                                                                <MudSlider T="int" @bind-Value="_protoCardMin" Min="80" Max="280" Step="10"
                                                                                                                                                                                                                                                                           Style="max-width: 200px;">
                                                                                                                                                                                                                                                                    @(_protoCardMin)px
                                                                                                                                                                                                                                                                </MudSlider>
                                                                                                                                                                                                                                                                <MudText Typo="Typo.caption" Class="me-2 ms-3">gap</MudText>
                                                                                                                                                                                                                                                                <MudSlider T="int" @bind-Value="_protoGridGap" Min="0" Max="24" Step="2"
                                                                                                                                                                                                                                                                           Style="max-width: 160px;">
                                                                                                                                                                                                                                                                    @(_protoGridGap)px
                                                                                                                                                                                                                                                                </MudSlider>
                                                                                                                                                                                                                                                                <MudText Typo="Typo.caption" Class="me-2 ms-3">items</MudText>
                                                                                                                                                                                                                                                                <MudNumericField T="int" @bind-Value="_protoGridCount" Min="0" Max="60" Variant="Variant.Text"
                                                                                                                                                                                                                                                                                 Dense="true" Style="max-width: 80px;" />
                                                                                                                                                                                                                                                            </div>
                                                                                                                                                                                                                                                            <div class="dt-lab-stage" style="flex-direction: column; align-items: stretch;">
                                                                                                                                                                                                                                                                @if (_protoGridCount == 0)
                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                    <div class="app-empty-state">
                                                                                                                                                                                                                                                                        <MudIcon Icon="@Icons.Material.Outlined.Inbox" Size="Size.Large" />
                                                                                                                                                                                                                                                                        <MudText Typo="Typo.body2">No items</MudText>
                                                                                                                                                                                                                                                                        <MudText Typo="Typo.caption">Increase the items numeric to populate the grid.</MudText>
                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                else
                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                    <div class="app-grid"
                                                                                                                                                                                                                                                                         style="@($"--app-card-min: {_protoCardMin}px; --app-grid-gap: {_protoGridGap}px;")">
                                                                                                                                                                                                                                                                        @for (var i = 1; i <= _protoGridCount; i++)
                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                            <div class="dt-grid-cell">item @(i)</div>
                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                                                                                                                                                                                                                                                    Live primitives: <code>.app-grid</code> + <code>.app-empty-state</code> (extracted in Phase
                                                                                                                                                                                                                                                                    9). Replaces every per-component <code>repeat(auto-fill, minmax(NNNpx, 1fr))</code>
                                                                                                                                                                                                                                                                    declaration and inline empty-state markup.
                                                                                                                                                                                                                                                                </MudText>
