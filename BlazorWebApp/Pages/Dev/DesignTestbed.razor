    {
        "Scheduler", "Prompts", "Resources", "CivitAI", "Danbooru", "Generate"
    };

    // ---- Data Display prototype lab state (Phase 7) ----
    private int _protoPage = 3;
    private int _protoCardMin = 140;
    private int _protoGridGap = 8;
    private int _protoGridCount = 12;

    private record ProtoTableRow(string Job, string Status, string Started);
    private static readonly ProtoTableRow[] _protoTableRows = new[]
    {
        new ProtoTableRow("job_001", "Completed", "2 min ago"),
        new ProtoTableRow("job_002", "Running", "12 sec ago"),
        new ProtoTableRow("job_003", "Queued", "just now"),
        new ProtoTableRow("job_004", "Failed", "5 min ago"),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var values = await JS.InvokeAsync<Dictionary<string, string>>(
                "designTestbed.getRootTokens",
                "--app-");

            _tokens = values
                .OrderBy(kvp => kvp.Key, StringComparer.Ordinal)
                .Select(kvp => new TokenInfo(kvp.Key, kvp.Value))
                .ToList();
        }
        catch
        {
            // Swallow: the empty-state UI handles a failed read.
            _tokens = new();
        }
        finally
        {
            _tokensLoading = false;
            StateHasChanged();
        }
    }

    private static bool IsLengthToken(TokenInfo t)
        => t.Value.EndsWith("px", StringComparison.Ordinal)
           || t.Value.EndsWith("rem", StringComparison.Ordinal)
           || t.Value.EndsWith("em", StringComparison.Ordinal);

