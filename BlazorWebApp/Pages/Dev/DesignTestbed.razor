                                                                                                                                                                                                                <MudTabs Elevation="@_protoTabsElevation" Rounded="@_protoTabsRounded"
                                                                                                                                                                                                                         Centered="@_protoTabsCentered" ApplyEffectsToContainer="@_protoTabsApplyEffects"
                                                                                                                                                                                                                         PanelClass="pa-3">
                                                                                                                                                                                                                    <MudTabPanel Text="Inventory">
                                                                                                                                                                                                                        <MudText Typo="Typo.caption">Panel A body</MudText>
                                                                                                                                                                                                                    </MudTabPanel>
                                                                                                                                                                                                                    <MudTabPanel Text="Deviations">
                                                                                                                                                                                                                        <MudText Typo="Typo.caption">Panel B body</MudText>
