    private record TokenInfo(string Name, string Value);

    // ---- Form Controls demo state (Phase 2) ----
    private string? _demoText = "Sample value";
    private int _demoNumber = 42;
    private string? _demoSelect = "Mode A";
    private string? _demoAutocomplete = "Mode A";
    private string? _demoLargeList;

    private static readonly string[] _selectOptions = new[] { "Mode A", "Mode B", "Mode C" };

    private static readonly IReadOnlyList<string> _largeList = Enumerable
        .Range(1, 240)
        .Select(i => $"lora_pack_{i:000}")
        .ToList();
    private int _largeListSize => _largeList.Count;

    // Cascading selector demo: Folder filters Project list.
    private const string CascadeAllFolders = "__all__";
    private static readonly Dictionary<string, IReadOnlyList<string>> _cascadeData = new()
    {
        ["Characters"] = new[] { "Aria", "Bjorn", "Cassia" },
        ["Environments"] = new[] { "Forest", "City", "Ocean" },
        ["Concepts"] = new[] { "Fluid", "Geometric", "Industrial" },
    };
    private static readonly IReadOnlyList<string> _cascadeFolders = _cascadeData.Keys.ToList();
    private string _cascadeFolder = CascadeAllFolders;
    private string? _cascadeProject = "Aria";

    private IEnumerable<string> _cascadeProjectsForFolder
        => _cascadeFolder == CascadeAllFolders
            ? _cascadeData.Values.SelectMany(v => v)
            : _cascadeData.TryGetValue(_cascadeFolder, out var list) ? list : Array.Empty<string>();

    private void OnCascadeFolderChanged(string newFolder)
    {
        _cascadeFolder = newFolder;
        // Clear Project if it is not part of the new folder's list.
        if (_cascadeProject is not null && !_cascadeProjectsForFolder.Contains(_cascadeProject))
        {
            _cascadeProject = null;
        }
    }

    private Task<IEnumerable<string>> SearchSelectOptions(string? value)
        => Task.FromResult<IEnumerable<string>>(string.IsNullOrWhiteSpace(value)
            ? _selectOptions
            : _selectOptions.Where(o => o.Contains(value, StringComparison.OrdinalIgnoreCase)));

    private Task<IEnumerable<string>> SearchLargeList(string? value)
        => Task.FromResult<IEnumerable<string>>(string.IsNullOrWhiteSpace(value)
            ? _largeList.Take(20)
            : _largeList.Where(o => o.Contains(value, StringComparison.OrdinalIgnoreCase)).Take(20));

    // ---- Buttons & Actions prototype lab state (Phase 3) ----
    private string _protoSize = "md"; // sm | md | lg
    private string _protoTone = "neutral"; // neutral | ghost | accent | danger
    private bool _protoIconOnly;
    private bool _protoDense;

    private string ProtoClasses()
    {
        var classes = new List<string> { "dt-proto-btn", $"dt-proto-btn--{_protoSize}", $"dt-proto-btn--{_protoTone}" };
        if (_protoIconOnly) classes.Add("dt-proto-btn--icon-only");
        if (_protoDense) classes.Add("dt-proto-btn--dense");
        return string.Join(' ', classes);
    }

    // ---- Cards & Surfaces prototype lab state (Phase 4) ----
    private string _protoCardTone = "surface"; // flush | surface | focus | outlined
    private string _protoCardDensity = "cozy"; // dense | cozy | comfortable
    private bool _protoCardInteractive;

    private string ProtoCardClasses()
    {
        var classes = new List<string>
        {
            "dt-proto-card",
            $"dt-proto-card--{_protoCardTone}",
            $"dt-proto-card--{_protoCardDensity}",
        };
        if (_protoCardInteractive) classes.Add("dt-proto-card--interactive");
        return string.Join(' ', classes);
    }

    // ---- Dialogs & Modals prototype lab state (Phase 5) ----
    private int _protoVersionCount = 4;
