                                                                                                                            <code>Scheduler/SchedulerEditorTab.razor:161</code></li>
                                                                                                                            <li>Inline <code>Style="background-color: rgba(0,0,0,0.02);"</code> for "subtle" surface &mdash;
                                                                                                                                <code>Prompts/PromptDialog.razor:78</code></li>
                                                                                                                                <li>Custom <code>box-shadow: -4px 0 24px ...</code> on a side panel (no token) &mdash;
                                                                                                                                    <code>Img2Vid/VideoViewer.razor.css:256</code></li>
                                                                                                                                </ul>

                                                                                                                                @* ---------- PROTOTYPE LAB ---------- *@
                                                                                                                                <div class="dt-section-head">
                                                                                                                                    <span class="dt-section-title">Prototype: <code>dt-proto-card</code></span>
                                                                                                                                    <span class="dt-section-sub">unified card sourced from <code>--app-surface-*</code> +
                                                                                                                                        <code>--mud-elevation-*</code></span>
                                                                                                                                    </div>
                                                                                                                                    <div class="dt-lab">
                                                                                                                                        <div class="dt-lab-controls">
                                                                                                                                            <MudText Typo="Typo.caption" Class="me-2">tone</MudText>
                                                                                                                                            <MudToggleGroup T="string" @bind-Value="_protoCardTone"
                                                                                                                                                            SelectionMode="SelectionMode.SingleSelection" Dense="true">
                                                                                                                                                <MudToggleItem Value="@("flush")" Text="flush" />
                                                                                                                                                <MudToggleItem Value="@("surface")" Text="surface" />
                                                                                                                                                <MudToggleItem Value="@("focus")" Text="focus" />
                                                                                                                                                <MudToggleItem Value="@("outlined")" Text="outlined" />
                                                                                                                                            </MudToggleGroup>

                                                                                                                                            <MudText Typo="Typo.caption" Class="me-2 ms-3">density</MudText>
                                                                                                                                            <MudToggleGroup T="string" @bind-Value="_protoCardDensity"
                                                                                                                                                            SelectionMode="SelectionMode.SingleSelection" Dense="true">
                                                                                                                                                <MudToggleItem Value="@("dense")" Text="dense" />
                                                                                                                                                <MudToggleItem Value="@("cozy")" Text="cozy" />
                                                                                                                                                <MudToggleItem Value="@("comfortable")" Text="comfortable" />
                                                                                                                                            </MudToggleGroup>

                                                                                                                                            <MudSwitch T="bool" @bind-Value="_protoCardInteractive" Color="Color.Primary"
                                                                                                                                                       Label="interactive" Class="ms-3" />
                                                                                                                                        </div>
                                                                                                                                        <div class="dt-lab-stage">
                                                                                                                                            <div class="@ProtoCardClasses()" style="min-width: 240px;">
                                                                                                                                                <MudText Typo="Typo.subtitle2">Prototype card</MudText>
                                                                                                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                                                                                                    tone=@_protoCardTone &middot; density=@_protoCardDensity@(_protoCardInteractive ? " · interactive" : "")
                                                                                                                                                </MudText>
                                                                                                                                            </div>
                                                                                                                                            <div class="@ProtoCardClasses()" style="min-width: 240px;">
                                                                                                                                                <MudText Typo="Typo.subtitle2">Companion</MudText>
                                                                                                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Same class, second instance.</MudText>
                                                                                                                                            </div>
                                                                                                                                        </div>
                                                                                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                                                                                            All values come from CSS vars: <code>--app-surface-radius</code>,
                                                                                                                                            <code>--app-surface-padding</code>,
                                                                                                                                            <code>--mud-elevation-*</code>, <code>--mud-palette-*</code>. No pixel literals.
                                                                                                                                        </MudText>
                                                                                                                                    </div>

                                                                                                                                    @* ---------- COMPARE ---------- *@
                                                                                                                                    <div class="dt-section-head">
                                                                                                                                        <span class="dt-section-title">Compare: flush child vs double-wrap</span>
                                                                                                                                        <span class="dt-section-sub">documented rule (<code>04-UI-DESIGN-LANGUAGE.md</code> &middot; Layout
                                                                                                                                            slot children render flush)</span>
                                                                                                                                        </div>
                                                                                                                                        <div class="dt-compare-grid dt-compare-grid--two">
                                                                                                                                            <div class="dt-compare-col dt-compare-col--good">
                                                                                                                                                <div class="dt-compare-tag dt-compare-tag--good">Use &middot; flush child</div>
                                                                                                                                                <div class="dt-stage-slot">
                                                                                                                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">layout slot
                                                                                                                                                        (rendered by shell)</MudText>
                                                                                                                                                        <MudStack Spacing="2">
                                                                                                                                                            <MudText Typo="Typo.subtitle2">Heading</MudText>
                                                                                                                                                            <MudText Typo="Typo.body2">Children render directly inside the slot's surface padding.
                                                                                                                                                            </MudText>
                                                                                                                                                        </MudStack>
                                                                                                                                                    </div>
                                                                                                                                                </div>
                                                                                                                                                <div class="dt-compare-col dt-compare-col--bad">
                                                                                                                                                    <div class="dt-compare-tag dt-compare-tag--bad">Avoid &middot; root <code>MudPaper pa-*</code>
                                                                                                                                                    </div>
                                                                                                                                                    <div class="dt-stage-slot">
                                                                                                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">layout slot
                                                                                                                                                            (rendered by shell)</MudText>
                                                                                                                                                            <MudPaper Elevation="2" Class="pa-3">
                                                                                                                                                                <MudStack Spacing="2">
                                                                                                                                                                    <MudText Typo="Typo.subtitle2">Heading</MudText>
                                                                                                                                                                    <MudText Typo="Typo.body2">Inset shadow + double padding around the same content.
                                                                                                                                                                    </MudText>
                                                                                                                                                                </MudStack>
                                                                                                                                                            </MudPaper>
                                                                                                                                                        </div>
                                                                                                                                                    </div>
                                                                                                                                                </div>
                                                                                                                                            </MudStack>
                                                                                                                                        </ContentOnlyLayout>
                                                                                                                                    </MudTabPanel>

                                                                                                                                    @* ============================== DIALOGS & MODALS ============================== *@
                                                                                                                                    <MudTabPanel Text="Dialogs &amp; Modals">
                                                                                                                                        <ContentOnlyLayout>
                                                                                                                                            <MudStack Spacing="4">
                                                                                                                                                <div>
                                                                                                                                                    <MudText Typo="Typo.h5">Dialogs &amp; Modals</MudText>
                                                                                                                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                                                                                                                        Token-driven <code>MudDialog</code> frame, custom fullscreen viewers, overflow patterns, and the
                                                                                                                                                        version selector threshold.
                                                                                                                                                    </MudText>
                                                                                                                                                </div>

                                                                                                                                                @* ---------- INVENTORY ---------- *@
                                                                                                                                                <div class="dt-section-head">
                                                                                                                                                    <span class="dt-section-title">MudDialog tokens</span>
                                                                                                                                                    <span class="dt-section-sub">live <code>--app-dialog-*</code> values from <code>:root</code></span>
                                                                                                                                                </div>
                                                                                                                                                <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                                                                                                                                                    <thead>
                                                                                                                                                        <tr>
                                                                                                                                                            <th style="width: 30%;">Variable</th>
                                                                                                                                                            <th style="width: 18%;">Computed</th>
                                                                                                                                                            <th>Purpose</th>
                                                                                                                                                        </tr>
                                                                                                                                                    </thead>
                                                                                                                                                    <tbody>
                                                                                                                                                        @foreach (var token in _tokens.Where(t => t.Name.StartsWith("--app-dialog")))
                                                                                                                                                        {
                                                                                                                                                            <tr>
                                                                                                                                                                <td><code>@token.Name</code></td>
                                                                                                                                                                <td><code>@token.Value</code></td>
                                                                                                                                                                <td>@GetTokenDescription(token.Name)</td>
                                                                                                                                                            </tr>
                                                                                                                                                        }
                                                                                                                                                    </tbody>
                                                                                                                                                </MudSimpleTable>

                                                                                                                                                <div class="dt-section-head">
                                                                                                                                                    <span class="dt-section-title">MudDialog patterns</span>
                                                                                                                                                    <span class="dt-section-sub">title + content + actions slots</span>
                                                                                                                                                </div>
                                                                                                                                                <div class="dt-inv">
                                                                                                                                                    <div class="dt-inv-row">
                                                                                                                                                        <div class="dt-inv-render">
                                                                                                                                                            <div style="width: 320px;">
                                                                                                                                                                <div class="dt-dialog-frame">
                                                                                                                                                                    <div class="dt-dialog-frame__title">
                                                                                                                                                                        <MudText Typo="Typo.subtitle2">Confirm action</MudText>
                                                                                                                                                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                                                                                                                                                                    </div>
                                                                                                                                                                    <div class="dt-dialog-frame__body">
                                                                                                                                                                        <MudText Typo="Typo.body2">Are you sure?</MudText>
                                                                                                                                                                    </div>
                                                                                                                                                                    <div class="dt-dialog-frame__actions">
                                                                                                                                                                        <MudButton Variant="Variant.Text">Cancel</MudButton>
                                                                                                                                                                        <MudButton Variant="Variant.Filled" Color="Color.Primary">Confirm</MudButton>
                                                                                                                                                                    </div>
                                                                                                                                                                </div>
                                                                                                                                                            </div>
                                                                                                                                                        </div>
                                                                                                                                                        <div class="dt-inv-label">Confirm dialog &middot; parameterized button colors</div>
                                                                                                                                                        <div class="dt-inv-src"><code>Components/Shared/ConfirmationDialog.razor</code></div>
                                                                                                                                                    </div>
                                                                                                                                                    <div class="dt-inv-row">
                                                                                                                                                        <div class="dt-inv-render">
                                                                                                                                                            <div style="width: 360px;">
                                                                                                                                                                <div class="dt-dialog-frame">
                                                                                                                                                                    <div class="dt-dialog-frame__title">
                                                                                                                                                                        <MudText Typo="Typo.subtitle2">Custom header</MudText>
                                                                                                                                                                    </div>
                                                                                                                                                                    <div class="dt-dialog-frame__body">
                                                                                                                                                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                                                                                                                                            <code>TitleContent</code> slot replaces default title; CSS zeroes padding on
                                                                                                                                                                            <code>.mud-dialog-title</code>.
                                                                                                                                                                        </MudText>
                                                                                                                                                                    </div>
                                                                                                                                                                </div>
                                                                                                                                                            </div>
                                                                                                                                                        </div>
                                                                                                                                                        <div class="dt-inv-label">Custom <code>TitleContent</code> with hero/header component</div>
                                                                                                                                                        <div class="dt-inv-src"><code>Resources/CivitaiModelInfoDialog.razor:3</code></div>
                                                                                                                                                    </div>
                                                                                                                                                </div>

                                                                                                                                                <div class="dt-section-head">
                                                                                                                                                    <span class="dt-section-title">Custom fullscreen overlays (non-MudDialog)</span>
                                                                                                                                                    <span class="dt-section-sub">media viewers / editors</span>
                                                                                                                                                </div>
                                                                                                                                                <div class="dt-inv">
                                                                                                                                                    <div class="dt-inv-row">
                                                                                                                                                        <div class="dt-inv-render">
                                                                                                                                                            <div
                                                                                                                                                                style="width: 200px; height: 110px; background: rgba(0,0,0,0.88); border-radius: 4px; display: flex; align-items: center; justify-content: center; color: white; position: relative;">
                                                                                                                                                                <span style="font-size: 0.78rem;">.asset-viewer-overlay</span>
                                                                                                                                                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                                                                                                                                               Style="position: absolute; top: 4px; right: 4px; color: white;" />
                                                                                                                                                            </div>
                                                                                                                                                        </div>
                                                                                                                                                        <div class="dt-inv-label">AssetViewer &middot; pan/drag, fixed positioning, body-scroll lock
                                                                                                                                                        </div>
                                                                                                                                                        <div class="dt-inv-src"><code>Components/Shared/AssetViewer.razor:13</code></div>
                                                                                                                                                    </div>
                                                                                                                                                    <div class="dt-inv-row">
                                                                                                                                                        <div class="dt-inv-render">
                                                                                                                                                            <div
                                                                                                                                                                style="width: 200px; height: 110px; background: rgba(0,0,0,0.7); border-radius: 4px; display: flex; flex-direction: column; align-items: stretch; padding: 4px; color: white;">
                                                                                                                                                                <div
                                                                                                                                                                    style="height: 12px; background: rgba(255,255,255,0.1); margin-bottom: 4px; font-size: 0.65rem; padding: 0 4px;">
                                                                                                                                                                    titlebar</div>
                                                                                                                                                                    <div
                                                                                                                                                                        style="height: 12px; background: rgba(255,255,255,0.1); margin-bottom: 4px; font-size: 0.65rem; padding: 0 4px;">
                                                                                                                                                                        toolbar</div>
                                                                                                                                                                        <div
                                                                                                                                                                            style="flex: 1; background: repeating-conic-gradient(rgba(255,255,255,0.06) 0% 25%, transparent 0% 50%) 50% / 12px 12px;">
                                                                                                                                                                        </div>
                                                                                                                                                                    </div>
                                                                                                                                                                </div>
                                                                                                                                                                <div class="dt-inv-label">ImageEditorModal &middot; titlebar + toolbar + checkered canvas</div>
                                                                                                                                                                <div class="dt-inv-src"><code>Components/ImageEditor/ImageEditorModal.razor:9</code></div>
                                                                                                                                                            </div>
                                                                                                                                                        </div>

                                                                                                                                                        @* ---------- DEVIATIONS ---------- *@
                                                                                                                                                        <div class="dt-section-head">
                                                                                                                                                            <span class="dt-section-title">Deviations</span>
                                                                                                                                                            <span class="dt-section-sub">things to converge on tokens / shared primitives</span>
                                                                                                                                                        </div>
                                                                                                                                                        <ul class="dt-dev-list">
                                                                                                                                                            <li>Inline <code>Style="max-width: 98vw; max-height: 98vh"</code> on <code>MudDialog</code> &mdash;
                                                                                                                                                                <code>Components/Shared/Image/ImageViewerDialog.razor:5</code> (should use a token /
                                                                                                                                                                dialog-class instead)</li>
                                                                                                                                                                <li><code>style="overflow-y: auto; height: calc(100vh - 120px);"</code> hard-coded chrome offset
                                                                                                                                                                    &mdash; <code>Components/Shared/InfoDrawer.razor:23</code></li>
                                                                                                                                                                    <li>Custom z-index stack (<code>9999</code>, <code>10000</code>, <code>10100</code>) on overlays
                                                                                                                                                                        &mdash;
                                                                                                                                                                        <code>ImageEditorModal.razor.css &middot; AssetViewer.razor.css &middot; VideoViewer.razor.css</code>
                                                                                                                                                                    </li>
                                                                                                                                                                    <li>Hard-coded close-button <code>position: fixed !important; top: 20px; right: 20px;</code> &mdash;
                                                                                                                                                                        same overlay CSS files</li>
                                                                                                                                                                    </ul>
                                                                                                                                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                                                                                                                        Z-index, close button placement, and chrome offsets are repeated across three overlay
                                                                                                                                                                        components &mdash; candidates for a shared <code>OverlayShell</code> primitive +
                                                                                                                                                                        <code>--app-overlay-*</code> tokens.
                                                                                                                                                                    </MudText>

                                                                                                                                                                    @* ---------- PROTOTYPE LAB ---------- *@
                                                                                                                                                                    <div class="dt-section-head">
                                                                                                                                                                        <span class="dt-section-title">Prototype: scrollable description + version selector threshold</span>
                                                                                                                                                                        <span class="dt-section-sub">two interactions every CivitAI-style dialog needs</span>
                                                                                                                                                                    </div>
                                                                                                                                                                    <div class="dt-lab">
                                                                                                                                                                        <div class="dt-lab-controls">
                                                                                                                                                                            <MudText Typo="Typo.caption" Class="me-2">version count</MudText>
                                                                                                                                                                            <MudSlider T="int" @bind-Value="_protoVersionCount" Min="1" Max="12" Step="1"
                                                                                                                                                                                       Class="dt-lab-slider" Style="max-width: 220px;">
                                                                                                                                                                                @_protoVersionCount versions
                                                                                                                                                                            </MudSlider>
                                                                                                                                                                            <MudText Typo="Typo.caption" Class="ms-3 me-2">threshold</MudText>
                                                                                                                                                                            <MudNumericField T="int" @bind-Value="_protoVersionThreshold" Min="1" Max="20"
                                                                                                                                                                                             Variant="Variant.Text" Dense="true" Style="max-width: 80px;" />
                                                                                                                                                                            <MudSwitch T="bool" @bind-Value="_protoDescriptionExpanded" Color="Color.Primary"
                                                                                                                                                                                       Label="description expanded" Class="ms-3" />
                                                                                                                                                                        </div>
                                                                                                                                                                        <div class="dt-lab-stage" style="flex-direction: column; align-items: stretch;">
                                                                                                                                                                            <div class="dt-dialog-backdrop">
                                                                                                                                                                                <div class="dt-dialog-frame" style="max-width: 520px;">
                                                                                                                                                                                    <div class="dt-dialog-frame__title">
                                                                                                                                                                                        <MudText Typo="Typo.subtitle2">Resource info</MudText>
                                                                                                                                                                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                                                                                                                                                                                    </div>
                                                                                                                                                                                    <div class="dt-dialog-frame__body">
                                                                                                                                                                                        <MudText Typo="Typo.subtitle2" Class="mb-2">Version</MudText>
                                                                                                                                                                                        @if (_protoVersionCount <= _protoVersionThreshold)
                                                                                                                                                                                        {
                                                                                                                                                                                            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                                                                                                                                                                                @for (var i = 1; i <= _protoVersionCount; i++)
                                                                                                                                                                                                {
                                                                                                                                                                                                    var idx = i;
                                                                                                                                                                                                    <MudButton
                                                                                                                                                                                                        Variant="@(idx == _protoActiveVersion ? Variant.Filled : Variant.Outlined)"
                                                                                                                                                                                                        Color="Color.Primary" Size="Size.Small"
                                                                                                                                                                                                        OnClick="@(() => _protoActiveVersion = idx)">
                                                                                                                                                                                                        v@(idx)
                                                                                                                                                                                                    </MudButton>
                                                                                                                                                                                                }
                                                                                                                                                                                            </div>
                                                                                                                                                                                        }
                                                                                                                                                                                        else
                                                                                                                                                                                        {
                                                                                                                                                                                            <MudSelect T="int" @bind-Value="_protoActiveVersion" Variant="Variant.Text"
                                                                                                                                                                                                       Dense="true" Label="Version">
                                                                                                                                                                                                @for (var i = 1; i <= _protoVersionCount; i++)
                                                                                                                                                                                                {
                                                                                                                                                                                                    var idx = i;
                                                                                                                                                                                                    <MudSelectItem Value="@idx">v@(idx)</MudSelectItem>
                                                                                                                                                                                                }
                                                                                                                                                                                            </MudSelect>
                                                                                                                                                                                        }
                                                                                                                                                                                        <MudDivider Class="my-3" />
                                                                                                                                                                                        <MudText Typo="Typo.subtitle2" Class="mb-1">Description</MudText>
                                                                                                                                                                                        <div class="@(_protoDescriptionExpanded ? "dt-dialog-frame__body--scrollable" : "")"
                                                                                                                                                                                             style="@(_protoDescriptionExpanded ? "" : "max-height: 60px; overflow: hidden; position: relative;")">
                                                                                                                                                                                            <MudText Typo="Typo.body2">
                                                                                                                                                                                                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum aliquet,
                                                                                                                                                                                                sapien at sodales tincidunt,
                                                                                                                                                                                                arcu sapien hendrerit nibh, vitae elementum sapien dolor in mi. Ut feugiat,
                                                                                                                                                                                                mauris vitae rhoncus blandit,
                                                                                                                                                                                                magna lectus posuere ipsum, eu fermentum sapien sapien id elit. Suspendisse
                                                                                                                                                                                                potenti. Nulla facilisi.
                                                                                                                                                                                                Praesent quis erat ac libero accumsan ullamcorper. Curabitur sit amet est
                                                                                                                                                                                                tortor. Donec efficitur,
                                                                                                                                                                                                ipsum et viverra dapibus, lectus tellus condimentum justo, eget pulvinar
                                                                                                                                                                                                sapien lectus a urna.
                                                                                                                                                                                                Cras vehicula, lectus eget rhoncus tincidunt, justo nibh fermentum est,
                                                                                                                                                                                                vitae dictum lectus libero non eros.
                                                                                                                                                                                            </MudText>
                                                                                                                                                                                        </div>
                                                                                                                                                                                    </div>
                                                                                                                                                                                    <div class="dt-dialog-frame__actions">
                                                                                                                                                                                        <MudButton Variant="Variant.Text">Close</MudButton>
                                                                                                                                                                                    </div>
                                                                                                                                                                                </div>
                                                                                                                                                                            </div>
                                                                                                                                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                                                                                                                                Frame uses <code>--app-dialog-radius</code>, <code>--app-dialog-padding</code>, and clamps
                                                                                                                                                                                to <code>--app-dialog-max-width</code>.
                                                                                                                                                                                Pills swap to <code>MudSelect</code> when count exceeds threshold; description body uses
                                                                                                                                                                                <code>max-height: 40vh; overflow-y: auto</code> when expanded.
                                                                                                                                                                            </MudText>
                                                                                                                                                                        </div>
                                                                                                                                                                    </div>
                                                                                                                                                                </MudStack>
                                                                                                                                                            </ContentOnlyLayout>
                                                                                                                                                        </MudTabPanel>

                                                                                                                                                        @* ============================== NAVIGATION ============================== *@
                                                                                                                                                        <MudTabPanel Text="Navigation">
                                                                                                                                                            <ContentOnlyLayout>
                                                                                                                                                                <MudStack Spacing="4">
                                                                                                                                                                    <div>
                                                                                                                                                                        <MudText Typo="Typo.h5">Navigation</MudText>
                                                                                                                                                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                                                                                                                                            <code>TabbedPageShell</code>, nested tabs, the horizontal <code>NavBar</code>, and
                                                                                                                                                                            component-context tab usage.
                                                                                                                                                                        </MudText>
                                                                                                                                                                    </div>

                                                                                                                                                                    @* ---------- INVENTORY ---------- *@
                                                                                                                                                                    <div class="dt-section-head">
                                                                                                                                                                        <span class="dt-section-title">TabbedPageShell</span>
                                                                                                                                                                        <span class="dt-section-sub">canonical page-level tab container</span>
                                                                                                                                                                    </div>
                                                                                                                                                                    <div class="dt-inv">
                                                                                                                                                                        <div class="dt-inv-row">
                                                                                                                                                                            <div class="dt-inv-render">
                                                                                                                                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                                                                                                                                    <code>Centered=true</code> &middot; <code>Rounded=true</code> &middot;
                                                                                                                                                                                    <code>Elevation=@LayoutDefaults.TabsElevation</code>
                                                                                                                                                                                </MudText>
                                                                                                                                                                            </div>
                                                                                                                                                                            <div class="dt-inv-label">Wrapping component &mdash; never <code>PanelClass</code>, never
                                                                                                                                                                                <code>ApplyEffectsToContainer</code></div>
                                                                                                                                                                                <div class="dt-inv-src"><code>Components/Layouts/TabbedPageShell.razor:18</code></div>
                                                                                                                                                                            </div>
                                                                                                                                                                            <div class="dt-inv-row">
                                                                                                                                                                                <div class="dt-inv-render">
                                                                                                                                                                                    <MudText Typo="Typo.caption">@_tabbedShellUsers.Length pages</MudText>
                                                                                                                                                                                </div>
                                                                                                                                                                                <div class="dt-inv-label">Pages using it: @string.Join(", ", _tabbedShellUsers)</div>
                                                                                                                                                                                <div class="dt-inv-src">
                                                                                                                                                                                    <code>Pages/Scheduler.razor:12 &middot; Prompts.razor:4 &middot; Resources.razor:17 &middot; CivitAI.razor:4</code>
                                                                                                                                                                                </div>
                                                                                                                                                                            </div>
                                                                                                                                                                        </div>

                                                                                                                                                                        <div class="dt-section-head">
                                                                                                                                                                            <span class="dt-section-title">Component-context MudTabs</span>
                                                                                                                                                                            <span class="dt-section-sub">allowed: dialogs, sub-panels, sidebar widgets &mdash; not pages</span>
                                                                                                                                                                        </div>
                                                                                                                                                                        <div class="dt-inv">
                                                                                                                                                                            <div class="dt-inv-row">
                                                                                                                                                                                <div class="dt-inv-render" style="min-width: 220px;">
