                                                                                                                                                                                                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                                                                                                                                                                                                                Bypasses shared elevation, padding, and gutter tokens.
                                                                                                                                                                                                                            </MudText>
                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                    </div>
