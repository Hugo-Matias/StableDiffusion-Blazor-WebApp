        "--app-surface-radius" => "Shared corner radius for sidebar / topbar / content surfaces.",
        "--app-surface-padding" => "Internal padding of layout surfaces; children render flush inside this.",
        "--app-dialog-max-width" => "Max width clamp for app-wide modal dialogs (AssetViewer, CivitAI dialog).",
        "--app-dialog-padding" => "Internal padding of app-wide modal dialogs; children render flush inside this.",
