                                                                                                                                                                                                                    <MudTabPanel Text="Prototype">
                                                                                                                                                                                                                        <MudText Typo="Typo.caption">Panel C body</MudText>
                                                                                                                                                                                                                    </MudTabPanel>
                                                                                                                                                                                                                </MudTabs>
                                                                                                                                                                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                                                                                                                                                                    On a real page, only <code>TabbedPageShell</code> renders <code>MudTabs</code>; everything
                                                                                                                                                                                                                    here is the
                                                                                                                                                                                                                    allowed configuration for component-context tabs.
                                                                                                                                                                                                                </MudText>
                                                                                                                                                                                                            </div>
