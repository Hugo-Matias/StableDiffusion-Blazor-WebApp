                                                                                                                                                                                                                <MudSwitch T="bool" @bind-Value="_protoTabsApplyEffects" Color="Color.Primary"
                                                                                                                                                                                                                           Label="ApplyEffectsToContainer" Class="ms-2" />
                                                                                                                                                                                                                <MudText Typo="Typo.caption" Class="me-2 ms-3">elevation</MudText>
                                                                                                                                                                                                                <MudNumericField T="int" @bind-Value="_protoTabsElevation" Min="0" Max="8"
                                                                                                                                                                                                                                 Variant="Variant.Text" Dense="true" Style="max-width: 80px;" />
                                                                                                                                                                                                            </div>
