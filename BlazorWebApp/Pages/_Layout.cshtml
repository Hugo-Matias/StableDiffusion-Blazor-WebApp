@using Microsoft.AspNetCore.Components.Web
@namespace BlazorWebApp.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<base href="~/" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
	<link href="https://use.fontawesome.com/releases/v5.14.0/css/all.css" rel="stylesheet">
	<link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
	<link href="/site.css" rel="stylesheet" />
	<link href="/css/send-to.css" rel="stylesheet" />
	<link href="/css/workshop-thread.css" rel="stylesheet" />
	<link href="BlazorWebApp.styles.css" rel="stylesheet" />
	<component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />

	@* Inline loader styles — kept in <head> so the overlay paints on the very first frame,
	   before any external CSS loads. This is what actually prevents the theme/FOUC flash. *@
	<style>
		#app-loader {
			position: fixed;
			inset: 0;
			z-index: 2147483647;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-direction: column;
			gap: 1.75rem;
			background: radial-gradient(ellipse at 30% 20%, #1a1a1a 0%, #161616 55%, #121212 100%);
			color: #e8ebff;
			font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			overflow: hidden;
			opacity: 1;
			transition: opacity 600ms ease, visibility 0s linear 600ms;
			will-change: opacity;
		}

		@@media (prefers-color-scheme: light) {
			#app-loader {
				background: radial-gradient(ellipse at 30% 20%, #eef1ff 0%, #e3e6f2 55%, #d8dbe8 100%);
				color: #1a1c2e;
			}
		}

		#app-loader.is-hidden {
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
		}

		#app-loader .aurora {
			position: absolute;
			inset: -20%;
			background:
				radial-gradient(circle at 20% 30%, rgba(100, 181, 246, 0.30), transparent 40%),
				radial-gradient(circle at 80% 70%, rgba(186, 104, 200, 0.25), transparent 45%),
				radial-gradient(circle at 60% 20%, rgba(255, 183, 77, 0.18), transparent 40%);
			filter: blur(60px);
			animation: aurora-drift 12s ease-in-out infinite alternate;
			pointer-events: none;
		}

		@@keyframes aurora-drift {
			0%   { transform: translate3d(-3%, -2%, 0) scale(1); }
			50%  { transform: translate3d(4%, 3%, 0) scale(1.08); }
			100% { transform: translate3d(-2%, 4%, 0) scale(0.96); }
		}

		#app-loader .mark {
			position: relative;
			width: 88px;
			height: 88px;
			display: grid;
			place-items: center;
		}

		#app-loader .mark::before {
			content: '';
			position: absolute;
			inset: -18px;
			border-radius: 50%;
			background: conic-gradient(from 0deg, #64B5F6, #BA68C8, #FFB74D, #64B5F6);
			filter: blur(14px);
			opacity: 0.8;
			animation: mark-spin 4s linear infinite, mark-pulse 2.4s ease-in-out infinite;
		}

		#app-loader .mark svg {
			position: relative;
			width: 56px;
			height: 56px;
			color: #fff;
			filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.5));
		}

		@@keyframes mark-spin {
			to { transform: rotate(360deg); }
		}

		@@keyframes mark-pulse {
			0%, 100% { opacity: 0.55; transform: scale(1); }
			50%      { opacity: 0.95; transform: scale(1.08); }
		}

		#app-loader .wordmark {
			position: relative;
			font-size: 1.35rem;
			font-weight: 500;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			background: linear-gradient(90deg, #64B5F6 0%, #ffffff 50%, #64B5F6 100%);
			background-size: 200% 100%;
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
			animation: shimmer 3s linear infinite;
		}

		@@media (prefers-color-scheme: light) {
			#app-loader .wordmark {
				background: linear-gradient(90deg, #5b3df5 0%, #1a1c2e 50%, #5b3df5 100%);
				background-size: 200% 100%;
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
			}
		}

		@@keyframes shimmer {
			0%   { background-position: 200% 0; }
			100% { background-position: -200% 0; }
		}

		#app-loader .progress {
			position: relative;
			width: min(260px, 55vw);
			height: 3px;
			border-radius: 999px;
			background: rgba(255, 255, 255, 0.08);
			overflow: hidden;
		}

		@@media (prefers-color-scheme: light) {
			#app-loader .progress { background: rgba(0, 0, 0, 0.08); }
		}

		#app-loader .progress::after {
			content: '';
			position: absolute;
			top: 0; left: 0; bottom: 0;
			width: 40%;
			background: linear-gradient(90deg, transparent, #64B5F6, #BA68C8, transparent);
			border-radius: 999px;
			animation: progress-slide 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
		}

		@@keyframes progress-slide {
			0%   { transform: translateX(-100%); }
			100% { transform: translateX(350%); }
		}

		#app-loader .status {
			font-size: 0.78rem;
			letter-spacing: 0.08em;
			opacity: 0.55;
		}

		@@media (prefers-reduced-motion: reduce) {
			#app-loader .aurora,
			#app-loader .mark::before,
			#app-loader .wordmark,
			#app-loader .progress::after {
				animation: none;
			}
		}
	</style>
</head>
<body>
	@* Fancy bootstrap loader — hides initial theme/state flash. Dismissed by AppLoader.js
	   once MainLayout signals it has finished initializing. *@
	<div id="app-loader" role="status" aria-live="polite" aria-label="Loading application">
		<div class="aurora"></div>
		<div class="mark">
			<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M21 19V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
			</svg>
		</div>
		<div class="wordmark">BlazorDiffusion</div>
		<div class="progress"></div>
		<div class="status">Initializing&hellip;</div>
	</div>

	@RenderBody()

	<div id="blazor-error-ui">
		<environment include="Staging,Production">
			An error has occurred. This application may no longer respond until reloaded.
		</environment>
		<environment include="Development">
			An unhandled exception has occurred. See browser dev tools for details.
		</environment>
		<a href="" class="reload">Reload</a>
		<a class="dismiss">🗙</a>
	</div>

	<script src="js/AppLoader.js"></script>
	<script src="https://kit.fontawesome.com/a47d10a521.js" crossorigin="anonymous"></script>
	<script src="_content/MudBlazor/MudBlazor.min.js"></script>
	<script src="_framework/blazor.server.js"></script>
	<script src="js/EditAttention.js"></script>
	<script src="js/Modal.js"></script>
	<script src="js/PromptHistoryStorage.js"></script>
	<script src="js/Site.js"></script>
	<script src="js/WorkshopComposer.js"></script>
	<script src="js/design-testbed.js"></script>
</body>
</html>
