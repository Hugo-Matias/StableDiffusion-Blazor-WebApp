@using BlazorWebApp.Data.Dtos.Ollama
@inject IInfoService InfoService
@implements IAsyncDisposable

<MudGrid Spacing="2">
    @* Settings Sidebar *@
    <MudItem xs="12" md="4" lg="3">
        <LLMSettingsPanel @bind-SelectedModel="_selectedModel" />
    </MudItem>
    
    @* Main Content Area *@
    <MudItem xs="12" md="8" lg="9">
        <LLMMainPanel SelectedModel="@_selectedModel" />
    </MudItem>
</MudGrid>

@code {
    private string _selectedModel = string.Empty;

    // Info content
    private readonly InfoContent _infoContent = new(
        Title: "LLM Tools - Quick Guide",
        Overview: "Use AI language models to enhance, simplify, and transform your image generation prompts. Configure model settings on the left, and use the tabs on the right to process prompts.",
        Shortcuts: new List<ShortcutInfo>
        {
            new("Ctrl+Enter", "Process prompt with current operation"),
            new("Ctrl+Z", "Undo last operation"),
            new("Ctrl+Y", "Redo undone operation"),
        },
        Tips: new List<string>
        {
            "Enhance expands simple prompts with artistic details and atmosphere",
            "Simplify distills complex prompts to essential elements",
            "Adjust Temperature for more creative (higher) or focused (lower) results",
            "Use custom system prompt templates for specific styles",
            "Batch processing allows transforming multiple prompts at once",
            "History persists across sessions - restore any previous result",
            "Save to Library adds the result to your Presets collection",
            "Export/Import templates to share with others",
            "System Prompts tab lets you create and manage custom templates"
        }
    );

    protected override void OnInitialized()
    {
        InfoService.SetInfo(_infoContent);
    }

    public ValueTask DisposeAsync()
    {
        InfoService.ClearInfo();
        return ValueTask.CompletedTask;
    }
}
