@using BlazorWebApp.Data.Entities

<div class="@_rowClass" style="@_style" @onclick="@(() => OnSelect.InvokeAsync(Node))">
    <MudIcon Icon="@GetIconFor(Node.Mode)" Size="Size.Small" Class="me-2" />
    <MudText Typo="Typo.body2" Class="text-truncate flex-grow-1">@Truncate(Node.PromptText, 100)</MudText>
    @if (!string.IsNullOrEmpty(Node.Instruction))
    {
        <MudText Typo="Typo.caption" Class="text-disabled me-2">[@Node.Instruction]</MudText>
    }
</div>

@code {
    [Parameter] public PromptWorkshopNode Node { get; set; } = null!;
    [Parameter] public bool IsCurrent { get; set; }
    [Parameter] public EventCallback<PromptWorkshopNode> OnSelect { get; set; }

    private string _rowClass => $"d-flex align-center pa-2 ma-1{(IsCurrent ? " bg-primary-lighten-5 rounded" : "")}";
    private string _style => $"cursor: pointer; margin-left: {Node.GenerationNumber * 24}px;";

    private static string GetIconFor(string mode) => mode.ToLower() switch
    {
        "root" => Icons.Material.Filled.AutoAwesome,
        "chat" => Icons.Material.Filled.Chat,
        "evolve" => Icons.Material.Filled.Science,
        _ => Icons.Material.Filled.HelpOutline,
    };

    private static string Truncate(string text, int maxLength) =>
        text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
}
