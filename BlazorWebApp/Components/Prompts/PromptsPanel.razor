@using static BlazorWebApp.Data.Enums
@using BlazorWebApp.Events
@using BlazorWebApp.Data.Entities
@using BlazorWebApp.Extensions
@using BlazorWebApp.Components.Prompts.Styles
@using BlazorWebApp.Models
@inject IStateService State
@inject IEventService Events
@inject IDatabaseService DB
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IInfoService InfoService
@implements IAsyncDisposable

<div @ref="_containerRef" tabindex="-1" class="prompts-panel-container">
    <MudGrid Spacing="2">
        @* Category Browser Sidebar *@
        <MudItem xs="12" md="3">
            <CategoryBrowser @ref="_categoryBrowser" 
                             OnCategorySelected="HandleCategorySelected" />
        </MudItem>
        
        @* Main Content Area *@
        <MudItem xs="12" md="9">
            <PromptStyleTable @ref="_promptStyleTable"
                              SelectedCategory="@_selectedCategory"
                              OnCategoryFilterChanged="HandleCategoryFilterChanged"
                              OnPromptChanged="HandlePromptChanged" />
        </MudItem>
    </MudGrid>
</div>

@code {
    private CategoryBrowser? _categoryBrowser;
    private PromptStyleTable? _promptStyleTable;
    private string? _selectedCategory;
    private ElementReference _containerRef;
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<PromptsPanel>? _dotNetRef;
    private bool _isDisposed;

    // Info content
    private readonly InfoContent _infoContent = new(
        Title: "Presets - Quick Guide",
        Overview: "Save and apply complete prompt configurations including positive and negative prompts, LoRA models, and other settings. Pin your favorites for instant access with keyboard shortcuts.",
        Shortcuts: new List<ShortcutInfo>
        {
            new("Ctrl+1-9", "Apply pinned preset to Txt2Img"),
            new("Ctrl+Shift+1-9", "Apply pinned preset to Img2Img"),
        },
        Tips: new List<string>
        {
            "Pin up to 9 presets for quick keyboard access (star icon in preset list)",
            "Categories help organize presets by theme, style, or use case",
            "Usage counter shows how often each preset has been applied",
            "Favorites (heart icon) appear at the top of the list",
            "Apply button replaces current prompt, Insert adds to existing text",
            "Search works across preset name, category, and tags",
            "Edit presets to update prompts or add LoRA configurations",
            "Duplicate presets to create variations quickly"
        }
    );

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isDisposed)
        {
            InfoService.SetInfo(_infoContent);
            
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/KeyboardShortcuts.js");
                await _jsModule.InvokeVoidAsync("initializeKeyboardShortcuts", _containerRef, _dotNetRef);
            }
            catch (Exception)
            {
                // Keyboard shortcuts failed to initialize, but component still works
            }
        }
    }

    private async Task HandleCategorySelected(string? category)
    {
        _selectedCategory = category;
        StateHasChanged();
    }

    private async Task HandleCategoryFilterChanged(string? category)
    {
        _selectedCategory = category;
        StateHasChanged();
    }

    private async Task HandlePromptChanged()
    {
        // Refresh both components when a prompt is added/edited/deleted
        if (_categoryBrowser != null)
            await _categoryBrowser.RefreshCategories();
        
        if (_promptStyleTable != null)
            await _promptStyleTable.RefreshPrompts();
        
        // Notify PromptFields to reload styles from DB
        Events.Publish(new StylesChangedEventArgs { ChangeType = "PromptsUpdated" });
        
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task ApplyPinnedPromptByIndex(int index)
    {
        try
        {
            var pinnedPrompts = await DB.GetPinnedPrompts();
            if (index >= 0 && index < pinnedPrompts.Count)
            {
                var prompt = pinnedPrompts[index];
                
                // Update GenerationParameters (primary)
                var promptsFragment = State.GenerationParameters.GetOrCreateFragment(FragmentKeys.Fragments.Prompts, FragmentKeys.Files.Prompts);
                var currentPositive = promptsFragment.GetValue<string>(FragmentKeys.Params.Positive) ?? "";
                var currentNegative = promptsFragment.GetValue<string>(FragmentKeys.Params.Negative) ?? "";
                promptsFragment.SetValue(FragmentKeys.Params.Positive, Parser.ParseStyle(currentPositive, prompt.Positive));
                promptsFragment.SetValue(FragmentKeys.Params.Negative, Parser.ParseStyle(currentNegative, prompt.Negative));
                
                // Update usage tracking
                await DB.UpdatePromptUsage(prompt.Id);
                
                // Notify that prompts were updated
                Events.Publish(new StylesChangedEventArgs { ChangeType = "PromptApplied" });
                
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception)
        {
            // Silently handle errors
        }
    }

    [JSInvokable]
    public async Task ApplyPinnedPromptToImg2ImgByIndex(int index)
    {
        try
        {
            var pinnedPrompts = await DB.GetPinnedPrompts();
            if (index >= 0 && index < pinnedPrompts.Count)
            {
                var prompt = pinnedPrompts[index];
                
                // Update GenerationParameters (primary)
                var promptsFragment = State.GenerationParameters.GetOrCreateFragment(FragmentKeys.Fragments.Prompts, FragmentKeys.Files.Prompts);
                var currentPositive = promptsFragment.GetValue<string>(FragmentKeys.Params.Positive) ?? "";
                var currentNegative = promptsFragment.GetValue<string>(FragmentKeys.Params.Negative) ?? "";
                promptsFragment.SetValue(FragmentKeys.Params.Positive, Parser.ParseStyle(currentPositive, prompt.Positive));
                promptsFragment.SetValue(FragmentKeys.Params.Negative, Parser.ParseStyle(currentNegative, prompt.Negative));
                
                // Update usage tracking
                await DB.UpdatePromptUsage(prompt.Id);
                
                // Notify that prompts were updated
                Events.Publish(new StylesChangedEventArgs { ChangeType = "PromptApplied" });
                
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception)
        {
            // Silently handle errors
        }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        InfoService.ClearInfo();
        
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("dispose");
                await _jsModule.DisposeAsync();
            }
            catch (Exception) { }
            
            _jsModule = null;
        }
        
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}
