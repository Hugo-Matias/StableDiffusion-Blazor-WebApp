@using BlazorWebApp.Data.Entities
@inject IDatabaseService Database
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_name" 
                          Label="Collection Name" 
                          Required 
                          HelperText="e.g., tops, bottoms, fantasy-locations" />
            
            <MudTextField @bind-Value="_category" 
                          Label="Category" 
                          HelperText="e.g., Clothing, Locations, Styles" />
            
            <MudTextField @bind-Value="_description" 
                          Label="Description" 
                          Lines="3"
                          HelperText="Brief description of this collection" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton OnClick="Save" 
                   Color="Color.Primary" 
                   Variant="Variant.Filled"
                   Disabled="string.IsNullOrWhiteSpace(_name)">
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    private string _name = string.Empty;
    private string _category = string.Empty;
    private string _description = string.Empty;

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        try
        {
            var collection = new WildcardCollection
            {
                Name = _name.Trim(),
                Category = string.IsNullOrWhiteSpace(_category) ? null : _category.Trim(),
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                CreatedAt = DateTime.Now,
                UpdatedAt = DateTime.Now,
                UsageCount = 0,
                Entries = new List<WildcardEntry>()
            };

            var created = await Database.CreateWildcardCollection(collection);
            MudDialog.Close(DialogResult.Ok(created));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating collection: {ex.Message}", Severity.Error);
        }
    }
}
