@using BlazorWebApp.Data.Entities
@inject IDatabaseService Database
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    @* Collection Header *@
    <MudPaper Elevation="2" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h5">@Collection.Name</MudText>
                <MudStack Row Spacing="1">
                    <MudTooltip Text="Edit collection">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                       Size="Size.Small" 
                                       OnClick="EditCollection" />
                    </MudTooltip>
                    <MudTooltip Text="Delete collection">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Size="Size.Small" 
                                       Color="Color.Error"
                                       OnClick="DeleteCollection" />
                    </MudTooltip>
                </MudStack>
            </MudStack>
            
            @if (!string.IsNullOrWhiteSpace(Collection.Category))
            {
                <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                    @Collection.Category
                </MudChip>
            }
            
            @if (!string.IsNullOrWhiteSpace(Collection.Description))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Collection.Description</MudText>
            }
        </MudStack>
    </MudPaper>

    @* Action Toolbar *@
    <MudPaper Elevation="1" Class="pa-2">
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap">
            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Add"
                           Size="Size.Small"
                           OnClick="AddEntry">
                    Add Entry
                </MudButton>
                @if (_selectedEntry != null && _entries.Count > 1)
                {
                    <MudDivider Vertical FlexItem Class="mx-2" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-1">Move:</MudText>
                    <MudTooltip Text="Move up">
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                       Size="Size.Small"
                                       Disabled="@(_selectedEntry.SortOrder == 0)"
                                       OnClick="MoveUp" />
                    </MudTooltip>
                    <MudTooltip Text="Move down">
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                       Size="Size.Small"
                                       Disabled="@(_selectedEntry.SortOrder == _entries.Count - 1)"
                                       OnClick="MoveDown" />
                    </MudTooltip>
                }
            </MudStack>
            <MudButtonGroup Variant="Variant.Text" Size="Size.Small">
                <MudButton StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ShowExportDialog">Export</MudButton>
            </MudButtonGroup>
        </MudStack>
    </MudPaper>

    @* Entry List *@
    <MudPaper Elevation="1" Class="pa-3">
        <MudStack Spacing="2">
            @* Header with search and pagination controls *@
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap">
                <MudText Typo="Typo.h6">Entries (@GetFilteredEntries().Count total)</MudText>
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                    @if (_entries.Count > 5)
                    {
                        <MudTextField @bind-Value="_entrySearchText"
                                      @bind-Value:after="OnSearchChanged"
                                      Placeholder="Search entries..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Clearable
                                      Immediate
                                      DebounceInterval="300"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      Style="max-width: 200px;" />
                    }
                    @if (GetFilteredEntries().Count > 10)
                    {
                        <MudSelect T="int" 
                                   Value="_pageSize" 
                                   ValueChanged="OnPageSizeChanged"
                                   Label="Per Page" 
                                   Variant="Variant.Text"
                                   Margin="Margin.Dense"
                                   Style="min-width: 100px;">
                            @foreach (var size in _pageSizeOptions)
                            {
                                <MudSelectItem Value="@size">@size</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudStack>
            </MudStack>
            <MudDivider />
            
            @* Scrollable entry list - Fixed height *@
            <div style="max-height: 400px; overflow-y: auto; min-height: 200px;">
                @if (_isLoading)
                {
                    <MudProgressLinear Indeterminate Color="Color.Primary" />
                }
                else if (!_entries.Any())
                {
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-4" Style="min-height: 200px;">
                        <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Default" />
                        <MudText Typo="Typo.body1" Color="Color.Default">No entries yet</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Add your first entry to get started</MudText>
                    </MudStack>
                }
                else
                {
                    var filteredEntries = GetFilteredEntries();
                    
                    @if (!filteredEntries.Any())
                    {
                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-4" Style="min-height: 200px;">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" />
                            <MudText Typo="Typo.body1" Color="Color.Default">No matching entries</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Try a different search term</MudText>
                        </MudStack>
                    }
                    else
                    {
                        var pagedEntries = GetPagedEntries();
                        
                        <MudList Clickable Dense="true" Class="entry-list">
                            @foreach (var entry in pagedEntries)
                            {
                                var isSelected = _selectedEntry?.Id == entry.Id;
                                var textColor = isSelected ? Color.Secondary : Color.Default;
                                <MudListItem Class="@(isSelected ? "entry-item entry-item-selected" : "entry-item")"
                                             OnClick="() => SelectEntry(entry)">
                                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.body1" Class="flex-grow-1" Color="@textColor">@entry.Value</MudText>
                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                            <MudChip Size="Size.Small" Variant="Variant.Text">
                                                @entry.Weight.ToString("F1")
                                            </MudChip>
                                            <span @onclick:stopPropagation="true">
                                                <MudTooltip Text="Edit entry">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                                   Size="Size.Small" 
                                                                   OnClick="() => EditEntry(entry)" />
                                                </MudTooltip>
                                            </span>
                                            <span @onclick:stopPropagation="true">
                                                <MudTooltip Text="Delete entry">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                                   Size="Size.Small" 
                                                                   Color="Color.Error"
                                                                   OnClick="() => DeleteEntry(entry)" />
                                                </MudTooltip>
                                            </span>
                                        </MudStack>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }
                }
            </div>
            
            @* Pagination controls at bottom *@
            @if (GetFilteredEntries().Count > _pageSize)
            {
                <MudDivider />
                <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="2" Class="pa-2">
                    <MudPagination Count="@GetTotalPages()" 
                                   Selected="_currentPage" 
                                   SelectedChanged="OnPageChanged"
                                   ShowFirstButton
                                   ShowLastButton
                                   Size="Size.Small"
                                   BoundaryCount="1"
                                   MiddleCount="3" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Showing @(((_currentPage - 1) * _pageSize) + 1)-@Math.Min(_currentPage * _pageSize, GetFilteredEntries().Count) of @GetFilteredEntries().Count
                    </MudText>
                </MudStack>
            }
        </MudStack>
    </MudPaper>

    @* Preview Panel - Collapsible *@
    @if (_isPreviewVisible)
    {
        <MudPaper Elevation="1" Class="pa-3">
            <MudStack Spacing="2">
                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle1"><strong>Preview</strong></MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff" 
                                   Size="Size.Small"
                                   OnClick="@(() => _isPreviewVisible = false)"
                                   title="Hide preview" />
                </MudStack>
                <MudDivider />
                
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                    <MudText Typo="Typo.body2"><strong>Syntax:</strong></MudText>
                    <MudChip Size="Size.Small" Color="Color.Primary">@GetWildcardSyntax()</MudChip>
                    <MudTooltip Text="Copy to clipboard">
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" 
                                       Size="Size.Small"
                                       OnClick="CopySyntax" />
                    </MudTooltip>
                    <MudSpacer />
                    @if (_entries.Any())
                    {
                        <MudButton Variant="Variant.Text" 
                                   Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Filled.Shuffle"
                                   OnClick="TestRandomSelection"
                                   Size="Size.Small">
                            Test Random
                        </MudButton>
                    }
                </MudStack>
                
                @if (_entries.Any())
                {
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary"><strong>Sample Values (by probability):</strong></MudText>
                            <MudList Dense="true" Style="max-height: 120px; overflow-y: auto;">
                                @foreach (var entry in _entries.OrderBy(e => e.SortOrder).Take(5))
                                {
                                    var probability = CalculateProbability(entry);
                                    <MudListItem Dense="true">
                                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <MudText Typo="Typo.caption" Style="overflow: hidden; text-overflow: ellipsis;">
                                                � @entry.Value.Truncate(40)
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">~@probability.ToString("F1")%</MudText>
                                        </MudStack>
                                    </MudListItem>
                                }
                                @if (_entries.Count > 5)
                                {
                                    <MudListItem Dense="true">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            ... and @(_entries.Count - 5) more
                                        </MudText>
                                    </MudListItem>
                                }
                            </MudList>
                        </MudItem>
                        
                        @if (!string.IsNullOrWhiteSpace(_randomResult))
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Color="Color.Secondary"><strong>Test Result:</strong></MudText>
                                <MudAlert Severity="Severity.Info" Dense="true" NoIcon="true" Class="mt-1">
                                    <MudText Typo="Typo.body2">"@_randomResult"</MudText>
                                </MudAlert>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
                        No entries to preview
                    </MudText>
                }
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-2">
            <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Text" 
                           StartIcon="@Icons.Material.Filled.Visibility"
                           OnClick="@(() => _isPreviewVisible = true)"
                           Size="Size.Small">
                    Show Preview
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter, EditorRequired]
    public WildcardCollection Collection { get; set; } = null!;

    [Parameter]
    public EventCallback OnEntriesChanged { get; set; }

    [Parameter]
    public EventCallback OnCollectionDeleted { get; set; }

    private List<WildcardEntry> _entries = new();
    private WildcardEntry? _selectedEntry;
    private int? _lastCollectionId;
    private bool _isLoading = true;
    private string _randomResult = string.Empty;
    private string _entrySearchText = string.Empty;
    
    // Pagination
    private int _currentPage = 1;
    private int _pageSize = 20;
    private readonly int[] _pageSizeOptions = { 10, 20, 50, 100 };
    private bool _isPreviewVisible = true;

    protected override async Task OnParametersSetAsync()
    {
        // Only clear selection when switching to a different collection
        if (_lastCollectionId != Collection.Id)
        {
            _selectedEntry = null;
            _lastCollectionId = Collection.Id;
            _entrySearchText = string.Empty;
            _currentPage = 1; // Reset to first page when changing collections
            await LoadEntries();
        }
    }

    private async Task LoadEntries()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _entries = await Database.GetEntriesByCollectionId(Collection.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading entries: {ex.Message}", Severity.Error);
            _entries = new();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void SelectEntry(WildcardEntry entry)
    {
        if (_selectedEntry?.Id == entry.Id)
        {
            _selectedEntry = null; // Toggle deselect if clicking same entry
        }
        else
        {
            _selectedEntry = entry;
        }
        StateHasChanged();
    }

    private async Task MoveUp()
    {
        if (_selectedEntry == null || _selectedEntry.SortOrder == 0) return;
        await SwapEntries(_selectedEntry.SortOrder, _selectedEntry.SortOrder - 1);
    }

    private async Task MoveDown()
    {
        if (_selectedEntry == null || _selectedEntry.SortOrder >= _entries.Count - 1) return;
        await SwapEntries(_selectedEntry.SortOrder, _selectedEntry.SortOrder + 1);
    }

    private async Task SwapEntries(int fromIndex, int toIndex)
    {
        try
        {
            var fromEntry = _entries.First(e => e.SortOrder == fromIndex);
            var toEntry = _entries.First(e => e.SortOrder == toIndex);

            // Swap sort orders
            fromEntry.SortOrder = toIndex;
            toEntry.SortOrder = fromIndex;

            await Database.UpdateWildcardEntry(fromEntry);
            await Database.UpdateWildcardEntry(toEntry);

            await OnEntriesChanged.InvokeAsync();
            
            // Keep the same entry selected (it's still the same object, just with updated SortOrder)
            // No need to reload - the local list is already updated
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error reordering entries: {ex.Message}", Severity.Error);
            _selectedEntry = null;
            await LoadEntries();
        }

        StateHasChanged();
    }

    private async Task AddEntry()
    {
        var options = new DialogOptions 
        { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var parameters = new DialogParameters
        {
            { "CollectionId", Collection.Id },
            { "NextSortOrder", _entries.Any() ? _entries.Max(e => e.SortOrder) + 1 : 0 }
        };
        
        var dialog = await DialogService.ShowAsync<EntryEditorDialog>("Add Entry", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadEntries();
            await OnEntriesChanged.InvokeAsync();
            Snackbar.Add("Entry added successfully", Severity.Success);
        }
    }

    private async Task EditEntry(WildcardEntry entry)
    {
        var options = new DialogOptions 
        { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var parameters = new DialogParameters
        {
            { "Entry", entry }
        };
        
        var dialog = await DialogService.ShowAsync<EntryEditorDialog>("Edit Entry", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadEntries();
            await OnEntriesChanged.InvokeAsync();
            Snackbar.Add("Entry updated successfully", Severity.Success);
        }
    }

    private async Task DeleteEntry(WildcardEntry entry)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Confirm Delete",
            $"Are you sure you want to delete the entry \"{entry.Value}\"?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm == true)
        {
            try
            {
                await Database.DeleteWildcardEntry(entry.Id);
                
                if (_selectedEntry?.Id == entry.Id)
                {
                    _selectedEntry = null;
                }
                
                await LoadEntries();
                await OnEntriesChanged.InvokeAsync();
                Snackbar.Add("Entry deleted successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting entry: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task EditCollection()
    {
        var options = new DialogOptions 
        { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var parameters = new DialogParameters
        {
            { "Collection", Collection },
            { "IsEdit", true }
        };
        
        var dialog = await DialogService.ShowAsync<CollectionEditorDialog>("Edit Collection", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnEntriesChanged.InvokeAsync();
            Snackbar.Add("Collection updated successfully", Severity.Success);
        }
    }

    private async Task DeleteCollection()
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Confirm Delete",
            $"Are you sure you want to delete the collection \"{Collection.Name}\" and all its entries?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm == true)
        {
            try
            {
                await Database.DeleteWildcardCollection(Collection.Id);
                await OnCollectionDeleted.InvokeAsync();
                Snackbar.Add("Collection deleted successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting collection: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ShowExportDialog()
    {
        var options = new DialogOptions 
        { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var parameters = new DialogParameters
        {
            { "Collection", Collection }
        };
        
        var dialog = await DialogService.ShowAsync<WildcardExportDialog>("Export Collection", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Snackbar.Add($"Collection exported successfully", Severity.Success);
        }
    }

    private async Task TestRandomSelection()
    {
        if (!_entries.Any())
        {
            _randomResult = string.Empty;
            return;
        }

        try
        {
            var result = await Database.GetWildcardCollectionByName(Collection.Name);
            if (result != null)
            {
                var totalWeight = result.Entries.Sum(e => e.Weight);
                var random = new Random().NextDouble() * totalWeight;
                var cumulative = 0.0;

                foreach (var entry in result.Entries)
                {
                    cumulative += entry.Weight;
                    if (random <= cumulative)
                    {
                        _randomResult = entry.Value;
                        break;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error testing random selection: {ex.Message}", Severity.Error);
        }

        StateHasChanged();
    }

    private async Task CopySyntax()
    {
        var syntax = GetWildcardSyntax();
        Snackbar.Add($"Syntax copied: {syntax}", Severity.Info);
    }

    private string GetWildcardSyntax()
    {
        return $"__{Collection.Name}__";
    }

    private double CalculateProbability(WildcardEntry entry)
    {
        var totalWeight = _entries.Sum(e => e.Weight);
        if (totalWeight == 0) return 0;
        return (entry.Weight / totalWeight) * 100;
    }

    private List<WildcardEntry> GetFilteredEntries()
    {
        if (string.IsNullOrWhiteSpace(_entrySearchText))
        {
            return _entries;
        }

        var searchLower = _entrySearchText.ToLower();
        return _entries
            .Where(e => e.Value.Contains(searchLower, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private List<WildcardEntry> GetPagedEntries()
    {
        var filtered = GetFilteredEntries();
        return filtered
            .OrderBy(e => e.SortOrder)
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
    }

    private int GetTotalPages()
    {
        var filtered = GetFilteredEntries();
        return (int)Math.Ceiling(filtered.Count / (double)_pageSize);
    }

    private void OnPageChanged(int newPage)
    {
        _currentPage = newPage;
        StateHasChanged();
    }

    private void OnPageSizeChanged(int newPageSize)
    {
        _pageSize = newPageSize;
        _currentPage = 1; // Reset to first page when page size changes
        StateHasChanged();
    }

    private void OnSearchChanged()
    {
        _currentPage = 1; // Reset to first page when search changes
        StateHasChanged();
    }
}
