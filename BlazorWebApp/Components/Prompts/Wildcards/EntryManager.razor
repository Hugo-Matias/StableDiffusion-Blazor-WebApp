@using BlazorWebApp.Data.Entities
@inject IDatabaseService Database
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    @* Collection Header *@
    <MudPaper Elevation="2" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h5">@Collection.Name</MudText>
                <MudStack Row Spacing="1">
                    <MudTooltip Text="Edit collection">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                       Size="Size.Small" 
                                       OnClick="EditCollection" />
                    </MudTooltip>
                    <MudTooltip Text="Delete collection">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Size="Size.Small" 
                                       Color="Color.Error"
                                       OnClick="DeleteCollection" />
                    </MudTooltip>
                </MudStack>
            </MudStack>
            
            @if (!string.IsNullOrWhiteSpace(Collection.Category))
            {
                <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                    @Collection.Category
                </MudChip>
            }
            
            @if (!string.IsNullOrWhiteSpace(Collection.Description))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Collection.Description</MudText>
            }
        </MudStack>
    </MudPaper>

    @* Action Toolbar *@
    <MudPaper Elevation="1" Class="pa-2">
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap">
            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Add"
                           Size="Size.Small"
                           OnClick="AddEntry">
                    Add Entry
                </MudButton>
                @if (_selectedEntry != null && _entries.Count > 1)
                {
                    <MudDivider Vertical FlexItem Class="mx-2" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-1">Move:</MudText>
                    <MudTooltip Text="Move up">
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                       Size="Size.Small"
                                       Disabled="@(_selectedEntry.SortOrder == 0)"
                                       OnClick="MoveUp" />
                    </MudTooltip>
                    <MudTooltip Text="Move down">
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                       Size="Size.Small"
                                       Disabled="@(_selectedEntry.SortOrder == _entries.Count - 1)"
                                       OnClick="MoveDown" />
                    </MudTooltip>
                }
            </MudStack>
            <MudButtonGroup Variant="Variant.Text" Size="Size.Small">
                <MudButton StartIcon="@Icons.Material.Filled.FileDownload">Export</MudButton>
            </MudButtonGroup>
        </MudStack>
    </MudPaper>

    @* Entry List *@
    <MudPaper Elevation="1" Class="pa-3">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">Entries (@_entries.Count)</MudText>
            <MudDivider />
            
            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate Color="Color.Primary" />
            }
            else if (!_entries.Any())
            {
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-4">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Default" />
                    <MudText Typo="Typo.body1" Color="Color.Default">No entries yet</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Add your first entry to get started</MudText>
                </MudStack>
            }
            else
            {
                <MudList Clickable Dense Class="entry-list">
                    @foreach (var entry in _entries.OrderBy(e => e.SortOrder))
                    {
                        var isSelected = _selectedEntry?.Id == entry.Id;
                        var textColor = isSelected ? Color.Secondary : Color.Default;
                        <MudListItem Class="@(isSelected ? "entry-item entry-item-selected" : "entry-item")"
                                     OnClick="() => SelectEntry(entry)">
                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body1" Class="flex-grow-1" Color="@textColor">@entry.Value</MudText>
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                    <MudChip Size="Size.Small" Variant="Variant.Text">
                                        @entry.Weight.ToString("F1")
                                    </MudChip>
                                    <span @onclick:stopPropagation="true">
                                        <MudTooltip Text="Edit entry">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                           Size="Size.Small" 
                                                           OnClick="() => EditEntry(entry)" />
                                        </MudTooltip>
                                    </span>
                                    <span @onclick:stopPropagation="true">
                                        <MudTooltip Text="Delete entry">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                           Size="Size.Small" 
                                                           Color="Color.Error"
                                                           OnClick="() => DeleteEntry(entry)" />
                                        </MudTooltip>
                                    </span>
                                </MudStack>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudStack>
    </MudPaper>

    @* Preview Panel *@
    <MudPaper Elevation="1" Class="pa-3">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">Preview</MudText>
            <MudDivider />
            
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.body2"><strong>Syntax:</strong></MudText>
                <MudChip Size="Size.Small" Color="Color.Primary">@GetWildcardSyntax()</MudChip>
                <MudTooltip Text="Copy to clipboard">
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" 
                                   Size="Size.Small"
                                   OnClick="CopySyntax" />
                </MudTooltip>
            </MudStack>
            
            @if (_entries.Any())
            {
                <MudText Typo="Typo.body2" Class="mt-2"><strong>Possible Values:</strong></MudText>
                <MudList Dense Class="preview-list">
                    @foreach (var entry in _entries.OrderBy(e => e.SortOrder).Take(5))
                    {
                        var probability = CalculateProbability(entry);
                        <MudListItem>
                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body2">• @entry.Value</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">~@probability.ToString("F1")%</MudText>
                            </MudStack>
                        </MudListItem>
                    }
                    @if (_entries.Count > 5)
                    {
                        <MudListItem>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                ... and @(_entries.Count - 5) more
                            </MudText>
                        </MudListItem>
                    }
                </MudList>
                
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Shuffle"
                           OnClick="TestRandomSelection"
                           FullWidth
                           Class="mt-2">
                    Test Random Selection
                </MudButton>
                
                @if (!string.IsNullOrWhiteSpace(_randomResult))
                {
                    <MudAlert Severity="Severity.Info" Dense>
                        <strong>Result:</strong> "@_randomResult"
                    </MudAlert>
                }
            }
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public WildcardCollection Collection { get; set; } = null!;

    [Parameter]
    public EventCallback OnEntriesChanged { get; set; }

    [Parameter]
    public EventCallback OnCollectionDeleted { get; set; }

    private List<WildcardEntry> _entries = new();
    private WildcardEntry? _selectedEntry;
    private int? _lastCollectionId;
    private bool _isLoading = true;
    private string _randomResult = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        // Only clear selection when switching to a different collection
        if (_lastCollectionId != Collection.Id)
        {
            _selectedEntry = null;
            _lastCollectionId = Collection.Id;
            await LoadEntries();
        }
    }

    private async Task LoadEntries()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _entries = await Database.GetEntriesByCollectionId(Collection.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading entries: {ex.Message}", Severity.Error);
            _entries = new();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void SelectEntry(WildcardEntry entry)
    {
        if (_selectedEntry?.Id == entry.Id)
        {
            _selectedEntry = null; // Toggle deselect if clicking same entry
        }
        else
        {
            _selectedEntry = entry;
        }
        StateHasChanged();
    }

    private async Task MoveUp()
    {
        if (_selectedEntry == null || _selectedEntry.SortOrder == 0) return;
        await SwapEntries(_selectedEntry.SortOrder, _selectedEntry.SortOrder - 1);
    }

    private async Task MoveDown()
    {
        if (_selectedEntry == null || _selectedEntry.SortOrder >= _entries.Count - 1) return;
        await SwapEntries(_selectedEntry.SortOrder, _selectedEntry.SortOrder + 1);
    }

    private async Task SwapEntries(int fromIndex, int toIndex)
    {
        try
        {
            var fromEntry = _entries.First(e => e.SortOrder == fromIndex);
            var toEntry = _entries.First(e => e.SortOrder == toIndex);

            // Swap sort orders
            fromEntry.SortOrder = toIndex;
            toEntry.SortOrder = fromIndex;

            await Database.UpdateWildcardEntry(fromEntry);
            await Database.UpdateWildcardEntry(toEntry);

            await OnEntriesChanged.InvokeAsync();
            
            // Keep the same entry selected (it's still the same object, just with updated SortOrder)
            // No need to reload - the local list is already updated
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error reordering entries: {ex.Message}", Severity.Error);
            _selectedEntry = null;
            await LoadEntries();
        }

        StateHasChanged();
    }

    private async Task AddEntry()
    {
        var options = new DialogOptions 
        { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var parameters = new DialogParameters
        {
            { "CollectionId", Collection.Id },
            { "NextSortOrder", _entries.Any() ? _entries.Max(e => e.SortOrder) + 1 : 0 }
        };
        
        var dialog = await DialogService.ShowAsync<EntryEditorDialog>("Add Entry", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadEntries();
            await OnEntriesChanged.InvokeAsync();
            Snackbar.Add("Entry added successfully", Severity.Success);
        }
    }

    private async Task EditEntry(WildcardEntry entry)
    {
        var options = new DialogOptions 
        { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var parameters = new DialogParameters
        {
            { "Entry", entry }
        };
        
        var dialog = await DialogService.ShowAsync<EntryEditorDialog>("Edit Entry", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadEntries();
            await OnEntriesChanged.InvokeAsync();
            Snackbar.Add("Entry updated successfully", Severity.Success);
        }
    }

    private async Task DeleteEntry(WildcardEntry entry)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Confirm Delete",
            $"Are you sure you want to delete the entry \"{entry.Value}\"?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm == true)
        {
            try
            {
                await Database.DeleteWildcardEntry(entry.Id);
                
                if (_selectedEntry?.Id == entry.Id)
                {
                    _selectedEntry = null;
                }
                
                await LoadEntries();
                await OnEntriesChanged.InvokeAsync();
                Snackbar.Add("Entry deleted successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting entry: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task EditCollection()
    {
        var options = new DialogOptions 
        { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var parameters = new DialogParameters
        {
            { "Collection", Collection },
            { "IsEdit", true }
        };
        
        var dialog = await DialogService.ShowAsync<CollectionEditorDialog>("Edit Collection", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnEntriesChanged.InvokeAsync();
            Snackbar.Add("Collection updated successfully", Severity.Success);
        }
    }

    private async Task DeleteCollection()
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Confirm Delete",
            $"Are you sure you want to delete the collection \"{Collection.Name}\" and all its entries?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm == true)
        {
            try
            {
                await Database.DeleteWildcardCollection(Collection.Id);
                await OnCollectionDeleted.InvokeAsync();
                Snackbar.Add("Collection deleted successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting collection: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task TestRandomSelection()
    {
        if (!_entries.Any())
        {
            _randomResult = string.Empty;
            return;
        }

        try
        {
            var result = await Database.GetWildcardCollectionByName(Collection.Name);
            if (result != null)
            {
                var totalWeight = result.Entries.Sum(e => e.Weight);
                var random = new Random().NextDouble() * totalWeight;
                var cumulative = 0.0;

                foreach (var entry in result.Entries)
                {
                    cumulative += entry.Weight;
                    if (random <= cumulative)
                    {
                        _randomResult = entry.Value;
                        break;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error testing random selection: {ex.Message}", Severity.Error);
        }

        StateHasChanged();
    }

    private async Task CopySyntax()
    {
        var syntax = GetWildcardSyntax();
        Snackbar.Add($"Syntax copied: {syntax}", Severity.Info);
    }

    private string GetWildcardSyntax()
    {
        return $"__{Collection.Name}__";
    }

    private double CalculateProbability(WildcardEntry entry)
    {
        var totalWeight = _entries.Sum(e => e.Weight);
        if (totalWeight == 0) return 0;
        return (entry.Weight / totalWeight) * 100;
    }
}
