@using System.Diagnostics
@using static BlazorWebApp.Data.Enums
@using BlazorWebApp.Events
@inject IStateService State
@inject IGalleryService Gallery
@inject IEventService Events
@inject IDatabaseService DB
@inject IIOService IO
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavManager
@inject IMediaSendToService SendTo
@implements IDisposable

<div class="@GetTileClasses()" @onclick="OpenImage" @onmouseenter="HandleMouseEnter" @onmouseleave="HandleMouseLeave">
    <img src="@IO.GetImageStaticFile(Image.Path)" alt="Generated image" class="gallery-tile-image" loading="lazy" />

    <div class="gallery-tile-chrome @(_isHovered || _isMenuOpen ? "visible" : string.Empty)">
        <div class="gallery-tile-topbar">
            <div class="gallery-tile-indicators">
                @if (Image.Favorite)
                {
                    <span class="gallery-tile-indicator favorite" title="Favorite">
                        <i class="fa-solid fa-heart"></i>
                    </span>
                }
                @if (Image.Score > 0)
                {
                    <span class="gallery-tile-indicator score" title="Score @Image.Score">
                        <i class="fa-solid fa-star"></i>
                        <span>@Image.Score</span>
                    </span>
                }
            </div>

            <div class="gallery-tile-actions" @onclick:stopPropagation="true">
                <button type="button" class="tile-action primary" title="View Fullscreen" @onclick="OpenImage">
                    <i class="fa-solid fa-expand"></i>
                </button>
                <button type="button" class="tile-action @(Image.Favorite ? "active" : string.Empty)"
                        title="@(Image.Favorite ? "Remove from Favorites" : "Add to Favorites")" @onclick="ToggleFavorite">
                    <i class="@(Image.Favorite ? "fa-solid fa-heart" : "fa-regular fa-heart")"></i>
                </button>
                <button type="button" class="tile-action" title="View Info" @onclick="ToggleInfoDrawer">
                    <i class="fa-solid fa-info"></i>
                </button>
                @if (ShowSelectionCheckbox)
                {
                    <button type="button" class="tile-action @(_isSelected ? "selected" : string.Empty)"
                            title="@(_isSelected ? "Deselect" : "Select")" @onclick="ToggleSelected">
                        <i class="@(_isSelected ? "fa-solid fa-square-check" : "fa-regular fa-square")"></i>
                    </button>
                }
                <div class="tile-menu-host" @onclick:stopPropagation="true">
                    <MudMenu @bind-Open="_isMenuOpen" Icon="@Icons.Material.Filled.MoreVert"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Size="Size.Small"
                             Dense="true" Class="tile-more-menu">
                        <ChildContent>
                            <div class="action-menu">
                                <MediaSendToDropdown Asset="Image" MediaType="SendToMediaType.Image"
                                                     RenderAsMenuSection="true" IncludeDivider="true" />

                                @if (SendTo.IsLocal(Image.Path))
                                {
                                    <div class="menu-section">
                                        <div class="menu-section-title">LLM Tools</div>
                                        <MudMenuItem OnClick="SendToImageToPrompt" Class="menu-item">
                                            <div class="menu-item-content">
                                                <i class="fa-solid fa-magnifying-glass menu-icon tertiary"></i>
                                                <span>Generate Prompt</span>
                                            </div>
                                        </MudMenuItem>
                                    </div>

                                    <div class="menu-divider"></div>
                                }

                                <div class="menu-section">
                                    <div class="menu-section-title">Organize</div>
                                    <MudMenuItem OnClick="ShowSwitchProjectDialog" Class="menu-item">
                                        <div class="menu-item-content">
                                            <i class="fa-solid fa-layer-group menu-icon tertiary"></i>
                                            <span>Set Project</span>
                                        </div>
                                    </MudMenuItem>
                                    <MudMenuItem OnClick="SetProjectCover" Class="menu-item">
                                        <div class="menu-item-content">
                                            <i class="fa-solid fa-image-portrait menu-icon secondary"></i>
                                            <span>Project Cover</span>
                                        </div>
                                    </MudMenuItem>
                                </div>

                                <div class="menu-divider"></div>

                                <div class="menu-section">
                                    <MudMenuItem OnClick="OpenFileInExplorer" Class="menu-item">
                                        <div class="menu-item-content">
                                            <i class="fa-solid fa-folder-open menu-icon primary"></i>
                                            <span>Open in Explorer</span>
                                        </div>
                                    </MudMenuItem>
                                    <MudMenuItem OnClick="DeleteImage" Class="menu-item danger">
                                        <div class="menu-item-content">
                                            <i class="fa-solid fa-trash-can menu-icon error"></i>
                                            <span>Delete</span>
                                        </div>
                                    </MudMenuItem>
                                </div>
                            </div>
                        </ChildContent>
                    </MudMenu>
                </div>
            </div>
        </div>
    </div>
</div>

<AssetInfoDrawer @bind-IsVisible="_showInfoDrawer" Image="Image" IsVideo="false" />

@code {
    [Parameter, EditorRequired] public Image Image { get; set; } = default!;
    [Parameter] public EventCallback<Image> OnSelectImage { get; set; }
    [Parameter] public EventCallback<Image> OnDeleteImage { get; set; }
    [Parameter] public EventCallback OnCoverChanged { get; set; }
    [Parameter] public bool ShowSelectionCheckbox { get; set; }

    private bool _isSelected;
    private bool _isHovered;
    private bool _isMenuOpen;
    private bool _showInfoDrawer;

    protected override void OnInitialized()
    {
        UpdateSelectionState();
        Events.Subscribe<ImageSelectionChangedEventArgs>(OnImageSelectionChanged);
        Events.Subscribe<StateChangedEventArgs>(OnStateChanged);
    }

    protected override void OnParametersSet()
    {
        UpdateSelectionState();
    }

    private string GetTileClasses()
    {
        var classes = "gallery-image-tile";
        if (_isSelected) classes += " selected";
        if (_isHovered || _isMenuOpen) classes += " hovered";
        return classes;
    }

    private void HandleMouseEnter() => _isHovered = true;

    private void HandleMouseLeave()
    {
        if (!_isMenuOpen)
        {
            _isHovered = false;
        }
    }

    private void UpdateSelectionState()
    {
        _isSelected = Image != null && Gallery.SelectedImageIds.Contains(Image.Id);
    }

    private void OnImageSelectionChanged(ImageSelectionChangedEventArgs args)
    {
        UpdateSelectionState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged(StateChangedEventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private Task OpenImage() => OnSelectImage.InvokeAsync(Image);

    private async Task ToggleFavorite()
    {
        Image.Favorite = !Image.Favorite;
        if (Image.Favorite && Image.Score == 0)
        {
            Image.Score = 3;
        }

        await DB.UpdateImage(Image);
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleInfoDrawer() => _showInfoDrawer = !_showInfoDrawer;

    private void ToggleSelected()
    {
        if (_isSelected)
        {
            Gallery.RemoveSelectedImage(Image.Id);
            _isSelected = false;
        }
        else
        {
            Gallery.AddSelectedImage(Image.Id);
            _isSelected = true;
        }
    }

    private static string GetModeIconColor(ModeType mode) => mode switch
    {
        ModeType.Img2Img => "warning",
        ModeType.Img2Vid => "info",
        ModeType.Txt2Img => "primary",
        ModeType.Extras => "warning",
        _ => "secondary"
    };

    private void OpenFileInExplorer() => Process.Start("explorer.exe", $"/select, {Image.Path}");

    private async Task SetProjectCover()
    {
        await DB.SetProjectCover(State.State.Gallery.ProjectId, Image.Path);
        await OnCoverChanged.InvokeAsync();
        Snackbar.Add($"Cover image selected for project {State.State.Gallery.ProjectName}.", Severity.Success);
    }

    private async Task ShowSwitchProjectDialog()
    {
        var parameters = new DialogParameters { ["Images"] = new List<Image> { Image } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ImageProjectDialog>("Switch Project", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var updatedImages = (List<Image>)result.Data;
            foreach (var image in updatedImages)
            {
                await DB.UpdateImage(image);
            }

            Snackbar.Add("Image project was changed.", Severity.Success);
        }
    }

    private Task DeleteImage() => OnDeleteImage.InvokeAsync(Image);

    private async Task SendToImageToPrompt()
    {
        var resolved = IO.ResolveFilePath(Image.Path);
        if (string.IsNullOrWhiteSpace(resolved) || !File.Exists(resolved))
        {
            Snackbar.Add("Image file is not available on disk.", Severity.Warning);
            return;
        }

        try
        {
            var bytes = await File.ReadAllBytesAsync(resolved);
            var ext = Path.GetExtension(resolved).TrimStart('.').ToLowerInvariant();
            var mime = ext switch
            {
                "jpg" or "jpeg" => "image/jpeg",
                "webp" => "image/webp",
                "gif" => "image/gif",
                _ => "image/png"
            };

            var promptState = State.State.Prompts.LLM.ImageToPrompt;
            promptState.LastImageDataUri = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            promptState.LastSourceLabel = "Gallery";
            promptState.LastResultText = null;

            State.State.Prompts.LLM.ActiveViewId = "image-to-prompt";
            await State.SaveState();

            Events.Publish(new ImageToPromptRequestedEventArgs
            {
                ImagePath = resolved,
                SourceLabel = "Gallery"
            });

            NavManager.NavigateTo("/prompts");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to send image: {ex.Message}", Severity.Error);
        }
    }

    public void Dispose()
    {
        Events.Unsubscribe<ImageSelectionChangedEventArgs>(OnImageSelectionChanged);
        Events.Unsubscribe<StateChangedEventArgs>(OnStateChanged);
    }
}
