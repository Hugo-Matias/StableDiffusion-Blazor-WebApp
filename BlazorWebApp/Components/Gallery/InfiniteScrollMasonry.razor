@inject IDatabaseService DB
@inject IGalleryService Gallery
@inject IIOService IO
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IAsyncDisposable
@using Microsoft.JSInterop

<div class="masonry-gallery-wrapper">
    <div class="gallery-toolbar">
        <MudButton OnClick="() => OpenViewer(0)" StartIcon="fa-solid fa-window-maximize" Color="Color.Secondary">Fullscreen</MudButton>
        <MudButton OnClick="ShowSelectionsDialog" StartIcon="fa-solid fa-check" Color="Color.Secondary">Selections</MudButton>
        @if (Gallery.SelectedImageIds.Count > 0)
        {
            <div class="selection-btn-group">
                <MudButton OnClick="ShowSwitchProjectDialog" StartIcon="fa-solid fa-layer-group" Color="Color.Tertiary">Set Project</MudButton>
                <MudButton OnClick="ShowDeleteImagesDialog" StartIcon="fa-solid fa-trash-can" Color="Color.Error">Delete</MudButton>
                <MudButton OnClick="Gallery.ClearSelectedImages" StartIcon="fa-regular fa-square" Color="Color.Warning">@($"Clear ({Gallery.SelectedImageIds.Count})")</MudButton>
                <MudButton OnClick="SelectAll" StartIcon="fa-solid fa-check-double" Color="Color.Info">Select All</MudButton>
            </div>
        }
    </div>

    <div class="gallery-flex">
        @foreach (var image in Images.Images)
        {
            <div class="gallery-item">
                @if (IsVideoFile(image.Path))
                {
                    <VideoCard Video="@ConvertToGeneratedVideo(image)"
                               Index="@Images.Images.IndexOf(image)"
                               OnSelectVideo="idx => OpenVideoViewer(idx)"
                               OnDeleteVideo="video => DeleteVideoFromImage(video)"
                               OnVideoChanged="HandleVideoChanged"
                               ShowSelectionCheckbox="true" />
                }
                else
                {
                    <ImageCard Image="@image"
                               Target="fullscreen-modal"
                               OnSelectImage="img => OpenViewer(Images.Images.IndexOf(img))"
                               OnDeleteImage="async () => await DeleteSingleImage(image)"
                               OnCoverChanged="async () => await InvokeAsync(StateHasChanged)"
                               ShowSelectionCheckbox="true" />
                }
            </div>
        }
    </div>

    @if (_isLoadingNext)
    {
        <div class="load-more-spinner">
            <MudProgressCircular Color="Color.Primary" Indeterminate />
        </div>
    }
    else if (!Images.HasNext)
    {
        <div class="end-of-results">
            <MudText Typo="Typo.caption">End of gallery</MudText>
        </div>
    }
</div>

<!-- Image Viewer (for non-video files) -->
<ImageViewer @bind-IsVisible="_showViewer" 
             Images="@_cachedNonVideoImages" 
             StartIndex="_viewerStartIndex" 
             OnClosed="HandleViewerClosed" />

<!-- Video Viewer (for video files) -->
<VideoViewer @bind-IsVisible="_showVideoViewer"
             Videos="@_cachedVideoItems"
             StartIndex="_videoViewerStartIndex"
             OnVideoChanged="HandleVideoChanged"
             OnClosed="HandleViewerClosed" />

@code {
    [Parameter, EditorRequired] public ImagesDto Images { get; set; } = new();
    [Parameter] public EventCallback OnLoadNextPage { get; set; }
    [Parameter] public EventCallback OnImagesChanged { get; set; }

    private bool _isLoadingNext;
    private bool _showViewer;
    private bool _showVideoViewer;
    private int _viewerStartIndex;
    private int _videoViewerStartIndex;
    private IJSObjectReference? _infiniteScrollModule;
    private DotNetObjectReference<InfiniteScrollMasonry>? _dotNetRef;
    
    // Cached lists for viewers - only updated when opening viewer
    private List<Image> _cachedNonVideoImages = new();
    private List<GeneratedVideo> _cachedVideoItems = new();

    private static readonly string[] VideoExtensions = { ".mp4", ".webm", ".mov", ".avi", ".mkv" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeInfiniteScroll();
        }
    }

    private async Task InitializeInfiniteScroll()
    {
        if (_infiniteScrollModule == null)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _infiniteScrollModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/InfiniteMasonry.js");
            await _infiniteScrollModule.InvokeAsync<IJSObjectReference>("attachWindowScroll", _dotNetRef, new { threshold = 500 });
        }
    }

    [JSInvokable]
    public async Task LoadNextPage()
    {
        if (_isLoadingNext || Images == null || !Images.HasNext) return;

        _isLoadingNext = true;
        await OnLoadNextPage.InvokeAsync();
        _isLoadingNext = false;
        await InvokeAsync(StateHasChanged);
    }

    private bool IsVideoFile(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return false;
        var extension = Path.GetExtension(path)?.ToLowerInvariant();
        return VideoExtensions.Contains(extension);
    }

    private GeneratedVideo ConvertToGeneratedVideo(Image image)
    {
        return new GeneratedVideo
        {
            Id = image.Id,
            FilePath = image.Path,
            Filename = Path.GetFileName(image.Path),
            Width = image.Width,
            Height = image.Height,
            Prompt = image.Prompt,
            NegativePrompt = image.NegativePrompt,
            Seed = image.Seed,
            Steps = image.Steps,
            CfgScale = image.CfgScale,
            DateCreated = image.DateCreated,
            Favorite = image.Favorite,
            Score = image.Score
        };
    }

    private void OpenViewer(int startIndex)
    {
        var image = Images.Images[startIndex];
        
        if (IsVideoFile(image.Path))
        {
            OpenVideoViewer(startIndex);
            return;
        }
        
        // Cache the non-video images list when opening
        _cachedNonVideoImages = Images.Images.Where(i => !IsVideoFile(i.Path)).ToList();
        _viewerStartIndex = _cachedNonVideoImages.IndexOf(image);
        if (_viewerStartIndex < 0) _viewerStartIndex = 0;
        _showViewer = true;
    }

    private void OpenVideoViewer(int startIndex)
    {
        var image = Images.Images[startIndex];
        
        // Cache the video items list when opening
        _cachedVideoItems = Images.Images
            .Where(i => IsVideoFile(i.Path))
            .Select(ConvertToGeneratedVideo)
            .ToList();
        
        _videoViewerStartIndex = _cachedVideoItems.FindIndex(v => v.FilePath == image.Path);
        if (_videoViewerStartIndex < 0) _videoViewerStartIndex = 0;
        _showVideoViewer = true;
    }

    private void HandleViewerClosed()
    {
        // Sync any changes from cached items back to the main list
        foreach (var video in _cachedVideoItems)
        {
            var image = Images.Images.FirstOrDefault(i => i.Id == video.Id);
            if (image != null)
            {
                image.Favorite = video.Favorite;
                image.Score = video.Score;
            }
        }
        StateHasChanged();
    }

    private void ShowSelectionsDialog()
    {
        var options = new DialogOptions() { MaxWidth = MaxWidth.Large, CloseButton = true };
        DialogService.Show<SelectionsDialog>("", options);
    }

    private async Task DeleteSingleImage(Image image)
    {
        await DB.DeleteImage(image);
        Images.Images.Remove(image);
        Snackbar.Add("Item deleted successfully.", Severity.Success);
        await OnImagesChanged.InvokeAsync();
    }

    private async Task DeleteVideoFromImage(GeneratedVideo video)
    {
        var image = Images.Images.FirstOrDefault(i => i.Path == video.FilePath);
        if (image != null)
        {
            await DeleteSingleImage(image);
        }
    }

    private async Task HandleVideoChanged(GeneratedVideo video)
    {
        // Sync changes back to the Image entity
        var image = Images.Images.FirstOrDefault(i => i.Id == video.Id);
        if (image != null)
        {
            image.Favorite = video.Favorite;
            image.Score = video.Score;
        }
        // Don't call StateHasChanged here - it would cause the viewer to re-render with a new list
    }

    private async Task ShowDeleteImagesDialog()
    {
        var parameters = new DialogParameters
        {
            { "OkButtonText", "Yes" },
            { "CancelButtonText", "No" },
            { "OkButtonColor", Color.Error },
            { "Content", new MarkupString("<span class='lead'>Are you sure you want to <strong class='text-danger'>delete</strong> the selected items?<br /></span><small>This action is irreversible!</small>") }
        };
        var dialog = await DialogService.ShowAsync<ConfirmationDialog>($"Delete {Gallery.SelectedImageIds.Count} Items", parameters, new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var selectedImages = await DB.GetImages(Gallery.SelectedImageIds);
            foreach (var img in selectedImages)
            {
                await DB.DeleteImage(img);
                Images.Images.RemoveAll(i => i.Id == img.Id);
            }
            Snackbar.Add("All selected items deleted successfully.", Severity.Success);
            Gallery.ClearSelectedImages();
            await OnImagesChanged.InvokeAsync();
        }
    }

    private async Task ShowSwitchProjectDialog()
    {
        var param = new DialogParameters();
        var selectedImages = await DB.GetImages(Gallery.SelectedImageIds);
        param.Add("Images", selectedImages);
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ImageProjectDialog>("Switch Project", param, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var updatedImages = (List<Image>)result.Data;
            await DB.UpdateImages(updatedImages);
            Snackbar.Add("Items projects were changed.", Severity.Success);
            Gallery.ClearSelectedImages();
            await OnImagesChanged.InvokeAsync();
        }
    }

    private void SelectAll()
    {
        if (Images?.Images == null) return;
        foreach (var id in Images.Images.Select(i => i.Id))
            Gallery.AddSelectedImage(id);
    }

    public async ValueTask DisposeAsync()
    {
        if (_infiniteScrollModule != null)
        {
            try
            {
                await _infiniteScrollModule.InvokeVoidAsync("dispose");
                await _infiniteScrollModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (Exception) { }
            _infiniteScrollModule = null;
        }
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}