@using BlazorWebApp.Events
@inject IStateService State
@inject IGalleryService Gallery
@inject IEventService Events
@inject DatabaseService DB
@inject IDialogService DialogService
@implements IDisposable

<div>
    <!-- Tabs with Action Buttons in Header -->
    <div class="tabs-header-container">
        <MudTabs Elevation="3" ActivePanelIndexChanged="HandleFolderSelected" Class="flex-grow-1">
            <MudTabPanel Text="All" ID=-1 />
            @foreach (var folder in Gallery.Folders)
            {
                <MudTabPanel ID=folder.Id>
                    <TabContent>
                        <div class="folder-tab-content">
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                           Size="Size.Small"
                                           Class="folder-nav-arrow arrow-left"
                                           Style="@GetArrowStyle(Gallery.Folders.IndexOf(folder) == 0)"
                                           Disabled="@(Gallery.Folders.IndexOf(folder) == 0)"
                                           OnClick="@(async () => await MoveFolderUp(folder))"
                                           title="Move left" />
                            
                            <span class="folder-tab-title">@folder.Name</span>
                            
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                           Size="Size.Small"
                                           Class="folder-nav-arrow arrow-right"
                                           Style="@GetArrowStyle(Gallery.Folders.IndexOf(folder) == Gallery.Folders.Count - 1)"
                                           Disabled="@(Gallery.Folders.IndexOf(folder) == Gallery.Folders.Count - 1)"
                                           OnClick="@(async () => await MoveFolderDown(folder))"
                                           title="Move right" />
                        </div>
                    </TabContent>
                </MudTabPanel>
            }
        </MudTabs>
        
        <!-- Action Buttons - Right Aligned -->
        <div class="tabs-actions">
            <MudTooltip Text="Add New Project">
                <CreateProjectButton Variant="Variant.Text" Color="Color.Primary" Class="action-button-uniform">
                    <MudIcon Icon="fa-solid fa-plus" />
                </CreateProjectButton>
            </MudTooltip>
            
            @if (State.State.Gallery.FolderId > 0)
            {
                <MudTooltip Text="Delete Folder">
                    <MudButton OnClick="ShowDeleteFolderModal" 
                               Variant="Variant.Text"
                               Color="Color.Error"
                               Class="action-button-uniform">
                        <MudIcon Icon="fa-solid fa-trash-can" />
                    </MudButton>
                </MudTooltip>
            }
            
            <MudTooltip Text="Remove Project Cover">
                <MudButton OnClick="RemoveProjectCover" 
                           Variant="Variant.Text"
                           Color="Color.Info"
                           Class="action-button-uniform">
                    <MudIcon Icon="fa-solid fa-image-portrait" />
                </MudButton>
            </MudTooltip>
            
            <MudTooltip Text="Reorder Folders">
                <MudButton OnClick="ToggleReorderArrows"
                           Variant="Variant.Text"
                           Color="@(_showReorderArrows ? Color.Success : Color.Default)"
                           Class="action-button-uniform">
                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" />
                </MudButton>
            </MudTooltip>
            
            <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
            
            <MudTooltip Text="@(_showFilters ? "Hide Filters" : "Show Filters")">
                <MudButton OnClick="ToggleFilters"
                           Variant="Variant.Filled"
                           Color="@(_showFilters ? Color.Warning : Color.Primary)"
                           Class="action-button-uniform">
                    <MudIcon Icon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)" />
                </MudButton>
            </MudTooltip>
        </div>
    </div>

    <!-- Projects Container -->
    <MudPaper Class="p-3" Elevation="2">
        <MudStack Class="projects-container" Row>
            @if (Gallery.Projects != null && Gallery.Projects.Count > 0)
            {
                @foreach (var project in Gallery.Projects)
                {
                    <ProjectCard ProjectId="project.Id" Name="@project.Name"
                                 OnSelected="HandleProjectSelected"
                                 OnDeleted="ShowDeleteProjectModal"
                                 OnEdited="ShowEditProjectModal" />
                }
            }
            else
            {
                <div class="empty-projects-message">
                    <MudText Typo="Typo.body1" Style="opacity: 0.5;">No projects yet. Click the + button to create one!</MudText>
                </div>
            }
        </MudStack>
    </MudPaper>
    
    <!-- Collapsible Filter Section -->
    <div class="filter-wrapper">
        <MudCollapse Expanded="_showFilters">
            <MudPaper Class="@($"filter-section pa-4 mb-3 {(_showFilters ? "expanded" : "")}")" Elevation="1">
                <!-- First Row -->
                <MudGrid Spacing="3">
                    <!-- Left: Prompt -->
                    <MudItem xs="12" md="5">
                        <MudTextField T="string" 
                                      @bind-Value="State.State.Gallery.Prompt" 
                                      Label="Prompt" 
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Clearable=true
                                      Immediate=true />
                    </MudItem>

                    <!-- Center: Order By -->
                    <MudItem xs="12" md="3">
                        <MudStack Row=true Spacing="2" AlignItems="AlignItems.Center">
                            <MudToggleIconButton @bind-Toggled="State.State.Gallery.OrderDescending"
                                                 Icon="@Icons.Material.Filled.ArrowUpward"
                                                 ToggledIcon="@Icons.Material.Filled.ArrowDownward"
                                                 Title="@(State.State.Gallery.OrderDescending ? "Descending" : "Ascending")"
                                                 ToggledTitle="@(State.State.Gallery.OrderDescending ? "Descending" : "Ascending")"
                                                 Color="Color.Primary"
                                                 ToggledColor="Color.Primary" />
                            <MudSelect T="GalleryOrderBy" 
                                       Label="Order by" 
                                       @bind-Value="State.State.Gallery.OrderBy"
                                       Variant="Variant.Outlined"
                                       AdornmentIcon="@Icons.Material.Filled.Sort"
                                       Adornment="Adornment.Start"
                                       Style="flex: 1;">
                                @foreach (GalleryOrderBy order in Enum.GetValues(typeof(GalleryOrderBy)))
                                {
                                    <MudSelectItem Value="order">@order</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>
                    </MudItem>

                    <!-- Right: Date Range & Filter Toggles -->
                    <MudItem xs="12" md="4">
                        <MudStack Row=true Spacing="2" AlignItems="AlignItems.Start">
                            <MudDateRangePicker Label="Date Range" 
                                                @bind-DateRange="State.State.Gallery.DateRange" 
                                                Variant="Variant.Outlined"
                                                Disabled="!State.State.Gallery.FilterByDateRange"
                                                AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                                                Adornment="Adornment.Start"
                                                AutoClose=true
                                                Style="flex: 1;" />

                            <div class="filter-toggles-compact">
                                <MudTooltip Text="Filter by Date Range">
                                    <MudToggleIconButton @bind-Toggled="State.State.Gallery.FilterByDateRange"
                                                         Icon="fa-regular fa-calendar"
                                                         ToggledIcon="fa-solid fa-calendar"
                                                         Color="Color.Default"
                                                         ToggledColor="Color.Success"
                                                         Size="Size.Medium" />
                                </MudTooltip>
                                <MudTooltip Text="Show Selected Only">
                                    <MudToggleIconButton @bind-Toggled="State.State.Gallery.IsSelectedOnly"
                                                         Icon="fa-regular fa-square-check"
                                                         ToggledIcon="fa-solid fa-square-check"
                                                         Color="Color.Default"
                                                         ToggledColor="Color.Success"
                                                         Size="Size.Medium" />
                                </MudTooltip>
                                <MudTooltip Text="Show Favorites Only">
                                    <MudToggleIconButton @bind-Toggled="State.State.Gallery.IsFavoritesOnly"
                                                         Icon="@Icons.Material.Outlined.FavoriteBorder"
                                                         ToggledIcon="@Icons.Material.Filled.Favorite"
                                                         Color="Color.Default"
                                                         ToggledColor="Color.Error"
                                                         Size="Size.Medium" />
                                </MudTooltip>
                                <MudTooltip Text="Filter by Score">
                                    <MudToggleIconButton @bind-Toggled="State.State.Gallery.IsScore"
                                                         Icon="fa-regular fa-star"
                                                         ToggledIcon="fa-solid fa-star"
                                                         Color="Color.Default"
                                                         ToggledColor="Color.Warning"
                                                         Size="Size.Medium" />
                                </MudTooltip>
                            </div>
                        </MudStack>
                    </MudItem>
                </MudGrid>

                <!-- Second Row -->
                <MudGrid Spacing="3" Class="mt-2">
                    <!-- Left: Negative Prompt -->
                    <MudItem xs="12" md="5">
                        <MudTextField T="string" 
                                      @bind-Value="State.State.Gallery.NegativePrompt" 
                                      Label="Negative Prompt" 
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.SearchOff"
                                      Clearable=true
                                      Immediate=true />
                    </MudItem>

                    <!-- Center: Pagination -->
                    <MudItem xs="12" md="3">
                        <MudStack Row=true Spacing="2" AlignItems="AlignItems.Center">
                            <MudToggleIconButton Toggled="State.State.Gallery.UseInfiniteScroll"
                                                 Icon="@Icons.Material.Filled.ViewModule"
                                                 ToggledIcon="@Icons.Material.Filled.AllInclusive"
                                                 Title="Pagination"
                                                 ToggledTitle="Infinite Scroll"
                                                 Color="Color.Info"
                                                 ToggledColor="Color.Info"
                                                 ToggledChanged="@(async (bool val) => await HandleNavigationModeChanged(val))" />
                            
                            @if (!State.State.Gallery.UseInfiniteScroll)
                            {
                                <MudNumericField T="int" 
                                                 Value="State.State.Gallery.PageSize" 
                                                 ValueChanged="HandlePageSizeChanged"
                                                 Label="Images Per Page" 
                                                 Min="1" 
                                                 Max="100"
                                                 Variant="Variant.Outlined"
                                                 Style="flex: 1;" />
                            }
                        </MudStack>
                    </MudItem>

                    <!-- Right: Rating -->
                    <MudItem xs="12" md="4">
                        <div class="rating-row">
                            <MudRating @bind-SelectedValue="State.State.Gallery.Score" 
                                       Disabled="!State.State.Gallery.IsScore" 
                                       MaxValue="3" 
                                       Size="Size.Large"
                                       Color="Color.Warning" />
                        </div>
                    </MudItem>
                </MudGrid>

                <!-- Action Buttons Row with Modes -->
                <MudDivider Class="my-3" />
                <MudStack Row=true Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <!-- Mode Chips - Left Aligned -->
                    <div class="modes-action-section">
                        <MudText Typo="Typo.caption" Class="mb-1" Style="opacity: 0.7;">Modes</MudText>
                        <MudChipSet SelectedChipsChanged="HandleModeSelection" Filter MultiSelection Class="mode-chips-action">
                            <MudChip Text="T2I" Variant="Variant.Text" Color="Color.Primary" Default="State.State.Gallery.IsModeTxt2Img" />
                            <MudChip Text="I2I" Variant="Variant.Text" Color="Color.Primary" Default="State.State.Gallery.IsModeImg2Img" />
                            <MudChip Text="I2V" Variant="Variant.Text" Color="Color.Secondary" Default="State.State.Gallery.IsModeImg2Vid" />
                            <MudChip Text="Upscale" Variant="Variant.Text" Color="Color.Tertiary" Default="State.State.Gallery.IsModeUpscale" />
                        </MudChipSet>
                    </div>

                    <!-- Filter/Reset Buttons - Centered -->
                    <MudStack Row=true Spacing="2" Class="action-buttons-center">
                        <MudButton OnClick="async () => await OnFilterImages.InvokeAsync()" 
                                   Variant="Variant.Filled" 
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.FilterAlt"
                                   Size="Size.Large">
                            Filter
                        </MudButton>
                        <MudButton OnClick="async () => await OnResetFilters.InvokeAsync()" 
                                   Variant="Variant.Filled" 
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   Size="Size.Large">
                            Reset
                        </MudButton>
                    </MudStack>

                    <!-- Spacer for balance -->
                    <div style="width: 200px;"></div>
                </MudStack>
            </MudPaper>
        </MudCollapse>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnFilterImages { get; set; }
    [Parameter] public EventCallback OnResetFilters { get; set; }
    [Parameter] public EventCallback OnProjectDeleted { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public EventCallback OnNavigationModeChanged { get; set; }
    [Parameter] public EventCallback OnPageSizeChanged { get; set; }

    private bool _showFilters = false;
    private bool _showReorderArrows = false;
    DialogOptions _dialogOptions = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small };

    protected override void OnInitialized()
    {
        Events.Subscribe<FolderChangedEventArgs>(OnFolderChanged);
    }

    private async void OnFolderChanged(FolderChangedEventArgs args)
    {
        await Gallery.GetProjects(args.FolderId);
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleFilters()
    {
        _showFilters = !_showFilters;
        StateHasChanged();
    }

    private void ToggleReorderArrows()
    {
        _showReorderArrows = !_showReorderArrows;
        StateHasChanged();
    }

    private async Task HandleProjectSelected(int projectId)
    {
        await Gallery.SetCurrentProject(projectId);
        await InvokeAsync(StateHasChanged);
    }

    private void HandleModeSelection(MudChip[] chips)
    {
        State.State.Gallery.IsModeTxt2Img = chips.Any(c => c.Text == "T2I");
        State.State.Gallery.IsModeImg2Img = chips.Any(c => c.Text == "I2I");
        State.State.Gallery.IsModeUpscale = chips.Any(c => c.Text == "Upscale");
        State.State.Gallery.IsModeImg2Vid = chips.Any(c => c.Text == "I2V");
    }

    private async Task HandleNavigationModeChanged(bool value)
    {
        State.State.Gallery.UseInfiniteScroll = value;
        await State.SaveState();
        await OnNavigationModeChanged.InvokeAsync();
    }

    private async Task HandlePageChanged(int page)
    {
        await OnPageChanged.InvokeAsync(page);
    }

    private async Task HandlePageSizeChanged(int pageSize)
    {
        State.State.Gallery.PageSize = pageSize;
        DB.PageSize = pageSize;
        await State.SaveState();
        await OnPageSizeChanged.InvokeAsync();
    }

    private async Task RemoveProjectCover()
    {
        var project = await DB.GetProject(State.State.Gallery.ProjectId);
        if (project != null)
        {
            project.SampleImagePath = null;
            await DB.UpdateProject(project);
        }
    }

    private async Task ShowDeleteProjectModal(int projectId)
    {
        var parameters = new DialogParameters();
        parameters.Add("OkButtonText", "Yes");
        parameters.Add("CancelButtonText", "No");
        parameters.Add("OkButtonColor", Color.Error);
        parameters.Add("Content", new MarkupString(@"<span class='lead'>Are you sure you want to <strong class='text-danger'>delete</strong> this project?<br /></span><small>This action is irreversible!</small>"));
        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Delete Project", parameters, _dialogOptions);
        var result = await dialog.Result;
        if (!result.Canceled) await DeleteProject(projectId);
    }

    private async Task ShowDeleteFolderModal()
    {
        var parameters = new DialogParameters();
        parameters.Add("OkButtonText", "Yes");
        parameters.Add("CancelButtonText", "No");
        parameters.Add("OkButtonColor", Color.Error);
        parameters.Add("Content", new MarkupString(@"<span class='lead'>Are you sure you want to <strong class='text-danger'>delete</strong> this folder?<br /></span><span>All projects in this folder will be folderless and you can find them in the ""All"" projects folder.</span><br/><small>This action is irreversible!</small>"));
        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Delete Folder", parameters, _dialogOptions);
        var result = await dialog.Result;
        if (!result.Canceled) await DeleteFolder();
    }

    private async Task DeleteFolder()
    {
        await DB.DeleteFolder(State.State.Gallery.FolderId);
        await Gallery.GetFolders();
        await Gallery.SetCurrentFolder(0);
    }

    private async Task DeleteProject(int id)
    {
        var project = await DB.DeleteProject(id);
        await Gallery.GetProjects(State.State.Gallery.FolderId);
        if (project != null)
            await Gallery.SetCurrentProject(project.Id);
        else
            await Gallery.SetCurrentProject(0);
        await OnProjectDeleted.InvokeAsync();
    }

    private async Task ShowEditProjectModal(int projectId)
    {
        var project = Gallery.Projects.FirstOrDefault(p => p.Id == projectId);
        var param = new DialogParameters();
        param.Add("Project", project);
        var dialog = await DialogService.ShowAsync<ProjectModal>($"Edit {project.Name}", param, _dialogOptions);
        var result = await dialog.Result;
        if (!result.Cancelled) await EditProject((Project)result.Data);
    }

    private async Task EditProject(Project project)
    {
        var updates = new Project() { Name = project.Name, Folder = project.Folder };
        await DB.UpdateProject(project.Id, updates);
        await Gallery.SetCurrentProject(State.State.Gallery.ProjectId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleFolderSelected(int selected)
    {
        if (selected == 0)
            await Gallery.SetCurrentFolder(selected);
        else
            await Gallery.SetCurrentFolder(Gallery.Folders[selected - 1].Id);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Events.Unsubscribe<FolderChangedEventArgs>(OnFolderChanged);
    }

    private async Task MoveFolderUp(Folder folder)
    {
        var index = Gallery.Folders.IndexOf(folder);
        if (index <= 0) return;
        
        Gallery.Folders.RemoveAt(index);
        Gallery.Folders.Insert(index - 1, folder);
        await UpdateAllSortOrders();
    }

    private async Task MoveFolderDown(Folder folder)
    {
        var index = Gallery.Folders.IndexOf(folder);
        if (index < 0 || index >= Gallery.Folders.Count - 1) return;

        Gallery.Folders.RemoveAt(index);
        Gallery.Folders.Insert(index + 1, folder);
        await UpdateAllSortOrders();
    }

    private async Task UpdateAllSortOrders()
    {
        for (int i = 0; i < Gallery.Folders.Count; i++)
        {
            Gallery.Folders[i].SortOrder = i;
            await DB.UpdateFolderSortOrder(Gallery.Folders[i].Id, i);
        }
        await InvokeAsync(StateHasChanged);
    }

    private string GetArrowStyle(bool isDisabled)
    {
        if (!_showReorderArrows || isDisabled)
            return "display: none !important;";
        
        return "display: inline-flex !important; opacity: 0.4; width: 24px; height: 24px; min-width: 24px; padding: 0;";
    }
}
