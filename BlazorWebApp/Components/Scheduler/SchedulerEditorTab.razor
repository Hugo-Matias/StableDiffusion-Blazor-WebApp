    private async Task<T?> ShowJsonDialogAsync<T>(T value, string title) where T : class
    {
        // Serialize against T (the declared base) so the $type discriminator is emitted for polymorphic
        // values. Serializing against value.GetType() would omit it and round-tripping as T would fail.
        var json = JsonSerializer.Serialize(value, typeof(T), SchedulerJsonOptions.Default);
        // Probe deserialization as T before OK succeeds - catches missing/unknown $type early.
        bool ProbeAsT(string text)
        {
            JsonSerializer.Deserialize<T>(text, SchedulerJsonOptions.Default);
            return true;
        }
        var parameters = new DialogParameters
        {
            ["Title"] = title,
            ["InitialJson"] = json,
            ["ValidateSchema"] = (Func<string, bool>)ProbeAsT,
        };
        var dlg = await Dialogs.ShowAsync<SchedulerJsonEditorDialog>(title, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dlg.Result;
        if (result is null || result.Canceled || result.Data is not string edited) return null;

        try
        {
            var parsed = JsonSerializer.Deserialize<T>(edited, SchedulerJsonOptions.Default);
            return parsed;
        }
        catch (JsonException ex)
        {
            Snackbar.Add($"Invalid JSON: {ex.Message}", Severity.Error);
            return null;
        }
    }

    private int ComputeIterations(JobAction action)
    {
        if (action.Variations.Count == 0) return Math.Max(1, action.Repeat);
        long total = 1;
        foreach (var v in action.Variations)
        {
            long size = v switch
            {
                ListVariation lv => Math.Max(1, lv.Values?.Count ?? 0),
                ToggleVariation => 2,
                RangeVariation r => RangeSize(r),
                RandomVariation r => Math.Max(1, r.Count),
                SearchReplaceVariation s => Math.Max(1, s.Replacements?.Count ?? 0),
                WildcardVariation w => WildcardSize(w),
                LlmVariation l => Math.Max(1, l.Count),
                _ => 1,
            };
            total *= size;
            if (total > int.MaxValue) { total = int.MaxValue; break; }
        }
        int result = (int)total;
        if (action.Limit is int lim && lim > 0 && lim < result) result = lim;
        return result * Math.Max(1, action.Repeat);
    }

    private static long RangeSize(RangeVariation r)
    {
        if (r.Step == 0) return 1;
        var n = (long)Math.Floor(Math.Abs((r.End - r.Start) / r.Step)) + 1;
        return Math.Max(1, n);
    }

    /// <summary>
    /// Resolves a Wildcard variation's contribution to the cartesian product.
    /// Count-bounded mode uses <see cref="WildcardVariation.Count"/> directly; full-sweep mode
    /// reads the collection size from <see cref="_wildcardSizes"/> (prefetched asynchronously by
    /// <see cref="PrefetchWildcardSizesAsync"/>). While a size is still loading we report 1 so the
    /// estimate stabilizes on the next render.
    /// </summary>
    private long WildcardSize(WildcardVariation w)
    {
        if (w.Count is int c && c > 0) return c;
        if (!string.IsNullOrWhiteSpace(w.CollectionName)
            && _wildcardSizes.TryGetValue(w.CollectionName, out var size) && size > 0)
        {
            return size;
        }
        return 1;
    }

    /// <summary>
    /// Scans the editing job's wildcard variations whose size is not yet cached and resolves
    /// them via <see cref="IWildcardService.GetCollectionSize(string)"/>. Triggers a re-render
    /// after each lookup so the cartesian-product estimate picks up the new value.
    /// </summary>
    private async Task PrefetchWildcardSizesAsync()
    {
        if (_editing is null) return;

        var names = _editing.Actions
            .SelectMany(a => a.Variations.OfType<WildcardVariation>())
            .Where(w => w.Count is null or 0)
            .Select(w => w.CollectionName)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.Ordinal)
            .Where(n => !_wildcardSizes.ContainsKey(n) && !_wildcardSizesInFlight.Contains(n))
            .ToList();

        if (names.Count == 0) return;

        foreach (var name in names) _wildcardSizesInFlight.Add(name);

        foreach (var name in names)
        {
            try
            {
                var size = await Wildcards.GetCollectionSize(name);
                _wildcardSizes[name] = size;
            }
            catch
            {
                // Swallow: a failed lookup leaves the name uncached (fallback of 1 applies).
            }
            finally
            {
                _wildcardSizesInFlight.Remove(name);
            }
            StateHasChanged();
        }
    }

    private int TotalGenerations => _editing?.Actions.Sum(a => ComputeIterations(a)) ?? 0;

