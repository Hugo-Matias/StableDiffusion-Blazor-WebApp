@inherits MudComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.caption" Class="mb-2">
            Edit JSON directly. The <code>$type</code> discriminator is required for polymorphic values.
        </MudText>
        <MudTextField @bind-Value="_json" Lines="18" Variant="Variant.Outlined"
                      Style="font-family: monospace; font-size: 12px;" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Ok">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Title { get; set; } = "Edit";
    [Parameter] public string InitialJson { get; set; } = "{}";

    private string _json = "{}";

    protected override void OnInitialized()
    {
        _json = InitialJson ?? "{}";
    }

    private void Ok() => MudDialog.Close(DialogResult.Ok(_json));
    private void Cancel() => MudDialog.Cancel();
}
