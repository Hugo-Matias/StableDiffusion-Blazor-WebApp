@using BlazorWebApp.Data.Dtos
@using BlazorWebApp.Data.Entities
@using BlazorWebApp.Events
@using BlazorWebApp.Scheduler
@using BlazorWebApp.Scheduler.Models
@using BlazorWebApp.Scheduler.Persistence
@using BlazorWebApp.Services
@inject IJobRepository JobRepo
@inject ISchedulerService Scheduler
@inject IDatabaseService Database
@inject IEventService Events
@implements IDisposable

<MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
    <MudSelect T="Guid?" Value="_selectedJobId" ValueChanged="OnJobSelectionChanged" Label="Job"
               Variant="Variant.Text" Dense="true" AnchorOrigin="Origin.BottomCenter" Style="min-width:280px;">
        <MudSelectItem T="Guid?" Value="@((Guid?)null)">(Select job)</MudSelectItem>
        @if (_jobs is not null)
        {
            foreach (var j in _jobs)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)j.Id)">
                    @j.Name @(j.Status == JobStatus.Running ? "(running)" : "") - @j.Runs.Count run(s)
                </MudSelectItem>
            }
        }
    </MudSelect>

    <MudSelect T="Guid?" Value="_selectedRunId" ValueChanged="OnRunSelectionChanged" Label="Run"
               Variant="Variant.Text" Dense="true" AnchorOrigin="Origin.BottomCenter" Style="min-width:280px;"
               Disabled="@(_selectedJob is null || _selectedJob.Runs.Count == 0)">
        <MudSelectItem T="Guid?" Value="@((Guid?)null)">(Select run)</MudSelectItem>
        @if (_selectedJob is not null)
        {
            foreach (var r in _selectedJob.Runs.OrderByDescending(x => x.RunNumber))
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)r.Id)">
                    Run #@r.RunNumber - @r.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") (@r.Status)
                </MudSelectItem>
            }
        }
    </MudSelect>

    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="ReloadAsync" Color="Color.Primary" Title="Refresh" />
</MudStack>

@if (_selectedJob is null)
{
    <MudAlert Severity="Severity.Info">Select a job to view its runs.</MudAlert>
}
else if (_selectedRun is null)
{
    <MudAlert Severity="Severity.Info">Select a run to view its generated images.</MudAlert>
}
else
{
    var total = _selectedRun.TotalIterations;
    var done = _selectedRun.CompletedImages + _selectedRun.FailedImages;
    var pct = total > 0 ? (double)done / total * 100.0 : 0.0;
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
            <MudChip T="string" Size="Size.Small" Color="@StatusColor(_selectedRun.Status)" Variant="Variant.Filled">
                @_selectedRun.Status
            </MudChip>
            <MudText Typo="Typo.body2">
                <strong>@_selectedRun.Name</strong>
            </MudText>
            <MudText Typo="Typo.body2">
                <strong>@_selectedRun.CompletedImages</strong> completed,
                <strong>@_selectedRun.FailedImages</strong> failed /
                <strong>@_selectedRun.TotalIterations</strong> total
            </MudText>
            @{
                var end = _selectedRun.CompletedAt ?? _selectedRun.UpdatedAt ?? DateTime.UtcNow;
                var elapsed = end - _selectedRun.StartedAt;
            }
            <MudText Typo="Typo.caption">Elapsed: @elapsed.ToString(@"hh\:mm\:ss")</MudText>
        </MudStack>
        <MudProgressLinear Value="@pct" Color="@StatusColor(_selectedRun.Status)" Rounded Size="Size.Medium" Class="mt-2" />
    </MudPaper>

    @if (_images is null)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" />
    }
    else if (_images.Count == 0)
    {
        <MudAlert Severity="Severity.Normal">No images have been generated by this run yet.</MudAlert>
    }
    else
    {
        <ImagesContainer Images="_imagesDto" CanSelect="true" />
    }
}

@code {
    [Parameter] public Guid? JobIdQuery { get; set; }
    [Parameter] public Guid? RunIdQuery { get; set; }

    private List<Job>? _jobs;
    private Guid? _selectedJobId;
    private Guid? _selectedRunId;
    private Job? _selectedJob;
    private Run? _selectedRun;
    private List<Image>? _images;
    private ImagesDto _imagesDto = new() { Images = new List<Image>(), CurrentPage = 1, PageCount = 1 };

    protected override async Task OnInitializedAsync()
    {
        Events.Subscribe<JobStartedEventArgs>(OnJobEvent);
        Events.Subscribe<JobProgressChangedEventArgs>(OnJobEvent);
        Events.Subscribe<JobImageGeneratedEventArgs>(OnJobEvent);
        Events.Subscribe<JobCompletedEventArgs>(OnJobEvent);

        await ReloadJobsAsync();

        _selectedJobId = JobIdQuery
            ?? Scheduler.RunningJobId
            ?? _jobs?.FirstOrDefault()?.Id;

        await LoadSelectedJobAsync(preferredRunId: RunIdQuery);
    }

    protected override async Task OnParametersSetAsync()
    {
        var jobChanged = JobIdQuery is not null && JobIdQuery != _selectedJobId;
        var runChanged = RunIdQuery is not null && RunIdQuery != _selectedRunId;
        if (jobChanged)
        {
            _selectedJobId = JobIdQuery;
            await LoadSelectedJobAsync(preferredRunId: RunIdQuery);
        }
        else if (runChanged)
        {
            _selectedRunId = RunIdQuery;
            await LoadSelectedRunAsync();
        }
    }

    private async Task ReloadJobsAsync() => _jobs = await JobRepo.ListAsync();

    private async Task ReloadAsync()
    {
        await ReloadJobsAsync();
        await LoadSelectedJobAsync(preferredRunId: _selectedRunId);
    }

    private async Task OnJobSelectionChanged(Guid? jobId)
    {
        _selectedJobId = jobId;
        await LoadSelectedJobAsync(preferredRunId: null);
    }

    private async Task OnRunSelectionChanged(Guid? runId)
    {
        _selectedRunId = runId;
        await LoadSelectedRunAsync();
    }

    private async Task LoadSelectedJobAsync(Guid? preferredRunId)
    {
        if (_selectedJobId is null)
        {
            _selectedJob = null;
            _selectedRun = null;
            _selectedRunId = null;
            ResetImages();
            StateHasChanged();
            return;
        }

        _selectedJob = await JobRepo.GetByIdAsync(_selectedJobId.Value);
        if (_selectedJob is null)
        {
            _selectedRun = null;
            _selectedRunId = null;
            ResetImages();
            StateHasChanged();
            return;
        }

        // Pick a run: preferred query id -> currently running -> newest run -> none.
        _selectedRunId = preferredRunId
            ?? (_selectedJob.RunState.CurrentRunId is Guid cur && _selectedJob.Runs.Any(r => r.Id == cur) ? (Guid?)cur : null)
            ?? _selectedJob.Runs.OrderByDescending(r => r.RunNumber).FirstOrDefault()?.Id;

        await LoadSelectedRunAsync();
    }

    private async Task LoadSelectedRunAsync()
    {
        if (_selectedJob is null || _selectedRunId is null)
        {
            _selectedRun = null;
            ResetImages();
            StateHasChanged();
            return;
        }

        _selectedRun = _selectedJob.Runs.FirstOrDefault(r => r.Id == _selectedRunId);
        if (_selectedRun is null)
        {
            ResetImages();
            StateHasChanged();
            return;
        }

        var ids = _selectedRun.GeneratedImageIds;
        if (ids is null || ids.Count == 0)
        {
            _images = new List<Image>();
        }
        else
        {
            var fetched = await Database.GetImages(ids.Distinct().ToList());
            var byId = fetched.ToDictionary(i => i.Id);
            _images = ids.Where(id => byId.ContainsKey(id)).Select(id => byId[id]).ToList();
        }

        // Newest first in the grid.
        var display = _images.ToList();
        display.Reverse();
        _imagesDto = new ImagesDto
        {
            Images = display,
            CurrentPage = 1,
            PageCount = 1,
            HasNext = false,
            HasPrev = false,
        };
        StateHasChanged();
    }

    private void ResetImages()
    {
        _images = null;
        _imagesDto = new ImagesDto { Images = new List<Image>(), CurrentPage = 1, PageCount = 1 };
    }

    private async void OnJobEvent<T>(T evt) where T : EventArgs
    {
        Guid? eventJobId = evt switch
        {
            JobStartedEventArgs s => s.JobId,
            JobProgressChangedEventArgs p => p.JobId,
            JobImageGeneratedEventArgs i => i.JobId,
            JobCompletedEventArgs c => c.JobId,
            _ => null,
        };

        if (eventJobId is null) return;

        await InvokeAsync(async () =>
        {
            await ReloadJobsAsync();
            if (eventJobId == _selectedJobId)
                await LoadSelectedJobAsync(preferredRunId: _selectedRunId);
            else
                StateHasChanged();
        });
    }

    private static Color StatusColor(JobStatus s) => s switch
    {
        JobStatus.Running => Color.Primary,
        JobStatus.Paused => Color.Warning,
        JobStatus.Completed => Color.Success,
        JobStatus.Failed => Color.Error,
        JobStatus.Cancelled => Color.Dark,
        JobStatus.Queued => Color.Info,
        _ => Color.Default,
    };

    public void Dispose()
    {
        Events.Unsubscribe<JobStartedEventArgs>(OnJobEvent);
        Events.Unsubscribe<JobProgressChangedEventArgs>(OnJobEvent);
        Events.Unsubscribe<JobImageGeneratedEventArgs>(OnJobEvent);
        Events.Unsubscribe<JobCompletedEventArgs>(OnJobEvent);
    }
}
