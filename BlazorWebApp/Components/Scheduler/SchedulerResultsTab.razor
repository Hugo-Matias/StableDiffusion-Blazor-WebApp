@using BlazorWebApp.Data.Entities
@using BlazorWebApp.Events
@using BlazorWebApp.Scheduler
@using BlazorWebApp.Scheduler.Models
@using BlazorWebApp.Scheduler.Persistence
@using BlazorWebApp.Services
@inject IJobRepository JobRepo
@inject ISchedulerService Scheduler
@inject IDatabaseService Database
@inject IEventService Events
@implements IDisposable

<MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
    <MudSelect T="Guid?" Value="_selectedJobId" ValueChanged="OnJobSelectionChanged" Label="Job"
               Variant="Variant.Text" Dense="true" AnchorOrigin="Origin.BottomCenter" Style="min-width:320px;">
        <MudSelectItem T="Guid?" Value="@((Guid?)null)">(Select job)</MudSelectItem>
        @if (_jobs is not null)
        {
            foreach (var j in _jobs)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)j.Id)">@j.Name @(j.Status == JobStatus.Running ? "(running)" : "")
                </MudSelectItem>
            }
        }
    </MudSelect>
    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="ReloadAsync" Color="Color.Primary" Title="Refresh" />
</MudStack>

@if (_selectedJob is null)
{
    <MudAlert Severity="Severity.Info">Select a job to view its generated images.</MudAlert>
}
else
{
    var total = _selectedJob.RunState.TotalIterations;
    var done = _selectedJob.RunState.CompletedImages + _selectedJob.RunState.FailedImages;
    var pct = total > 0 ? (double)done / total * 100.0 : 0.0;
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
            <MudChip T="string" Size="Size.Small" Color="@StatusColor(_selectedJob.Status)" Variant="Variant.Filled">
                @_selectedJob.Status
            </MudChip>
            <MudText Typo="Typo.body2">
                <strong>@_selectedJob.RunState.CompletedImages</strong> completed,
                <strong>@_selectedJob.RunState.FailedImages</strong> failed /
                <strong>@_selectedJob.RunState.TotalIterations</strong> total
            </MudText>
            @if (_selectedJob.RunState.StartedAt is not null)
            {
                var start = _selectedJob.RunState.StartedAt.Value;
                var end = _selectedJob.RunState.UpdatedAt ?? DateTime.UtcNow;
                var elapsed = end - start;
                <MudText Typo="Typo.caption">Elapsed: @elapsed.ToString(@"hh\:mm\:ss")</MudText>
            }
        </MudStack>
        <MudProgressLinear Value="@pct" Color="@StatusColor(_selectedJob.Status)" Rounded Size="Size.Medium" Class="mt-2" />
    </MudPaper>

    @if (_images is null)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" />
    }
    else if (_images.Count == 0)
    {
        <MudAlert Severity="Severity.Normal">No images have been generated by this job yet.</MudAlert>
    }
    else
    {
        var latest = _images[^1];
        <MudPaper Class="pa-3 mb-3" Elevation="1">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Latest</MudText>
            <MudImage Src="@ResolveImageSrc(latest.Path)" Alt="Latest result" Fluid="true"
                      Style="max-height: 420px; object-fit: contain;" />
            <MudText Typo="Typo.caption">@latest.Width x @latest.Height - Seed @latest.Seed -
                @latest.DateCreated.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudText>
            </MudPaper>

            <MudGrid Spacing="2">
                @foreach (var img in _imagesReversed)
                {
                    <MudItem xs="6" sm="4" md="3" lg="2">
                        <MudPaper Elevation="0" Class="pa-1">
                            <MudImage Src="@ResolveImageSrc(img.Path)" Alt="@($"Image {img.Id}")" ObjectFit="ObjectFit.Cover"
                                      Style="width:100%; aspect-ratio: 1/1;" />
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    }

@code {
    [Parameter] public Guid? JobIdQuery { get; set; }

    private List<Job>? _jobs;
    private Guid? _selectedJobId;
    private Job? _selectedJob;
    private List<Image>? _images;
    private IReadOnlyList<Image> _imagesReversed = Array.Empty<Image>();

    protected override async Task OnInitializedAsync()
    {
        Events.Subscribe<JobStartedEventArgs>(OnJobEvent);
        Events.Subscribe<JobProgressChangedEventArgs>(OnJobEvent);
        Events.Subscribe<JobImageGeneratedEventArgs>(OnJobEvent);
        Events.Subscribe<JobCompletedEventArgs>(OnJobEvent);

        await ReloadJobsAsync();

        _selectedJobId = JobIdQuery
            ?? Scheduler.RunningJobId
            ?? _jobs?.FirstOrDefault()?.Id;

        await LoadSelectedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (JobIdQuery is not null && JobIdQuery != _selectedJobId)
        {
            _selectedJobId = JobIdQuery;
            await LoadSelectedAsync();
        }
    }

    private async Task ReloadJobsAsync() => _jobs = await JobRepo.ListAsync();

    private async Task ReloadAsync()
    {
        await ReloadJobsAsync();
        await LoadSelectedAsync();
    }

    private async Task OnJobSelectionChanged(Guid? jobId)
    {
        _selectedJobId = jobId;
        await LoadSelectedAsync();
    }

    private async Task LoadSelectedAsync()
    {
        if (_selectedJobId is null)
        {
            _selectedJob = null;
            _images = null;
            _imagesReversed = Array.Empty<Image>();
            StateHasChanged();
            return;
        }

        _selectedJob = await JobRepo.GetByIdAsync(_selectedJobId.Value);
        if (_selectedJob is null)
        {
            _images = null;
            _imagesReversed = Array.Empty<Image>();
            StateHasChanged();
            return;
        }

        var ids = _selectedJob.RunState.GeneratedImageIds;
        if (ids is null || ids.Count == 0)
        {
            _images = new List<Image>();
            _imagesReversed = Array.Empty<Image>();
        }
        else
        {
            var fetched = await Database.GetImages(ids.Distinct().ToList());
            // Preserve job-run order (not DB order)
            var byId = fetched.ToDictionary(i => i.Id);
            _images = ids.Where(id => byId.ContainsKey(id)).Select(id => byId[id]).ToList();
            var rev = _images.ToList();
            rev.Reverse();
            _imagesReversed = rev;
        }
        StateHasChanged();
    }

    private async void OnJobEvent<T>(T evt) where T : EventArgs
    {
        Guid? eventJobId = evt switch
        {
            JobStartedEventArgs s => s.JobId,
            JobProgressChangedEventArgs p => p.JobId,
            JobImageGeneratedEventArgs i => i.JobId,
            JobCompletedEventArgs c => c.JobId,
            _ => null,
        };

        if (eventJobId is null) return;

        // Refresh job list status chips even for unrelated jobs; but only reload images for the current selection.
        await InvokeAsync(async () =>
        {
            await ReloadJobsAsync();
            if (eventJobId == _selectedJobId)
                await LoadSelectedAsync();
            else
                StateHasChanged();
        });
    }

    private static string ResolveImageSrc(string path)
    {
        if (string.IsNullOrEmpty(path)) return string.Empty;
        if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return path;
        // Paths are typically relative to wwwroot.
        return path.StartsWith("/") ? path : "/" + path.Replace('\\', '/');
    }

    private static Color StatusColor(JobStatus s) => s switch
    {
        JobStatus.Running => Color.Primary,
        JobStatus.Paused => Color.Warning,
        JobStatus.Completed => Color.Success,
        JobStatus.Failed => Color.Error,
        JobStatus.Cancelled => Color.Dark,
        JobStatus.Queued => Color.Info,
        _ => Color.Default,
    };

    public void Dispose()
    {
        Events.Unsubscribe<JobStartedEventArgs>(OnJobEvent);
        Events.Unsubscribe<JobProgressChangedEventArgs>(OnJobEvent);
        Events.Unsubscribe<JobImageGeneratedEventArgs>(OnJobEvent);
        Events.Unsubscribe<JobCompletedEventArgs>(OnJobEvent);
    }
}

