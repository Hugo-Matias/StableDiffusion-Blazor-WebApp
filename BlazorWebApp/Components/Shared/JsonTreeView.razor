@if (Node.Children?.Any() == true)
{
    <MudTreeViewItem T="JsonTreeNode" Text="@($"{Node.Name}")">
        @foreach (var child in Node.Children)
        {
            <JsonTreeView Node="child" />
        }
    </MudTreeViewItem>
}
else
{
    <MudText Class="p-2 ms-7" Typo="Typo.body1">@($"{Node.Name}: {Node.Value}")</MudText>
}

@code {
    [Parameter]
    public JsonTreeNode Node { get; set; } = null!;
}
