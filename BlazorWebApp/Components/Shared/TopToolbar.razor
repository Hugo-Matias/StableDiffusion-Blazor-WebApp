@using BlazorWebApp.Events
@using static BlazorWebApp.Data.Enums
@inject IStateService State
@inject IGalleryService Gallery
@inject IEventService Events
@inject IDatabaseService DB
@inject ThemeService ThemeService
@inject IDialogService DialogService
@inject IConfiguration Configuration
@implements IDisposable

<div class="mt-6">
    <MudGrid Justify="Justify.FlexEnd">
        @* Row 1: Folder, Project, and Theme selectors *@
        <MudItem xs="5">
            <MudSelect T=string Value=State.State.Gallery.FolderName ValueChanged="HandleFolderSelected" Label="Folder" AdornmentIcon="fa-solid fa-folder" AdornmentColor="Color.Secondary" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                <MudSelectItem Value=@("")>All</MudSelectItem>
                @if (Gallery.Folders != null)
                {
                    @foreach (var folder in Gallery.Folders)
                    {
                        <MudSelectItem Value="@folder.Name">@folder.Name</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="5">
            <MudSelect T=string Value=State.State.Gallery.ProjectName ValueChanged="HandleProjectSelected" Label="Project" AdornmentIcon="fa-solid fa-layer-group" AdornmentColor="Color.Success" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                @if (Gallery.Projects != null)
                {
                    @foreach (var project in Gallery.Projects)
                    {
                        <MudSelectItem Value="@project.Name">@project.Name</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="2">
            <MudSelect T="string" Value="@(State.State.CurrentTheme ?? "Default")" ValueChanged="HandleThemeSelected" Label="Theme" AdornmentIcon="@Icons.Material.Filled.Palette" AdornmentColor="Color.Info" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                @foreach (var themeName in ThemeService.ThemeNames)
                {
                    <MudSelectItem Value="@themeName">@themeName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        @* Row 2: State Presets and action buttons *@
        <MudItem xs="10">
            <MudSelect @bind-Value=_selectedState T="BlazorWebApp.Data.Entities.State" Label="State Preset" Adornment="Adornment.End" AdornmentIcon="fa-solid fa-indent" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                @if (_states != null)
                {
                    @foreach (var state in _states)
                    {
                        <MudSelectItem Value="state">@state.Title</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="2">
            <MudButtonGroup Class="w-100" OverrideStyles=false>
                <MudIconButton Style="flex:1;" Icon="fa-solid fa-plus" Color=Color.Primary OnClick=@(() => ShowStateDialog(new())) Title="Create new state" />
                <MudIconButton Style="flex:1;" Icon="fa-solid fa-pen" Color=Color.Info OnClick=@(() => ShowStateDialog(_selectedState)) Disabled=@(_selectedState == null) Title="Edit state" />
                <MudIconButton Style="flex:1;" Icon="fa-solid fa-play" Color=Color.Success OnClick=@(() => LoadStatePreset(_selectedState)) Disabled=@(_selectedState == null) Title="Load state" />
            </MudButtonGroup>
        </MudItem>
    </MudGrid>

    @if (CurrentPage == "/civitai")
    {
        <MudDivider Class="my-3" />
        <ToolbarCivitaiSettings />
    }
</div>

@code {
    [CascadingParameter] public Action? OnThemeChanged { get; set; }
    [Parameter] public string CurrentPage { get; set; } = "/";

    private BlazorWebApp.Data.Entities.State? _selectedState;
    private List<BlazorWebApp.Data.Entities.State> _states = new();

    protected async override Task OnInitializedAsync()
    {
        Events.Subscribe<FolderChangedEventArgs>(OnFolderChanged);
        Events.Subscribe<ProjectChangedEventArgs>(OnProjectsChanged);
        
        await InitializeStates();
        await Gallery.GetFolders();
        await Gallery.GetProjects(State.State.Gallery.FolderId);
        
        if (Gallery.Projects != null && Gallery.Projects.Count > 0)
        {
            if (State.State.Gallery.ProjectId == 0)
            {
                var latestProject = await DB.GetLatestProject();
                if (latestProject != null)
                {
                    await Gallery.SetCurrentProject(latestProject.Id);
                }
            }
            else
            {
                await Gallery.SetCurrentProject(State.State.Gallery.ProjectId);
            }
        }
        else
        {
            State.State.Gallery.ProjectName = "Create New Project...";
        }
    }

    private async Task InitializeStates()
    {
        _states = await DB.GetStates(int.Parse(Configuration["StateVersion"]));
        if (_states != null && _states.Count > 0)
        {
            _states.RemoveAt(0);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowStateDialog(BlazorWebApp.Data.Entities.State state)
    {
        var options = new DialogOptions() { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
        var param = new DialogParameters();
        param.Add("StatePreset", state);
        var dialog = await DialogService.ShowAsync<StateDialog>("", param, options);
        await dialog.Result;
        await InitializeStates();
    }

    private async Task LoadStatePreset(BlazorWebApp.Data.Entities.State? statePreset)
    {
        if (statePreset != null)
        {
            await State.LoadState(statePreset.Id);
        }
    }

    private async Task HandleThemeSelected(string selected)
    {
        State.State.CurrentTheme = selected;
        await State.SaveState();
        OnThemeChanged?.Invoke();
    }

    private async Task HandleProjectSelected(string selected)
    {
        var project = await DB.GetProject(selected);
        if (project != null)
        {
            await Gallery.SetCurrentProject(project.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleFolderSelected(string selected)
    {
        if (string.IsNullOrWhiteSpace(selected))
        {
            await Gallery.SetCurrentFolder(0);
        }
        else 
        {
            var folder = await DB.GetFolder(selected);
            if (folder != null)
            {
                await Gallery.SetCurrentFolder(folder.Id);
            }
        }
        
        // Refresh projects for the new folder
        await Gallery.GetProjects(State.State.Gallery.FolderId);
        await InvokeAsync(StateHasChanged);
    }

    private void OnFolderChanged(FolderChangedEventArgs args)
    {
        Refresh();
    }

    private void OnProjectsChanged(ProjectChangedEventArgs args)
    {
        Refresh();
    }

    public void Dispose()
    {
        Events.Unsubscribe<FolderChangedEventArgs>(OnFolderChanged);
        Events.Unsubscribe<ProjectChangedEventArgs>(OnProjectsChanged);
    }

    private async void Refresh()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception) { }
    }
}
