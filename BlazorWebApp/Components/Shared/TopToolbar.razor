@using static BlazorWebApp.Data.Enums
@inject IStateService State
@inject IOrchestratorService Orchestrator
@inject ThemeService ThemeService

<div class="mt-6">
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
        <MudSelect T="string" Value="@(State.State.CurrentTheme ?? "Default")" ValueChanged="HandleThemeSelected"
                   Label="Theme" Variant="Variant.Text" Dense="true" AdornmentIcon="@Icons.Material.Filled.Palette"
                   AdornmentColor="Color.Info" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            @foreach (var themeName in ThemeService.ThemeNames)
            {
                <MudSelectItem Value="@themeName">@themeName</MudSelectItem>
            }
        </MudSelect>
    </MudStack>

    @if (CurrentPage == "/civitai")
    {
        <MudDivider Class="my-3" />
        <ToolbarCivitaiSettings />
    }

    @if (CurrentPage.StartsWith("/generate"))
    {
        var workflow = GetGenerateWorkflow();
        if (workflow != null)
        {
            <MudDivider Class="my-3" />
            <GenerateStatePresetPanel Workflow="@workflow" />
        }

        <MudDivider Class="my-3" />
        <ToolbarLLMSettings />
        <MudDivider Class="my-3" />
        <ToolbarWorkflowFilters />
        <MudDivider Class="my-3" />
        <ToolbarResourceFilters />
    }

    @if (CurrentPage.StartsWith("/prompts"))
    {
        <MudDivider Class="my-3" />
        <ToolbarLLMSettings />
    }
</div>

@code {
    [CascadingParameter] public Action? OnThemeChanged { get; set; }
    [Parameter] public string CurrentPage { get; set; } = "/";

    private async Task HandleThemeSelected(string selected)
    {
        State.State.CurrentTheme = selected;
        await State.SaveState();
        OnThemeChanged?.Invoke();
    }

    private Workflow? GetGenerateWorkflow()
    {
        var segments = CurrentPage.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length >= 2
            && segments[0].Equals("generate", StringComparison.OrdinalIgnoreCase)
            && Guid.TryParse(segments[1], out var workflowId))
        {
            return Orchestrator.GetWorkflowById(workflowId);
        }

        return Orchestrator.GetCurrentWorkflow();
    }

}
