@using BlazorWebApp.Data.Dtos.Ollama
@using static BlazorWebApp.Data.Enums
@inject IStateService State
@inject ISettingsService Settings
@inject OllamaService OllamaService
@inject ISnackbar Snackbar

@if (_isInitialized)
{
    <MudText Typo="Typo.subtitle2" Class="mb-1">LLM Settings</MudText>
    <MudGrid Spacing="2" Class="mb-2">
        @* Model Selector *@
        <MudItem xs="12" sm="4">
            <MudSelect T="string" Value="@State.State.Generation.LLM.Model"
                       ValueChanged="HandleModelChanged"
                       Label="Model"
                       Variant="Variant.Text"
                       Dense
                       AnchorOrigin="Origin.BottomLeft"
                       TransformOrigin="Origin.TopLeft">
                @if (_availableModels != null)
                {
                    foreach (var model in _availableModels)
                    {
                        <MudSelectItem Value="@model.Name">@model.Name</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>

        @* Temperature Quick Access *@
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <div style="width: 100%;">
                <MudText Typo="Typo.caption" Class="mb-1">Temperature: @State.State.Generation.LLM.Options.Temperature.ToString("F1")</MudText>
                <MudSlider T="float"
                           Value="@State.State.Generation.LLM.Options.Temperature"
                           ValueChanged="HandleTemperatureChanged"
                           Min="@Settings.Settings.Generation.Shared.LLMEnhancer.Temperature.Min"
                           Max="@Settings.Settings.Generation.Shared.LLMEnhancer.Temperature.Max"
                           Step="@Settings.Settings.Generation.Shared.LLMEnhancer.Temperature.Step"
                           Variant="Variant.Filled"
                           Size="Size.Small" />
            </div>
        </MudItem>

        @* Advanced Settings Toggle *@
        <MudItem xs="12" sm="4" Class="d-flex align-center justify-end">
            <MudButton OnClick="ToggleAdvancedSettings"
                       StartIcon="@(_showAdvancedSettings ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                       Size="Size.Small"
                       Variant="Variant.Text"
                       Color="Color.Primary">
                Advanced
            </MudButton>
        </MudItem>

        @* Advanced Settings Panel *@
        @if (_showAdvancedSettings)
        {
            <MudItem xs="12">
                <MudPaper Class="pa-3" Outlined>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="int"
                                           Value="@State.State.Generation.LLM.Options.Seed"
                                           ValueChanged="HandleSeedChanged"
                                           Label="Seed"
                                           Variant="Variant.Text"
                                           Min="@Settings.Settings.Generation.Shared.LLMEnhancer.Seed.Min"
                                           Max="@Settings.Settings.Generation.Shared.LLMEnhancer.Seed.Max" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="int"
                                           Value="@State.State.Generation.LLM.Options.TopK"
                                           ValueChanged="HandleTopKChanged"
                                           Label="Top K"
                                           Variant="Variant.Text"
                                           Min="@Settings.Settings.Generation.Shared.LLMEnhancer.TopK.Min"
                                           Max="@Settings.Settings.Generation.Shared.LLMEnhancer.TopK.Max" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="float"
                                           Value="@State.State.Generation.LLM.Options.TopP"
                                           ValueChanged="HandleTopPChanged"
                                           Label="Top P"
                                           Variant="Variant.Text"
                                           Min="@Settings.Settings.Generation.Shared.LLMEnhancer.TopP.Min"
                                           Max="@Settings.Settings.Generation.Shared.LLMEnhancer.TopP.Max"
                                           Step="@Settings.Settings.Generation.Shared.LLMEnhancer.TopP.Step" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="float"
                                           Value="@State.State.Generation.LLM.Options.MinP"
                                           ValueChanged="HandleMinPChanged"
                                           Label="Min P"
                                           Variant="Variant.Text"
                                           Min="@Settings.Settings.Generation.Shared.LLMEnhancer.MinP.Min"
                                           Max="@Settings.Settings.Generation.Shared.LLMEnhancer.MinP.Max"
                                           Step="@Settings.Settings.Generation.Shared.LLMEnhancer.MinP.Step" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="int"
                                           Value="@State.State.Generation.LLM.Options.NumCtx"
                                           ValueChanged="HandleNumCtxChanged"
                                           Label="Context Length"
                                           Variant="Variant.Text"
                                           Min="@Settings.Settings.Generation.Shared.LLMEnhancer.NumCtx.Min"
                                           Max="@Settings.Settings.Generation.Shared.LLMEnhancer.NumCtx.Max" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="int"
                                           Value="@State.State.Generation.LLM.Options.NumPredict"
                                           ValueChanged="HandleNumPredictChanged"
                                           Label="Max Tokens"
                                           Variant="Variant.Text"
                                           Min="@Settings.Settings.Generation.Shared.LLMEnhancer.NumPredict.Min"
                                           Max="@Settings.Settings.Generation.Shared.LLMEnhancer.NumPredict.Max" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private bool _isInitialized;
    private bool _showAdvancedSettings;
    private List<OllamaModel>? _availableModels;

    protected override async Task OnInitializedAsync()
    {
        await LoadModelsAsync();
        _isInitialized = true;
    }

    private async Task LoadModelsAsync()
    {
        try
        {
            _availableModels = await OllamaService.GetModels();
            if (_availableModels != null && _availableModels.Count > 0)
            {
                // Set default if empty
                if (string.IsNullOrEmpty(State.State.Generation.LLM.Model))
                {
                    State.State.Generation.LLM.Model = Settings.Settings.Generation.Shared.LLMEnhancer.Model;
                    if (!_availableModels.Any(m => m.Name == State.State.Generation.LLM.Model))
                    {
                        State.State.Generation.LLM.Model = _availableModels[0].Name;
                    }
                    await State.SaveState();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load models: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleModelChanged(string model)
    {
        State.State.Generation.LLM.Model = model;
        await State.SaveState();
        StateHasChanged();
    }

    private async Task HandleTemperatureChanged(float temperature)
    {
        State.State.Generation.LLM.Options.Temperature = temperature;
        await State.SaveState();
        StateHasChanged();
    }

    private async Task HandleSeedChanged(int seed)
    {
        State.State.Generation.LLM.Options.Seed = seed;
        await State.SaveState();
        StateHasChanged();
    }

    private async Task HandleTopKChanged(int topK)
    {
        State.State.Generation.LLM.Options.TopK = topK;
        await State.SaveState();
        StateHasChanged();
    }

    private async Task HandleTopPChanged(float topP)
    {
        State.State.Generation.LLM.Options.TopP = topP;
        await State.SaveState();
        StateHasChanged();
    }

    private async Task HandleMinPChanged(float minP)
    {
        State.State.Generation.LLM.Options.MinP = minP;
        await State.SaveState();
        StateHasChanged();
    }

    private async Task HandleNumCtxChanged(int numCtx)
    {
        State.State.Generation.LLM.Options.NumCtx = numCtx;
        await State.SaveState();
        StateHasChanged();
    }

    private async Task HandleNumPredictChanged(int numPredict)
    {
        State.State.Generation.LLM.Options.NumPredict = numPredict;
        await State.SaveState();
        StateHasChanged();
    }

    private void ToggleAdvancedSettings()
    {
        _showAdvancedSettings = !_showAdvancedSettings;
    }
}
