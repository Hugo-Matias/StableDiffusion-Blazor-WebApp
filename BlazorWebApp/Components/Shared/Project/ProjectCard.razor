@inject ManagerService M
@inject DatabaseService DB
@inject IOService IO
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="@GetCardClasses()" @onmouseenter="HandleMouseEnter" @onmouseleave="HandleMouseLeave">
    <div class="media-wrapper">
        @if (_isVideo)
        {
            <video id="@_videoId"
                   src="@_mediaUrl"
                   class="card-media"
                   muted
                   loop
                   playsinline
                   preload="metadata" />
        }
        else
        {
            <img src="@_mediaUrl" alt="@Name" class="card-media" loading="lazy" />
        }
        
        @* Hover Overlay *@
        <div class="hover-overlay @(_isHovered ? "visible" : "")">
            @* Top Section - Project Name *@
            <div class="overlay-top @(_isHovered ? "visible" : "")">
                <div class="project-name">
                    <span>@Name</span>
                </div>
            </div>
            
            @* Center Section - Quick Actions *@
            <div class="overlay-center @(_isHovered ? "visible" : "")">
                <div class="quick-actions">
                    <button class="action-btn primary" @onclick="() => OnSelected.InvokeAsync(ProjectId)" title="Select Project">
                        <i class="fa-solid fa-check"></i>
                    </button>
                    <button class="action-btn" @onclick="() => OnEdited.InvokeAsync(ProjectId)" title="Edit Project">
                        <i class="fa-solid fa-pen"></i>
                    </button>
                    <button class="action-btn danger" @onclick="() => OnDeleted.InvokeAsync(ProjectId)" title="Delete Project">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            </div>
        </div>
        
        @* Selected Indicator *@
        @if (M.State.Gallery.ProjectId == ProjectId && !_isHovered)
        {
            <div class="selected-indicator">
                <i class="fa-solid fa-check"></i>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public string Name { get; set; }
    [Parameter] public EventCallback<int> OnDeleted { get; set; }
    [Parameter] public EventCallback<int> OnSelected { get; set; }
    [Parameter] public EventCallback<int> OnEdited { get; set; }

    private static readonly string[] VideoExtensions = { ".mp4", ".webm", ".mov", ".avi", ".mkv" };

    private IJSObjectReference? _jsModule;
    private string _videoId = $"project-video-{Guid.NewGuid():N}";
    private string _mediaUrl;
    private bool _isVideo;
    private bool _isHovered;

    protected override async Task OnParametersSetAsync()
    {
        await SetProjectSampleMedia(ProjectId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _isVideo)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/VideoCard.js");
        }
    }

    private string GetCardClasses()
    {
        var classes = "project-card";
        if (M.State.Gallery.ProjectId == ProjectId) classes += " selected";
        if (_isHovered) classes += " hovered";
        return classes;
    }

    private bool IsVideoFile(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return false;
        var extension = Path.GetExtension(path)?.ToLowerInvariant();
        return VideoExtensions.Contains(extension);
    }

    private async Task SetProjectSampleMedia(int projectId)
    {
        var imagePath = await DB.GetSampleImage(projectId);
        if (string.IsNullOrWhiteSpace(imagePath))
        {
            var imageEntity = await DB.GetRandomFavorite(projectId);
            if (imageEntity != null)
                imagePath ??= imageEntity.Path;
        }
        
        if (!string.IsNullOrWhiteSpace(imagePath))
        {
            _mediaUrl = IO.GetImageStaticFile(imagePath);
            _isVideo = IsVideoFile(imagePath);
        }
        else
        {
            _mediaUrl = "./no_image.png";
            _isVideo = false;
        }
    }

    private async Task HandleMouseEnter()
    {
        _isHovered = true;
        if (_isVideo && _jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("playVideo", _videoId);
            }
            catch { }
        }
    }

    private async Task HandleMouseLeave()
    {
        _isHovered = false;
        if (_isVideo && _jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("pauseVideo", _videoId);
            }
            catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch { }
        }
    }
}
