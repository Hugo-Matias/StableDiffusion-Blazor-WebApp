@inject ManagerService M
@inject DatabaseService DB
@inject IOService IO

<div class="@GetCardClasses()" @onmouseenter="() => _isHovered = true" @onmouseleave="() => _isHovered = false">
    <div class="image-wrapper">
        <img src="@_image" alt="@Name" class="card-image" loading="lazy" />
        
        @* Hover Overlay *@
        <div class="hover-overlay @(_isHovered ? "visible" : "")">
            @* Top Section - Project Name *@
            <div class="overlay-top @(_isHovered ? "visible" : "")">
                <div class="project-name">
                    <span>@Name</span>
                </div>
            </div>
            
            @* Center Section - Quick Actions *@
            <div class="overlay-center @(_isHovered ? "visible" : "")">
                <div class="quick-actions">
                    <button class="action-btn primary" @onclick="() => OnSelected.InvokeAsync(ProjectId)" title="Select Project">
                        <i class="fa-solid fa-check"></i>
                    </button>
                    <button class="action-btn" @onclick="() => OnEdited.InvokeAsync(ProjectId)" title="Edit Project">
                        <i class="fa-solid fa-pen"></i>
                    </button>
                    <button class="action-btn danger" @onclick="() => OnDeleted.InvokeAsync(ProjectId)" title="Delete Project">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            </div>
        </div>
        
        @* Selected Indicator *@
        @if (M.State.Gallery.ProjectId == ProjectId && !_isHovered)
        {
            <div class="selected-indicator">
                <i class="fa-solid fa-check"></i>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public string Name { get; set; }
    [Parameter] public EventCallback<int> OnDeleted { get; set; }
    [Parameter] public EventCallback<int> OnSelected { get; set; }
    [Parameter] public EventCallback<int> OnEdited { get; set; }

    private string _image;
    private bool _isHovered;

    protected override async Task OnParametersSetAsync()
    {
        _image = await SetProjectSampleImage(ProjectId);
    }

    private string GetCardClasses()
    {
        var classes = "project-card";
        if (M.State.Gallery.ProjectId == ProjectId) classes += " selected";
        if (_isHovered) classes += " hovered";
        return classes;
    }

    private async Task<string> SetProjectSampleImage(int projectId)
    {
        var image = await DB.GetSampleImage(projectId);
        if (string.IsNullOrWhiteSpace(image))
        {
            var imageEntity = await DB.GetRandomFavorite(projectId);
            if (imageEntity != null)
                image ??= imageEntity.Path;
        }
        if (!string.IsNullOrWhiteSpace(image)) return IO.GetImageStaticFile(image);
        else return "./no_image.png";
    }
}
