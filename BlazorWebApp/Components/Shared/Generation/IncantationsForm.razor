@using BlazorWebApp.Data.Dtos.WebUI
@inject ISettingsService Settings

<MudText Typo="Typo.button" Style="opacity:0.2;">Incantations</MudText>
<MudGrid>
    <MudItem xs="6">
        <MudCheckBox @bind-Checked=Parameters.IsPAGEnabled Label="Perturbed Attention Guidance" />
    </MudItem>
    <MudItem xs="6">
        <MudSlider @bind-Value=Parameters.PAGScale Min=Settings.Settings.Scripts.Incantations.PAG.Min Max=Settings.Settings.Scripts.Incantations.PAG.Max Step=Settings.Settings.Scripts.Incantations.PAG.Step ValueLabel=true><small>Scale: </small> @Parameters.PAGScale</MudSlider>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public ScriptParametersIncantations Parameters { get; set; }
}
