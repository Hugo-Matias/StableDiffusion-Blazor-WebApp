@inject ISettingsService Settings

<MudItem xs="12">
    <MudText Typo="Typo.caption" Class="mb-4">Quick Resolution:</MudText>
    <MudGrid Spacing="2" Justify="Justify.Center">
        @foreach (var res in Settings.Settings.Generation.Shared.QuickResolutions)
        {
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudButton OnClick="@(() => SetResolution(res.Width, res.Height))"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           FullWidth
                           Size="Size.Small">
                    @res.Label
                </MudButton>
            </MudItem>
        }
    </MudGrid>
    <div class="d-flex justify-center mt-3">
        <MudButtonGroup Variant="Variant.Text" Color="Color.Primary">
            <MudButton OnClick="@(() => ScaleResolution(0.5))"
                       StartIcon="fa-solid fa-compress"
                       Size="Size.Small">
                x0.5
            </MudButton>
            <MudButton OnClick="RotateResolution"
                       StartIcon="fa-solid fa-image-portrait"
                       Size="Size.Small">
                Rotate
            </MudButton>
            <MudButton OnClick="ToggleLockAspectRatio"
                       StartIcon="@(_isAspectRatioLocked ? "fa-solid fa-lock" : "fa-solid fa-lock-open")"
                       Color="@(_isAspectRatioLocked ? Color.Success : Color.Default)"
                       Size="Size.Small"
                       Title="@(_isAspectRatioLocked ? "Unlock aspect ratio" : "Lock to square aspect ratio")">
                Lock
            </MudButton>
            <MudButton OnClick="@(() => ScaleResolution(2.0))"
                       StartIcon="fa-solid fa-expand"
                       Size="Size.Small">
                x2
            </MudButton>
        </MudButtonGroup>
    </div>
</MudItem>
<MudItem xs="6">
    <MudSlider T="int" 
               @bind-Value="@_localWidth"
               @bind-Value:after="OnWidthChanged"
               Min="Settings.Settings.Generation.Shared.Resolution.Min" 
               Max="Settings.Settings.Generation.Shared.Resolution.Max" 
               Step="Settings.Settings.Generation.Shared.Resolution.Step" 
               Variant="Variant.Filled" 
               ValueLabel 
               TickMarks>
        <small>Width:</small> @(_localWidth)px
    </MudSlider>
</MudItem>
<MudItem xs="6">
    <MudSlider T="int" 
               @bind-Value="@_localHeight"
               @bind-Value:after="OnHeightChanged"
               Min="Settings.Settings.Generation.Shared.Resolution.Min" 
               Max="Settings.Settings.Generation.Shared.Resolution.Max" 
               Step="Settings.Settings.Generation.Shared.Resolution.Step" 
               Variant="Variant.Filled" 
               ValueLabel 
               TickMarks>
        <small>Height:</small> @(_localHeight)px
    </MudSlider>
</MudItem>

@code {
    /// <summary>
    /// Current width value.
    /// </summary>
    [Parameter] public int Width { get; set; } = 512;
    
    /// <summary>
    /// Callback when width changes.
    /// </summary>
    [Parameter] public EventCallback<int> WidthChanged { get; set; }
    
    /// <summary>
    /// Current height value.
    /// </summary>
    [Parameter] public int Height { get; set; } = 768;
    
    /// <summary>
    /// Callback when height changes.
    /// </summary>
    [Parameter] public EventCallback<int> HeightChanged { get; set; }
    
    /// <summary>
    /// Optional callback when any resolution change occurs (for additional side effects).
    /// </summary>
    [Parameter] public EventCallback OnResolutionChanged { get; set; }
    
    private bool _isAspectRatioLocked = false;
    
    // Local state that syncs with parameters
    private int _localWidth;
    private int _localHeight;
    
    protected override void OnParametersSet()
    {
        _localWidth = Width;
        _localHeight = Height;
    }

    private async Task OnWidthChanged()
    {
        await WidthChanged.InvokeAsync(_localWidth);
        
        // If locked, update height to match width
        if (_isAspectRatioLocked)
        {
            _localHeight = _localWidth;
            await HeightChanged.InvokeAsync(_localHeight);
        }
        
        await OnResolutionChanged.InvokeAsync();
    }

    private async Task OnHeightChanged()
    {
        await HeightChanged.InvokeAsync(_localHeight);
        
        // If locked, update width to match height
        if (_isAspectRatioLocked)
        {
            _localWidth = _localHeight;
            await WidthChanged.InvokeAsync(_localWidth);
        }
        
        await OnResolutionChanged.InvokeAsync();
    }

    private async Task SetResolution(int width, int height)
    {
        _localWidth = width;
        _localHeight = height;
        await WidthChanged.InvokeAsync(width);
        await HeightChanged.InvokeAsync(height);
        await OnResolutionChanged.InvokeAsync();
    }

    private async Task RotateResolution()
    {
        // Swap width and height
        var newWidth = _localHeight;
        var newHeight = _localWidth;
        _localWidth = newWidth;
        _localHeight = newHeight;
        await WidthChanged.InvokeAsync(newWidth);
        await HeightChanged.InvokeAsync(newHeight);
        await OnResolutionChanged.InvokeAsync();
    }

    private async Task ScaleResolution(double scale)
    {
        var step = Settings.Settings.Generation.Shared.Resolution.Step;
        
        // Scale and round to nearest step
        var newWidth = (int)(Math.Round(_localWidth * scale / step) * step);
        var newHeight = (int)(Math.Round(_localHeight * scale / step) * step);
        
        // Clamp to min/max
        var min = Settings.Settings.Generation.Shared.Resolution.Min;
        var max = Settings.Settings.Generation.Shared.Resolution.Max;
        _localWidth = Math.Clamp(newWidth, min, max);
        _localHeight = Math.Clamp(newHeight, min, max);
        
        await WidthChanged.InvokeAsync(_localWidth);
        await HeightChanged.InvokeAsync(_localHeight);
        await OnResolutionChanged.InvokeAsync();
    }

    private async Task ToggleLockAspectRatio()
    {
        _isAspectRatioLocked = !_isAspectRatioLocked;
        
        // When locking, set both dimensions to the larger of the two
        if (_isAspectRatioLocked)
        {
            var largerDimension = Math.Max(_localWidth, _localHeight);
            _localWidth = largerDimension;
            _localHeight = largerDimension;
            await WidthChanged.InvokeAsync(_localWidth);
            await HeightChanged.InvokeAsync(_localHeight);
            await OnResolutionChanged.InvokeAsync();
        }
    }
}
