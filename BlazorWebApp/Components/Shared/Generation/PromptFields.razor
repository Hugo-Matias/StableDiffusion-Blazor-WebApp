@typeparam T where T : SharedParameters
@using System.Text.Json
@using static BlazorWebApp.Data.Enums
@using BlazorWebApp.Events
@inject IIOService IO
@inject IStateService State
@inject IBackendService Backend
@inject IEventService Events
@inject IDatabaseService DB
@inject IJSRuntime JS
@implements IAsyncDisposable
@implements IDisposable

<div @ref="_containerRef" tabindex="-1">
    <EditForm Model="Parameters">
        <MudPaper Class="pa-6 mb-5 mt-n4">
            <MudGrid>
                <MudItem xs="9">
                    <MudStack>
                        <MudStack>
                            <TextFieldAutocomplete 
                                Class="prompt" 
                                Lines="_promptLines" 
                                Label="Prompt" 
                                @bind-Value="@Parameters.Prompt"
                                OnAdornmentClick="() => PromptDrawer.Visible = true" 
                                AdornmentIcon="fa-solid fa-tags"
                                MinCharsToTrigger="2"
                                MaxSuggestions="15"
                                EnableFuzzyMatching="State.State.Generation.Autocomplete.EnableFuzzySearch"
                                EnableDictionary="true" 
                                EnableAutocomplete="State.State.Generation.Autocomplete.IsEnabled"
                                IsNegative="false"
                                OnLoraSelected="HandleLoraSelected"
                                OnStyleSelected="HandleStyleSelected" />
                            
                            <TextFieldAutocomplete 
                                Class="negative-prompt" 
                                Lines="_negativePromptLines" 
                                Label="Negative Prompt" 
                                @bind-Value="@Parameters.NegativePrompt"
                                OnAdornmentClick="() => NegativePromptDrawer.Visible = true" 
                                AdornmentIcon="fa-solid fa-tags"
                                Disabled="Backend.IsBackendAvailable && State.State.Generation.WorkflowBase != null && _disableNegativeBases.Contains(State.State.Generation.WorkflowBase)"
                                MinCharsToTrigger="2"
                                MaxSuggestions="15"
                                EnableFuzzyMatching="State.State.Generation.Autocomplete.EnableFuzzySearch"
                                EnableDictionary="true"
                                EnableAutocomplete="State.State.Generation.Autocomplete.IsEnabled"
                                IsNegative="true"
                                OnLoraSelected="HandleLoraSelected"
                                OnStyleSelected="HandleStyleSelected" />
                        </MudStack>
                        <MudStack Row=true Spacing="2">
                            <MudTooltip Text="Toggle autocomplete suggestions">
                                <MudSwitch Checked="State.State.Generation.Autocomplete.IsEnabled" 
                                           CheckedChanged="@((bool value) => HandleAutocompleteChanged(value))"
                                           Color="Color.Primary" 
                                           Label="Autocomplete"/>
                            </MudTooltip>
                            <MudTooltip Text="Toggle fuzzy subsequence matching (e.g., 'cascl' matches 'casual clothing')">
                                <MudSwitch Checked="State.State.Generation.Autocomplete.EnableFuzzySearch" 
                                           CheckedChanged="@((bool value) => HandleFuzzySearchChanged(value))"
                                           Color="Color.Primary" 
                                           Label="Fuzzy Search" 
                                           Disabled="!State.State.Generation.Autocomplete.IsEnabled" />
                            </MudTooltip>
                        </MudStack>
                    </MudStack>
                </MudItem>
                <MudItem xs="3">
                    <MudStack Class="h-100 w-100">
                        <MudChipSet Style="height: 10vh; overflow: scroll;" ReadOnly>
                            @if (State.State.Generation.Styles != null && State.State.Generation.Styles.Count() > 0)
                            {
                                @foreach (var style in State.State.Generation.Styles)
                                {
                                    <MudChip Color="Color.Primary">@style.Name</MudChip>
                                }
                            }
                        </MudChipSet>
                        <MudStack Row=true>
                            <MudSelect Label="Styles" Text="" SelectedValues="State.State.Generation.Styles" SelectedValuesChanged=HandleStylesChanged T="PromptStyle" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" MaxHeight="600" AdornmentIcon="fa-solid fa-delete-left" OnAdornmentClick="() => HandleStylesChanged(new List<PromptStyle>())" Adornment="Adornment.End" MultiSelection>

                                @if (_availableStyles != null)
                                {
                                    @foreach (var style in _availableStyles)
                                    {
                                        if (!(string.IsNullOrWhiteSpace(style.Prompt) && string.IsNullOrWhiteSpace(style.NegativePrompt)))
                                        {
                                            <MudSelectItem Value=style T="PromptStyle">@style.Name</MudSelectItem>
                                        }
                                    }
                                }
                            </MudSelect>
                            <MudTooltip Delay="1600" Duration="600" Text="Write selected styles to the prompts and clear the list." Placement="Placement.Start">
                                <MudIconButton Icon="fa-solid fa-pencil" OnClick="WritePrompts" />
                            </MudTooltip>
                        </MudStack>
                        <GenerateButton @ref="_generateButtonRef" Parameters="Parameters" OnGenerate="OnGenerate" OnSkip="OnSkip" OnInterrupt="OnInterrupt" ButtonDisabled=ButtonDisabled />
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </EditForm>
</div>

<TagDrawer @ref="PromptDrawer" OnAppendTags="OnPromptTagAppended" HeaderBgColor="var(--mud-palette-success)" ButtonTags="_buttonTags" OnPromptReplaced="@(p => HandleLLMPromptApplied(p, false))" IsNegativePrompt="false" />
<TagDrawer @ref="NegativePromptDrawer" OnAppendTags="OnNegativePromptTagAppended" HeaderBgColor="var(--mud-palette-error)" ButtonTags="_buttonTags" OnPromptReplaced="@(p => HandleLLMPromptApplied(p, true))" IsNegativePrompt="true" />

@code {
    [Parameter]
    public T Parameters { get; set; }
    [Parameter]
    public EventCallback OnGenerate { get; set; }
    [Parameter]
    public EventCallback OnSkip { get; set; }
    [Parameter]
    public EventCallback OnInterrupt { get; set; }
    [Parameter]
    public EventCallback OnStylesChanged { get; set; }
    [Parameter]
    public EventCallback<T> ParametersChanged { get; set; }
    [Parameter]
    public EventCallback<AppendedTags> OnPromptTagAppended { get; set; }
    [Parameter]
    public EventCallback<AppendedTags> OnNegativePromptTagAppended { get; set; }
    [Parameter]
    public bool ButtonDisabled { get; set; }
    [Parameter]
    public TagDrawer? PromptDrawer { get; set; }
    [Parameter]
    public TagDrawer? NegativePromptDrawer { get; set; }

    private int _promptLines = 6;
    private int _negativePromptLines = 4;
    private bool _isDrawerOpen = false;
    private bool _isConverging = false;
    private List<ModelBase> _disableNegativeBases = new() { ModelBase.Flux, ModelBase.Qwen };
    private List<PromptStyle>? _availableStyles;
    private PromptButton? _buttonTags;
    private ElementReference _containerRef;
    private GenerateButton _generateButtonRef;
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<PromptFields<T>> _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        // Load button tags from IOService
        LoadButtonTags();
        
        // Load styles from database
        await LoadStyles();
        
        _dotNetRef = DotNetObjectReference.Create(this);
        
        // Subscribe to state changes to update styles when they're loaded
        Events.Subscribe<StateChangedEventArgs>(HandleStateChanged);
        Events.Subscribe<StylesChangedEventArgs>(HandleStylesChangedEvent);
    }

    private async Task LoadStyles()
    {
        try
        {
            // Load prompts from database and convert to styles
            var promptResources = await DB.GetPrompts();
            var styles = new List<PromptStyle>();
            
            foreach (var prompt in promptResources)
            {
                styles.Add(new PromptStyle(prompt));
            }
            
            // Update available styles list
            _availableStyles = styles;
            
            // If there are currently selected styles in state, preserve them if they still exist
            if (State.State.Generation.Styles != null && State.State.Generation.Styles.Any())
            {
                var currentStyles = State.State.Generation.Styles.ToList();
                State.State.Generation.Styles = styles.Where(s => currentStyles.Any(cs => cs.Name == s.Name));
            }
            else
            {
                // Initialize to empty list if null
                State.State.Generation.Styles = new List<PromptStyle>();
            }
            
            // Note: Removed publishing StylesChangedEventArgs here to prevent infinite recursion
            // The component that triggers a change (e.g., adding/deleting prompts) should publish the event
        }
        catch (Exception ex)
        {
            // If styles loading fails, initialize to empty list
            _availableStyles = new List<PromptStyle>();
            State.State.Generation.Styles ??= new List<PromptStyle>();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/Input.js");
                await _jsModule.InvokeVoidAsync("initializePromptFieldsKeyboard", _containerRef, _dotNetRef);
            }
            catch (Exception ex)
            {
                // Keyboard shortcut initialization failed, but component still works
            }
        }
    }

    private async void HandleStateChanged(StateChangedEventArgs args)
    {
        // Reload styles from database when state changes (in case new prompts were added)
        await LoadStyles();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleStylesChangedEvent(StylesChangedEventArgs args)
    {
        // Skip reload if this was triggered by our own LoadStyles (would cause infinite recursion)
        // Only reload when external changes happen (e.g., prompts added/updated/deleted from other components)
        if (args.ChangeType == "Loaded")
            return;
            
        // Reload styles from database when prompts are added/updated/deleted
        await LoadStyles();
        await InvokeAsync(StateHasChanged);
    }

    private void LoadButtonTags()
    {
        try
        {
            var json = IO.GetJsonAsString("Data/example.json");
            _buttonTags = JsonSerializer.Deserialize<PromptButton>(json, new JsonSerializerOptions() { PropertyNameCaseInsensitive = true });
        }
        catch
        {
            _buttonTags = null;
        }
    }

    [JSInvokable]
    public async Task HandleCtrlEnter()
    {
        if (!ButtonDisabled && !_isConverging && _generateButtonRef != null)
        {
            _generateButtonRef.Generate();
        }
    }

    /// <summary>
    /// Handles LoRA selection from autocomplete trigger.
    /// Adds the LoRA to the Parameters.Loras list with default settings.
    /// </summary>
    private async Task HandleLoraSelected(Lora lora)
    {
        // Initialize Loras list if null
        if (Parameters.Loras == null)
        {
            Parameters.Loras = new List<Lora>();
        }

        // Check if LoRA already exists
        if (!Parameters.Loras.Any(l => l.Name.Equals(lora.Name, StringComparison.OrdinalIgnoreCase)))
        {
            Parameters.Loras.Add(lora);
            await ParametersChanged.InvokeAsync(Parameters);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Handles style selection from autocomplete trigger.
    /// Adds the style to the generation state styles list.
    /// </summary>
    private async Task HandleStyleSelected(PromptStyle style)
    {
        // Get current styles or initialize empty list
        var currentStyles = State.State.Generation.Styles?.ToList() ?? new List<PromptStyle>();
        
        // Check if style already exists (avoid duplicates)
        if (!currentStyles.Any(s => s.Name.Equals(style.Name, StringComparison.OrdinalIgnoreCase)))
        {
            currentStyles.Add(style);
            State.State.Generation.Styles = currentStyles;
            await OnStylesChanged.InvokeAsync();
            StateHasChanged();
        }
    }

    private void HandleStylesChanged(IEnumerable<PromptStyle> styles) 
    { 
        State.State.Generation.Styles = styles;
        OnStylesChanged.InvokeAsync();
    }

    private async Task HandleLLMPromptApplied(string prompt, bool isNegative)
    {
        if (isNegative)
        {
            Parameters.NegativePrompt = prompt;
        }
        else
        {
            Parameters.Prompt = prompt;
        }
        await ParametersChanged.InvokeAsync(Parameters);
        StateHasChanged();
    }

    private void WritePrompts()
    {
        Parser.ParseParameters(Parameters, State.State.Generation.Styles);
        HandleStylesChanged(Array.Empty<PromptStyle>());
    }

    private async Task HandleAutocompleteChanged(bool value)
    {
        State.State.Generation.Autocomplete.IsEnabled = value;
        await State.SaveState();
        StateHasChanged();
    }

    private async Task HandleFuzzySearchChanged(bool value)
    {
        State.State.Generation.Autocomplete.EnableFuzzySearch = value;
        await State.SaveState();
        StateHasChanged();
    }

    public void Dispose()
    {
        Events.Unsubscribe<StateChangedEventArgs>(HandleStateChanged);
        Events.Unsubscribe<StylesChangedEventArgs>(HandleStylesChangedEvent);
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        
        _dotNetRef?.Dispose();
        if (_jsModule != null)
        {
            await _jsModule.DisposeAsync();
        }
    }
}
