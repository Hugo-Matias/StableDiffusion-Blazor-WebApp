@typeparam T where T : SharedParameters
@using System.Text.Json
@using static BlazorWebApp.Data.Enums
@inject IOService IO
@inject ManagerService M
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_containerRef" tabindex="-1">
    <EditForm Model="Parameters">
        <MudPaper Class="pa-6 mb-5 mt-n4">
            <MudGrid>
                <MudItem xs="9">
                    <MudStack>
                        <MudStack>
                            <TextFieldAutocomplete 
                                Class="prompt" 
                                Lines="_promptLines" 
                                Label="Prompt" 
                                @bind-Value="@Parameters.Prompt"
                                OnAdornmentClick="() => PromptDrawer.Visible = true" 
                                AdornmentIcon="fa-solid fa-tags"
                                MinCharsToTrigger="2"
                                MaxSuggestions="15"
                                EnableFuzzyMatching="M.State.Generation.Autocomplete.EnableFuzzySearch"
                                EnableDictionary="true" 
                                EnableAutocomplete="M.State.Generation.Autocomplete.IsEnabled"
                                IsNegative="false" />
                            
                            <TextFieldAutocomplete 
                                Class="negative-prompt" 
                                Lines="_negativePromptLines" 
                                Label="Negative Prompt" 
                                @bind-Value="@Parameters.NegativePrompt"
                                OnAdornmentClick="() => NegativePromptDrawer.Visible = true" 
                                AdornmentIcon="fa-solid fa-tags"
                                Disabled="M.IsComfyUIUp && M.State.Generation.WorkflowBase != null && _disableNegativeBases.Contains(M.State.Generation.WorkflowBase)"
                                MinCharsToTrigger="2"
                                MaxSuggestions="15"
                                EnableFuzzyMatching="M.State.Generation.Autocomplete.EnableFuzzySearch"
                                EnableDictionary="true"
                                EnableAutocomplete="M.State.Generation.Autocomplete.IsEnabled"
                                IsNegative="true" />
                        </MudStack>
                        <MudStack Row=true Spacing="2">
                            <MudTooltip Text="Toggle autocomplete suggestions">
                                <MudSwitch Checked="M.State.Generation.Autocomplete.IsEnabled" 
                                           CheckedChanged="@((bool value) => HandleAutocompleteChanged(value))"
                                           Color="Color.Primary" 
                                           Label="Autocomplete"/>
                            </MudTooltip>
                            <MudTooltip Text="Toggle fuzzy subsequence matching (e.g., 'cascl' matches 'casual clothing')">
                                <MudSwitch Checked="M.State.Generation.Autocomplete.EnableFuzzySearch" 
                                           CheckedChanged="@((bool value) => HandleFuzzySearchChanged(value))"
                                           Color="Color.Primary" 
                                           Label="Fuzzy Search" 
                                           Disabled="!M.State.Generation.Autocomplete.IsEnabled" />
                            </MudTooltip>
                        </MudStack>
                    </MudStack>
                </MudItem>
                <MudItem xs="3">
                    <MudStack Class="h-100 w-100">
                        <MudChipSet Style="height: 10vh; overflow: scroll;" ReadOnly>
                            @if (M.State.Generation.Styles != null && M.State.Generation.Styles.Count() > 0)
                            {
                                @foreach (var style in M.State.Generation.Styles)
                                {
                                    <MudChip Color="Color.Primary">@style.Name</MudChip>
                                }
                            }
                        </MudChipSet>
                        <MudStack Row=true>
                            <MudSelect Label="Styles" Text="" SelectedValues="M.State.Generation.Styles" SelectedValuesChanged=HandleStylesChanged T="PromptStyle" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" MaxHeight="600" AdornmentIcon="fa-solid fa-delete-left" OnAdornmentClick="() => HandleStylesChanged(new List<PromptStyle>())" Adornment="Adornment.End" MultiSelection>

                                @if (M.Styles != null)
                                {
                                    @foreach (var style in M.Styles)
                                    {
                                        if (!(string.IsNullOrWhiteSpace(style.Prompt) && string.IsNullOrWhiteSpace(style.NegativePrompt)))
                                        {
                                            <MudSelectItem Value=style T="PromptStyle">@style.Name</MudSelectItem>
                                        }
                                    }
                                }
                            </MudSelect>
                            <MudTooltip Delay="1600" Duration="600" Text="Write selected styles to the prompts and clear the list." Placement="Placement.Start">
                                <MudIconButton Icon="fa-solid fa-pencil" OnClick="WritePrompts" />
                            </MudTooltip>
                        </MudStack>
                        <GenerateButton @ref="_generateButtonRef" Parameters="Parameters" OnGenerate="OnGenerate" OnSkip="OnSkip" OnInterrupt="OnInterrupt" ButtonDisabled=ButtonDisabled />
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </EditForm>
</div>

<TagDrawer @ref="PromptDrawer" OnAppendTags="OnPromptTagAppended" HeaderBgColor="var(--mud-palette-success)" ButtonTags=M.ButtonTags OnPromptReplaced=@(p => HandleLLMPromptApplied(p, false)) IsNegativePrompt=false />
<TagDrawer @ref="NegativePromptDrawer" OnAppendTags="OnNegativePromptTagAppended" HeaderBgColor="var(--mud-palette-error)" ButtonTags=M.ButtonTags OnPromptReplaced=@(p => HandleLLMPromptApplied(p, true)) IsNegativePrompt=true />

@code {
    [Parameter]
    public T Parameters { get; set; }
    [Parameter]
    public EventCallback OnGenerate { get; set; }
    [Parameter]
    public EventCallback OnSkip { get; set; }
    [Parameter]
    public EventCallback OnInterrupt { get; set; }
    [Parameter]
    public EventCallback OnStylesChanged { get; set; }
    [Parameter]
    public EventCallback<T> ParametersChanged { get; set; }
    [Parameter]
    public EventCallback<AppendedTags> OnPromptTagAppended { get; set; }
    [Parameter]
    public EventCallback<AppendedTags> OnNegativePromptTagAppended { get; set; }
    [Parameter]
    public bool ButtonDisabled { get; set; }
    [Parameter]
    public TagDrawer? PromptDrawer { get; set; }
    [Parameter]
    public TagDrawer? NegativePromptDrawer { get; set; }

    private int _promptLines = 6;
    private int _negativePromptLines = 4;
    private bool _isDrawerOpen = false;
    private List<ModelBase> _disableNegativeBases = new() { ModelBase.Flux, ModelBase.Qwen };
    private ElementReference _containerRef;
    private GenerateButton _generateButtonRef;
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<PromptFields<T>> _dotNetRef;

    protected override void OnInitialized()
    {
        if (M.ButtonTags == null) M.GetButtonTags();
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/Input.js");
                await _jsModule.InvokeVoidAsync("initializePromptFieldsKeyboard", _containerRef, _dotNetRef);
            }
            catch (Exception ex)
            {
                // Keyboard shortcut initialization failed, but component still works
            }
        }
    }

    [JSInvokable]
    public async Task HandleCtrlEnter()
    {
        if (!ButtonDisabled && !M.IsConverging && _generateButtonRef != null)
        {
            _generateButtonRef.Generate();
        }
    }

    private void HandleStylesChanged(IEnumerable<PromptStyle> styles) 
    { 
        M.State.Generation.Styles = styles;
        OnStylesChanged.InvokeAsync();
    }

    private async Task HandleLLMPromptApplied(string prompt, bool isNegative)
    {
        if (isNegative)
        {
            Parameters.NegativePrompt = prompt;
        }
        else
        {
            Parameters.Prompt = prompt;
        }
        await ParametersChanged.InvokeAsync(Parameters);
        StateHasChanged();
    }

    private void WritePrompts()
    {
        Parser.ParseParameters(Parameters, M.State.Generation.Styles);
        HandleStylesChanged(Array.Empty<PromptStyle>());
    }

    private async Task HandleAutocompleteChanged(bool value)
    {
        M.State.Generation.Autocomplete.IsEnabled = value;
        await M.SaveState();
        StateHasChanged();
    }

    private async Task HandleFuzzySearchChanged(bool value)
    {
        M.State.Generation.Autocomplete.EnableFuzzySearch = value;
        await M.SaveState();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_jsModule != null)
        {
            await _jsModule.DisposeAsync();
        }
    }
}
