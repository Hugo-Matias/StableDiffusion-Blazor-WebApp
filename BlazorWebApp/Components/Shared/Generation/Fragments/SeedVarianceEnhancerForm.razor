@*
    SeedVarianceEnhancerForm - Form for seed-variance-enhancer.sbn fragment
    
    Handles: randomize_percent, strength, noise_insert, steps_switchover_percent, 
             seed, mask_starts_at, mask_percent
    
    Uses strongly-typed SeedVarianceEnhancerFragment for direct property access.
*@
@using static BlazorWebApp.Models.FragmentKeys
@using BlazorWebApp.Models.Fragments
@inject IGenerationParameterService ParameterService

<MudGrid>
    <MudItem xs="6">
        <MudSlider T="int" 
                   @bind-Value="_localRandomizePercent"
                   @bind-Value:after="OnRandomizePercentChanged"
                   Min="0"
                   Max="100"
                   Step="5"
                   Variant="Variant.Filled"
                   ValueLabel>
            <small>Randomize:</small> @(_localRandomizePercent)%
        </MudSlider>
    </MudItem>
    <MudItem xs="6">
        <MudSlider T="int" 
                   @bind-Value="_localStrength"
                   @bind-Value:after="OnStrengthChanged"
                   Min="0"
                   Max="100"
                   Step="1"
                   Variant="Variant.Filled"
                   ValueLabel>
            <small>Strength:</small> @_localStrength
        </MudSlider>
    </MudItem>
    <MudItem xs="6">
        <MudSelect T="string" Label="Noise Insert" @bind-Value="_localNoiseInsert" @bind-Value:after="OnNoiseInsertChanged" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            @foreach (var option in _noiseInsertOptions)
            {
                <MudSelectItem Value="@option" />
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="6">
        <MudSlider T="int" 
                   @bind-Value="_localStepsSwitchoverPercent"
                   @bind-Value:after="OnStepsSwitchoverPercentChanged"
                   Min="0"
                   Max="100"
                   Step="5"
                   Variant="Variant.Filled"
                   ValueLabel>
            <small>Steps Switchover:</small> @(_localStepsSwitchoverPercent)%
        </MudSlider>
    </MudItem>
    <MudItem xs="4">
        <MudNumericField T="long" @bind-Value="_localSeed" @bind-Value:after="OnSeedChanged" Label="Seed" Min="-1" Max="long.MaxValue" />
    </MudItem>
    <MudItem xs="4">
        <MudSelect T="string" Label="Mask Starts At" @bind-Value="_localMaskStartsAt" @bind-Value:after="OnMaskStartsAtChanged" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            @foreach (var option in _maskStartsAtOptions)
            {
                <MudSelectItem Value="@option" />
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="4">
        <MudSlider T="int" 
                   @bind-Value="_localMaskPercent"
                   @bind-Value:after="OnMaskPercentChanged"
                   Min="0"
                   Max="100"
                   Step="5"
                   Variant="Variant.Filled"
                   ValueLabel>
            <small>Mask:</small> @(_localMaskPercent)%
        </MudSlider>
    </MudItem>
    <MudItem xs="12">
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
            <MudText Typo="Typo.caption">
                <strong>Seed Variance Enhancer</strong> modifies <strong>@(_localRandomizePercent)%</strong> of the prompt embedding values with noise (strength: <strong>@_localStrength</strong>).
                The noise is applied during the first <strong>@(_localStepsSwitchoverPercent)%</strong> of steps, then removed so the model can refine the output.
                <br /><br />
                <em>Tip: Strength 15-30 and randomize_percent 50 work well with Z-Image Turbo. Longer prompts provide more embedding values to manipulate.</em>
            </MudText>
        </MudAlert>
    </MudItem>
</MudGrid>

@code {
    /// <summary>
    /// Fragment ID this form is associated with.
    /// </summary>
    [Parameter] public string FragmentId { get; set; } = Fragments.SeedVarianceEnhancer;
    
    /// <summary>
    /// Optional callback when any value changes.
    /// </summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    
    #region Local State
    
    private int _localRandomizePercent;
    private int _localStrength;
    private string _localNoiseInsert = "noise on beginning steps";
    private int _localStepsSwitchoverPercent;
    private long _localSeed;
    private string _localMaskStartsAt = "beginning";
    private int _localMaskPercent;
    
    // Options for dropdowns
    private List<string> _noiseInsertOptions = new() { "noise on beginning steps", "noise on ending steps", "noise on all steps", "disabled" };
    private List<string> _maskStartsAtOptions = new() { "beginning", "end" };
    
    /// <summary>
    /// Gets the typed fragment for direct property access.
    /// </summary>
    private SeedVarianceEnhancerFragment? Fragment => 
        ParameterService.Current.GetFragment<SeedVarianceEnhancerFragment>(FragmentId);
    
    protected override void OnInitialized()
    {
        InitializeFromFragment();
    }
    
    protected override void OnParametersSet()
    {
        InitializeFromFragment();
    }
    
    /// <summary>
    /// Initializes local state from typed fragment properties.
    /// </summary>
    private void InitializeFromFragment()
    {
        var fragment = Fragment;
        if (fragment == null) return;
        
        _localRandomizePercent = fragment.RandomizePercent;
        _localStrength = fragment.Strength;
        _localNoiseInsert = fragment.NoiseInsert;
        _localStepsSwitchoverPercent = fragment.StepsSwitchoverPercent;
        _localSeed = fragment.Seed;
        _localMaskStartsAt = fragment.MaskStartsAt;
        _localMaskPercent = fragment.MaskPercent;
    }
    
    #endregion
    
    #region Event Handlers
    
    private async Task OnRandomizePercentChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVarianceEnhancerFragment>(FragmentId);
        fragment.RandomizePercent = _localRandomizePercent;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnStrengthChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVarianceEnhancerFragment>(FragmentId);
        fragment.Strength = _localStrength;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnNoiseInsertChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVarianceEnhancerFragment>(FragmentId);
        fragment.NoiseInsert = _localNoiseInsert;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnStepsSwitchoverPercentChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVarianceEnhancerFragment>(FragmentId);
        fragment.StepsSwitchoverPercent = _localStepsSwitchoverPercent;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnSeedChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVarianceEnhancerFragment>(FragmentId);
        fragment.Seed = _localSeed;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnMaskStartsAtChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVarianceEnhancerFragment>(FragmentId);
        fragment.MaskStartsAt = _localMaskStartsAt;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnMaskPercentChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVarianceEnhancerFragment>(FragmentId);
        fragment.MaskPercent = _localMaskPercent;
        await OnChanged.InvokeAsync();
    }
    
    #endregion
}
