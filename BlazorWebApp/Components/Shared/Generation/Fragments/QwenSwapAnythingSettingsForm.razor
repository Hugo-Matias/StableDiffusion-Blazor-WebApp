@using BlazorWebApp.Attributes
@using BlazorWebApp.Workflows.Fragments.Qwen
@attribute [FragmentComponent("QwenSwapAnythingSettingsForm")]
@inject IGenerationParameterService ParameterService

<MudStack Spacing="2">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudTextField T="string" Label="SAM Prompt A" @bind-Value="_samPromptA"
                          @bind-Value:after="OnSamPromptAChanged" Variant="Variant.Text" Dense="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField T="string" Label="SAM Prompt B" @bind-Value="_samPromptB"
                          @bind-Value:after="OnSamPromptBChanged" Variant="Variant.Text" Dense="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField T="string" Label="Reference Mask" @bind-Value="_referencePrompt"
                          @bind-Value:after="OnReferencePromptChanged" Variant="Variant.Text" Dense="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSlider T="double" @bind-Value="_samThreshold" @bind-Value:after="OnSamThresholdChanged" Min="0" Max="1"
                       Step="0.01" ValueLabel>
                <small>SAM Threshold:</small> @_samThreshold.ToString("F2")
            </MudSlider>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSlider T="int" @bind-Value="_samRefineIterations" @bind-Value:after="OnSamRefineIterationsChanged"
                       Min="0" Max="10" Step="1" ValueLabel>
                <small>SAM Refine:</small> @_samRefineIterations
            </MudSlider>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSlider T="int" @bind-Value="_growMaskExpand" @bind-Value:after="OnGrowMaskExpandChanged" Min="0"
                       Max="128" Step="1" ValueLabel>
                <small>Grow Mask:</small> @_growMaskExpand
            </MudSlider>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudSlider T="double" @bind-Value="_targetMegapixels" @bind-Value:after="OnTargetMegapixelsChanged"
                       Min="0.01" Max="16" Step="0.01" ValueLabel>
                <small>Target MP:</small> @_targetMegapixels.ToString("F2")
            </MudSlider>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSlider T="double" @bind-Value="_referenceMegapixels" @bind-Value:after="OnReferenceMegapixelsChanged"
                       Min="0.01" Max="16" Step="0.01" ValueLabel>
                <small>Reference MP:</small> @_referenceMegapixels.ToString("F2")
            </MudSlider>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSlider T="int" @bind-Value="_referenceScaleLength" @bind-Value:after="OnReferenceScaleLengthChanged"
                       Min="256" Max="4096" Step="8" ValueLabel>
                <small>Reference Long Side:</small> @_referenceScaleLength
            </MudSlider>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" Label="Latent Source" @bind-Value="_latentSource"
                       @bind-Value:after="OnLatentSourceChanged" Variant="Variant.Text" Dense="true"
                       AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                <MudSelectItem Value="@QwenSwapAnythingSettingsFragment.LatentSourceTarget">Target image</MudSelectItem>
                <MudSelectItem Value="@QwenSwapAnythingSettingsFragment.LatentSourceReference">Reference image
                </MudSelectItem>
                <MudSelectItem Value="@QwenSwapAnythingSettingsFragment.LatentSourceEmpty">Empty latent</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudNumericField T="int" Label="Empty Width" @bind-Value="_emptyLatentWidth"
                             @bind-Value:after="OnEmptyLatentWidthChanged" Variant="Variant.Text" Dense="true" Min="64" Max="8192"
                             Step="8" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudNumericField T="int" Label="Empty Height" @bind-Value="_emptyLatentHeight"
                             @bind-Value:after="OnEmptyLatentHeightChanged" Variant="Variant.Text" Dense="true" Min="64" Max="8192"
                             Step="8" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudNumericField T="int" Label="Batch" @bind-Value="_emptyLatentBatchSize"
                             @bind-Value:after="OnEmptyLatentBatchSizeChanged" Variant="Variant.Text" Dense="true" Min="1" Max="64"
                             Step="1" />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudSlider T="double" @bind-Value="_easyCacheReuseThreshold"
                       @bind-Value:after="OnEasyCacheReuseThresholdChanged" Min="0" Max="1" Step="0.01" ValueLabel>
                <small>Cache Reuse:</small> @_easyCacheReuseThreshold.ToString("F2")
            </MudSlider>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSlider T="double" @bind-Value="_easyCacheStartPercent"
                       @bind-Value:after="OnEasyCacheStartPercentChanged" Min="0" Max="1" Step="0.01" ValueLabel>
                <small>Cache Start:</small> @_easyCacheStartPercent.ToString("F2")
            </MudSlider>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSlider T="double" @bind-Value="_easyCacheEndPercent" @bind-Value:after="OnEasyCacheEndPercentChanged"
                       Min="0" Max="1" Step="0.01" ValueLabel>
                <small>Cache End:</small> @_easyCacheEndPercent.ToString("F2")
            </MudSlider>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    [Parameter] public FragmentReference? Fragment { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private string _samPromptA = "face";
    private string _samPromptB = "hair";
    private string _referencePrompt = "face,hair";
    private double _samThreshold = 0.5;
    private int _samRefineIterations = 2;
    private int _growMaskExpand = 20;
    private double _targetMegapixels = 1;
    private double _referenceMegapixels = 1;
    private int _referenceScaleLength = 1328;
    private string _latentSource = QwenSwapAnythingSettingsFragment.LatentSourceTarget;
    private int _emptyLatentWidth = 896;
    private int _emptyLatentHeight = 1152;
    private int _emptyLatentBatchSize = 1;
    private double _easyCacheReuseThreshold = 0.27;
    private double _easyCacheStartPercent = 0.15;
    private double _easyCacheEndPercent = 0.95;

    protected override void OnParametersSet()
    {
        if (Fragment == null) return;

        _samPromptA = ParameterService.GetFragmentProperty(Fragment, "sam_prompt_a", "face");
        _samPromptB = ParameterService.GetFragmentProperty(Fragment, "sam_prompt_b", "hair");
        _referencePrompt = ParameterService.GetFragmentProperty(Fragment, "reference_prompt", "face,hair");
        _samThreshold = ParameterService.GetFragmentProperty(Fragment, "sam_threshold", 0.5);
        _samRefineIterations = ParameterService.GetFragmentProperty(Fragment, "sam_refine_iterations", 2);
        _growMaskExpand = ParameterService.GetFragmentProperty(Fragment, "grow_mask_expand", 20);
        _targetMegapixels = ParameterService.GetFragmentProperty(Fragment, "target_megapixels", 1.0);
        _referenceMegapixels = ParameterService.GetFragmentProperty(Fragment, "reference_megapixels", 1.0);
        _referenceScaleLength = ParameterService.GetFragmentProperty(Fragment, "reference_scale_length", 1328);
        _latentSource = ParameterService.GetFragmentProperty(Fragment, "latent_source",
QwenSwapAnythingSettingsFragment.LatentSourceTarget);
        _emptyLatentWidth = ParameterService.GetFragmentProperty(Fragment, "empty_latent_width", 896);
        _emptyLatentHeight = ParameterService.GetFragmentProperty(Fragment, "empty_latent_height", 1152);
        _emptyLatentBatchSize = ParameterService.GetFragmentProperty(Fragment, "empty_latent_batch_size", 1);
        _easyCacheReuseThreshold = ParameterService.GetFragmentProperty(Fragment, "easycache_reuse_threshold", 0.27);
        _easyCacheStartPercent = ParameterService.GetFragmentProperty(Fragment, "easycache_start_percent", 0.15);
        _easyCacheEndPercent = ParameterService.GetFragmentProperty(Fragment, "easycache_end_percent", 0.95);
    }

    private async Task SetValue<T>(string key, T value)
    {
        ParameterService.SetFragmentProperty(Fragment, key, value, notify: true);
        await OnChanged.InvokeAsync();
    }

    private Task OnSamPromptAChanged() => SetValue("sam_prompt_a", _samPromptA);
    private Task OnSamPromptBChanged() => SetValue("sam_prompt_b", _samPromptB);
    private Task OnReferencePromptChanged() => SetValue("reference_prompt", _referencePrompt);
    private Task OnSamThresholdChanged() => SetValue("sam_threshold", _samThreshold);
    private Task OnSamRefineIterationsChanged() => SetValue("sam_refine_iterations", _samRefineIterations);
    private Task OnGrowMaskExpandChanged() => SetValue("grow_mask_expand", _growMaskExpand);
    private Task OnTargetMegapixelsChanged() => SetValue("target_megapixels", _targetMegapixels);
    private Task OnReferenceMegapixelsChanged() => SetValue("reference_megapixels", _referenceMegapixels);
    private Task OnReferenceScaleLengthChanged() => SetValue("reference_scale_length", _referenceScaleLength);
    private Task OnLatentSourceChanged() => SetValue("latent_source", _latentSource);
    private Task OnEmptyLatentWidthChanged() => SetValue("empty_latent_width", _emptyLatentWidth);
    private Task OnEmptyLatentHeightChanged() => SetValue("empty_latent_height", _emptyLatentHeight);
    private Task OnEmptyLatentBatchSizeChanged() => SetValue("empty_latent_batch_size", _emptyLatentBatchSize);
    private Task OnEasyCacheReuseThresholdChanged() => SetValue("easycache_reuse_threshold", _easyCacheReuseThreshold);
    private Task OnEasyCacheStartPercentChanged() => SetValue("easycache_start_percent", _easyCacheStartPercent);
    private Task OnEasyCacheEndPercentChanged() => SetValue("easycache_end_percent", _easyCacheEndPercent);
}