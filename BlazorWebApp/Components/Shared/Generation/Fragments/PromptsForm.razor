    #region Styles Tab

    /// <summary>
    /// Returns the filtered list of available styles based on the search text.
    /// Empty-prompt styles are skipped. Matching is case-insensitive on the Name.
    /// </summary>
    private void InvalidateStylesCache()
    {
        _cachedFilteredStyles = null;
        _cachedFilteredStyleRows = null;
        _cachedStyleTags = null;
    }

    private List<PromptStyle> GetFilteredStyles()
    {
        if (_cachedFilteredStyles != null) return _cachedFilteredStyles;
        if (_availableStyles == null) return (_cachedFilteredStyles = new List<PromptStyle>());

        var query = _availableStyles
            .Where(s => !(string.IsNullOrWhiteSpace(s.Prompt) && string.IsNullOrWhiteSpace(s.NegativePrompt)));

        if (!string.IsNullOrWhiteSpace(_stylesSearchText))
        {
            var needle = _stylesSearchText.Trim();
            query = query.Where(s => s.Name != null
                && s.Name.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }

        if (_stylesFavFilter)
            query = query.Where(s => s.IsFavorite);

        if (!string.IsNullOrEmpty(_stylesCategoryFilter))
            query = query.Where(s => s.Category == _stylesCategoryFilter);

        if (_stylesTagsFilter.Count > 0)
            query = query.Where(s => s.Tags != null && _stylesTagsFilter.All(t => s.Tags.Contains(t)));

        return (_cachedFilteredStyles = query.OrderBy(s => s.Name).ToList());
    }

    private ICollection<IReadOnlyList<PromptStyle>> GetFilteredStyleRows()
    {
        if (_cachedFilteredStyleRows != null) return _cachedFilteredStyleRows;

        var styles = GetFilteredStyles();
        var rows = new List<IReadOnlyList<PromptStyle>>((styles.Count + 1) / 2);

        for (var index = 0; index < styles.Count; index += 2)
        {
            rows.Add(index + 1 < styles.Count
                ? new[] { styles[index], styles[index + 1] }
                : new[] { styles[index] });
        }

        return _cachedFilteredStyleRows = rows;
    }

    private IEnumerable<string> GetStyleCategories()
    {
        if (_cachedStyleCategories != null) return _cachedStyleCategories;
        return (_cachedStyleCategories = _availableStyles
            ?.Where(s => !string.IsNullOrEmpty(s.Category))
            .Select(s => s.Category!)
            .Distinct()
            .OrderBy(c => c)
            .ToList() ?? new List<string>());
    }

    private IEnumerable<string> GetStyleTags()
    {
        if (_cachedStyleTags != null) return _cachedStyleTags;
        return (_cachedStyleTags = GetFilteredStyles()
            .Where(s => s.Tags != null)
            .SelectMany(s => s.Tags!)
            .GroupBy(t => t)
            .OrderByDescending(g => g.Count())
            .Select(g => g.Key)
            .ToList());
    }

    private bool IsStyleSelected(PromptStyle style)
        => State.GenerationParameters?.Styles?.Any(s => s.Name == style.Name) ?? false;

    /// <summary>
    /// Toggles a style in the selected set. Called from the styles tab checkbox rows.
    /// </summary>
    private async Task ToggleStyle(PromptStyle style)
    {
        var current = State.GenerationParameters.Styles?.ToList() ?? new List<PromptStyle>();
        var existing = current.FirstOrDefault(s => s.Name == style.Name);
        if (existing != null)
        {
            current.Remove(existing);
        }
        else
        {
            current.Add(style);
        }
        await HandleStylesSelectionChanged(current);
    }

    /// <summary>
    /// Handles the close-button click on an individual applied-styles chip.
    /// MudChipSet invokes this with the chip's Value so we can remove it.
    /// </summary>
    private async Task HandleAppliedChipClosed(MudChip chip)
    {
        if (chip?.Value is not PromptStyle style) return;
        var current = State.GenerationParameters.Styles?.ToList() ?? new List<PromptStyle>();
        var existing = current.FirstOrDefault(s => s.Name == style.Name);
        if (existing != null)
        {
            current.Remove(existing);
            await HandleStylesSelectionChanged(current);
        }
    }

