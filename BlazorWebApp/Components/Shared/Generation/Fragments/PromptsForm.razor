    public void Dispose()
    {
        Events.Unsubscribe<StylesChangedEventArgs>(HandleStylesChangedEvent);
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();

        _dotNetRef?.Dispose();
        if (_jsModule != null)
        {
            await _jsModule.DisposeAsync();
        }
    }

