@*
    UpscaleForm - Form for upscale.sbn fragment
    
    Handles: upscale_model, upscale_width, upscale_height, upscale_steps, upscale_denoise, upscale_scale
    
    Uses strongly-typed UpscaleFragment for direct property access.
*@
@using static BlazorWebApp.Models.FragmentKeys
@using BlazorWebApp.Models.Fragments
@inject IGenerationParameterService ParameterService
@inject IBackendService Backend

<MudGrid>
    <MudItem xs="12" Class="align-items-center justify-content-center d-flex">
        <MudText Typo="Typo.overline">@_resizeInfo</MudText>
    </MudItem>
    <MudItem xs="4">
        <MudSelect T="string" Label="Upscaler" @bind-Value="_localUpscaleModel" @bind-Value:after="OnUpscaleModelChanged" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            @if (Backend.Upscalers != null && Backend.Upscalers.Count > 0)
            {
                @foreach (var upscaler in Backend.Upscalers)
                {
                    <MudSelectItem Value="@upscaler.Name" />
                }
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="4">
        <MudSlider T="int" @bind-Value="_localUpscaleSteps" @bind-Value:after="OnUpscaleStepsChanged"
                   Min="0" Max="150" Step="1" 
                   Variant="Variant.Filled" ValueLabel>
            <small>Steps:</small> @(_localUpscaleSteps > 0 ? _localUpscaleSteps.ToString() : "Original")
        </MudSlider>
    </MudItem>
    <MudItem xs="4">
        <MudSlider T="float" @bind-Value="_localUpscaleDenoise" @bind-Value:after="OnUpscaleDenoiseChanged"
                   Min="0f" Max="1f" Step="0.01f" 
                   Variant="Variant.Filled" ValueLabel>
            <small>Denoising:</small> @_localUpscaleDenoise.ToString("F2")
        </MudSlider>
    </MudItem>
    <MudItem xs="4">
        <MudSlider T="float" @bind-Value="_localUpscaleScale" @bind-Value:after="OnUpscaleScaleChanged"
                   Min="1f" Max="4f" Step="0.25f" 
                   Variant="Variant.Filled" ValueLabel>
            <small>Scale Multiplier:</small> @(_localUpscaleScale)x
        </MudSlider>
    </MudItem>
    <MudItem xs="4">
        <MudSlider T="int" @bind-Value="_localUpscaleWidth" @bind-Value:after="OnUpscaleWidthChanged"
                   Min="64" Max="4096" Step="8" 
                   Variant="Variant.Filled" ValueLabel>
            <small>Width:</small> @(_localUpscaleWidth)px
        </MudSlider>
    </MudItem>
    <MudItem xs="4">
        <MudSlider T="int" @bind-Value="_localUpscaleHeight" @bind-Value:after="OnUpscaleHeightChanged"
                   Min="64" Max="4096" Step="8" 
                   Variant="Variant.Filled" ValueLabel>
            <small>Height:</small> @(_localUpscaleHeight)px
        </MudSlider>
    </MudItem>
</MudGrid>

@code {
    /// <summary>
    /// Fragment ID this form is associated with.
    /// </summary>
    [Parameter] public string FragmentId { get; set; } = Fragments.Upscale;
    
    /// <summary>
    /// Optional callback when any value changes.
    /// </summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    
    #region Local State
    
    private string _localUpscaleModel = string.Empty;
    private int _localUpscaleSteps;
    private float _localUpscaleDenoise;
    private float _localUpscaleScale;
    private int _localUpscaleWidth;
    private int _localUpscaleHeight;
    private MarkupString _resizeInfo = new();
    
    /// <summary>
    /// Gets the typed fragment for direct property access.
    /// </summary>
    private UpscaleFragment? Fragment => 
        ParameterService.Current.GetFragment<UpscaleFragment>(FragmentId);
    
    protected override void OnInitialized()
    {
        InitializeFromFragment();
    }
    
    protected override void OnParametersSet()
    {
        InitializeFromFragment();
    }
    
    /// <summary>
    /// Initializes local state from typed fragment properties.
    /// </summary>
    private void InitializeFromFragment()
    {
        var fragment = Fragment;
        if (fragment == null) return;
        
        _localUpscaleModel = fragment.Model;
        _localUpscaleSteps = fragment.Steps;
        _localUpscaleDenoise = fragment.Denoise;
        _localUpscaleScale = fragment.Scale;
        _localUpscaleWidth = fragment.Width;
        _localUpscaleHeight = fragment.Height;
        
        RefreshResizeInfo();
    }
    
    #endregion
    
    #region Event Handlers
    
    private async Task OnUpscaleModelChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<UpscaleFragment>(FragmentId);
        fragment.Model = _localUpscaleModel;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnUpscaleStepsChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<UpscaleFragment>(FragmentId);
        fragment.Steps = _localUpscaleSteps;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnUpscaleDenoiseChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<UpscaleFragment>(FragmentId);
        fragment.Denoise = _localUpscaleDenoise;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnUpscaleScaleChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<UpscaleFragment>(FragmentId);
        fragment.Scale = _localUpscaleScale;
        RefreshResizeInfo();
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnUpscaleWidthChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<UpscaleFragment>(FragmentId);
        fragment.Width = _localUpscaleWidth;
        RefreshResizeInfo();
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnUpscaleHeightChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<UpscaleFragment>(FragmentId);
        fragment.Height = _localUpscaleHeight;
        RefreshResizeInfo();
        await OnChanged.InvokeAsync();
    }
    
    #endregion
    
    private void RefreshResizeInfo()
    {
        // Get base dimensions from latent fragment if available
        var latent = ParameterService.Current.GetFragment<LatentFragment>(Fragments.Latent);
        var baseWidth = latent?.Width ?? 1024;
        var baseHeight = latent?.Height ?? 1024;
        
        if (_localUpscaleWidth > 0 && _localUpscaleHeight > 0)
        {
            _resizeInfo = new MarkupString($"From: {baseWidth}x{baseHeight} px &rarr; To: <strong>{_localUpscaleWidth}x{_localUpscaleHeight} px</strong>");
        }
        else if (_localUpscaleScale > 0)
        {
            var targetWidth = (int)(baseWidth * _localUpscaleScale);
            var targetHeight = (int)(baseHeight * _localUpscaleScale);
            _resizeInfo = new MarkupString($"From: {baseWidth}x{baseHeight} px &rarr; To: <strong>{targetWidth}x{targetHeight} px</strong> ({_localUpscaleScale}x)");
        }
        else
        {
            _resizeInfo = new MarkupString(string.Empty);
        }
    }
}
