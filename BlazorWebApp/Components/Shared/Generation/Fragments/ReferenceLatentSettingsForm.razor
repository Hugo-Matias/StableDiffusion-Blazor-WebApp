@using BlazorWebApp.Attributes
@using BlazorWebApp.Models
@attribute [FragmentComponent("ReferenceLatentSettingsForm")]
@inject IGenerationParameterService ParameterService

<MudGrid Spacing="2">
    <MudItem xs="6">
        <MudSlider T="double"
                   @bind-Value="_localMegapixels"
                   @bind-Value:after="OnMegapixelsChanged"
                   Min="_megapixelsMin"
                   Max="_megapixelsMax"
                   Step="_megapixelsStep"
                   Variant="Variant.Filled"
                   ValueLabel>
            <small>Megapixels:</small> @_localMegapixels.ToString("F1")
        </MudSlider>
    </MudItem>
    <MudItem xs="6">
        <MudSlider T="int"
                   @bind-Value="_localResolutionSteps"
                   @bind-Value:after="OnResolutionStepsChanged"
                   Min="_resolutionStepsMin"
                   Max="_resolutionStepsMax"
                   Step="_resolutionStepsStep"
                   Variant="Variant.Filled"
                   ValueLabel>
            <small>Resolution Steps:</small> @_localResolutionSteps
        </MudSlider>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public FragmentReference? Fragment { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private double _localMegapixels;
    private int _localResolutionSteps;

    private double _megapixelsMin = 0.1, _megapixelsMax = 4.0, _megapixelsStep = 0.1;
    private int _resolutionStepsMin = 1, _resolutionStepsMax = 64, _resolutionStepsStep = 1;

    protected override void OnParametersSet()
    {
        if (Fragment == null) return;

        LoadConstraintsFromSchema();

        _localMegapixels = ParameterService.GetFragmentProperty(Fragment, "megapixels", 1.0);
        _localResolutionSteps = ParameterService.GetFragmentProperty(Fragment, "resolution_steps", 1);
    }

    private void LoadConstraintsFromSchema()
    {
        if (Fragment?.Schema?.Parameters == null) return;

        if (Fragment.Schema.Parameters.TryGetValue("megapixels", out var megapixelsConstraints))
        {
            _megapixelsMin = megapixelsConstraints.GetMin(0.1);
            _megapixelsMax = megapixelsConstraints.GetMax(4.0);
            _megapixelsStep = megapixelsConstraints.GetStep(0.1);
        }

        if (Fragment.Schema.Parameters.TryGetValue("resolution_steps", out var resolutionStepsConstraints))
        {
            _resolutionStepsMin = resolutionStepsConstraints.GetMin(1);
            _resolutionStepsMax = resolutionStepsConstraints.GetMax(64);
            _resolutionStepsStep = resolutionStepsConstraints.GetStep(1);
        }
    }

    private async Task OnMegapixelsChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "megapixels", _localMegapixels, notify: true);
        await OnChanged.InvokeAsync();
    }

    private async Task OnResolutionStepsChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "resolution_steps", _localResolutionSteps, notify: true);
        await OnChanged.InvokeAsync();
    }
}
