@*
    RTXUpscaleForm - Form for the rtx_upscale fragment (RTXVideoSuperResolution).

    Resize mode picks between "scale by multiplier" and "target dimensions"; only the
    relevant sub-fields are shown for the active mode.
*@
@using BlazorWebApp.Attributes
@using BlazorWebApp.Models
@attribute [FragmentComponent("RTXUpscaleForm")]
@inject IGenerationParameterService ParameterService

<MudGrid Spacing="2">
    <MudItem xs="12" sm="4">
        <MudSelect T="string"
                   Label="Resize Mode"
                   Variant="Variant.Text"
                   Dense="true"
                   @bind-Value="_localResizeMode"
                   @bind-Value:after="OnResizeModeChanged"
                   AnchorOrigin="Origin.BottomLeft"
                   TransformOrigin="Origin.TopLeft">
            @foreach (var option in _resizeModes)
            {
                <MudSelectItem Value="@option">@option</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    @if (_localResizeMode == "dimensions")
    {
        <MudItem xs="6" sm="4">
            <MudSlider T="int" @bind-Value="_localWidth" @bind-Value:after="OnWidthChanged"
                       Min="@GetConstraint("width").GetMin(64)"
                       Max="@GetConstraint("width").GetMax(8192)"
                       Step="@GetConstraint("width").GetStep(8)"
                       Variant="Variant.Filled" ValueLabel>
                <small>Width:</small> @(_localWidth)px
            </MudSlider>
        </MudItem>
        <MudItem xs="6" sm="4">
            <MudSlider T="int" @bind-Value="_localHeight" @bind-Value:after="OnHeightChanged"
                       Min="@GetConstraint("height").GetMin(64)"
                       Max="@GetConstraint("height").GetMax(8192)"
                       Step="@GetConstraint("height").GetStep(8)"
                       Variant="Variant.Filled" ValueLabel>
                <small>Height:</small> @(_localHeight)px
            </MudSlider>
        </MudItem>
    }
    else
    {
        <MudItem xs="12" sm="4">
            <MudSlider T="double" @bind-Value="_localScale" @bind-Value:after="OnScaleChanged"
                       Min="@GetConstraint("scale").GetMin(1.0)"
                       Max="@GetConstraint("scale").GetMax(4.0)"
                       Step="@GetConstraint("scale").GetStep(0.01)"
                       Variant="Variant.Filled" ValueLabel>
                <small>Scale:</small> @(_localScale.ToString("F2"))x
            </MudSlider>
        </MudItem>
    }
    <MudItem xs="12" sm="4">
        <MudSelect T="string"
                   Label="Quality"
                   Variant="Variant.Text"
                   Dense="true"
                   @bind-Value="_localQuality"
                   @bind-Value:after="OnQualityChanged"
                   AnchorOrigin="Origin.BottomLeft"
                   TransformOrigin="Origin.TopLeft">
            @foreach (var option in _qualityOptions)
            {
                <MudSelectItem Value="@option">@option</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public FragmentReference? Fragment { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private string _localResizeMode = "multiplier";
    private double _localScale = 2.0;
    private int _localWidth = 1920;
    private int _localHeight = 1080;
    private string _localQuality = "ULTRA";

    private string[] _resizeModes = [];
    private string[] _qualityOptions = [];
    private Dictionary<string, ParameterConstraints> _constraints = new();

    protected override void OnParametersSet()
    {
        if (Fragment == null) return;

        _constraints = Fragment.Schema?.Parameters ?? new Dictionary<string, ParameterConstraints>();
        _resizeModes = GetOptions("resize_mode");
        _qualityOptions = GetOptions("quality");

        _localResizeMode = ParameterService.GetFragmentProperty(Fragment, "resize_mode", "multiplier");
        _localScale = ParameterService.GetFragmentProperty(Fragment, "scale", 2.0);
        _localWidth = ParameterService.GetFragmentProperty(Fragment, "width", 1920);
        _localHeight = ParameterService.GetFragmentProperty(Fragment, "height", 1080);
        _localQuality = ParameterService.GetFragmentProperty(Fragment, "quality", "ULTRA");
    }

    private ParameterConstraints GetConstraint(string parameterName)
        => _constraints.GetValueOrDefault(parameterName) ?? new ParameterConstraints();

    private string[] GetOptions(string parameterName)
        => Fragment?.Schema?.GetConstraints(parameterName).Options?.ToArray() ?? [];

    private async Task OnResizeModeChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "resize_mode", _localResizeMode, notify: true);
        await OnChanged.InvokeAsync();
    }

    private async Task OnScaleChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "scale", _localScale, notify: true);
        await OnChanged.InvokeAsync();
    }

    private async Task OnWidthChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "width", _localWidth, notify: true);
        await OnChanged.InvokeAsync();
    }

    private async Task OnHeightChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "height", _localHeight, notify: true);
        await OnChanged.InvokeAsync();
    }

    private async Task OnQualityChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "quality", _localQuality, notify: true);
        await OnChanged.InvokeAsync();
    }
}
