@*
    SeedVR2Form - Form for upscale-seedvr2.sbn fragment
    
    Handles: seedvr2_model, seedvr2_vae_model, seedvr2_resolution, seedvr2_batch_size, blocks_to_swap,
             vae_tile_size, vae_tile_overlap, seedvr2_input_noise_scale, seedvr2_latent_noise_scale
    
    This is an optional feature for high-quality video/image upscaling using SeedVR2.
    Values are read from FragmentParameters.Values and synced back on change.
*@
@using BlazorWebApp.Attributes
@attribute [FragmentComponent("SeedVR2Form")]
@inject IGenerationParameterService ParameterService
@inject IWorkflowService WorkflowService

<MudGrid>
    <MudItem xs="12" Class="align-items-center justify-content-center d-flex">
        <MudText Typo="Typo.overline">@_resizeInfo</MudText>
    </MudItem>
    <MudItem xs="6">
        <MudSelect T="string" Label="DiT Model" @bind-Value="_localModel" @bind-Value:after="OnModelChanged" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            @foreach (var model in GetOptions("seedvr2_model"))
            {
                <MudSelectItem Value="@model" />
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="6">
        <MudSelect T="string" Label="VAE Model" @bind-Value="_localVaeModel" @bind-Value:after="OnVaeModelChanged" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            @foreach (var model in GetOptions("seedvr2_vae_model"))
            {
                <MudSelectItem Value="@model" />
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="4">
        <MudSlider T="int" @bind-Value="_localResolution" @bind-Value:after="OnResolutionChanged"
                   Min="@GetConstraint("seedvr2_resolution").GetMin(512)" 
                   Max="@GetConstraint("seedvr2_resolution").GetMax(4096)" 
                   Step="@GetConstraint("seedvr2_resolution").GetStep(64)" 
                   Variant="Variant.Filled" ValueLabel>
            <small>Resolution:</small> @(_localResolution)px
        </MudSlider>
    </MudItem>
    <MudItem xs="2">
        <MudNumericField T="int" @bind-Value="_localBatchSize" @bind-Value:after="OnBatchSizeChanged"
                         Label="Batch Size" 
                         Min="@GetConstraint("seedvr2_batch_size").GetMin(1)" 
                         Max="@GetConstraint("seedvr2_batch_size").GetMax(10)" 
                         Step="@GetConstraint("seedvr2_batch_size").GetStep(1)" />
    </MudItem>
    <MudItem xs="6">
        <MudNumericField T="int" @bind-Value="_localBlocksToSwap" @bind-Value:after="OnBlocksToSwapChanged"
                         Label="Blocks to Swap" 
                         Min="@GetConstraint("blocks_to_swap").GetMin(0)" 
                         Max="@GetConstraint("blocks_to_swap").GetMax(36)" 
                         Step="@GetConstraint("blocks_to_swap").GetStep(1)" />
    </MudItem>
    <MudItem xs="3">
        <MudNumericField T="int" @bind-Value="_localVaeTileSize" @bind-Value:after="OnVaeTileSizeChanged"
                         Label="VAE Tile Size" 
                         Min="@GetConstraint("vae_tile_size").GetMin(128)" 
                         Max="@GetConstraint("vae_tile_size").GetMax(2048)" 
                         Step="@GetConstraint("vae_tile_size").GetStep(64)" />
    </MudItem>
    <MudItem xs="3">
        <MudNumericField T="int" @bind-Value="_localVaeTileOverlap" @bind-Value:after="OnVaeTileOverlapChanged"
                         Label="VAE Tile Overlap" 
                         Min="@GetConstraint("vae_tile_overlap").GetMin(0)" 
                         Max="@GetConstraint("vae_tile_overlap").GetMax(512)" 
                         Step="@GetConstraint("vae_tile_overlap").GetStep(32)" />
    </MudItem>
    <MudItem xs="6">
        <MudSlider T="float" @bind-Value="_localInputNoiseScale" @bind-Value:after="OnInputNoiseScaleChanged"
                   Min="@GetConstraint("seedvr2_input_noise_scale").GetMin(0f)" 
                   Max="@GetConstraint("seedvr2_input_noise_scale").GetMax(1f)" 
                   Step="@GetConstraint("seedvr2_input_noise_scale").GetStep(0.01f)" 
                   Variant="Variant.Filled" 
                   ValueLabel>
            <small>Input Noise Scale:</small> @_localInputNoiseScale.ToString("F2")
        </MudSlider>
    </MudItem>
    <MudItem xs="6">
        <MudSlider T="float" @bind-Value="_localLatentNoiseScale" @bind-Value:after="OnLatentNoiseScaleChanged"
                   Min="@GetConstraint("seedvr2_latent_noise_scale").GetMin(0f)" 
                   Max="@GetConstraint("seedvr2_latent_noise_scale").GetMax(1f)" 
                   Step="@GetConstraint("seedvr2_latent_noise_scale").GetStep(0.01f)" 
                   Variant="Variant.Filled" 
                   ValueLabel>
            <small>Latent Noise Scale:</small> @_localLatentNoiseScale.ToString("F2")
        </MudSlider>
    </MudItem>
</MudGrid>

@code {
    /// <summary>
    /// Fragment reference containing the fragment ID, parameters, and schema.
    /// </summary>
    [Parameter] public FragmentReference? Fragment { get; set; }
    
    /// <summary>
    /// Optional callback when any value changes.
    /// </summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    
    #region Local State (for MudBlazor binding - prevents snap-back)
    
    private string? _localModel;
    private string? _localVaeModel;
    private int _localResolution;
    private int _localBatchSize;
    private int _localBlocksToSwap;
    private int _localVaeTileSize;
    private int _localVaeTileOverlap;
    private float _localInputNoiseScale;
    private float _localLatentNoiseScale;
    private MarkupString _resizeInfo = new();
    
    // Cached constraints from schema - Dictionary preserves parameter names as keys
    private Dictionary<string, ParameterConstraints> _constraints = new();
    
    // Dynamic options from ComfyUI - keyed by parameter name
    private Dictionary<string, List<string>> _dynamicOptions = new();
    
    protected override async Task OnInitializedAsync()
    {
        if (Fragment == null) return;
        
        LoadConstraints();
        await LoadDynamicOptionsAsync();
    }
    
    protected override void OnParametersSet()
    {
        if (Fragment == null) return;
        
        // Re-read values when Fragment changes
        InitializeFromFragment();
    }
    
    /// <summary>
    /// Gets constraint for a parameter, returning empty constraint if not found.
    /// </summary>
    private ParameterConstraints GetConstraint(string parameterName)
        => _constraints.GetValueOrDefault(parameterName) ?? new ParameterConstraints();
    
    /// <summary>
    /// Gets dynamic options for a parameter, returning empty list if not found.
    /// </summary>
    private List<string> GetOptions(string parameterName)
        => _dynamicOptions.GetValueOrDefault(parameterName) ?? new List<string>();
    
    /// <summary>
    /// Loads parameter constraints from the fragment schema.
    /// </summary>
    private void LoadConstraints()
    {
        if (Fragment?.Schema?.Parameters == null) return;
        
        // Store entire Parameters dictionary - preserves parameter names as keys
        _constraints = Fragment.Schema.Parameters;
    }
    
    /// <summary>
    /// Loads dynamic options from ComfyUI for all parameters with dynamic sources.
    /// Iterates over constraints dictionary - source and input_name are in the constraint itself.
    /// </summary>
    private async Task LoadDynamicOptionsAsync()
    {
        if (Fragment == null) return;
        
        foreach (var (parameterName, constraint) in _constraints)
        {
            if (constraint.HasDynamicSource)
            {
                var options = await ParameterService.ResolveSourceOptionsAsync(constraint);
                _dynamicOptions[parameterName] = options;
            }
        }
    }
    
    /// <summary>
    /// Initializes local state from fragment parameters.
    /// 
    /// Default value priority (see IGenerationParameterService for full documentation):
    /// 1. Workflow template's pipeline step parameters
    /// 2. Fragment template defaults
    /// 3. First dynamic option (for fields with ComfyUI sources) - handled here in UI
    /// </summary>
    private void InitializeFromFragment()
    {
        if (Fragment == null) return;
        
        // Model fields with dynamic sources: apply first-option fallback if no default
        _localModel = ParameterService.GetFragmentProperty(Fragment, "seedvr2_model", (string?)null);
        if (string.IsNullOrEmpty(_localModel))
        {
            _localModel = GetOptions("seedvr2_model").FirstOrDefault();
            if (_localModel != null)
            {
                ParameterService.SetFragmentProperty(Fragment, "seedvr2_model", _localModel, notify: false);
            }
        }
        
        _localVaeModel = ParameterService.GetFragmentProperty(Fragment, "seedvr2_vae_model", (string?)null);
        if (string.IsNullOrEmpty(_localVaeModel))
        {
            _localVaeModel = GetOptions("seedvr2_vae_model").FirstOrDefault();
            if (_localVaeModel != null)
            {
                ParameterService.SetFragmentProperty(Fragment, "seedvr2_vae_model", _localVaeModel, notify: false);
            }
        }
        
        // Numeric fields: use fragment defaults (priority 1 & 2 handled by service)
        _localResolution = ParameterService.GetFragmentProperty(Fragment, "seedvr2_resolution", 2048);
        _localBatchSize = ParameterService.GetFragmentProperty(Fragment, "seedvr2_batch_size", 1);
        _localBlocksToSwap = ParameterService.GetFragmentProperty(Fragment, "blocks_to_swap", 36);
        _localVaeTileSize = ParameterService.GetFragmentProperty(Fragment, "vae_tile_size", 1024);
        _localVaeTileOverlap = ParameterService.GetFragmentProperty(Fragment, "vae_tile_overlap", 128);
        _localInputNoiseScale = ParameterService.GetFragmentProperty(Fragment, "seedvr2_input_noise_scale", 0f);
        _localLatentNoiseScale = ParameterService.GetFragmentProperty(Fragment, "seedvr2_latent_noise_scale", 0f);
        
        RefreshResizeInfo();
    }
    
    #endregion
    
    #region Event Handlers
    
    private async Task OnModelChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "seedvr2_model", _localModel, notify: true);
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnVaeModelChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "seedvr2_vae_model", _localVaeModel, notify: true);
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnResolutionChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "seedvr2_resolution", _localResolution, notify: true);
        RefreshResizeInfo();
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnBatchSizeChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "seedvr2_batch_size", _localBatchSize, notify: true);
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnBlocksToSwapChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "blocks_to_swap", _localBlocksToSwap, notify: true);
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnVaeTileSizeChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "vae_tile_size", _localVaeTileSize, notify: true);
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnVaeTileOverlapChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "vae_tile_overlap", _localVaeTileOverlap, notify: true);
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnInputNoiseScaleChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "seedvr2_input_noise_scale", _localInputNoiseScale, notify: true);
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnLatentNoiseScaleChanged()
    {
        ParameterService.SetFragmentProperty(Fragment, "seedvr2_latent_noise_scale", _localLatentNoiseScale, notify: true);
        await OnChanged.InvokeAsync();
    }
    
    #endregion
    
    private void RefreshResizeInfo()
    {
        // Get base dimensions from latent fragment if available
        var baseWidth = 1024;
        var baseHeight = 1024;
        
        // Try to read base dimensions from primary latent fragment
        if (ParameterService.PrimaryLatentFragment != null)
        {
            baseWidth = ParameterService.GetFragmentProperty(ParameterService.PrimaryLatentFragment, "width", 1024);
            baseHeight = ParameterService.GetFragmentProperty(ParameterService.PrimaryLatentFragment, "height", 1024);
        }
        
        // SeedVR2 uses resolution (smallest side) to scale proportionally
        var aspectRatio = (float)baseWidth / baseHeight;
        int targetWidth, targetHeight;
        
        if (aspectRatio >= 1)
        {
            // Landscape or square
            targetHeight = _localResolution;
            targetWidth = (int)(_localResolution * aspectRatio);
        }
        else
        {
            // Portrait
            targetWidth = _localResolution;
            targetHeight = (int)(_localResolution / aspectRatio);
        }
        
        _resizeInfo = new MarkupString($"From: {baseWidth}x{baseHeight} px &rarr; To: <strong>{targetWidth}x{targetHeight} px</strong> (smallest side: {_localResolution}px)");
    }
}
