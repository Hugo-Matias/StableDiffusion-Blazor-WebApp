@*
    SeedVR2Form - Form for upscale-seedvr2.sbn fragment
    
    Handles: seedvr2_model, seedvr2_vae_model, seedvr2_resolution, seedvr2_batch_size, blocks_to_swap,
             vae_tile_size, vae_tile_overlap, seedvr2_input_noise_scale, seedvr2_latent_noise_scale
    
    Uses strongly-typed SeedVR2Fragment for direct property access.
    Constraints are read from the fragment's #meta schema (single source of truth).
*@
@using static BlazorWebApp.Models.FragmentKeys
@using BlazorWebApp.Models.Fragments
@inject IGenerationParameterService ParameterService
@inject IFragmentSchemaService SchemaService

<MudGrid>
    <MudItem xs="12" Class="align-items-center justify-content-center d-flex">
        <MudText Typo="Typo.overline">@_resizeInfo</MudText>
    </MudItem>
    <MudItem xs="6">
        <MudSelect T="string" Label="DiT Model" @bind-Value="_localModel" @bind-Value:after="OnModelChanged" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            @foreach (var model in _modelOptions)
            {
                <MudSelectItem Value="@model" />
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="6">
        <MudSelect T="string" Label="VAE Model" @bind-Value="_localVaeModel" @bind-Value:after="OnVaeModelChanged" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            @foreach (var model in _vaeModelOptions)
            {
                <MudSelectItem Value="@model" />
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="4">
        <MudSlider T="int" @bind-Value="_localResolution" @bind-Value:after="OnResolutionChanged"
                   Min="@GetConstraints("seedvr2_resolution").GetMin(512)" 
                   Max="@GetConstraints("seedvr2_resolution").GetMax(4096)" 
                   Step="@GetConstraints("seedvr2_resolution").GetStep(64)" 
                   Variant="Variant.Filled" ValueLabel>
            <small>Resolution:</small> @(_localResolution)px
        </MudSlider>
    </MudItem>
    <MudItem xs="2">
        <MudNumericField T="int" @bind-Value="_localBatchSize" @bind-Value:after="OnBatchSizeChanged"
                         Label="Batch Size" 
                         Min="@GetConstraints("seedvr2_batch_size").GetMin(1)" 
                         Max="@GetConstraints("seedvr2_batch_size").GetMax(10)" 
                         Step="@GetConstraints("seedvr2_batch_size").GetStep(1)" />
    </MudItem>
    <MudItem xs="6">
        <MudNumericField T="int" @bind-Value="_localBlocksToSwap" @bind-Value:after="OnBlocksToSwapChanged"
                         Label="Blocks to Swap" 
                         Min="@GetConstraints("blocks_to_swap").GetMin(0)" 
                         Max="@GetConstraints("blocks_to_swap").GetMax(36)" 
                         Step="@GetConstraints("blocks_to_swap").GetStep(1)" />
    </MudItem>
    <MudItem xs="3">
        <MudNumericField T="int" @bind-Value="_localVaeTileSize" @bind-Value:after="OnVaeTileSizeChanged"
                         Label="VAE Tile Size" 
                         Min="@GetConstraints("vae_tile_size").GetMin(128)" 
                         Max="@GetConstraints("vae_tile_size").GetMax(2048)" 
                         Step="@GetConstraints("vae_tile_size").GetStep(64)" />
    </MudItem>
    <MudItem xs="3">
        <MudNumericField T="int" @bind-Value="_localVaeTileOverlap" @bind-Value:after="OnVaeTileOverlapChanged"
                         Label="VAE Tile Overlap" 
                         Min="@GetConstraints("vae_tile_overlap").GetMin(0)" 
                         Max="@GetConstraints("vae_tile_overlap").GetMax(512)" 
                         Step="@GetConstraints("vae_tile_overlap").GetStep(32)" />
    </MudItem>
    <MudItem xs="6">
        <MudSlider T="float" @bind-Value="_localInputNoiseScale" @bind-Value:after="OnInputNoiseScaleChanged"
                   Min="@GetConstraints("seedvr2_input_noise_scale").GetMin(0f)" 
                   Max="@GetConstraints("seedvr2_input_noise_scale").GetMax(1f)" 
                   Step="@GetConstraints("seedvr2_input_noise_scale").GetStep(0.01f)" 
                   Variant="Variant.Filled" ValueLabel>
            <small>Input Noise Scale:</small> @_localInputNoiseScale.ToString("F2")
        </MudSlider>
    </MudItem>
    <MudItem xs="6">
        <MudSlider T="float" @bind-Value="_localLatentNoiseScale" @bind-Value:after="OnLatentNoiseScaleChanged"
                   Min="@GetConstraints("seedvr2_latent_noise_scale").GetMin(0f)" 
                   Max="@GetConstraints("seedvr2_latent_noise_scale").GetMax(1f)" 
                   Step="@GetConstraints("seedvr2_latent_noise_scale").GetStep(0.01f)" 
                   Variant="Variant.Filled" ValueLabel>
            <small>Latent Noise Scale:</small> @_localLatentNoiseScale.ToString("F2")
        </MudSlider>
    </MudItem>
</MudGrid>

@code {
    /// <summary>
    /// Fragment ID this form is associated with.
    /// </summary>
    [Parameter] public string FragmentId { get; set; } = Fragments.SeedVR2;
    
    /// <summary>
    /// Optional callback when any value changes.
    /// </summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    
    #region Schema & Constraints
    
    private FragmentSchema? _schema;
    
    /// <summary>
    /// Gets constraints for a parameter from the fragment schema.
    /// Falls back to empty constraints if schema not loaded.
    /// </summary>
    private ParameterConstraints GetConstraints(string parameterName)
    {
        return _schema?.GetConstraints(parameterName) ?? new ParameterConstraints();
    }
    
    #endregion
    
    #region Local State
    
    private string _localModel = string.Empty;
    private string _localVaeModel = string.Empty;
    private int _localResolution;
    private int _localBatchSize;
    private int _localBlocksToSwap;
    private int _localVaeTileSize;
    private int _localVaeTileOverlap;
    private float _localInputNoiseScale;
    private float _localLatentNoiseScale;
    private MarkupString _resizeInfo = new();
    
    // Dynamic options from ComfyUI
    private List<string> _modelOptions = new();
    private List<string> _vaeModelOptions = new();
    
    /// <summary>
    /// Gets the typed fragment for direct property access.
    /// </summary>
    private SeedVR2Fragment? Fragment => 
        ParameterService.Current.GetFragment<SeedVR2Fragment>(FragmentId);
    
    protected override async Task OnInitializedAsync()
    {
        // Load schema from the .sbn file (single source of truth for constraints)
        _schema = SchemaService.GetFragmentSchema("upscale-seedvr2.sbn");
        
        await LoadDynamicOptionsAsync();
        InitializeFromFragment();
    }
    
    protected override void OnParametersSet()
    {
        InitializeFromFragment();
    }
    
    /// <summary>
    /// Loads dynamic options from ComfyUI for model fields.
    /// </summary>
    private async Task LoadDynamicOptionsAsync()
    {
        // Load options from ComfyUI using the schema's source definitions
        var modelConstraints = GetConstraints("seedvr2_model");
        var vaeConstraints = GetConstraints("seedvr2_vae_model");
        
        if (modelConstraints.HasDynamicSource)
        {
            _modelOptions = await ParameterService.ResolveSourceOptionsAsync(modelConstraints);
        }
        
        if (vaeConstraints.HasDynamicSource)
        {
            _vaeModelOptions = await ParameterService.ResolveSourceOptionsAsync(vaeConstraints);
        }
        
        // Fallback if no options loaded
        if (_modelOptions.Count == 0)
            _modelOptions = new List<string> { "seedvr2_ema_7b-Q4_K_M.gguf" };
        if (_vaeModelOptions.Count == 0)
            _vaeModelOptions = new List<string> { "ema_vae_fp16.safetensors" };
    }
    
    /// <summary>
    /// Initializes local state from typed fragment properties.
    /// </summary>
    private void InitializeFromFragment()
    {
        var fragment = Fragment;
        if (fragment == null) return;
        
        _localModel = fragment.Model;
        if (string.IsNullOrEmpty(_localModel) && _modelOptions.Count > 0)
        {
            _localModel = _modelOptions.First();
            fragment.Model = _localModel;
        }
        
        _localVaeModel = fragment.VaeModel;
        if (string.IsNullOrEmpty(_localVaeModel) && _vaeModelOptions.Count > 0)
        {
            _localVaeModel = _vaeModelOptions.First();
            fragment.VaeModel = _localVaeModel;
        }
        
        _localResolution = fragment.Resolution;
        _localBatchSize = fragment.BatchSize;
        _localBlocksToSwap = fragment.BlocksToSwap;
        _localVaeTileSize = fragment.VaeTileSize;
        _localVaeTileOverlap = fragment.VaeTileOverlap;
        _localInputNoiseScale = fragment.InputNoiseScale;
        _localLatentNoiseScale = fragment.LatentNoiseScale;
        
        RefreshResizeInfo();
    }
    
    #endregion
    
    #region Event Handlers
    
    private async Task OnModelChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVR2Fragment>(FragmentId);
        fragment.Model = _localModel;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnVaeModelChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVR2Fragment>(FragmentId);
        fragment.VaeModel = _localVaeModel;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnResolutionChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVR2Fragment>(FragmentId);
        fragment.Resolution = _localResolution;
        RefreshResizeInfo();
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnBatchSizeChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVR2Fragment>(FragmentId);
        fragment.BatchSize = _localBatchSize;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnBlocksToSwapChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVR2Fragment>(FragmentId);
        fragment.BlocksToSwap = _localBlocksToSwap;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnVaeTileSizeChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVR2Fragment>(FragmentId);
        fragment.VaeTileSize = _localVaeTileSize;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnVaeTileOverlapChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVR2Fragment>(FragmentId);
        fragment.VaeTileOverlap = _localVaeTileOverlap;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnInputNoiseScaleChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVR2Fragment>(FragmentId);
        fragment.InputNoiseScale = _localInputNoiseScale;
        await OnChanged.InvokeAsync();
    }
    
    private async Task OnLatentNoiseScaleChanged()
    {
        var fragment = ParameterService.Current.GetOrCreateFragment<SeedVR2Fragment>(FragmentId);
        fragment.LatentNoiseScale = _localLatentNoiseScale;
        await OnChanged.InvokeAsync();
    }
    
    #endregion
    
    private void RefreshResizeInfo()
    {
        // Get base dimensions from latent fragment if available
        var latent = ParameterService.Current.GetFragment<LatentFragment>(Fragments.Latent);
        var baseWidth = latent?.Width ?? 1024;
        var baseHeight = latent?.Height ?? 1024;
        
        // SeedVR2 uses resolution (smallest side) to scale proportionally
        var aspectRatio = (float)baseWidth / baseHeight;
        int targetWidth, targetHeight;
        
        if (aspectRatio >= 1)
        {
            // Landscape or square
            targetHeight = _localResolution;
            targetWidth = (int)(_localResolution * aspectRatio);
        }
        else
        {
            // Portrait
            targetWidth = _localResolution;
            targetHeight = (int)(_localResolution / aspectRatio);
        }
        
        _resizeInfo = new MarkupString($"From: {baseWidth}x{baseHeight} px &rarr; To: <strong>{targetWidth}x{targetHeight} px</strong> (smallest side: {_localResolution}px)");
    }
}
