@inject IResourceCacheService ResourceCache
@inject IIOService IO

<div class="@(_previewSrc != null ? "lora-card lora-card--banner" : "lora-card")">
    @if (_previewSrc != null)
    {
        <img class="lora-card-bg" src="@_previewSrc" loading="lazy" />
    }
    <div class="lora-card-body">
        <div class="lora-card-name">
            <MudText Typo="Typo.caption" Class="lora-name-text">@Lora.Name</MudText>
        </div>
        <div class="lora-card-controls">
            <MudNumericField Value="Lora.Strength"
                             ValueChanged="@(async (float v) => await OnStrengthChanged(v))"
                             Variant="Variant.Text"
                             Min="-5f" Max="5f" Step="0.05f" Format="N2"
                             Margin="Margin.Dense"
                             Class="lora-strength-field" />
            @if (IsDualModel)
            {
                <MudButton Variant="Variant.Filled"
                           Color="@(_isHigh ? Color.Primary : Color.Secondary)"
                           Size="Size.Small"
                           OnClick="TogglePath"
                           Title="@(_isHigh ? "Assigned to High model" : "Assigned to Low model")"
                           Class="lora-ctrl-btn">
                    @(_isHigh ? "H" : "L")
                </MudButton>
            }
            <MudToggleIconButton Toggled="Lora.IsNegative"
                                 ToggledChanged="@(async (bool v) => await OnIsNegativeChanged(v))"
                                 Icon="fa-solid fa-circle-plus"
                                 Color="@Color.Success"
                                 ToggledIcon="fa-solid fa-circle-minus"
                                 ToggledColor="@Color.Error"
                                 Size="Size.Small"
                                 Title="@(Lora.IsNegative ? "Negative Prompt" : "Prompt")" />
            <MudCheckBox Checked="Lora.IsEnabled"
                         CheckedChanged="@(async (bool v) => await OnIsEnabledChanged(v))"
                         Title="Toggle Activation"
                         Dense="true" />
            <MudIconButton Icon="fa-solid fa-xmark"
                           OnClick="async () => await OnRemoveLora.InvokeAsync(Lora)"
                           Color="Color.Error"
                           Size="Size.Small"
                           Title="Remove" />
        </div>
    </div>
</div>

@code {
    [Parameter] public Lora Lora { get; set; }
    [Parameter] public bool IsDualModel { get; set; }
    [Parameter] public EventCallback<Lora> OnRemoveLora { get; set; }
    [Parameter] public EventCallback<Lora> OnLoraChanged { get; set; }

    private bool _isHigh;
    private string? _previewSrc;
    private string? _cachedPath;

    protected override async Task OnParametersSetAsync()
    {
        _isHigh = Lora.HasHighPath || !Lora.HasLowPath;

        if (Lora.Path != _cachedPath)
        {
            _cachedPath = Lora.Path;
            _previewSrc = await LoadPreviewAsync(Lora.Path);
        }
    }

    private async Task<string?> LoadPreviewAsync(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return null;
        var resource = await ResourceCache.FindByFilenameAsync(path);
        if (resource == null) return null;
        var img = IO.GetResourceImagePath(resource.Type?.Name ?? "LORA", path);
        return string.IsNullOrEmpty(img) ? null : img;
    }

    private async Task TogglePath()
    {
        var path = Lora.Path;
        if (_isHigh)
        {
            Lora.LowPath = path;
            Lora.HighPath = null;
            _isHigh = false;
        }
        else
        {
            Lora.HighPath = path;
            Lora.LowPath = null;
            _isHigh = true;
        }
        await NotifyLoraChanged();
    }

    private async Task OnStrengthChanged(float value)
    {
        Lora.Strength = value;
        await NotifyLoraChanged();
    }

    private async Task OnIsNegativeChanged(bool value)
    {
        Lora.IsNegative = value;
        await NotifyLoraChanged();
    }

    private async Task OnIsEnabledChanged(bool value)
    {
        Lora.IsEnabled = value;
        await NotifyLoraChanged();
    }

    private async Task NotifyLoraChanged()
    {
        await OnLoraChanged.InvokeAsync(Lora);
    }
}
