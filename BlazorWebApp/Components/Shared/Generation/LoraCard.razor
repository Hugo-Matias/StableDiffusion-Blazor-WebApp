@inject IResourceCacheService ResourceCache
@inject IIOService IO
@inject ISettingsService Settings

<div class="@(_previewSrc != null ? "lora-card lora-card--banner" : "lora-card")">
    @if (_previewSrc != null)
    {
        <img class="lora-card-bg" src="@_previewSrc" loading="lazy" />
    }
    <div class="lora-card-body">
        <div class="lora-card-name">
            <MudText Typo="Typo.caption" Class="lora-name-text">@(_displayName ?? Lora.Name)</MudText>
        </div>
        <div class="lora-card-controls">
            <MudNumericField Value="Lora.Strength" ValueChanged="@(async (float v) => await OnStrengthChanged(v))"
                             Variant="Variant.Text" Min="Settings.Settings.Generation.Shared.LoraWeight.Min"
                             Max="Settings.Settings.Generation.Shared.LoraWeight.Max"
                             Step="Settings.Settings.Generation.Shared.LoraWeight.Step" Format="N2" Margin="Margin.Dense"
                             Style="width:38px;margin:0 4px;" />
            @if (IsDualModel)
            {
                <button class="lora-hl-btn @TargetClass" @onclick="TogglePath" title="@TargetTitle">
                    @TargetLabel
                </button>
            }
            <MudToggleIconButton Toggled="Lora.IsNegative"
                                 ToggledChanged="@(async (bool v) => await OnIsNegativeChanged(v))" Icon="fa-solid fa-circle-plus"
                                 Color="@Color.Success" ToggledIcon="fa-solid fa-circle-minus" ToggledColor="@Color.Error"
                                 Size="Size.Small" Title="@(Lora.IsNegative ? "Negative Prompt" : "Prompt")" />
            <MudCheckBox Checked="Lora.IsEnabled" CheckedChanged="@(async (bool v) => await OnIsEnabledChanged(v))"
                         Title="Toggle Activation" Dense="true" />
            <MudIconButton Icon="fa-solid fa-xmark" OnClick="async () => await OnRemoveLora.InvokeAsync(Lora)"
                           Color="Color.Error" Size="Size.Small" Title="Remove" />
        </div>
    </div>
</div>

@code {
    [Parameter] public Lora Lora { get; set; }
    [Parameter] public bool IsDualModel { get; set; }
    [Parameter] public string HighTargetLabel { get; set; } = "H";
    [Parameter] public string LowTargetLabel { get; set; } = "L";
    [Parameter] public string BothTargetLabel { get; set; } = "Both";
    [Parameter] public EventCallback<Lora> OnRemoveLora { get; set; }
    [Parameter] public EventCallback<Lora> OnLoraChanged { get; set; }

    private LoraTarget _target = LoraTarget.High;
    private string? _previewSrc;
    private string? _displayName;
    private string? _cachedPath;

    private string TargetClass => _target switch
    {
        LoraTarget.Both => "lora-hl-btn--both",
        LoraTarget.Low => "lora-hl-btn--low",
        _ => "lora-hl-btn--high"
    };

    private string TargetLabel => _target switch
    {
        LoraTarget.Both => BothTargetLabel,
        LoraTarget.Low => LowTargetLabel,
        _ => HighTargetLabel
    };

    private string TargetTitle => _target switch
    {
        LoraTarget.Both => $"Assigned to {HighTargetLabel} and {LowTargetLabel}",
        LoraTarget.Low => $"Assigned to {LowTargetLabel}",
        _ => $"Assigned to {HighTargetLabel}"
    };

    protected override async Task OnParametersSetAsync()
    {
        _target = GetTarget();

        if (Lora.Path != _cachedPath)
        {
            _cachedPath = Lora.Path;
            var metadata = await LoadMetadataAsync(Lora.Path);
            _previewSrc = metadata.PreviewSrc;
            _displayName = metadata.DisplayName;
        }
    }

    private async Task<(string? PreviewSrc, string? DisplayName)> LoadMetadataAsync(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return (null, null);
        var resource = await ResourceCache.FindByFilenameAsync(path);
        if (resource == null) return (null, null);
        var img = IO.GetResourceImagePath(resource.Type?.Name ?? "LORA", path);
        var displayName = await ResolveDisplayName(resource, path);
        return (string.IsNullOrEmpty(img) ? null : img, displayName);
    }

    private async Task<string?> ResolveDisplayName(Resource resource, string path)
    {
        var title = resource.Title ?? string.Empty;
        if (string.IsNullOrWhiteSpace(title)) return null;

        var resources = await ResourceCache.GetCachedResourcesAsync();
        var hasSiblingResources = resources.Any(candidate =>
            candidate.Id != resource.Id &&
            string.Equals(candidate.Title, title, StringComparison.OrdinalIgnoreCase));

        if (hasSiblingResources)
        {
            var versionLabel = ResolveVersionLabel(resource, path, title);
            if (!string.IsNullOrWhiteSpace(versionLabel)) return $"{title} - {versionLabel}";
        }

        return title;
    }

    private static string? ResolveVersionLabel(Resource resource, string path, string title)
    {
        if (!string.IsNullOrWhiteSpace(resource.VersionName)) return resource.VersionName;

        var filename = string.IsNullOrWhiteSpace(resource.Filename) ? path : resource.Filename;
        var stem = Path.GetFileNameWithoutExtension(filename);
        if (!string.IsNullOrWhiteSpace(stem) && !stem.Equals(title, StringComparison.OrdinalIgnoreCase)) return stem;

        return resource.CivitaiModelVersionId.HasValue ? $"Version {resource.CivitaiModelVersionId.Value}" : null;
    }

    private async Task TogglePath()
    {
        var path = ResolvePath();
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        if (_target == LoraTarget.High)
        {
            Lora.LowPath = path;
            Lora.HighPath = null;
            _target = LoraTarget.Low;
        }
        else if (_target == LoraTarget.Low)
        {
            Lora.HighPath = path;
            Lora.LowPath = path;
            _target = LoraTarget.Both;
        }
        else
        {
            Lora.HighPath = path;
            Lora.LowPath = null;
            _target = LoraTarget.High;
        }
        await NotifyLoraChanged();
    }

    private LoraTarget GetTarget()
    {
        if (Lora.HasHighPath && Lora.HasLowPath)
        {
            return LoraTarget.Both;
        }

        return Lora.HasLowPath ? LoraTarget.Low : LoraTarget.High;
    }

    private string? ResolvePath()
    {
        if (!string.IsNullOrWhiteSpace(Lora.Path))
        {
            return Lora.Path;
        }

        if (!string.IsNullOrWhiteSpace(Lora.HighPath))
        {
            return Lora.HighPath;
        }

        return Lora.LowPath;
    }

    private async Task OnStrengthChanged(float value)
    {
        Lora.Strength = value;
        await NotifyLoraChanged();
    }

    private async Task OnIsNegativeChanged(bool value)
    {
        Lora.IsNegative = value;
        await NotifyLoraChanged();
    }

    private async Task OnIsEnabledChanged(bool value)
    {
        Lora.IsEnabled = value;
        await NotifyLoraChanged();
    }

    private async Task NotifyLoraChanged()
    {
        await OnLoraChanged.InvokeAsync(Lora);
    }

    private enum LoraTarget
    {
        High,
        Low,
        Both
    }
}
