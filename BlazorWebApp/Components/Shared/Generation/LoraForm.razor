@using static BlazorWebApp.Data.Enums
@using BlazorWebApp.Events
@inject IRouterService Router
@inject IOrchestratorService M
@inject IResourceFilterService ResourceFilter
@inject IResourceFilterStateService FilterState
@inject IEventService Events
@implements IDisposable

<MudText Typo="Typo.caption" Class="mb-1">Loras</MudText>
<MudAutocomplete T="string" @bind-Value=_lora Label="Search..." SearchFunc="SearchLoras" Adornment="Adornment.End"
                 AdornmentIcon="fa-solid fa-plus" OnAdornmentClick="AddLora" MaxItems="null" MaxHeight="600" CoerceValue="true"
                 CoerceText="true" ResetValueOnEmptyText="true" Clearable="true" SelectOnClick="false"
                 ToStringFunc="@(s => string.IsNullOrWhiteSpace(s) ? string.Empty : s.Substring(0, s.LastIndexOf('.')))" />
@if (Loras != null && Loras.Count > 0)
{
    <div class="loras-panels-flush">
        @if (Loras.Count(l => l.IsEnabled) > 0)
        {
            <MudExpansionPanel Text=@($"Enabled Loras ({Loras.Count(l => l.IsEnabled)})") @bind-IsExpanded=_isEnabledExpanded
                               Style="background-color: transparent; background-image: none; box-shadow: none; border-radius: 0; border-bottom: 1px solid var(--mud-palette-divider);">
                @foreach (var lora in Loras.Where(l => l.IsEnabled))
                {
                    <LoraCard Lora="lora" IsDualModel="IsDualModel" OnRemoveLora="RemoveLora" OnLoraChanged="UpdateLora" />
                }
            </MudExpansionPanel>
        }
        @if (Loras.Count(l => !l.IsEnabled) > 0)
        {
            <MudExpansionPanel Text=@($"Disabled Loras ({Loras.Count(l => !l.IsEnabled)})") @bind-IsExpanded=_isDisabledExpanded
                               Style="background-color: transparent; background-image: none; box-shadow: none; border-radius: 0; border-bottom: 1px solid var(--mud-palette-divider);">
                @foreach (var lora in Loras.Where(l => !l.IsEnabled))
                {
                    <LoraCard Lora="lora" IsDualModel="IsDualModel" OnRemoveLora="RemoveLora" OnLoraChanged="UpdateLora" />
                }
            </MudExpansionPanel>
        }
    </div>
}
@code {
    [Parameter]
    public Backend Backend { get; set; }
    [Parameter]
    public List<Lora> Loras { get; set; }
    [Parameter]
    public bool IsDualModel { get; set; }
    [Parameter]
    public EventCallback OnLorasUpdated { get; set; }

    private string _lora;
    private bool _isEnabledExpanded = true;
    private bool _isDisabledExpanded = false;

    override protected void OnInitialized()
    {
        if (Loras == null) Loras = new List<Lora>();
        Events.Subscribe<ResourceFilterChangedEventArgs>(OnFilterChanged);
        Events.Subscribe<ResourcesChangedEventArgs>(OnResourcesChanged);
    }

    public async Task<IEnumerable<string>> SearchLoras(string search)
    {
        var results = await Router.SearchLoras(Backend, search);
        var resultList = results.ToList();

        var workflow = M.GetCurrentWorkflow();
        if (workflow == null)
            return resultList;

        await FilterState.EnsureInitializedForWorkflowAsync(workflow);
        var effectiveBaseModels = FilterState.GetEffectiveBaseModels();

        if (effectiveBaseModels == null)
            return await ResourceFilter.FilterLorasByWorkflowAsync(resultList, workflow, includeUntracked:
FilterState.IncludeUntracked);

        return await ResourceFilter.FilterByBaseModelsAsync(resultList, effectiveBaseModels, includeUntracked:
FilterState.IncludeUntracked);
    }

    public async Task AddLora()
    {
        if (string.IsNullOrWhiteSpace(_lora)) return;

        var name = Path.GetFileNameWithoutExtension(_lora);
        var path = _lora;

        Loras.Add(new()
        {
            Name = name,
            Path = path,
            IsNegative = false,
            Strength = 1,
            IsEnabled = true,
            HighPath = IsDualModel ? path : null
        });

        await OnLorasUpdated.InvokeAsync();
    }

    public async Task RemoveLora(Lora lora)
    {
        Loras.Remove(lora);
        await OnLorasUpdated.InvokeAsync();
    }

    public async Task UpdateLora(Lora lora)
    {
        await OnLorasUpdated.InvokeAsync();
    }

    private void OnFilterChanged(ResourceFilterChangedEventArgs args)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnResourcesChanged(ResourcesChangedEventArgs args)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Events.Unsubscribe<ResourceFilterChangedEventArgs>(OnFilterChanged);
        Events.Unsubscribe<ResourcesChangedEventArgs>(OnResourcesChanged);
    }
}