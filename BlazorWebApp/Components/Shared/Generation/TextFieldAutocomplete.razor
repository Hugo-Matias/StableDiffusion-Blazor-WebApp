@using System.Text.RegularExpressions
@inject CsvService CsvService
@inject ICacheService CacheService
@inject IWildcardService WildcardService
@inject IDatabaseService DatabaseService
@inject IJSRuntime JS
@inject ILogger<TextFieldAutocomplete> Logger
@implements IAsyncDisposable

<div class="prompt-autocomplete-wrapper" @ref="_wrapperRef">
    <MudTextField @ref="_textFieldRef"
                  Class="@Class"
                  Lines="@Lines"
                  Label="@Label"
                  Value="@Value"
                  ValueChanged="@HandleValueChanged"
                  OnAdornmentClick="@OnAdornmentClick"
                  Adornment="@Adornment"
                  AdornmentIcon="@AdornmentIcon"
                  T="string"
                  Clearable="@Clearable"
                  Immediate="@Immediate"
                  Disabled="@Disabled" />

    @if (_showSuggestions && (_tagSuggestions.Any() || _wordSuggestions.Any()))
    {
        <MudPaper Class="autocomplete-dropdown" Elevation="8" Style="@GetDropdownStyle()">
            <MudList Clickable Dense>
                <!-- Tag Suggestions Section -->
                @if (_tagSuggestions.Any())
                {
                    @if (_wordSuggestions.Any())
                    {
                        <MudListSubheader>
                            <MudText Typo="Typo.caption" Style="opacity:0.6;">
                                <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" /> Tags
                            </MudText>
                        </MudListSubheader>
                    }

                    @for (int i = 0; i < _tagSuggestions.Count; i++)
                    {
                        var index = i;
                        var tag = _tagSuggestions[i];
                        var isSelected = index == _selectedIndex && _selectedSection == SuggestionSection.Tags;

                        <MudListItem Class="@(isSelected ? "selected-suggestion" : "")"
                                     OnClick="() => SelectTag(tag)"
                                     Style="@(isSelected ? "background-color: var(--mud-palette-action-default-hover);" : "")">
                            <MudText Typo="Typo.body2" Style="font-family:'FiraCode NF';" Color="@GetTagColor(tag.Color)">
                                @if (tag.IsRecentlyUsed)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Style="opacity:0.6; margin-right: 4px;" />
                                }
                                <strong>@GetHighlightedText(tag.Name)</strong>
                                @if (!tag.Name.Contains(_currentWord, StringComparison.InvariantCultureIgnoreCase) && !string.IsNullOrEmpty(tag.Aliases))
                                {
                                    <small style="opacity:0.5;"> → @GetMatchingAlias(tag)</small>
                                }
                            </MudText>
                            <MudText Typo="Typo.caption" Style="opacity:0.4; margin-left: auto; display: flex; align-items: center; gap: 8px;">
                                @if (tag.LocalUses > 0)
                                {
                                    <span style="color: var(--mud-palette-success);">Uses: @tag.LocalUses</span>
                                }
                                @if (!string.IsNullOrEmpty(tag.Source))
                                {
                                    <span style="opacity:0.3;">[@tag.Source]</span>
                                }
                            </MudText>
                        </MudListItem>
                    }
                }

                <!-- Dictionary Words Section -->
                @if (_wordSuggestions.Any())
                {
                    @if (_tagSuggestions.Any())
                    {
                        <MudDivider Class="my-2" />
                        <MudListSubheader>
                            <MudText Typo="Typo.caption" Style="opacity:0.6;">
                                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" /> Dictionaries
                            </MudText>
                        </MudListSubheader>
                    }

                    @for (int i = 0; i < _wordSuggestions.Count; i++)
                    {
                        var index = i;
                        var word = _wordSuggestions[i];
                        var isSelected = index == _selectedIndex && _selectedSection == SuggestionSection.Words;

                        <MudListItem Class="@(isSelected ? "selected-suggestion" : "")"
                                     OnClick="() => SelectWord(word.Word)"
                                     Style="@(isSelected ? "background-color: var(--mud-palette-action-default-hover);" : "")">
                            <MudText Typo="Typo.body2" Style="font-family:'FiraCode NF';" Color="Color.Info">
                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Style="opacity:0.6;" />
                                @GetHighlightedText(word.Word)
                            </MudText>
                            @if (!string.IsNullOrEmpty(word.Source))
                            {
                                <MudText Typo="Typo.caption" Style="opacity:0.3; margin-left: auto;">
                                    [@word.Source]
                                </MudText>
                            }
                        </MudListItem>
                    }
                }
            </MudList>

            <MudDivider />
            <MudText Typo="Typo.caption" Class="px-3 py-1" Style="opacity:0.3;">
                <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" />
                <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" /> navigate •
                <MudIcon Icon="@Icons.Material.Filled.KeyboardTab" Size="Size.Small" />
                <MudIcon Icon="@Icons.Material.Filled.KeyboardReturn" Size="Size.Small" /> select •
                <strong>Esc</strong> close
            </MudText>
        </MudPaper>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Prompt";
    [Parameter] public int Lines { get; set; } = 4;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public Adornment Adornment { get; set; } = Adornment.End;
    [Parameter] public string AdornmentIcon { get; set; } = "";
    [Parameter] public EventCallback OnAdornmentClick { get; set; }
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Immediate { get; set; } = true;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public int MinCharsToTrigger { get; set; } = 2;
    [Parameter] public int MaxSuggestions { get; set; } = 8;
    [Parameter] public char TriggerChar { get; set; } = '\0';
    [Parameter] public bool EnableFuzzyMatching { get; set; } = true;
    [Parameter] public bool EnableDictionary { get; set; } = true;
    [Parameter] public bool EnableAutocomplete { get; set; } = true;
    [Parameter] public bool IsNegative { get; set; } = false;

    // Phase 4: Event callbacks for non-prompt triggers (LoRA/Style selection)
    [Parameter] public EventCallback<Lora> OnLoraSelected { get; set; }
    [Parameter] public EventCallback<PromptStyle> OnStyleSelected { get; set; }

    private MudTextField<string> _textFieldRef;
    private ElementReference _wrapperRef;
    
    // Existing suggestion lists (Tags/Dictionary)
    private List<Tag> _tagSuggestions = new();
    private List<DictionaryWord> _wordSuggestions = new();
    
    // Phase 4: Wildcard suggestion lists
    private List<string> _wildcardCategorySuggestions = new();
    private List<WildcardCollection> _wildcardCollectionSuggestions = new();
    
    // Phase 4: LoRA and Style suggestion lists
    private List<LocalResource> _loraSuggestions = new();
    private List<PromptStyle> _styleSuggestions = new();
    
    private bool _showSuggestions = false;
    private int _selectedIndex = 0;
    private SuggestionSection _selectedSection = SuggestionSection.Tags;
    
    // Phase 4: Current autocomplete mode (determines which search/UI path to use)
    private AutocompleteMode _currentMode = AutocompleteMode.Tags;
    
    // Phase 4: Wildcard navigation context for hierarchical selection
    private WildcardContext? _wildcardContext;
    
    private string _currentWord = string.Empty;
    private int _cursorPosition = 0;
    private System.Timers.Timer _debounceTimer;
    private const int DebounceDelay = 100;
    private DotNetObjectReference<TextFieldAutocomplete> _dotNetRef;
    private IJSObjectReference _jsModule;
    private bool _isSelectingSuggestion = false;

    // Existing section enum for Tags/Words keyboard navigation
    private enum SuggestionSection { Tags, Words }

    /// <summary>
    /// Autocomplete mode determines which trigger is active and which search/UI path to use.
    /// Priority order: Wildcards > LoRA > Style > Tags (forced) > Tags (default)
    /// </summary>
    private enum AutocompleteMode
    {
        None,                   // No trigger detected, autocomplete disabled
        Tags,                   // Default or # trigger (tag/dictionary search)
        WildcardCategory,       // _ trigger (searching categories)
        WildcardCollection,     // __category/ (searching collections within category)
        Lora,                   // < trigger (LoRA search, adds to list)
        Style                   // @ trigger (Style search, adds to list)
    }

    /// <summary>
    /// State machine for wildcard hierarchical navigation.
    /// Tracks whether user is selecting category or collection.
    /// </summary>
    private enum WildcardState
    {
        SearchingCategories,     // After "_" or "_c" - show/filter categories
        SearchingCollections,    // After "__category/" - show/filter collections
        Complete                 // After "__category/collection__ " - selection finished
    }

    /// <summary>
    /// Context for wildcard navigation, maintains state between category and collection selection.
    /// </summary>
    private class WildcardContext
    {
        /// <summary>Current state in the wildcard selection flow</summary>
        public WildcardState State { get; set; }
        
        /// <summary>Category selected in first step (e.g., "clothing")</summary>
        public string? SelectedCategory { get; set; }
        
        /// <summary>Position where the trigger started (for text replacement)</summary>
        public int TriggerStartPosition { get; set; }
        
        /// <summary>Current search/filter query within the mode</summary>
        public string SearchQuery { get; set; } = "";
    }

    /// <summary>
    /// Detects which autocomplete mode should be active based on text before cursor.
    /// Priority order: Wildcards > LoRA > Style > Tag Force > Tags (default)
    /// </summary>
    private AutocompleteMode DetectAutocompleteMode(string textBeforeCursor)
    {
        if (string.IsNullOrEmpty(textBeforeCursor))
        {
            _wildcardContext = null;
            return AutocompleteMode.Tags;
        }

        // 1. Wildcard detection (highest priority due to complexity)
        // Find the last underscore that could be a trigger
        var lastUnderscore = textBeforeCursor.LastIndexOf('_');
        if (lastUnderscore >= 0)
        {
            var afterUnderscore = textBeforeCursor.Substring(lastUnderscore);
            
            // Pattern: __category/ (collection search) - check this first as it's more specific
            var categoryCollectionMatch = Regex.Match(afterUnderscore, @"^__([a-zA-Z0-9\-_]+)/([a-zA-Z0-9\-_]*)$");
            if (categoryCollectionMatch.Success)
            {
                _wildcardContext = new WildcardContext
                {
                    State = WildcardState.SearchingCollections,
                    SelectedCategory = categoryCollectionMatch.Groups[1].Value,
                    TriggerStartPosition = lastUnderscore,
                    SearchQuery = categoryCollectionMatch.Groups[2].Value
                };
                return AutocompleteMode.WildcardCollection;
            }
            
            // Pattern: Single _ at word boundary (category search)
            // Must be at start of text or preceded by space/comma/newline
            var charBeforeUnderscore = lastUnderscore > 0 ? textBeforeCursor[lastUnderscore - 1] : ' ';
            if (charBeforeUnderscore == ' ' || charBeforeUnderscore == ',' || charBeforeUnderscore == '\n' || lastUnderscore == 0)
            {
                // Check if it's a single underscore followed by valid category chars (no second underscore yet)
                if (Regex.IsMatch(afterUnderscore, @"^_[a-zA-Z0-9\-]*$") && !afterUnderscore.StartsWith("__"))
                {
                    _wildcardContext = new WildcardContext
                    {
                        State = WildcardState.SearchingCategories,
                        TriggerStartPosition = lastUnderscore,
                        SearchQuery = afterUnderscore.Substring(1) // Remove the leading "_"
                    };
                    return AutocompleteMode.WildcardCategory;
                }
            }
        }
        
        // Reset wildcard context if no wildcard pattern matched
        _wildcardContext = null;
        
        // 2. LoRA trigger '<'
        var lastLt = textBeforeCursor.LastIndexOf('<');
        if (lastLt >= 0)
        {
            var afterLt = textBeforeCursor.Substring(lastLt + 1);
            // Valid if no delimiter (comma/newline) between trigger and cursor
            // Also check it's not inside a completed LoRA tag (no '>')
            if (!afterLt.Contains(',') && !afterLt.Contains('\n') && !afterLt.Contains('>'))
            {
                return AutocompleteMode.Lora;
            }
        }
        
        // 3. Style trigger '@'
        var lastAt = textBeforeCursor.LastIndexOf('@');
        if (lastAt >= 0)
        {
            var afterAt = textBeforeCursor.Substring(lastAt + 1);
            // Valid if no delimiter between trigger and cursor
            if (!afterAt.Contains(',') && !afterAt.Contains('\n'))
            {
                return AutocompleteMode.Style;
            }
        }
        
        // 4. Tag force trigger '#' - allows searching for tags with special chars
        var lastHash = textBeforeCursor.LastIndexOf('#');
        if (lastHash >= 0)
        {
            var afterHash = textBeforeCursor.Substring(lastHash + 1);
            // Valid if no delimiter between trigger and cursor
            if (!afterHash.Contains(',') && !afterHash.Contains('\n'))
            {
                // For forced tag search, we'll use the text after # as the search query
                return AutocompleteMode.Tags;
            }
        }
        
        // 5. Default: existing tag/dictionary behavior
        return AutocompleteMode.Tags;
    }

    /// <summary>
    /// Gets the search query for the current mode based on trigger position.
    /// </summary>
    private string GetSearchQueryForMode(string textBeforeCursor, AutocompleteMode mode)
    {
        switch (mode)
        {
            case AutocompleteMode.WildcardCategory:
            case AutocompleteMode.WildcardCollection:
                return _wildcardContext?.SearchQuery ?? "";
                
            case AutocompleteMode.Lora:
                var lastLt = textBeforeCursor.LastIndexOf('<');
                return lastLt >= 0 ? textBeforeCursor.Substring(lastLt + 1) : "";
                
            case AutocompleteMode.Style:
                var lastAt = textBeforeCursor.LastIndexOf('@');
                return lastAt >= 0 ? textBeforeCursor.Substring(lastAt + 1) : "";
                
            case AutocompleteMode.Tags:
                // Check for # trigger first
                var lastHash = textBeforeCursor.LastIndexOf('#');
                if (lastHash >= 0)
                {
                    var afterHash = textBeforeCursor.Substring(lastHash + 1);
                    if (!afterHash.Contains(',') && !afterHash.Contains('\n'))
                    {
                        return afterHash;
                    }
                }
                // Fall back to word at cursor
                return _currentWord;
                
            default:
                return "";
        }
    }

    /// <summary>
    /// Clears all suggestion lists across all modes.
    /// </summary>
    private void ClearAllSuggestions()
    {
        _tagSuggestions.Clear();
        _wordSuggestions.Clear();
        _wildcardCategorySuggestions.Clear();
        _wildcardCollectionSuggestions.Clear();
        _loraSuggestions.Clear();
        _styleSuggestions.Clear();
    }

    /// <summary>
    /// Checks if any suggestions exist for the current mode.
    /// </summary>
    private bool HasAnySuggestions()
    {
        return _currentMode switch
        {
            AutocompleteMode.WildcardCategory => _wildcardCategorySuggestions.Any(),
            AutocompleteMode.WildcardCollection => _wildcardCollectionSuggestions.Any(),
            AutocompleteMode.Lora => _loraSuggestions.Any(),
            AutocompleteMode.Style => _styleSuggestions.Any(),
            AutocompleteMode.Tags => _tagSuggestions.Any() || _wordSuggestions.Any(),
            _ => false
        };
    }

    protected override void OnInitialized()
    {
        _debounceTimer = new System.Timers.Timer(DebounceDelay);
        _debounceTimer.Elapsed += async (sender, e) => await SearchSuggestions();
        _debounceTimer.AutoReset = false;
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/Input.js");
                await _jsModule.InvokeVoidAsync("initializeAutocomplete", _wrapperRef, _dotNetRef);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error initializing autocomplete");
            }
        }
    }

    [JSInvokable]
    public void OnCursorPositionChanged(int position)
    {
        _cursorPosition = position;
        
        if (EnableAutocomplete)
        {
            _debounceTimer.Stop();
            _debounceTimer.Start();
        }
    }

    private async Task HandleValueChanged(string newValue)
    {
        if (_isSelectingSuggestion)
        {
            _isSelectingSuggestion = false;
            Value = newValue;
            await ValueChanged.InvokeAsync(Value);
            return;
        }

        Value = newValue;
        await ValueChanged.InvokeAsync(Value);

        _cursorPosition = await GetCursorPosition();

        if (EnableAutocomplete)
        {
            _debounceTimer.Stop();
            _debounceTimer.Start();
        }
    }

    private async Task SearchSuggestions()
    {
        await InvokeAsync(async () =>
        {
            // Clear all suggestion lists across all modes
            ClearAllSuggestions();

            // Don't show suggestions if autocomplete is disabled
            if (!EnableAutocomplete)
            {
                _showSuggestions = false;
                StateHasChanged();
                return;
            }

            if (string.IsNullOrWhiteSpace(Value))
            {
                _showSuggestions = false;
                _currentMode = AutocompleteMode.Tags;
                _wildcardContext = null;
                StateHasChanged();
                return;
            }
            
            // Get text before cursor for mode detection
            var textBeforeCursor = Value.Substring(0, Math.Min(_cursorPosition, Value.Length));
            
            // Detect which autocomplete mode should be active
            _currentMode = DetectAutocompleteMode(textBeforeCursor);
            
            // Get the current word for default tag searches
            _currentWord = GetWordAtCursor(Value, _cursorPosition);

            // Route to appropriate search method based on mode
            switch (_currentMode)
            {
                case AutocompleteMode.WildcardCategory:
                    await SearchWildcardCategories();
                    break;
                    
                case AutocompleteMode.WildcardCollection:
                    await SearchWildcardCollections();
                    break;
                    
                case AutocompleteMode.Lora:
                    await SearchLoras(GetSearchQueryForMode(textBeforeCursor, _currentMode));
                    break;
                    
                case AutocompleteMode.Style:
                    await SearchStyles(GetSearchQueryForMode(textBeforeCursor, _currentMode));
                    break;
                    
                case AutocompleteMode.Tags:
                default:
                    await SearchTagsAndDictionary();
                    break;
            }

            // Update visibility based on whether we have any suggestions
            _showSuggestions = HasAnySuggestions();
            _selectedIndex = 0;
            
            // Reset section for tag mode
            if (_currentMode == AutocompleteMode.Tags)
            {
                _selectedSection = _tagSuggestions.Any() ? SuggestionSection.Tags : SuggestionSection.Words;
            }

            StateHasChanged();
        });
    }

    /// <summary>
    /// Search for tags and dictionary words (existing behavior).
    /// </summary>
    private async Task SearchTagsAndDictionary()
    {
        if (!ShouldTriggerAutocomplete(_currentWord))
            return;

        // Search tags with fuzzy matching
        var tagResults = await CsvService.SearchTags(_currentWord, EnableFuzzyMatching);
        _tagSuggestions = tagResults.Take(MaxSuggestions).ToList();

        // Search dictionary words if enabled
        if (EnableDictionary && _currentWord.Length >= 3)
        {
            // For negative prompts, only search the Negative theme
            if (IsNegative)
            {
                _wordSuggestions = CacheService.SearchDictionaryThemes(
                    _currentWord, 
                    new[] { DictionaryTheme.Negative }, 
                    5
                );
            }
            else
            {
                // For positive prompts, exclude Negative theme
                _wordSuggestions = CacheService.SearchDictionaries(
                    _currentWord, 
                    5, 
                    DictionaryTheme.Negative
                );
            }
        }
    }

    /// <summary>
    /// Search for wildcard categories.
    /// </summary>
    private async Task SearchWildcardCategories()
    {
        if (_wildcardContext == null) return;
        
        try
        {
            var allCategories = await WildcardService.GetCategories();
            
            // Filter by search query if provided
            if (!string.IsNullOrWhiteSpace(_wildcardContext.SearchQuery))
            {
                allCategories = allCategories
                    .Where(c => c.StartsWith(_wildcardContext.SearchQuery, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
            
            _wildcardCategorySuggestions = allCategories.Take(MaxSuggestions).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error searching wildcard categories");
            _wildcardCategorySuggestions.Clear();
        }
    }

    /// <summary>
    /// Search for wildcard collections within the selected category.
    /// </summary>
    private async Task SearchWildcardCollections()
    {
        if (_wildcardContext == null || string.IsNullOrEmpty(_wildcardContext.SelectedCategory))
            return;
        
        try
        {
            var collections = await WildcardService.GetCollectionsByCategory(_wildcardContext.SelectedCategory);
            
            // Filter by search query if provided
            if (!string.IsNullOrWhiteSpace(_wildcardContext.SearchQuery))
            {
                collections = collections
                    .Where(c => c.Name.StartsWith(_wildcardContext.SearchQuery, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
            
            _wildcardCollectionSuggestions = collections.Take(MaxSuggestions).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error searching wildcard collections for category '{Category}'", _wildcardContext.SelectedCategory);
            _wildcardCollectionSuggestions.Clear();
        }
    }

    /// <summary>
    /// Search for LoRA resources.
    /// </summary>
    private async Task SearchLoras(string searchQuery)
    {
        try
        {
            // Get all resources and filter for LORA/LoCon types
            var allResources = await DatabaseService.GetResources();
            
            var loraResources = allResources
                .Where(r => r.Type != null && 
                           (r.Type.Name.Equals("LORA", StringComparison.OrdinalIgnoreCase) ||
                            r.Type.Name.Equals("LoCon", StringComparison.OrdinalIgnoreCase)) &&
                       r.IsEnabled); // Only show enabled LoRAs
            
            // Filter by search query if provided
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                loraResources = loraResources.Where(r => 
                    r.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    r.Filename.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (r.Tags != null && r.Tags.Any(t => t.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))));
            }
            
            // Convert to LocalResource and take max suggestions
            _loraSuggestions = loraResources
                .OrderBy(r => r.Title)
                .Take(MaxSuggestions)
                .Select(r => new LocalResource(r))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error searching LoRAs with query '{Query}'", searchQuery);
            _loraSuggestions.Clear();
        }
    }

    /// <summary>
    /// Search for prompt styles.
    /// </summary>
    private async Task SearchStyles(string searchQuery)
    {
        try
        {
            var allPrompts = await DatabaseService.GetPrompts();
            
            // Convert to PromptStyle and filter
            var styles = allPrompts
                .Select(p => new PromptStyle(p))
                .Where(s => !string.IsNullOrWhiteSpace(s.Prompt) || !string.IsNullOrWhiteSpace(s.NegativePrompt));
            
            // Filter by search query if provided
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                styles = styles.Where(s => s.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            }
            
            _styleSuggestions = styles.Take(MaxSuggestions).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error searching styles with query '{Query}'", searchQuery);
            _styleSuggestions.Clear();
        }
    }

    [JSInvokable]
    public async Task HandleKeyDownFromJS(string key)
    {
        if (!_showSuggestions) return;

        var totalTagsCount = _tagSuggestions.Count;
        var totalWordsCount = _wordSuggestions.Count;

        switch (key)
        {
            case "ArrowDown":
                if (_selectedSection == SuggestionSection.Tags && _selectedIndex < totalTagsCount - 1)
                {
                    _selectedIndex++;
                }
                else if (_selectedSection == SuggestionSection.Tags && totalWordsCount > 0)
                {
                    _selectedSection = SuggestionSection.Words;
                    _selectedIndex = 0;
                }
                else if (_selectedSection == SuggestionSection.Words && _selectedIndex < totalWordsCount - 1)
                {
                    _selectedIndex++;
                }
                await InvokeAsync(StateHasChanged);
                break;

            case "ArrowUp":
                if (_selectedIndex > 0)
                {
                    _selectedIndex--;
                }
                else if (_selectedSection == SuggestionSection.Words && totalTagsCount > 0)
                {
                    _selectedSection = SuggestionSection.Tags;
                    _selectedIndex = totalTagsCount - 1;
                }
                await InvokeAsync(StateHasChanged);
                break;

            case "Enter":
            case "Tab":
                if (_selectedSection == SuggestionSection.Tags && _tagSuggestions.Any())
                {
                    await InvokeAsync(async () => await SelectTag(_tagSuggestions[_selectedIndex]));
                }
                else if (_selectedSection == SuggestionSection.Words && _wordSuggestions.Any())
                {
                    await InvokeAsync(async () => await SelectWord(_wordSuggestions[_selectedIndex].Word));
                }
                break;

            case "Escape":
                _showSuggestions = false;
                await InvokeAsync(StateHasChanged);
                break;
        }
    }

    [JSInvokable]
    public bool IsDropdownVisible() => _showSuggestions;

    private async Task SelectTag(Tag tag)
    {
        await InsertSuggestion(tag.Name);
        CacheService.IncrementTagUsage(tag.Name);
    }

    private async Task SelectWord(string word)
    {
        await InsertSuggestion(word);
    }

    private async Task InsertSuggestion(string suggestion)
    {
        try
        {
            var (start, end) = GetWordBoundaries(Value, _cursorPosition);

            var beforeRaw = Value.Substring(0, start);
            var afterRaw = Value.Substring(end);

            var beforeTrimmed = beforeRaw.TrimEnd();
            var afterTrimmed = afterRaw.TrimStart();

            string prefix = "";
            if (beforeTrimmed.Length > 0)
            {
                prefix = beforeTrimmed.EndsWith(",") ? " " : ", ";
            }

            string suffix = "";
            if (afterTrimmed.Length > 0)
            {
                suffix = afterTrimmed.StartsWith(",") ? (afterTrimmed.StartsWith(", ") ? "" : " ") : ", ";
            }
            else
            {
                suffix = ", ";
            }

            var newValue = $"{beforeTrimmed}{prefix}{suggestion}{suffix}{afterTrimmed}";

            _showSuggestions = false;
            _isSelectingSuggestion = true;

            Value = newValue;
            await _textFieldRef.SetText(newValue);
            await ValueChanged.InvokeAsync(newValue);

            StateHasChanged();
            await Task.Delay(50);

            var newCursorPos = beforeTrimmed.Length + prefix.Length + suggestion.Length + suffix.Length;
            await SetCursorPosition(newCursorPos);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error inserting suggestion");
        }
    }

    private bool ShouldTriggerAutocomplete(string word)
    {
        if (string.IsNullOrWhiteSpace(word)) return false;
        if (word.Length < MinCharsToTrigger) return false;

        if (TriggerChar != '\0')
        {
            var beforeCursor = Value.Substring(0, Math.Min(_cursorPosition, Value.Length));
            var lastTrigger = beforeCursor.LastIndexOf(TriggerChar);
            if (lastTrigger == -1) return false;

            var afterTrigger = beforeCursor.Substring(lastTrigger + 1);
            if (afterTrigger.Contains(',')) return false;
        }

        return true;
    }

    private string GetWordAtCursor(string text, int position)
    {
        if (string.IsNullOrEmpty(text) || position < 0 || position > text.Length)
            return string.Empty;

        var (start, end) = GetWordBoundaries(text, position);
        return text.Substring(start, end - start).Trim();
    }

    private (int start, int end) GetWordBoundaries(string text, int position)
    {
        if (string.IsNullOrEmpty(text)) return (0, 0);

        position = Math.Min(position, text.Length);

        int start = position;
        while (start > 0 && text[start - 1] != ',' && text[start - 1] != '\n')
            start--;

        while (start < position && char.IsWhiteSpace(text[start]))
            start++;

        int end = position;
        while (end < text.Length && text[end] != ',' && text[end] != '\n')
            end++;

        return (start, end);
    }

    private MarkupString GetHighlightedText(string text)
    {
        if (string.IsNullOrWhiteSpace(_currentWord))
            return new MarkupString(text);

        var index = text.IndexOf(_currentWord, StringComparison.InvariantCultureIgnoreCase);
        if (index < 0)
            return new MarkupString(text);

        var before = text.Substring(0, index);
        var match = text.Substring(index, _currentWord.Length);
        var after = text.Substring(index + _currentWord.Length);

        return new MarkupString($"{before}<span style='background-color: var(--mud-palette-warning); color: var(--mud-palette-dark);'>{match}</span>{after}");
    }

    private string GetMatchingAlias(Tag tag) => Parser.ParseCsvTagAlias(tag.Aliases, _currentWord);

    private Color GetTagColor(int colorIndex) => Parser.ParseCsvTagColor(colorIndex);

    private string GetDropdownStyle() => "position: absolute; z-index: 1300; margin-top: 4px; max-width: 600px; min-width: 350px;";

    private async Task<int> GetCursorPosition()
    {
        try
        {
            return await JS.InvokeAsync<int>("getCaretPosition", _textFieldRef.InputReference);
        }
        catch
        {
            return Value?.Length ?? 0;
        }
    }

    private async Task SetCursorPosition(int position)
    {
        try
        {
            await JS.InvokeVoidAsync("setCaretPosition", _textFieldRef.InputReference, position);
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        _debounceTimer?.Dispose();
        _dotNetRef?.Dispose();

        if (_jsModule != null)
        {
            await _jsModule.DisposeAsync();
        }
    }
