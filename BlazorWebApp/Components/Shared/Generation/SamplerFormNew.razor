@inherits FragmentFormBase
@inject IBackendService Backend

@* New Sampler Form - uses FragmentSchema for binding *@

<MudGrid>
    <MudItem xs="6">
        <MudSelect T="string"
                   Value="@GetString("sampler_name")"
                   ValueChanged="@((string v) => SetValue("sampler_name", v))"
                   Label="Sampler"
                   AnchorOrigin="Origin.BottomLeft"
                   TransformOrigin="Origin.TopLeft">
            @if (Backend.Samplers != null)
            {
                @foreach (var sampler in Backend.Samplers)
                {
                    <MudSelectItem Value="@sampler.Name">@sampler.Name</MudSelectItem>
                }
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="6">
        <MudSelect T="string"
                   Value="@GetString("scheduler")"
                   ValueChanged="@((string v) => SetValue("scheduler", v))"
                   Label="Scheduler"
                   AnchorOrigin="Origin.BottomLeft"
                   TransformOrigin="Origin.TopLeft">
            @if (Backend.Schedulers != null)
            {
                @foreach (var scheduler in Backend.Schedulers)
                {
                    <MudSelectItem Value="@scheduler.Name">@scheduler.Name</MudSelectItem>
                }
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="6">
        <MudSlider T="int"
                   Value="@GetInt("steps", 20)"
                   ValueChanged="@((int v) => SetValue("steps", v))"
                   Min="@GetMinInt("steps", 1)"
                   Max="@GetMaxInt("steps", 150)"
                   Step="@GetStepInt("steps", 1)"
                   Variant="Variant.Filled"
                   ValueLabel="true">
            <small>Steps:</small> @GetInt("steps", 20)
        </MudSlider>
    </MudItem>
    <MudItem xs="6">
        <MudSlider T="double"
                   Value="@GetDouble("cfg", 7)"
                   ValueChanged="@((double v) => SetValue("cfg", v))"
                   Min="@GetMinDouble("cfg", 1)"
                   Max="@GetMaxDouble("cfg", 30)"
                   Step="@GetStepDouble("cfg", 0.5)"
                   Variant="Variant.Filled"
                   ValueLabel="true">
            <small>CFG:</small> @GetDouble("cfg", 7).ToString("F1")
        </MudSlider>
    </MudItem>
    <MudItem xs="6">
        <MudSlider T="double"
                   Value="@GetDouble("denoise", 1)"
                   ValueChanged="@((double v) => SetValue("denoise", v))"
                   Min="@GetMinDouble("denoise", 0)"
                   Max="@GetMaxDouble("denoise", 1)"
                   Step="@GetStepDouble("denoise", 0.01)"
                   Variant="Variant.Filled"
                   ValueLabel="true">
            <small>Denoise:</small> @GetDouble("denoise", 1).ToString("F2")
        </MudSlider>
    </MudItem>
    <MudItem xs="6">
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.End">
            <MudNumericField T="long"
                             Value="@GetLong("seed", -1)"
                             ValueChanged="@((long v) => SetValue("seed", v))"
                             Label="Seed"
                             Min="-1"
                             Style="flex-grow: 1;" />
            <MudIconButton Icon="@Icons.Material.Filled.Casino"
                           Size="Size.Small"
                           Title="Randomize"
                           OnClick="@(() => SetValue("seed", -1L))" />
        </MudStack>
    </MudItem>
</MudGrid>

