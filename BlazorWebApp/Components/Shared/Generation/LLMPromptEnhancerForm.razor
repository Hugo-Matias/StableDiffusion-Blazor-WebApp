@using BlazorWebApp.Data.Dtos.Ollama
@inject OllamaService OllamaAPI
@inject IStateService State
@inject ISettingsService Settings

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12">
            <MudSelect @bind-Value="_selectedModel"
                      Label="LLM Model"
                      Variant="Variant.Outlined"
                      AnchorOrigin="Origin.BottomLeft"
                      TransformOrigin="Origin.TopLeft">
                @if (_availableModels != null)
                {
                    foreach (var model in _availableModels)
                    {
                        <MudSelectItem Value="@model.Name">@model.Name</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="_currentPrompt"
                          Label="Simple Prompt"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Placeholder="e.g., beautiful woman, sunset, beach"
                          Immediate />
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="_currentInstructions"
                          Label="Instructions"
                          Variant="Variant.Outlined"
                          Lines="2"
                          HelperText="Use {prompt} as placeholder for the input prompt"
                          Immediate />
        </MudItem>

        <MudItem xs="6">
            <MudNumericField @bind-Value="State.State.Generation.LLM.Options.Seed"
                           Label="Seed"
                           Variant="Variant.Outlined"
                           Min="@Settings.Settings.Generation.Shared.LLMEnhancer.Seed.Min"
                           Max="@Settings.Settings.Generation.Shared.LLMEnhancer.Seed.Max"
                           Immediate />
        </MudItem>

        <MudItem xs="6" Class="d-flex align-center">
            <MudButtonGroup Variant="Variant.Filled" Color="Color.Primary">
                <MudButton OnClick="GeneratePrompt"
                          Disabled="_isGenerating"
                          StartIcon="@Icons.Material.Filled.AutoAwesome">
                    @(_isGenerating ? "Generating..." : "Enhance Prompt")
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Shuffle"
                              OnClick="RandomizeSeed"
                              Disabled="_isGenerating" />
            </MudButtonGroup>
        </MudItem>

        <MudItem xs="12">
            <MudExpansionPanel Text="Advanced Options">
                <MudGrid>
                    <MudItem xs="6">
                        <MudSlider @bind-Value="State.State.Generation.LLM.Options.Temperature"
                                   Min="@Settings.Settings.Generation.Shared.LLMEnhancer.Temperature.Min"
                                   Max="@Settings.Settings.Generation.Shared.LLMEnhancer.Temperature.Max"
                                   Step="@Settings.Settings.Generation.Shared.LLMEnhancer.Temperature.Step"
                                   Variant="Variant.Filled"
                                   ValueLabel><small>Temperature:</small> @State.State.Generation.LLM.Options.Temperature.ToString("F1")</MudSlider>
                    </MudItem>
                    <MudItem xs="6">
                        <MudSlider @bind-Value="State.State.Generation.LLM.Options.TopP"
                                   Min="@Settings.Settings.Generation.Shared.LLMEnhancer.TopP.Min"
                                   Max="@Settings.Settings.Generation.Shared.LLMEnhancer.TopP.Max"
                                   Step="@Settings.Settings.Generation.Shared.LLMEnhancer.TopP.Step"
                                   Variant="Variant.Filled"
                                   ValueLabel><small>Top P:</small> @State.State.Generation.LLM.Options.TopP.ToString("F2")</MudSlider>
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField @bind-Value="State.State.Generation.LLM.Options.TopK"
                                       Label="Top K"
                                       Variant="Variant.Outlined"
                                       Min="@Settings.Settings.Generation.Shared.LLMEnhancer.TopK.Min"
                                       Max="@Settings.Settings.Generation.Shared.LLMEnhancer.TopK.Max" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField @bind-Value="State.State.Generation.LLM.Options.NumPredict"
                                       Label="Max Tokens"
                                       Variant="Variant.Outlined"
                                       Min="@Settings.Settings.Generation.Shared.LLMEnhancer.NumPredict.Min"
                                       Max="@Settings.Settings.Generation.Shared.LLMEnhancer.NumPredict.Max" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField @bind-Value="State.State.Generation.LLM.Options.MinP"
                                       Label="Min P"
                                       Variant="Variant.Outlined"
                                       Min="@Settings.Settings.Generation.Shared.LLMEnhancer.MinP.Min"
                                       Max="@Settings.Settings.Generation.Shared.LLMEnhancer.MinP.Max"
                                       Step="@Settings.Settings.Generation.Shared.LLMEnhancer.MinP.Step"
                                       HelperText="Minimum probability threshold (optional)" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField @bind-Value="State.State.Generation.LLM.Options.NumCtx"
                                       Label="Context Length"
                                       Variant="Variant.Outlined"
                                       Min="@Settings.Settings.Generation.Shared.LLMEnhancer.NumCtx.Min"
                                       Max="@Settings.Settings.Generation.Shared.LLMEnhancer.NumCtx.Max"
                                       HelperText="Number of tokens in context (optional)" />
                    </MudItem>
                </MudGrid>
            </MudExpansionPanel>
        </MudItem>

        @{
            var enhancedPrompt = IsNegativePrompt 
                ? State.State.Generation.LLM.EnhancedNegativePrompt 
                : State.State.Generation.LLM.EnhancedPrompt;
        }

        @if (!string.IsNullOrEmpty(enhancedPrompt))
        {
            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudTextField @bind-Value="_currentEnhancedPrompt"
                              Label="Enhanced Prompt"
                              Variant="Variant.Filled"
                              Lines="20" />
            </MudItem>

            <MudItem xs="12">
                <MudButtonGroup Variant="Variant.Filled" Color="Color.Success">
                    <MudButton OnClick="ApplyToMainPrompt"
                              StartIcon="@Icons.Material.Filled.Check">
                        Apply to Main Prompt
                    </MudButton>
                    <MudButton OnClick="GeneratePrompt"
                              StartIcon="@Icons.Material.Filled.Refresh">
                        Regenerate
                    </MudButton>
                    <MudButton OnClick="ClearResult"
                              StartIcon="@Icons.Material.Filled.Clear"
                              Color="Color.Default">
                        Clear
                    </MudButton>
                </MudButtonGroup>
            </MudItem>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Error" Dense>@_errorMessage</MudAlert>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

@code {
    [Parameter]
    public EventCallback<string> OnPromptApplied { get; set; }

    [Parameter]
    public bool IsNegativePrompt { get; set; }

    private bool _isGenerating;
    private string? _errorMessage;
    private List<OllamaModel>? _availableModels;
    private string _selectedModel = string.Empty;

    private string _currentPrompt
    {
        get => IsNegativePrompt ? State.State.Generation.LLM.NegativePrompt : State.State.Generation.LLM.Prompt;
        set
        {
            if (IsNegativePrompt)
                State.State.Generation.LLM.NegativePrompt = value;
            else
                State.State.Generation.LLM.Prompt = value;
        }
    }

    private string _currentInstructions
    {
        get => IsNegativePrompt 
            ? (string.IsNullOrEmpty(State.State.Generation.LLM.NegativeInstructions) 
                ? Settings.Settings.Generation.Shared.LLMEnhancer.NegativeInstructions 
                : State.State.Generation.LLM.NegativeInstructions)
            : (string.IsNullOrEmpty(State.State.Generation.LLM.Instructions) 
                ? Settings.Settings.Generation.Shared.LLMEnhancer.Instructions 
                : State.State.Generation.LLM.Instructions);
        set
        {
            if (IsNegativePrompt)
                State.State.Generation.LLM.NegativeInstructions = value;
            else
                State.State.Generation.LLM.Instructions = value;
        }
    }

    private string _currentEnhancedPrompt
    {
        get => IsNegativePrompt ? State.State.Generation.LLM.EnhancedNegativePrompt : State.State.Generation.LLM.EnhancedPrompt;
        set
        {
            if (IsNegativePrompt)
                State.State.Generation.LLM.EnhancedNegativePrompt = value;
            else
                State.State.Generation.LLM.EnhancedPrompt = value;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadModels();
    }

    private async Task LoadModels()
    {
        try
        {
            _availableModels = await OllamaAPI.GetModels();
            if (_availableModels != null && _availableModels.Count > 0)
            {
                _selectedModel = Settings.Settings.Generation.Shared.LLMEnhancer.Model;
                if (!_availableModels.Any(m => m.Name == _selectedModel))
                {
                    _selectedModel = _availableModels[0].Name;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load models: {ex.Message}";
        }
    }

    private async Task GeneratePrompt()
    {
        if (string.IsNullOrWhiteSpace(_currentPrompt))
        {
            _errorMessage = "Please enter a prompt first.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedModel))
        {
            _errorMessage = "Please select an LLM model first.";
            return;
        }

        _isGenerating = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var enhancedPrompt = await OllamaAPI.ExpandPrompt(
                _currentPrompt,
                _selectedModel,
                IsNegativePrompt,
                State.State.Generation.LLM.Options.ToOllamaOptions());

            _currentEnhancedPrompt = enhancedPrompt;

            await State.SaveState();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error generating prompt: {ex.Message}";
        }
        finally
        {
            _isGenerating = false;
            StateHasChanged();
        }
    }

    private void RandomizeSeed()
    {
        State.State.Generation.LLM.Options.Seed = new Random().Next();
    }

    private async Task ApplyToMainPrompt()
    {
        if (!string.IsNullOrEmpty(_currentEnhancedPrompt))
        {
            await OnPromptApplied.InvokeAsync(_currentEnhancedPrompt);
        }
    }

    private async Task ClearResult()
    {
        _currentEnhancedPrompt = string.Empty;
        await State.SaveState();
    }
}