@using BlazorWebApp.Models
@using BlazorWebApp.Components.Shared.Image
@using BlazorWebApp.Components.Shared.Generation

@* Individual source input (image or video) - reuses ImageInput for images *@

<div class="source-item">
    @if (Source.Type?.ToLowerInvariant() == "video")
    {
        @* Video input - drag/drop with browser-side preview. Uploads bypass SignalR
           via fetch() to /api/upload-source so the page stays responsive. *@
        <VideoInput Filename="@Source.Filename" FilenameChanged="HandleVideoFilenameChanged" Title="@DisplayLabel"
                    VideoOptions="@Source.VideoOptions" VideoOptionsChanged="HandleVideoOptionsChanged"
                    DefaultVideoOptions="@SourceDefinition?.DefaultVideoOptions" MaxFileSizeMB="1024" />
    }
    else if (Source.Type?.ToLowerInvariant() == "audio")

    {
        @* Audio input - file upload only *@
        <MudText Typo="Typo.caption" Class="mb-1">@DisplayLabel</MudText>
        <MudFileUpload T="IBrowserFile" Accept=".wav,.mp3,.flac,.ogg,.m4a" FilesChanged="HandleAudioUpload" Class="mb-2">
            <ButtonTemplate>
                <MudButton HtmlTag="label" Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AudioFile" FullWidth="true" for="@context">
                    @(string.IsNullOrEmpty(Source.Filename) ? "Upload Audio" : Source.Filename)
                </MudButton>
            </ButtonTemplate>
        </MudFileUpload>

        @if (!string.IsNullOrEmpty(Source.Data))
        {
            <div class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.caption" Color="Color.Success">
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                    Audio loaded
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" Color="Color.Error"
                               OnClick="ClearSource" />
            </div>
        }
    }
    else
    {
        @* Image input - reuse ImageInput component for drag/drop, clipboard, and editor *@
        <ImageInput ImageData="@Source.Data" ImageDataChanged="HandleImageChanged" Title="@DisplayLabel"
                    OnImageLoaded="HandleImageLoaded" OnEditClicked="HandleEditClicked"
                    OnBlankCanvasClicked="HandleBlankCanvasClicked" MaxFileSizeMB="50" AutoResize="false" />
    }
</div>

@code {
    /// <summary>
    /// The source asset to display/edit.
    /// </summary>
    [Parameter, EditorRequired]
    public SourceAsset Source { get; set; } = new();

    /// <summary>
    /// The source ID.
    /// </summary>
    [Parameter, EditorRequired]
    public string SourceId { get; set; } = "";

    /// <summary>
    /// Callback when the source changes.
    /// </summary>
    [Parameter]
    public EventCallback<(string sourceId, SourceAsset source)> OnSourceChanged { get; set; }

    [Parameter]
    public WorkflowSource? SourceDefinition { get; set; }

    private string DisplayLabel => string.IsNullOrWhiteSpace(SourceDefinition?.Label) ? Source.Label :
SourceDefinition.Label;

    /// <summary>
    /// Callback when edit is clicked (for image editor integration).
    /// </summary>
    [Parameter]
    public EventCallback<string> OnEditClicked { get; set; }

    /// <summary>
    /// Callback when blank canvas is clicked (for image editor integration).
    /// </summary>
    [Parameter]
    public EventCallback<string> OnBlankCanvasClicked { get; set; }

    private async Task HandleImageChanged(string imageData)
    {
        Source.Data = imageData;
        Source.Filename = null; // Clear filename since it's from drag/drop or clipboard
        await OnSourceChanged.InvokeAsync((SourceId, Source));
    }

    private void HandleImageLoaded((int width, int height) dimensions)
    {
        // Store dimensions if needed for workflow processing
        Source.Width = dimensions.width;
        Source.Height = dimensions.height;
    }

    private async Task HandleEditClicked()
    {
        await OnEditClicked.InvokeAsync(SourceId);
    }

    private async Task HandleBlankCanvasClicked()
    {
        await OnBlankCanvasClicked.InvokeAsync(SourceId);
    }

    private async Task HandleVideoFilenameChanged(string? filename)
    {
        // The VideoInput component uploads directly to ComfyUI and gives us back the
        // server-side input filename. The workflow fragments resolve videos through
        // SourceAsset.Filename, and UploadSourceImagesAsync skips re-uploading when
        // Data is short and not a data: URI - so we leave Data null on purpose.
        Source.Filename = filename;
        Source.Data = filename; // Marks the source as "has data" without storing bytes.
        if (string.IsNullOrEmpty(filename))
        {
            Source.Clear();
        }
        await OnSourceChanged.InvokeAsync((SourceId, Source));
    }

    private async Task HandleVideoOptionsChanged(VideoSourceOptions options)
    {
        Source.VideoOptions = options;
        await OnSourceChanged.InvokeAsync((SourceId, Source));
    }

    private async Task HandleAudioUpload(IBrowserFile file)
    {
        if (file == null) return;

        try
        {
            var buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024).ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            var mimeType = string.IsNullOrEmpty(file.ContentType) ? "audio/wav" : file.ContentType;

            Source.Data = $"data:{mimeType};base64,{base64}";
            Source.Filename = file.Name;

            await OnSourceChanged.InvokeAsync((SourceId, Source));
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error uploading audio: {ex.Message}");
        }
    }

    private async Task ClearSource()
    {
        Source.Clear();
        await OnSourceChanged.InvokeAsync((SourceId, Source));
    }
}
