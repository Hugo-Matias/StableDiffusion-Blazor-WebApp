@using BlazorWebApp.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    AudioInput - Drag/drop + direct browser upload for audio reference files.

    Uploads via XHR to /api/upload-source so the bytes never travel through
    the SignalR circuit. This prevents the "Cannot send data if the connection
    is not in the 'Connected' State" error that occurs when large base64
    payloads saturate the circuit during audio file uploads.

    Matches VideoInput pattern: dropzone overlay, transparent file input,
    drag-over highlight, upload progress indicator, and trim settings panel.
*@

<MudPaper Class="@(string.IsNullOrEmpty(Class) ? "audio-input-container" : $"audio-input-container {Class}")"
          Elevation="2">
    <div class="audio-input-header">
        <MudText Typo="Typo.subtitle2" Class="audio-input-title">@Title</MudText>
        <MudStack Row Class="audio-input-actions" AlignItems="AlignItems.Center">
            @if (HasContent)
            {
                <MudTooltip Text="Replace audio">
                    <MudIconButton Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" OnClick="TriggerBrowse" />
                </MudTooltip>
                <MudTooltip Text="Clear audio">
                    <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" OnClick="ClearAudio" />
                </MudTooltip>
                @if (_durationSeconds > 0)
                {
                    <MudChip Size="Size.Small" Variant="Variant.Text" Color="Color.Info">
                        @_durationSeconds.ToString("0.#")s
                    </MudChip>
                }
            }
        </MudStack>
    </div>

    @* Dropzone - JS module attaches drag/drop listeners here *@
    <div @ref="_dropzoneRef" class="audio-input-content">
        @* Audio preview player - always present, hidden when no content *@
        <audio @ref="_audioRef" controls playsinline preload="metadata" class="@AudioPlayerClass"></audio>

        @if (!HasContent && !_isUploading)
        {
            <div class="audio-input-overlay @(_isDragOver ? "drag-over" : "")">
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="overlay-content">
                    <MudIcon Icon="@Icons.Material.Filled.AudioFile" Size="Size.Large" />
                    <MudText Typo="Typo.body1">@(_isDragOver ? "Drop audio file" : "Drop audio here")</MudText>
                    <MudText Typo="Typo.caption">or click to browse</MudText>
                </MudStack>
            </div>
        }

        @if (_isUploading)
        {
            <div class="audio-input-loading">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Indeterminate="@(_progress < 0)" Value="@_progress" Color="Color.Primary"
                                         Size="Size.Large" />
                    <MudText Typo="Typo.caption" Color="Color.Surface">
                        @(_progress >= 0 ? $"Uploading {_progress:0}%" : "Uploading...")
                    </MudText>
                </MudStack>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="audio-input-error">
                <MudAlert Severity="Severity.Error" Dense ShowCloseIcon CloseIconClicked="() => _errorMessage = null">
                    @_errorMessage
                </MudAlert>
            </div>
        }

        @* Transparent file input covers the dropzone so clicking anywhere opens the picker.
           When audio is loaded it switches to passthrough mode so clicks don't intercept. *@
        <input @ref="_inputFileRef" type="file" accept=".wav,.mp3,.flac,.ogg,.m4a,audio/*"
               class="@(HasContent ? "audio-input-file passthrough" : "audio-input-file")" />
    </div>

</MudPaper>

@code {
    [Parameter] public string? Filename { get; set; }
    [Parameter] public EventCallback<string?> FilenameChanged { get; set; }
    [Parameter] public AudioSourceOptions? AudioOptions { get; set; }
    [Parameter] public EventCallback<AudioSourceOptions> AudioOptionsChanged { get; set; }
    [Parameter] public AudioSourceOptions? DefaultAudioOptions { get; set; }
    [Parameter] public string Title { get; set; } = "Audio Input";
    [Parameter] public string? Class { get; set; }
    [Parameter] public int MaxFileSizeMB { get; set; } = 200;
    [Parameter] public string UploadEndpoint { get; set; } = "/api/upload-source";

    /// <summary>
    /// Fired when audio metadata (duration) becomes available.
    /// </summary>
    [Parameter]
    public EventCallback<double> DurationLoaded { get; set; }

    private bool HasContent => !string.IsNullOrWhiteSpace(Filename);
    private string DisplayedFilename => Path.GetFileName(Filename) ?? Filename ?? string.Empty;
    private string? PreviewUrl => HasContent ? $"/api/source-preview?filename={Uri.EscapeDataString(Filename)}" : null;
    private string AudioPlayerClass => $"audio-input-player {(HasContent ? "" : "hidden")}";


    private ElementReference _dropzoneRef;
    private ElementReference _audioRef;
    private ElementReference _inputFileRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _instance;
    private DotNetObjectReference<AudioInput>? _dotNetRef;

    private bool _isDragOver;
    private bool _isUploading;
    private int _progress = -1;
    private string? _errorMessage;
    private string? _syncedPreviewUrl;
    private double _durationSeconds;

    // Local trim state
    private double _localTrimStart;
    private double _localTrimDuration;

    protected override void OnParametersSet()
    {
        var options = EffectiveOptions();
        _localTrimStart = Math.Max(0, options.TrimStart);
        _localTrimDuration = Math.Max(0, options.TrimDuration);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/AudioInput.js");
                _dotNetRef = DotNetObjectReference.Create(this);
                _instance = await _module.InvokeAsync<IJSObjectReference>(
                    "init",
                    _dropzoneRef,
                    _inputFileRef,
                    _audioRef,
                    _dotNetRef,
                    UploadEndpoint,
                    MaxFileSizeMB);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"AudioInput: failed to init JS module: {ex.Message}");
            }
        }

        // Sync preview URL when filename changes.
        await SyncPreviewAsync();
    }

    private async Task SyncPreviewAsync()
    {
        if (_instance is null) return;
        var url = HasContent ? PreviewUrl : "";

        // Always apply trim settings, even when URL hasn't changed.
        try
        {
            await _instance.InvokeVoidAsync("setTrim", _localTrimStart, _localTrimDuration);
        }
        catch { /* circuit may be busy */ }

        if (_syncedPreviewUrl == url) return;

        _syncedPreviewUrl = url;
        try
        {
            await _instance.InvokeVoidAsync("setSrc", url);
        }
        catch { /* circuit may be busy */ }
    }

    [JSInvokable]
    public Task OnDragEnter()
    {
        _isDragOver = true;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnDragLeave()
    {
        _isDragOver = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnDrop()
    {
        _isDragOver = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUploadStarted()
    {
        _isUploading = true;
        _progress = -1;
        _errorMessage = null;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnAudioMetadataChanged(int width, int height, double duration)
    {
        _durationSeconds = duration;
        // Clamp trim start to audio duration.
        if (_localTrimStart > _durationSeconds && _durationSeconds > 0)
        {
            _localTrimStart = 0;
        }

        if (DurationLoaded.HasDelegate)
        {
            await DurationLoaded.InvokeAsync(duration);
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUploadProgress(int percent)
    {
        _progress = percent;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnUploadCompleted(string filename, int width, int height, double duration)
    {
        _isUploading = false;
        _progress = -1;
        _durationSeconds = Math.Max(_durationSeconds, duration);
        Filename = filename;
        _syncedPreviewUrl = null;

        // Switch audio element to server-side preview URL.
        await SyncPreviewAsync();

        if (FilenameChanged.HasDelegate)
        {
            await FilenameChanged.InvokeAsync(filename);
        }

        // Commit trim options if they changed.
        await CommitOptionsAsync();

        // Force UI refresh so the trim panel and player become visible.
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUploadFailed(string message)
    {
        _isUploading = false;
        _progress = -1;
        _errorMessage = string.IsNullOrWhiteSpace(message) ? "Upload failed." : message;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ClearAudio()
    {
        Filename = null;
        _durationSeconds = 0;
        _errorMessage = null;
        _syncedPreviewUrl = null;
        if (_instance is not null)
        {
            try { await _instance.InvokeVoidAsync("clear"); } catch { /* ignored */ }
        }
        if (FilenameChanged.HasDelegate)
        {
            await FilenameChanged.InvokeAsync(null);
        }

        // Force UI refresh so the empty state renders immediately.
        await InvokeAsync(StateHasChanged);
    }

    private async Task TriggerBrowse()
    {
        if (_instance is null) return;
        try
        {
            await _instance.InvokeVoidAsync("openPicker");
        }
        catch { /* ignored - circuit may be busy */ }
    }


    private AudioSourceOptions EffectiveOptions()
    {
        return AudioOptions?.Clone() ?? DefaultAudioOptions?.Clone() ?? new AudioSourceOptions();
    }

    private AudioSourceOptions CreateOptionsFromLocal()
    {
        return new AudioSourceOptions
        {
            TrimStart = _localTrimStart,
            TrimDuration = _localTrimDuration
        };
    }

    private async Task CommitOptionsAsync()
    {
        var options = CreateOptionsFromLocal();
        AudioOptions = options;
        if (AudioOptionsChanged.HasDelegate)
        {
            await AudioOptionsChanged.InvokeAsync(options);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_instance is not null)
            {
                await _instance.InvokeVoidAsync("dispose");
                await _instance.DisposeAsync();
            }
        }
        catch { /* ignored - circuit may already be down */ }
        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch { /* ignored */ }
        _dotNetRef?.Dispose();
    }
}
