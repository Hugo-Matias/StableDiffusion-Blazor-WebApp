@using BlazorWebApp.Data.Dtos.ComfyUI.Workflow
@inject ISettingsService Settings

<MudText Typo="Typo.button" Style="opacity:0.2;">Seed Variance Enhancer</MudText>
<MudGrid>
    <MudItem xs="6">
        <MudSlider @bind-Value=Parameters.RandomizePercent
                   Min=Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.RandomizePercent.Min
                   Max=Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.RandomizePercent.Max
                   Step=Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.RandomizePercent.Step
                   Variant="Variant.Filled"
                   ValueLabel=true>
            <small>Randomize:</small> @(Parameters.RandomizePercent)%
        </MudSlider>
    </MudItem>
    <MudItem xs="6">
        <MudSlider @bind-Value=Parameters.Strength
                   Min=Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.Strength.Min
                   Max=Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.Strength.Max
                   Step=Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.Strength.Step
                   Variant="Variant.Filled"
                   ValueLabel=true>
            <small>Strength:</small> @(Parameters.Strength)
        </MudSlider>
    </MudItem>
    <MudItem xs="6">
        <MudSelect T="string" Label="Noise Insert" @bind-Value=Parameters.NoiseInsert AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            @foreach (var option in Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.NoiseInsertOptions)
            {
                <MudSelectItem Value=@option />
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="6">
        <MudSlider @bind-Value=Parameters.StepsSwitchoverPercent
                   Min=Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.StepsSwitchoverPercent.Min
                   Max=Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.StepsSwitchoverPercent.Max
                   Step=Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.StepsSwitchoverPercent.Step
                   Variant="Variant.Filled"
                   ValueLabel=true>
            <small>Steps Switchover:</small> @(Parameters.StepsSwitchoverPercent)%
        </MudSlider>
    </MudItem>
    <MudItem xs="4">
        <MudNumericField @bind-Value=Parameters.Seed Label="Seed" Min="-1" Max="long.MaxValue" />
    </MudItem>
    <MudItem xs="4">
        <MudSelect T="string" Label="Mask Starts At" @bind-Value=Parameters.MaskStartsAt AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            @foreach (var option in Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.MaskStartsAtOptions)
            {
                <MudSelectItem Value=@option />
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="4">
        <MudSlider @bind-Value=Parameters.MaskPercent
                   Min=Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.MaskPercent.Min
                   Max=Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.MaskPercent.Max
                   Step=Settings.Settings.Generation.Txt2Img.SeedVarianceEnhancer.MaskPercent.Step
                   Variant="Variant.Filled"
                   ValueLabel=true>
            <small>Mask:</small> @(Parameters.MaskPercent)%
        </MudSlider>
    </MudItem>
    <MudItem xs="12">
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
            <MudText Typo="Typo.caption">
                <strong>Seed Variance Enhancer</strong> modifies <strong>@(Parameters.RandomizePercent)%</strong> of the prompt embedding values with noise (strength: <strong>@(Parameters.Strength)</strong>).
                The noise is applied during the first <strong>@(Parameters.StepsSwitchoverPercent)%</strong> of steps, then removed so the model can refine the output.
                <br /><br />
                <em>Tip: Strength 15-30 and randomize_percent 50 work well with Z-Image Turbo. Longer prompts provide more embedding values to manipulate.</em>
            </MudText>
        </MudAlert>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public SeedVarianceEnhancerParameters Parameters { get; set; }
}
