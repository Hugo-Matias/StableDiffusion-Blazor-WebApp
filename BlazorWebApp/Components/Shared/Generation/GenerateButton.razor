@using BlazorWebApp.Events
@inject IStateService State
@inject IEventService Events
@implements IDisposable

<EditForm Model="_dummyModel" OnSubmit="@Generate" class="d-flex flex-column justify-content-center">
    <MudStack Class="d-flex flex-column justify-content-center align-items-center w-100 h-100">
        @if (!_isConverging)
        {
            <MudButton Variant="Variant.Filled" Color=Color.Success ButtonType="ButtonType.Submit" StartIcon="fa-solid fa-circle-half-stroke" Disabled="@IsDisabled" FullWidth>Generate</MudButton>
        }
        else
        {
            <MudButtonGroup Variant=Variant.Filled Color=Color.Primary OverrideStyles=false Class="w-100">
                <MudButton OnClick=@(() => OnSkip.InvokeAsync()) Variant=Variant.Filled Color=Color.Warning StartIcon="fa-solid fa-forward" ButtonType="ButtonType.Button" Class="w-100" FullWidth>Skip</MudButton>
            <MudButton OnClick=@(() => OnInterrupt.InvokeAsync()) Variant=Variant.Filled Color=Color.Error StartIcon="fa-solid fa-ban" ButtonType="ButtonType.Button" FullWidth>Interrupt</MudButton>
        </MudButtonGroup>
        }
    </MudStack>
</EditForm>

@code {
    /// <summary>
    /// Called when generate is clicked.
    /// </summary>
    [Parameter] public EventCallback OnGenerateClicked { get; set; }
    
    [Parameter] public EventCallback OnSkip { get; set; }
    [Parameter] public EventCallback OnInterrupt { get; set; }
    
    /// <summary>
    /// Whether the button is disabled.
    /// </summary>
    [Parameter] public bool IsDisabled { get; set; }

    private bool _isConverging = false;
    private object _dummyModel = new();

    protected override void OnInitialized()
    {
        Events.Subscribe<ConvergingChangedEventArgs>(OnConvergingChanged);
    }

    private void OnConvergingChanged(ConvergingChangedEventArgs args)
    {
        _isConverging = args.IsConverging;
        _ = InvokeAsync(StateHasChanged);
    }

    public async void Generate()
    {
        if (OnGenerateClicked.HasDelegate)
        {
            await OnGenerateClicked.InvokeAsync();
        }
        
        await State.SaveState();
    }

    public void Dispose()
    {
        Events.Unsubscribe<ConvergingChangedEventArgs>(OnConvergingChanged);
    }
}
