@using BlazorWebApp.Events
@using static BlazorWebApp.Data.Enums
@inject IStateService State
@inject IGalleryService Gallery
@inject IBackendService Backend
@inject IOrchestratorService Orchestrator
@inject IEventService Events
@implements IDisposable

<div>
    <MudNavMenu Class="navbar-horizontal" Rounded>
        <MudTooltip Text="Gallery" Placement="Placement.Bottom" Arrow="true">
            <MudNavLink Href="/" Match=NavLinkMatch.All>
                <MudIcon Icon="fa-solid fa-images" Class="nav-icon me-1" /><span class="nav-label">Gallery</span>
            </MudNavLink>
        </MudTooltip>
        @{
            var generateDisabled = !Backend.IsBackendAvailable || Orchestrator.ResolveWorkflowForBase() == null;
            var generateTooltip = generateDisabled
                ? "No workflows available for the current base"
                : "Generate";
        }
        <MudTooltip Text="@generateTooltip" Placement="Placement.Bottom" Arrow="true">
            <MudNavLink Href="/generate"
                        Match=NavLinkMatch.Prefix
                        Class="@(generateDisabled ? "nav-disabled" : "")">
                <MudIcon Icon="fa-solid fa-wand-magic-sparkles" Class="nav-icon me-1" /><span class="nav-label">Generate</span>
            </MudNavLink>
        </MudTooltip>
        <MudTooltip Text="Scheduler" Placement="Placement.Bottom" Arrow="true">
            <MudNavLink Href="/scheduler" Match=NavLinkMatch.Prefix>
                <MudIcon Icon="fa-solid fa-calendar-check" Class="nav-icon me-1" /><span class="nav-label">Scheduler</span>
            </MudNavLink>
        </MudTooltip>
        <MudTooltip Text="Prompts" Placement="Placement.Bottom" Arrow="true">
            <MudNavLink Href="/prompts" Match=NavLinkMatch.Prefix>
                <MudIcon Icon="fa-solid fa-quote-left" Class="nav-icon me-1" /><span class="nav-label">Prompts</span>
            </MudNavLink>
        </MudTooltip>
        <MudTooltip Text="Resources" Placement="Placement.Bottom" Arrow="true">
            <MudNavLink Href="/resources" Match=NavLinkMatch.Prefix>
                <MudIcon Icon="fa-solid fa-download" Class="nav-icon me-1" /><span class="nav-label">Resources</span>
            </MudNavLink>
        </MudTooltip>
        <MudTooltip Text="CivitAI" Placement="Placement.Bottom" Arrow="true">
            <MudNavLink Href="/civitai" Match=NavLinkMatch.Prefix>
                <MudIcon Icon="fa-solid fa-globe" Class="nav-icon me-1" /><span class="nav-label">CivitAI</span>
            </MudNavLink>
        </MudTooltip>
        <MudTooltip Text="Danbooru" Placement="Placement.Bottom" Arrow="true">
            <MudNavLink Href="/danbooru" Match=NavLinkMatch.Prefix>
                <MudIcon Icon="fa-solid fa-box" Class="nav-icon me-1" /><span class="nav-label">Danbooru</span>
            </MudNavLink>
        </MudTooltip>
        <MudTooltip Text="Design Test Bed" Placement="Placement.Bottom" Arrow="true">
            <MudNavLink Href="/dev/design-testbed" Match=NavLinkMatch.Prefix>
                <MudIcon Icon="fa-solid fa-palette" Class="nav-icon me-1" /><span class="nav-label">Design</span>
            </MudNavLink>
        </MudTooltip>
    </MudNavMenu>
</div>

@code {
    protected override void OnInitialized()
    {
        Events.Subscribe<BackendAvailabilityChangedEventArgs>(OnBackendStateChanged);
        Events.Subscribe<ProjectChangedEventArgs>(OnProjectsChanged);
        Events.Subscribe<StateChangedEventArgs>(OnWorkflowBaseChanged);
    }

    /// <summary>
    /// Returns true if the global Generate button has a resolvable workflow target.
    /// Used only for tooltip/disabled styling; the link itself points at /generate
    /// and the page resolves the concrete workflow id.
    /// </summary>
    private bool CanResolveGenerate() =>
        Backend.IsBackendAvailable && Orchestrator.ResolveWorkflowForBase() != null;

    private void OnBackendStateChanged(BackendAvailabilityChangedEventArgs args)
    {
        Refresh();
    }

    private void OnProjectsChanged(ProjectChangedEventArgs args)
    {
        Refresh();
    }

    private void OnWorkflowBaseChanged(StateChangedEventArgs args)
    {
        Refresh();
    }

    private async void Refresh() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Events.Unsubscribe<BackendAvailabilityChangedEventArgs>(OnBackendStateChanged);
        Events.Unsubscribe<ProjectChangedEventArgs>(OnProjectsChanged);
        Events.Unsubscribe<StateChangedEventArgs>(OnWorkflowBaseChanged);
    }
}
