@using BlazorWebApp.Events
@using static BlazorWebApp.Data.Enums
@inject IStateService State
@inject IGalleryService Gallery
@inject IBackendService Backend
@inject IEventService Events
@implements IDisposable

<div>
    <MudNavMenu Class="navbar-horizontal" Rounded>
        <MudNavLink Href="/" Match=NavLinkMatch.All><i class="fas fa-images me-1" /> Gallery</MudNavLink>
        @if (Gallery.Projects.Count > 0)
        {
            if (Backend.IsBackendAvailable && State.State.Generation.Workflows != null && State.State.Generation.Workflows.Count > 0)
            {
                var w = State.State.Generation.Workflows;
                var b = State.State.Generation.WorkflowBase;
                if (w.Any(w => w.Mode == ModeType.Txt2Img))
                {
                    foreach (var workflow in w.Where(w => w.Mode == ModeType.Txt2Img && (b != null ? w.Base == b : true)))
                    {
                        <MudNavLink Href=@($"/comfyui/txt2img/{workflow.Id}") Match=NavLinkMatch.Prefix><i class="fa-regular fa-file-lines me-1" /> @(workflow.Title)</MudNavLink>
                    }
                }
                if (w.Any(w => w.Mode == ModeType.Img2Img))
                {
                    foreach (var workflow in w.Where(w => w.Mode == ModeType.Img2Img && (b != null ? w.Base == b : true)))
                    {
                        <MudNavLink Href=@($"/comfyui/img2img/{workflow.Id}") Match=NavLinkMatch.Prefix><i class="fa-regular fa-file-image me-1" /> @(workflow.Title)</MudNavLink>
                    }
                }
                if (w.Any(w => w.Mode == ModeType.Img2Vid))
                {
                    foreach (var workflow in w.Where(w => w.Mode == ModeType.Img2Vid && (b != null ? w.Base == b : true)))
                    {
                        <MudNavLink Href=@($"/comfyui/img2vid/{workflow.Id}") Match=NavLinkMatch.Prefix><i class="fa-solid fa-video me-1" /> @(workflow.Title)</MudNavLink>
                    }
                }
            }
        }
        <MudNavLink Href="/resources" Match=NavLinkMatch.Prefix><i class="fa-solid fa-download me-1" /> Resources</MudNavLink>
        <MudNavLink Href="/danbooru" Match=NavLinkMatch.Prefix><i class="fa-solid fa-box me-1" /> Danbooru</MudNavLink>
        <MudNavLink Href="/prompts" Match=NavLinkMatch.Prefix><i class="fa-solid fa-quote-left me-1" /> Prompts</MudNavLink>
    </MudNavMenu>
</div>

@code {
    protected override void OnInitialized()
    {
        Events.Subscribe<BackendAvailabilityChangedEventArgs>(OnBackendStateChanged);
        Events.Subscribe<ProjectChangedEventArgs>(OnProjectsChanged);
        Events.Subscribe<StateChangedEventArgs>(OnWorkflowBaseChanged);
    }

    private void OnBackendStateChanged(BackendAvailabilityChangedEventArgs args)
    {
        Refresh();
    }

    private void OnProjectsChanged(ProjectChangedEventArgs args)
    {
        Refresh();
    }

    private void OnWorkflowBaseChanged(StateChangedEventArgs args)
    {
        Refresh();
    }

    private async void Refresh() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Events.Unsubscribe<BackendAvailabilityChangedEventArgs>(OnBackendStateChanged);
        Events.Unsubscribe<ProjectChangedEventArgs>(OnProjectsChanged);
        Events.Unsubscribe<StateChangedEventArgs>(OnWorkflowBaseChanged);
    }
}
