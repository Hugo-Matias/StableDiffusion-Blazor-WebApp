@inherits LayoutComponentBase
@using BlazorWebApp.Events
@using BlazorWebApp.Services.Templating
@using static BlazorWebApp.Data.Enums
@inject IOrchestratorService M
@inject IStateService State
@inject IBackendService Backend
@inject IModelService Models
@inject IEventService Events
@inject ThemeService ThemeService
@inject NavigationManager NavManager
@inject IInfoService InfoService
@inject IFluidTemplateService FluidService
@implements IDisposable

<PageTitle>BlazorDiffusion</PageTitle>

<MudThemeProvider @bind-IsDarkMode=State.State.IsDarkMode Theme="_currentTheme" />
<MudDialogProvider />
<MudSnackbarProvider />

<div>
    <MudLayout Style="overflow:hidden;">
        <MudAppBar Style="z-index: 1400;">
            <ProgressContainer />
            <MudIconButton Href="/" Variant="Variant.Text" Icon="fa-solid fa-image me-1" Class="brand w-auto" />
            <NavBar />
            <MudSpacer />
            
            @* Right-aligned toolbar items *@
            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                @* Base Selector (ComfyUI only) *@
                @if (Backend.IsBackendAvailable && _workflowBases != null && _workflowBases.Count > 0)
                {
                    <MudSelect Value="State.State.Generation.WorkflowBase" 
                               T="ModelBase" 
                               ValueChanged="HandleWorkflowBaseSelected" 
                               Label="Base" 
                               Variant="Variant.Outlined"
                               Class="base-selector"
                               AnchorOrigin="Origin.BottomCenter" 
                               TransformOrigin="Origin.TopCenter"
                               Adornment="Adornment.End"
                               AdornmentIcon="@Icons.Material.Filled.Refresh"
                               AdornmentColor="Color.Inherit"
                               OnAdornmentClick="RefreshWorkflows">
                        @foreach (var workflowBase in _workflowBases)
                        {
                            <MudSelectItem Value="@workflowBase" />
                        }
                    </MudSelect>
                }
                
                @* Dark/Light Mode Toggle *@
                <MudIconButton Icon="@(State.State.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                               Color="Color.Inherit" 
                               Title="@(State.State.IsDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")"
                               OnClick="ToggleDarkMode" />
                
                @* Info/Help Button *@
                @if (InfoService.CurrentInfo != null)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Info"
                                   Color="Color.Inherit"
                                   Title="Help & Shortcuts"
                                   OnClick="OpenInfoDrawer" />
                }
                
                <MudIconButton Class=@(_isModelLoading ? "spinner" : "") 
                               Icon="@Icons.Material.Filled.Settings" 
                               Color=@(_isModelLoading ? Color.Info : Color.Inherit) 
                               OnClick="() => DrawerToggler()" />
            </MudStack>
        </MudAppBar>

        @* Backdrop for TopToolbar *@
        @if (_isToolbarOpen)
        {
            <div class="toolbar-backdrop" @onclick="CloseToolbar"></div>
        }

        <MudExpansionPanels Style="position: fixed; width:100%; z-index:1301; top: 0px;">
            <MudExpansionPanel HideIcon=true @bind-IsExpanded="_isToolbarOpen">
                <CascadingValue Value="@((Action)HandleThemeChanged)">
                    <TopToolbar />
                </CascadingValue>
            </MudExpansionPanel>
        </MudExpansionPanels>
        <MudMainContent>
            <MudContainer Class="mt-5" MaxWidth="MaxWidth.ExtraLarge">
                @Body
            </MudContainer>
        </MudMainContent>
        
        @* Info Drawer (global, contextual) - inside MudLayout for proper overlay *@
        <InfoDrawer @ref="_infoDrawer" />
    </MudLayout>
</div>

@code {
    private bool _isToolbarOpen = false;
    private bool _isModelLoading = false;
    private MudTheme _currentTheme = new MudTheme();
    private List<ModelBase> _workflowBases = new();
    private InfoDrawer? _infoDrawer;
    
    // Pages that should NOT redirect when Base changes (non-generation pages)
    private static readonly string[] _safePages = { "/", "/prompts", "/resources", "/danbooru" };

    protected override void OnInitialized()
    {
        Events.Subscribe<ProgressChangedEventArgs>(OnProgressChanged);
        Events.Subscribe<ModelsChangedEventArgs>(OnSDModelsChange);
        Events.Subscribe<StateChangedEventArgs>(OnWorkflowBaseChanged);
        Events.Subscribe<BackendAvailabilityChangedEventArgs>(OnBackendStateChanged);
        InfoService.OnInfoChanged += HandleInfoChanged;
        NavManager.LocationChanged += HandleLocationChanged;
        LoadTheme();
    }

    protected async override Task OnInitializedAsync() 
    { 
        // Load persisted state from database via Orchestrator
        // This ensures workflows are refreshed from disk templates (not just from database)
        await M.LoadState();
        
        // Check backend availability using BackendService
        var isBackendAvailable = await Backend.CheckBackendAvailability();
        
        // Load backend-dependent resources if backend is available
        if (isBackendAvailable)
        {
            await M.LoadBackendDependentResources();
        }
        
        LoadWorkflowBases();
    }

    private async void OnBackendStateChanged(BackendAvailabilityChangedEventArgs args)
    {
        LoadWorkflowBases();
        
        // Load backend-dependent resources when backend comes online
        if (Backend.IsBackendAvailable)
        {
            await M.LoadBackendDependentResources();
        }
        
        await InvokeAsync(StateHasChanged);
    }

    private void LoadWorkflowBases()
    {
        if (Backend.IsBackendAvailable && State.State?.Generation?.Workflows != null)
        {
            _workflowBases = State.State.Generation.Workflows
                .Select(w => w.Base.ToString())
                .Where(b => !string.IsNullOrWhiteSpace(b))
                .Distinct(StringComparer.InvariantCultureIgnoreCase)
                .Select(b => Enum.Parse<ModelBase>(b, ignoreCase: true))
                .OrderBy(b => b)
                .ToList();
        }
    }

    private void LoadTheme()
    {
        _currentTheme = ThemeService.GetTheme(State.State.CurrentTheme ?? "Default");
    }

    private void HandleThemeChanged()
    {
        LoadTheme();
        StateHasChanged();
    }

    private async Task ToggleDarkMode()
    {
        State.State.IsDarkMode = !State.State.IsDarkMode;
        await State.SaveState();
        StateHasChanged();
    }

    private async Task HandleWorkflowBaseSelected(ModelBase selected)
    {
        var previousBase = State.State.Generation.WorkflowBase;
        
        M.SetWorkflowBase(selected);
        await Models.GetWorkflowModels();
        
        // If base changed and user is on a generation page, redirect to Index
        if (previousBase != selected && !IsOnSafePage())
        {
            NavManager.NavigateTo("/");
        }
    }

    private void RefreshWorkflows()
    {
        // Clear Fluid template cache to force re-reading templates from disk
        FluidService.ClearCache();
        
        // Refresh workflows from disk templates
        M.RefreshWorkflowsFromDisk();
        
        LoadWorkflowBases();
        StateHasChanged();
    }

    /// <summary>
    /// Checks if the current page is a "safe" page that shouldn't redirect on Base change.
    /// Safe pages: Index, Prompts, Resources, Danbooru
    /// </summary>
    private bool IsOnSafePage()
    {
        var currentPath = NavManager.ToBaseRelativePath(NavManager.Uri);
        var normalizedPath = "/" + currentPath.ToLowerInvariant().TrimEnd('/');
        
        // Check exact matches first
        if (_safePages.Any(p => normalizedPath.Equals(p, StringComparison.OrdinalIgnoreCase)))
            return true;
        
        // Check prefix matches for sub-pages (e.g., /prompts/123)
        if (_safePages.Any(p => p != "/" && normalizedPath.StartsWith(p, StringComparison.OrdinalIgnoreCase)))
            return true;
        
        return false;
    }

    private void DrawerToggler() 
    {
        _isToolbarOpen = !_isToolbarOpen;
        StateHasChanged();
    }

    private void CloseToolbar()
    {
        _isToolbarOpen = false;
        StateHasChanged();
    }

    private void OpenInfoDrawer()
    {
        if (_infoDrawer != null)
        {
            if (_infoDrawer.IsOpen)
                _infoDrawer.Close();
            else
                _infoDrawer.Open();
        }
    }

    private void HandleInfoChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Close drawer when navigating away from page
        _infoDrawer?.Close();
    }

    private void OnProgressChanged(ProgressChangedEventArgs args) => Refresh();
    private void OnSDModelsChange(ModelsChangedEventArgs args) => Refresh();
    private void OnWorkflowBaseChanged(StateChangedEventArgs args) => Refresh();

    private async void Refresh()
    {
        _isModelLoading = string.IsNullOrEmpty(Models.GetCurrentModel()) || Models.GetCurrentModel() == "Loading...";
        LoadWorkflowBases();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Events.Unsubscribe<ProgressChangedEventArgs>(OnProgressChanged);
        Events.Unsubscribe<ModelsChangedEventArgs>(OnSDModelsChange);
        Events.Unsubscribe<StateChangedEventArgs>(OnWorkflowBaseChanged);
        Events.Unsubscribe<BackendAvailabilityChangedEventArgs>(OnBackendStateChanged);
        InfoService.OnInfoChanged -= HandleInfoChanged;
        NavManager.LocationChanged -= HandleLocationChanged;
    }
}
