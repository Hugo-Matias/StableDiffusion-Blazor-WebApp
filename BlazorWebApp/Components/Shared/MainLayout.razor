@inherits LayoutComponentBase
@inject ManagerService M
@inject SDAPIService SDAPI
@inject ComfyUIService CAPI
@inject ThemeService ThemeService
@implements IDisposable

<PageTitle>BlazorDiffusion</PageTitle>

<MudThemeProvider @bind-IsDarkMode=M.State.IsDarkMode Theme="_currentTheme" />
<MudDialogProvider />
<MudSnackbarProvider />

<div>
    <MudLayout Style="overflow:hidden;">
        <MudAppBar>
            <ProgressContainer />
            <MudIconButton Href="/" Variant="Variant.Text" Icon="fa-solid fa-image me-1" Class="brand w-auto" />
            <NavBar />
            <MudSpacer />
            @if (M.SDModels != null && M.SDModels.Count > 0)
            {
                <MudSelect T="string"
                            Label="Model"
                            @bind-Value="@M.State.Generation.SDModel"
                            OnOpen="@(() => M.GetSDModels())"
                            Style="min-width: 200px;"
                            AnchorOrigin="Origin.BottomCenter">
                    @foreach (var model in M.SDModels)
                    {
                        <MudSelectItem Value="@model.Model_name">@model.Title</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudIconButton Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" OnClick="ToggleTheme" Title="Toggle Theme" />
            <MudIconButton Class=@(M.State.Generation.SDModel == "Loading..." ? "spinner" : "") Icon="@Icons.Material.Filled.Settings" Color=@(M.State.Generation.SDModel == "Loading..." ? Color.Info : Color.Inherit) Edge="Edge.Start" OnClick="() => DrawerToggler()" />
        </MudAppBar>
        <MudExpansionPanels Style="position: fixed; width:100%; z-index:100;">
            <MudExpansionPanel HideIcon=true IsExpanded="_isToolbarOpen">
                <TopToolbar />
            </MudExpansionPanel>
        </MudExpansionPanels>
        <MudMainContent>
            <MudContainer Class="mt-5" MaxWidth="MaxWidth.ExtraLarge">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</div>

@code {
    private bool _isToolbarOpen = false;
    private MudTheme _currentTheme = new MudTheme();

    protected override void OnInitialized()
    {
        M.OnProgressChanged += Refresh;
        M.OnSDModelsChange += Refresh;
        LoadTheme();
    }

    protected async override Task OnInitializedAsync() 
    { 
        M.IsWebuiUp = await SDAPI.CheckWebuiState();
    }

    private void LoadTheme()
    {
        _currentTheme = ThemeService.GetTheme(M.State.CurrentTheme ?? "Default");
    }

    private async Task ToggleTheme()
    {
        var currentIndex = Array.IndexOf(ThemeService.ThemeNames, M.State.CurrentTheme ?? "Default");
        var nextIndex = (currentIndex + 1) % ThemeService.ThemeNames.Length;
        
        M.State.CurrentTheme = ThemeService.ThemeNames[nextIndex];
        LoadTheme();
        await M.SaveState();
        StateHasChanged();
    }

    private void DrawerToggler() => _isToolbarOpen = !_isToolbarOpen;

    private async void Refresh() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        M.OnProgressChanged -= Refresh;
        M.OnSDModelsChange += Refresh;
    }
}
