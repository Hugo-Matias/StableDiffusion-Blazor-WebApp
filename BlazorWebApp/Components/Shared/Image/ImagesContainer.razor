@using BlazorWebApp.Events
@inject IStateService State
@inject IGalleryService Gallery
@inject IEventService Events
@inject IDatabaseService DB
@inject IIOService IO
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<div style="@Style" class="images-container-wrapper">
    <div class="images-container-toolbar">
        @if (Images.Images is not null && Images.Images.Count > 0)
        {
            <div class="toolbar-buttons" style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; align-items: center; width: 100%;">
                <MudButton OnClick="() => OpenViewer(0)" StartIcon="fa-solid fa-window-maximize" Color="Color.Secondary" Size="Size.Small">Fullscreen</MudButton>
                <MudButton OnClick="ShowSelectionsDialog" StartIcon="fa-solid fa-check" Color="Color.Secondary" Size="Size.Small">Selections</MudButton>
                @if (CanSelect && Gallery.SelectedImageIds.Count > 0)
                {
                    <MudButton OnClick="ShowSwitchProjectDialog" StartIcon="fa-solid fa-layer-group" Color="Color.Tertiary" Size="Size.Small">Set Project</MudButton>
                    <MudButton OnClick="ShowDeleteImagesDialog" StartIcon="fa-solid fa-trash-can" Color="Color.Error" Size="Size.Small">Delete</MudButton>
                    <MudButton OnClick="Gallery.ClearSelectedImages" StartIcon="fa-regular fa-square" Color="Color.Warning" Size="Size.Small">Clear (@Gallery.SelectedImageIds.Count)</MudButton>
                    <MudButton OnClick="SelectAll" StartIcon="fa-solid fa-check-double" Color="Color.Info" Size="Size.Small">Select All</MudButton>
                }
                @if (Images.PageCount > 1)
                {
                    <MudPagination BoundaryCount="2" MiddleCount="3" Count="Images.PageCount" Selected="_currentPage" SelectedChanged="page => HandlePageChanged(page)" Size="Size.Small" />
                }
            </div>
        }
    </div>

    <div class="images-grid-container">
        @if (Images.Images is not null && Images.Images.Count > 0)
        {
            <MudGrid Spacing="2" Justify="Justify.Center" Class="fixed-height-grid">
                @foreach (var image in Images.Images)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3" xl="2" Class="grid-item-fixed">
                        @if (IsVideoFile(image.Path))
                        {
                            <VideoCard Video="@ConvertToGeneratedVideo(image)" 
                                       Index="@Images.Images.IndexOf(image)"
                                       OnSelectVideo="idx => OpenViewer(idx)" 
                                       OnDeleteVideo="video => ShowDeleteImageDialogFromVideo(video)"
                                       OnVideoChanged="HandleVideoChanged"
                                       ShowSelectionCheckbox="CanSelect"
                                       UseFixedSize="true" />
                        }
                        else
                        {
                            <ImageCard Image="@image" 
                                       Target="fullscreen-modal" 
                                       OnSelectImage="img => OpenViewer(Images.Images.IndexOf(img))" 
                                       OnDeleteImage="ShowDeleteImageDialog" 
                                       OnCoverChanged="async () => await OnCoverChanged.InvokeAsync()" 
                                       ShowSelectionCheckbox="CanSelect"
                                       UseFixedSize="true" />
                        }
                    </MudItem>
                }
            </MudGrid>
            
            @if (Images.PageCount > 1)
            {
                <div class="pagination-bottom" style="display: flex; justify-content: center; margin-top: 1rem;">
                    <MudPagination BoundaryCount="2" MiddleCount="5" Count="Images.PageCount" Selected="_currentPage" SelectedChanged="page => HandlePageChanged(page)" />
                </div>
            }
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Class="mt-10">
                <MudProgressCircular Color="Color.Primary" Indeterminate />
            </MudStack>
        }
    </div>
</div>

<!-- Unified Asset Viewer (handles both images and videos with pagination) -->
<AssetViewer @bind-IsVisible="_showViewer" 
             Assets="@Images.Images" 
             StartIndex="_viewerStartIndex"
             CurrentPage="_currentPage"
             PageCount="Images.PageCount"
             TotalCount="@(Images.PageCount * Images.Images.Count)"
             OnPageChange="HandleViewerPageChange"
             OnAssetChanged="HandleAssetChanged"
             OnClosed="HandleViewerClosed" />

@code {
    [Parameter] public ImagesDto Images { get; set; }
    [Parameter] public EventCallback<int> OnPageSelected { get; set; }
    [Parameter] public EventCallback OnDeleteImage { get; set; }
    [Parameter] public EventCallback OnCoverChanged { get; set; }
    [Parameter] public string Style { get; set; }
    [Parameter] public bool CanSelect { get; set; }

    private int _currentPage = 1;
    private bool _showViewer;
    private int _viewerStartIndex;

    private static readonly string[] VideoExtensions = { ".mp4", ".webm", ".mov", ".avi", ".mkv" };

    protected override void OnInitialized()
    {
        Events.Subscribe<ImageSelectionChangedEventArgs>(OnImageSelectionChanged);
    }

    private void OnImageSelectionChanged(ImageSelectionChangedEventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private bool IsVideoFile(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return false;
        var extension = Path.GetExtension(path)?.ToLowerInvariant();
        return VideoExtensions.Contains(extension);
    }

    private GeneratedVideo ConvertToGeneratedVideo(Image image)
    {
        return new GeneratedVideo
        {
            Id = image.Id,
            FilePath = image.Path,
            Filename = Path.GetFileName(image.Path),
            Width = image.Width,
            Height = image.Height,
            Prompt = image.Prompt,
            NegativePrompt = image.NegativePrompt,
            Seed = image.Seed,
            Steps = image.Steps,
            CfgScale = image.CfgScale,
            DateCreated = image.DateCreated,
            Favorite = image.Favorite,
            Score = image.Score
        };
    }

    private void OpenViewer(int startIndex)
    {
        _viewerStartIndex = startIndex;
        _showViewer = true;
    }

    private async Task HandleViewerPageChange(int newPage)
    {
        _currentPage = newPage;
        await OnPageSelected.InvokeAsync(newPage);
        await InvokeAsync(StateHasChanged);
    }

    private void HandleViewerClosed()
    {
        StateHasChanged();
    }

    private void HandleAssetChanged(Image image)
    {
        // Asset was updated in the viewer (favorite, score, etc.)
        StateHasChanged();
    }

    private void HandleVideoChanged(GeneratedVideo video)
    {
        // Sync changes back to the Image entity in the list
        var image = Images.Images.FirstOrDefault(i => i.Id == video.Id);
        if (image != null)
        {
            image.Favorite = video.Favorite;
            image.Score = video.Score;
        }
    }

    public void HandlePageChanged(int page)
    {
        _currentPage = page;
        OnPageSelected.InvokeAsync(page);
    }

    private void ShowSelectionsDialog()
    {
        var options = new DialogOptions() { MaxWidth = MaxWidth.Large, CloseButton = true };
        DialogService.Show<SelectionsDialog>("", options);
    }

    private async Task ShowDeleteImageDialog(Image image)
    {
        var parameters = new DialogParameters();
        parameters.Add("OkButtonText", "Yes");
        parameters.Add("CancelButtonText", "No");
        parameters.Add("OkButtonColor", Color.Error);
        parameters.Add("Content", new MarkupString(@"<span class='lead'>Are you sure you want to <strong class='text-danger'>delete</strong> this item?<br /></span><small>This action is irreversible!</small>"));
        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Delete Item", parameters, new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (!result.Canceled) await DeleteImage(image, true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowDeleteImageDialogFromVideo(GeneratedVideo video)
    {
        var image = Images.Images.FirstOrDefault(i => i.Path == video.FilePath);
        if (image != null)
        {
            await ShowDeleteImageDialog(image);
        }
    }

    private async Task ShowDeleteImagesDialog()
    {
        var parameters = new DialogParameters();
        parameters.Add("OkButtonText", "Yes");
        parameters.Add("CancelButtonText", "No");
        parameters.Add("OkButtonColor", Color.Error);
        parameters.Add("Content", new MarkupString(@"<span class='lead'>Are you sure you want to <strong class='text-danger'>delete</strong> the selected items?<br /></span><small>This action is irreversible!</small>"));
        var dialog = await DialogService.ShowAsync<ConfirmationDialog>($"Delete {Gallery.SelectedImageIds.Count} Items", parameters, new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var selectedImages = await DB.GetImages(Gallery.SelectedImageIds);
            foreach (var image in selectedImages)
            {
                await DeleteImage(image, false);
            }
            Snackbar.Add("All selected items deleted successfully.", Severity.Success);
            Gallery.ClearSelectedImages();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectAll()
    {
        var ids = Images.Images.Select(i => i.Id).ToList();
        foreach (var id in ids)
        {
            Gallery.AddSelectedImage(id);
        }
    }

    private async Task DeleteImage(Image image, bool showSnack)
    {
        var response = await DB.DeleteImage(image);
        await OnDeleteImage.InvokeAsync();
        if (showSnack) Snackbar.Add("Item deleted successfuly.", Severity.Success);
    }

    private async Task ShowSwitchProjectDialog()
    {
        var param = new DialogParameters();
        var selectedImages = await DB.GetImages(Gallery.SelectedImageIds);
        param.Add("Images", selectedImages);
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ImageProjectDialog>("Switch Project", param, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var updatedImages = (List<Image>)result.Data;
            await DB.UpdateImages(updatedImages);
            Snackbar.Add("Items projects were changed.", Severity.Success);
            Gallery.ClearSelectedImages();
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Events.Unsubscribe<ImageSelectionChangedEventArgs>(OnImageSelectionChanged);
    }
}
