@using System.Diagnostics;
@using static BlazorWebApp.Data.Enums;
@inject ManagerService M
@inject DatabaseService DB
@inject IOService IO
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavManager
@implements IDisposable

<div class="@GetCardClasses()" @onmouseenter="HandleMouseEnter" @onmouseleave="HandleMouseLeave">
    @* Image Container *@
    <div class="image-wrapper">
        <img src="@IO.GetImageStaticFile(Image.Path)" 
             alt="Generated image" 
             class="card-image"
             loading="lazy" />
        
        @* Hover Overlay *@
        <div class="hover-overlay @(_isHovered || _isMenuOpen ? "visible" : "")">
            @* Top Section - Score & Selection *@
            <div class="overlay-top">
                <div class="rating-container @(_isHovered || _isMenuOpen || Image.Score > 0 ? "visible" : "")">
                    <MudRating SelectedValue="Image.Score" 
                               SelectedValueChanged="SetScore" 
                               MaxValue="3" 
                               Size="Size.Small"
                               Color="Color.Warning" />
                </div>
                
                @if (ShowSelectionCheckbox)
                {
                    <div class="selection-container @(_isHovered || _isMenuOpen || _isSelected ? "visible" : "")">
                        <MudCheckBox Checked="_isSelected" 
                                     T="bool" 
                                     CheckedChanged="HandleSelected" 
                                     Color="Color.Success" 
                                     UncheckedColor="Color.Default"
                                     Size="Size.Medium" />
                    </div>
                }
            </div>
            
            @* Center Section - Quick Actions *@
            <div class="overlay-center @(_isHovered || _isMenuOpen ? "visible" : "")">
                <div class="quick-actions">
                    <button class="action-btn primary" @onclick="@(() => OnSelectImage.InvokeAsync(Image))" title="View Fullscreen">
                        <i class="fa-solid fa-expand"></i>
                    </button>
                    <button class="action-btn @(Image.Favorite ? "active" : "")" @onclick="@(() => ToggleFavorite(!Image.Favorite))" title="@(Image.Favorite ? "Remove from Favorites" : "Add to Favorites")">
                        <i class="@(Image.Favorite ? "fa-solid fa-heart" : "fa-regular fa-heart")"></i>
                    </button>
                    <button class="action-btn" @onclick="ShowImageInfoDialog" title="View Info">
                        <i class="fa-solid fa-info"></i>
                    </button>
                </div>
            </div>
            
            @* Bottom Section - Info & More Actions *@
            <div class="overlay-bottom @(_isHovered || _isMenuOpen ? "visible" : "")">
                <div class="image-info">
                    @if (Image.ModeId != 3)
                    {
                        <div class="info-row">
                            <span class="info-item">
                                <i class="fa-solid fa-seedling"></i>
                                @Image.Seed
                            </span>
                            <span class="info-item">
                                <i class="fa-solid fa-stairs"></i>
                                @Image.Steps
                            </span>
                            <span class="info-item">
                                <i class="fa-solid fa-scale-unbalanced"></i>
                                @Image.CfgScale
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="info-row">
                            <span class="info-item">Upscaled</span>
                            <span class="info-item">@Image.Width × @Image.Height</span>
                        </div>
                    }
                </div>
                
                <div class="more-actions">
                    <MudMenu @bind-Open="_isMenuOpen"
                             Icon="@Icons.Material.Filled.MoreVert" 
                             AnchorOrigin="Origin.TopCenter" 
                             TransformOrigin="Origin.BottomCenter"
                             Size="Size.Small"
                             Dense="true"
                             Class="more-menu">
                        <ChildContent>
                            <div class="action-menu">
                                @* Only show "Send To" section if there are available workflows *@
                                @if (HasWorkflowForMode(ModeType.Img2Img) || HasWorkflowForMode(ModeType.Img2Vid) || HasWorkflowForMode(ModeType.Extras))
                                {
                                    <div class="menu-section">
                                        <div class="menu-section-title">Send To</div>
                                        @if (HasWorkflowForMode(ModeType.Img2Img))
                                        {
                                            <MudMenuItem OnClick="@(() => SendTo(img2img: true))" Class="menu-item">
                                                <div class="menu-item-content">
                                                    <i class="fa-solid fa-file-image menu-icon warning"></i>
                                                    <span>Img2Img</span>
                                                </div>
                                            </MudMenuItem>
                                        }
                                        @if (HasWorkflowForMode(ModeType.Img2Vid))
                                        {
                                            <MudMenuItem OnClick="SendToImg2Vid" Class="menu-item">
                                                <div class="menu-item-content">
                                                    <i class="fa-solid fa-video menu-icon info"></i>
                                                    <span>Img2Vid</span>
                                                </div>
                                            </MudMenuItem>
                                        }
                                        @if (HasWorkflowForMode(ModeType.Extras))
                                        {
                                            <MudMenuItem OnClick="@(() => SendTo(img2img: false))" Class="menu-item">
                                                <div class="menu-item-content">
                                                    <i class="fa-solid fa-panorama menu-icon warning"></i>
                                                    <span>Upscale</span>
                                                </div>
                                            </MudMenuItem>
                                        }
                                    </div>
                                    
                                    <div class="menu-divider"></div>
                                }
                                
                                <div class="menu-section">
                                    <div class="menu-section-title">Organize</div>
                                    <MudMenuItem OnClick="ShowSwitchProjectDialog" Class="menu-item">
                                        <div class="menu-item-content">
                                            <i class="fa-solid fa-layer-group menu-icon tertiary"></i>
                                            <span>Set Project</span>
                                        </div>
                                    </MudMenuItem>
                                    <MudMenuItem OnClick="SetProjectCover" Class="menu-item">
                                        <div class="menu-item-content">
                                            <i class="fa-solid fa-image-portrait menu-icon secondary"></i>
                                            <span>Project Cover</span>
                                        </div>
                                    </MudMenuItem>
                                </div>
                                
                                <div class="menu-divider"></div>
                                
                                <div class="menu-section">
                                    <MudMenuItem OnClick="OpenFileInExplorer" Class="menu-item">
                                        <div class="menu-item-content">
                                            <i class="fa-solid fa-folder-open menu-icon primary"></i>
                                            <span>Open in Explorer</span>
                                        </div>
                                    </MudMenuItem>
                                    <MudMenuItem OnClick="@(() => OnDeleteImage.InvokeAsync(Image))" Class="menu-item danger">
                                        <div class="menu-item-content">
                                            <i class="fa-solid fa-trash-can menu-icon error"></i>
                                            <span>Delete</span>
                                        </div>
                                    </MudMenuItem>
                                </div>
                            </div>
                        </ChildContent>
                    </MudMenu>
                </div>
            </div>
        </div>
        
        @* Persistent Indicators (visible when not hovered but has state) *@
        @if (!_isHovered && !_isMenuOpen)
        {
            @if (Image.Favorite)
            {
                <div class="favorite-indicator">
                    <i class="fa-solid fa-heart"></i>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public Image Image { get; set; }
    [Parameter] public string Target { get; set; }
    [Parameter] public EventCallback<Image> OnSelectImage { get; set; }
    [Parameter] public EventCallback<Image> OnDeleteImage { get; set; }
    [Parameter] public EventCallback OnCoverChanged { get; set; }
    [Parameter] public bool ShowSelectionCheckbox { get; set; }
    [Parameter] public bool UseFixedSize { get; set; } = false;

    private bool _isSelected;
    private bool _isHovered;
    private bool _isMenuOpen;

    protected override void OnInitialized()
    {
        _isSelected = M.SelectedImageIds.Contains(Image.Id);
        M.OnSelectedImagesChanged += Refresh;
        M.OnRefreshImagesContainer += Refresh;
    }

    private string GetCardClasses()
    {
        var classes = "gallery-card";
        if (UseFixedSize) classes += " fixed-size";
        if (_isSelected) classes += " selected";
        if (_isHovered || _isMenuOpen) classes += " hovered";
        return classes;
    }

    private void HandleMouseEnter()
    {
        _isHovered = true;
    }

    private void HandleMouseLeave()
    {
        // Don't clear hover if menu is open
        if (!_isMenuOpen)
        {
            _isHovered = false;
        }
    }

    private bool HasWorkflowForMode(ModeType mode)
    {
        // For WebUI, all modes are always available
        if (M.IsWebuiUp) return true;
        
        // For ComfyUI, check if there's a workflow for the current model base and requested mode
        if (M.IsComfyUIUp && M.State.Generation.Workflows != null)
        {
            var currentBase = M.State.Generation.WorkflowBase;
            return M.State.Generation.Workflows.Any(w => w.Base == currentBase && w.Mode == mode);
        }
        
        return false;
    }

    private Workflow? GetWorkflowForMode(ModeType mode)
    {
        if (M.State.Generation.Workflows == null) return null;
        
        var currentBase = M.State.Generation.WorkflowBase;
        return M.State.Generation.Workflows.FirstOrDefault(w => w.Base == currentBase && w.Mode == mode);
    }

    private async Task ToggleFavorite(bool isChecked)
    {
        Image.Favorite = !Image.Favorite;
        if (Image.Favorite && Image.Score == 0)
        {
            Image.Score = 3;
        }
        await DB.UpdateImage(Image);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetScore(int score)
    {
        Image.Score = score;
        await DB.UpdateImage(Image);
        await InvokeAsync(StateHasChanged);
    }

    private void OpenFileInExplorer() => Process.Start("explorer.exe", $"/select, {Image.Path}");

    private async Task SetProjectCover()
    {
        await DB.SetProjectCover(M.State.Gallery.ProjectId, Image.Path);
        await OnCoverChanged.InvokeAsync();
        Snackbar.Add($"Cover image selected for project {M.State.Gallery.ProjectName}.", Severity.Success);
    }

    private void SendTo(bool img2img)
    {
        var data = $"data:image/png;base64,{IO.GetBase64FromFile(Image.Path)}";
        if (img2img) M.CanvasImageData = data;
        else M.UpscaleImageData = data;
    }

    private void SendToImg2Vid()
    {
        var data = $"data:image/png;base64,{IO.GetBase64FromFile(Image.Path)}";
        M.Img2VidInputImage = data;
        
        // Find the Img2Vid workflow for the current model base
        var workflow = GetWorkflowForMode(ModeType.Img2Vid);
        if (workflow != null)
        {
            NavManager.NavigateTo($"/comfyui/img2vid/{workflow.Id}");
            Snackbar.Add("Image sent to Img2Vid", Severity.Success);
        }
        else
        {
            Snackbar.Add("No Img2Vid workflow found for current model base", Severity.Warning);
        }
    }

    private void ShowImageInfoDialog()
    {
        var param = new DialogParameters();
        param.Add("Image", Image);
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        DialogService.Show<ImageInfoDialog>("Image Info", param, options);
    }

    private async Task ShowSwitchProjectDialog()
    {
        var param = new DialogParameters();
        param.Add("Images", new List<Image>() { Image });
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ImageProjectDialog>("Switch Project", param, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var updatedImages = (List<Image>)result.Data;
            foreach (var image in updatedImages)
            {
                await DB.UpdateImage(image);
            }
            Snackbar.Add("Image project was changed.", Severity.Success);
        }
    }

    private void HandleSelected(bool isChecked)
    {
        if (isChecked) M.AddSelectedImage(Image.Id);
        else M.RemoveSelectedImage(Image.Id);
        _isSelected = isChecked;
    }

    private async void Refresh()
    {
        _isSelected = M.SelectedImageIds.Contains(Image.Id);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        M.OnSelectedImagesChanged -= Refresh;
        M.OnRefreshImagesContainer -= Refresh;
    }
}