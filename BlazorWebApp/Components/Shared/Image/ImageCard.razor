@using System.Diagnostics;
@using static BlazorWebApp.Data.Enums;
@using BlazorWebApp.Events
@inject IStateService State
@inject IGalleryService Gallery
@inject ISessionService Session
@inject IBackendService Backend
@inject IEventService Events
@inject IDatabaseService DB
@inject IIOService IO
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavManager
@inject IMediaSendToService SendTo
@implements IDisposable

<div class="@GetCardClasses()" @onmouseenter="HandleMouseEnter" @onmouseleave="HandleMouseLeave">
    @* Image Container *@
    <div class="image-wrapper">
        <img src="@IO.GetImageStaticFile(Image.Path)" alt="Generated image" class="card-image" loading="lazy" />
        
        @* Hover Overlay *@
        <div class="hover-overlay @(_isHovered || _isMenuOpen ? "visible" : "")">
            @* Top Section - Score & Selection *@
            <div class="overlay-top">
                <div class="rating-container @(_isHovered || _isMenuOpen || Image.Score > 0 ? "visible" : "")">
                    <MudRating SelectedValue="Image.Score" SelectedValueChanged="SetScore" MaxValue="3"
                               Size="Size.Small" Color="Color.Warning" />
                </div>
                
                @if (ShowSelectionCheckbox)
                {
                    <div class="selection-container @(_isHovered || _isMenuOpen || _isSelected ? "visible" : "")">
                        <MudCheckBox Checked="_isSelected" T="bool" CheckedChanged="HandleSelected" Color="Color.Success"
                                     UncheckedColor="Color.Default" Size="Size.Medium" />
                    </div>
                }
            </div>
            
            @* Center Section - Quick Actions *@
            <div class="overlay-center @(_isHovered || _isMenuOpen ? "visible" : "")">
                <div class="quick-actions">
                    <button class="action-btn primary" @onclick="@(() => OnSelectImage.InvokeAsync(Image))"
                            title="View Fullscreen">
                        <i class="fa-solid fa-expand"></i>
                    </button>
                    <button class="action-btn @(Image.Favorite ? "active" : "")"
                            @onclick="@(() => ToggleFavorite(!Image.Favorite))"
                            title="@(Image.Favorite ? "Remove from Favorites" : "Add to Favorites")">
                        <i class="@(Image.Favorite ? "fa-solid fa-heart" : "fa-regular fa-heart")"></i>
                    </button>
                    <button class="action-btn" @onclick="ToggleInfoDrawer" title="View Info">
                        <i class="fa-solid fa-info"></i>
                    </button>
                </div>
            </div>
            
            @* Bottom Section - Info & More Actions *@
            <div class="overlay-bottom @(_isHovered || _isMenuOpen ? "visible" : "")">
                <div class="image-info">
                    @if (!_isMenuOpen && Image.ModeId != 3)
                    {
                        <div class="info-row">
                            <span class="info-item">
                                <i class="fa-solid fa-seedling"></i>
                                @Image.Seed
                            </span>
                            <span class="info-item">
                                <i class="fa-solid fa-stairs"></i>
                                @Image.Steps
                            </span>
                            <span class="info-item">
                                <i class="fa-solid fa-scale-unbalanced"></i>
                                @Image.CfgScale
                            </span>
                        </div>
                    }
                    else if (!_isMenuOpen)
                    {
                        <div class="info-row">
                            <span class="info-item">Upscaled</span>
                            <span class="info-item">@Image.Width × @Image.Height</span>
                        </div>
                    }
                </div>
                
                <div class="media-card-actions">
                    <div class="more-actions media-action-rail-host">
                        @if (_isMenuOpen)
                        {
                            <div class="media-action-rail">
                                <button type="button" class="media-action-rail-btn danger" title="Delete" @onclick="@(() => RunActionAsync(() => OnDeleteImage.InvokeAsync(Image)))">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                                <button type="button" class="media-action-rail-btn primary" title="Open in Explorer" @onclick="@(() => RunAction(OpenFileInExplorer))">
                                    <i class="fa-solid fa-folder-open"></i>
                                </button>
                                <button type="button" class="media-action-rail-btn secondary" title="Project Cover" @onclick="@(() => RunActionAsync(SetProjectCover))">
                                    <i class="fa-solid fa-image-portrait"></i>
                                </button>
                                <button type="button" class="media-action-rail-btn tertiary" title="Set Project" @onclick="@(() => RunActionAsync(ShowSwitchProjectDialog))">
                                    <i class="fa-solid fa-layer-group"></i>
                                </button>
                                @if (SendTo.IsLocal(Image.Path))
                                {
                                    <button type="button" class="media-action-rail-btn tertiary" title="Generate Prompt" @onclick="@(() => RunActionAsync(SendToImageToPrompt))">
                                        <i class="fa-solid fa-magnifying-glass"></i>
                                    </button>
                                }
                                <MediaSendToDropdown Asset="Image" MediaType="SendToMediaType.Image" RenderAsActionButton="true"
                                                     ActionButtonClass="media-action-rail-btn primary" OnTargetSelected="CloseActionMenu" />
                            </div>
                        }
                        <button type="button" class="media-action-rail-trigger" title="More actions" @onclick="ToggleActionMenu">
                            <MudIcon Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" />
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        @* Persistent Indicators (visible when not hovered but has state) *@
        @if (!_isHovered && !_isMenuOpen)
        {
            @if (Image.Favorite)
            {
                <div class="favorite-indicator">
                    <i class="fa-solid fa-heart"></i>
                </div>
            }
        }
    </div>
</div>

<!-- Info Drawer -->
<AssetInfoDrawer @bind-IsVisible="_showInfoDrawer" Image="Image" IsVideo="false" />

@code {
    [Parameter] public Image Image { get; set; } = default!;
    [Parameter] public string Target { get; set; } = string.Empty;
    [Parameter] public EventCallback<Image> OnSelectImage { get; set; }
    [Parameter] public EventCallback<Image> OnDeleteImage { get; set; }
    [Parameter] public EventCallback OnCoverChanged { get; set; }
    [Parameter] public bool ShowSelectionCheckbox { get; set; }
    [Parameter] public bool UseFixedSize { get; set; } = false;

    private bool _isSelected;
    private bool _isHovered;
    private bool _isMenuOpen;
    private bool _showInfoDrawer;

    protected override void OnInitialized()
    {
        UpdateSelectionState();
        Events.Subscribe<ImageSelectionChangedEventArgs>(OnImageSelectionChanged);
        Events.Subscribe<StateChangedEventArgs>(OnStateChanged);
    }

    protected override void OnParametersSet()
    {
        UpdateSelectionState();
    }

    private void UpdateSelectionState()
    {
        if (Image != null)
        {
            _isSelected = Gallery.SelectedImageIds.Contains(Image.Id);
        }
    }

    private void OnImageSelectionChanged(ImageSelectionChangedEventArgs args)
    {
        UpdateSelectionState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged(StateChangedEventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetCardClasses()
    {
        var classes = "gallery-card";
        if (UseFixedSize) classes += " fixed-size";
        if (_isSelected) classes += " selected";
        if (_isHovered || _isMenuOpen) classes += " hovered";
        return classes;
    }

    private void HandleMouseEnter()
    {
        _isHovered = true;
    }

    private void HandleMouseLeave()
    {
        CloseActionMenu();
    }

    private async Task ToggleFavorite(bool isChecked)
    {
        Image.Favorite = !Image.Favorite;
        if (Image.Favorite && Image.Score == 0)
        {
            Image.Score = 3;
        }
        await DB.UpdateImage(Image);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetScore(int score)
    {
        Image.Score = score;
        await DB.UpdateImage(Image);
        await InvokeAsync(StateHasChanged);
    }

    private void OpenFileInExplorer() => Process.Start("explorer.exe", $"/select, {Image.Path}");

    private async Task SetProjectCover()
    {
        await DB.SetProjectCover(State.State.Gallery.ProjectId, Image.Path);
        await OnCoverChanged.InvokeAsync();
        Snackbar.Add($"Cover image selected for project {State.State.Gallery.ProjectName}.", Severity.Success);
    }

    /// <summary>
    /// Phase 12: Switch the LLM Tools tab to the Image-to-Prompt view, hand off the image
    /// through persisted state (Publish would race the navigation - the target view does not
    /// exist yet when the event fires, so the subscription set is empty), and navigate to /prompts.
    /// </summary>
    private async Task SendToImageToPrompt()
    {
        var resolved = IO.ResolveFilePath(Image.Path);
        if (string.IsNullOrWhiteSpace(resolved) || !File.Exists(resolved))
        {
            Snackbar.Add("Image file is not available on disk.", Severity.Warning);
            return;
        }

        try
        {
            var bytes = await File.ReadAllBytesAsync(resolved);
            var ext = Path.GetExtension(resolved).TrimStart('.').ToLowerInvariant();
            var mime = ext switch
            {
                "jpg" or "jpeg" => "image/jpeg",
                "webp" => "image/webp",
                "gif" => "image/gif",
                _ => "image/png"
            };

            var s = State.State.Prompts.LLM.ImageToPrompt;
            s.LastImageDataUri = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            s.LastSourceLabel = "Gallery";
            // Clear stale result so the new image starts with an empty prompt area.
            s.LastResultText = null;

            State.State.Prompts.LLM.ActiveViewId = "image-to-prompt";
            await State.SaveState();

            // Also publish the event for the same-page case (user already on /prompts and the
            // ImageToPromptView is mounted). The view's handler is idempotent with the state hydration.
            Events.Publish(new ImageToPromptRequestedEventArgs
            {
                ImagePath = resolved,
                SourceLabel = "Gallery"
            });

            NavManager.NavigateTo("/prompts");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to send image: {ex.Message}", Severity.Error);
        }
    }

    private void ToggleInfoDrawer()
    {
        _showInfoDrawer = !_showInfoDrawer;
    }

    private async Task ShowSwitchProjectDialog()
    {
        var param = new DialogParameters();
        param.Add("Images", new List<Image>() { Image });
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ImageProjectDialog>("Switch Project", param, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var updatedImages = (List<Image>)result.Data;
            foreach (var image in updatedImages)
            {
                await DB.UpdateImage(image);
            }
            Snackbar.Add("Image project was changed.", Severity.Success);
        }
    }

    private void HandleSelected(bool isChecked)
    {
        if (isChecked) Gallery.AddSelectedImage(Image.Id);
        else Gallery.RemoveSelectedImage(Image.Id);
        _isSelected = isChecked;
    }

    private void ToggleActionMenu()
    {
        _isMenuOpen = !_isMenuOpen;
        _isHovered = _isMenuOpen;
    }

    private void CloseActionMenu()
    {
        _isMenuOpen = false;
        _isHovered = false;
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        CloseActionMenu();
        await action();
    }

    private void RunAction(Action action)
    {
        CloseActionMenu();
        action();
    }

    public void Dispose()
    {
        Events.Unsubscribe<ImageSelectionChangedEventArgs>(OnImageSelectionChanged);
        Events.Unsubscribe<StateChangedEventArgs>(OnStateChanged);
    }
}