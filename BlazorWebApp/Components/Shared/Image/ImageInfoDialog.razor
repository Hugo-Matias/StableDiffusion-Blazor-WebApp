@using System.Text.Json
@inject OrchestratorService M
@inject IStateService State
@inject DatabaseService DB
@inject IOService IO
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div>
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6" Class="me-5"><MudIcon Icon="fa-solid fa-image" /> Image Info</MudText>
            <MudText Typo="Typo.caption" Style="opacity:0.3;">Id: @Image.Id</MudText>
        </TitleContent>
        <DialogContent>
            @if (Image.ModeId != 3)
            {
                <MudTabs Centered=true Rounded=true PanelClass="pa-3">
                    <MudTabPanel Text="Parameters">
                        <MudStack AlignItems="AlignItems.Center" Row=true>
                            <MudTextField T="string" Label="Prompt" Style="color: var(--mud-palette-success); font-size:0.8rem;" Text="@Image.Prompt" Lines="5" ReadOnly=true />
                            <ImageInfoCopyParameterButtons Property="@nameof(SharedParameters.Prompt)" OnTxt2ImgClicked="(e) => SetParameter(e, isImg2Img: false)" OnImg2ImgClicked="(e) => SetParameter(e, isImg2Img: true)" Vertical />
                        </MudStack>
                        <div class="spacer" />
                        <MudStack AlignItems="AlignItems.Center" Row=true>
                            <MudTextField T="string" Label="Negative Prompt" Style="color: var(--mud-palette-error); font-size: 0.8rem;" Text="@Image.NegativePrompt" Lines="5" ReadOnly=true />
                            <ImageInfoCopyParameterButtons Property="@nameof(SharedParameters.NegativePrompt)" OnTxt2ImgClicked="(e) => SetParameter(e, isImg2Img: false)" OnImg2ImgClicked="(e) => SetParameter(e, isImg2Img: true)" Vertical />
                        </MudStack>
                        <div class="spacer" />
                        <MudStack AlignItems="AlignItems.Center" Row=true>
                            <MudField Label="Model" Class="copy-btns">
                                @if (Image.Model != null)
                                {
                                    @Image.Model.Filename.Replace(".safetensors", "")
                                    <MudIconButton OnClick="@(async () => await M.SetSDModel(Image.Model.Filename))" Icon="fa-solid fa-upload icon" />
                                }
                                else if (!string.IsNullOrWhiteSpace(_modelName))
                                {
                                    <MudTooltip Text="Resource not found!">
                                        <MudText Color="Color.Error">@_modelName</MudText>

                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudText Color="Color.Warning">Unknown</MudText>
                                }
                            </MudField>
                            <MudField Label="Sampler" Class="copy-btns">
                                @GetSampler()
                                <ImageInfoCopyParameterButtons Property="@nameof(SharedParameters.SamplerIndex)" OnTxt2ImgClicked="(e) => SetParameter(e, isImg2Img: false)" OnImg2ImgClicked="(e) => SetParameter(e, isImg2Img: true)" />
                            </MudField>
                            <MudField Label="Scheduler" Class="copy-btns">
                                @Image.Scheduler
                                <ImageInfoCopyParameterButtons Property="@nameof(SharedParameters.Scheduler)" OnTxt2ImgClicked="(e) => SetParameter(e, isImg2Img: false)" OnImg2ImgClicked="(e) => SetParameter(e, isImg2Img: true)" />
                            </MudField>
                            <MudField Label="Steps" Class="copy-btns">
                                @Image.Steps.ToString()
                                <ImageInfoCopyParameterButtons Property="@nameof(SharedParameters.Steps)" OnTxt2ImgClicked="(e) => SetParameter(e, isImg2Img: false)" OnImg2ImgClicked="(e) => SetParameter(e, isImg2Img: true)" />
                            </MudField>
                        </MudStack>
                        <div class="spacer" />
                        <MudStack AlignItems="AlignItems.Center" Row=true>
                            <MudField Label="Seed" Class="copy-btns">
                                @Image.Seed.ToString()
                                <ImageInfoCopyParameterButtons Property="@nameof(SharedParameters.Seed)" OnTxt2ImgClicked="(e) => SetParameter(e, isImg2Img: false)" OnImg2ImgClicked="(e) => SetParameter(e, isImg2Img: true)" />
                            </MudField>
                            <MudField Label="CFG Scale" Class="copy-btns">
                                @Image.CfgScale.ToString()
                                <ImageInfoCopyParameterButtons Property="@nameof(SharedParameters.CfgScale)" OnTxt2ImgClicked="(e) => SetParameter(e, isImg2Img: false)" OnImg2ImgClicked="(e) => SetParameter(e, isImg2Img: true)" />
                            </MudField>
                            <MudField Label="Denoising Strength" Class="copy-btns">
                                @Image.DenoisingStrength.ToString()
                                <ImageInfoCopyParameterButtons Property="@nameof(SharedParameters.DenoisingStrength)" OnTxt2ImgClicked="(e) => SetParameter(e, isImg2Img: false)" OnImg2ImgClicked="(e) => SetParameter(e, isImg2Img: true)" />
                            </MudField>
                            <MudField Label="Width" Class="copy-btns">
                                @Image.Width.ToString() px
                                <ImageInfoCopyParameterButtons Property="@nameof(SharedParameters.Width)" OnTxt2ImgClicked="(e) => SetParameter(e, isImg2Img: false)" OnImg2ImgClicked="(e) => SetParameter(e, isImg2Img: true)" />
                            </MudField>
                            <MudField Label="Height" Class="copy-btns">
                                @Image.Height.ToString() px
                                <ImageInfoCopyParameterButtons Property="@nameof(SharedParameters.Height)" OnTxt2ImgClicked="(e) => SetParameter(e, isImg2Img: false)" OnImg2ImgClicked="(e) => SetParameter(e, isImg2Img: true)" />
                            </MudField>
                        </MudStack>
                        <div class="spacer" />
                        <MudStack AlignItems="AlignItems.Center" Row=true>
                            <MudTextField Label="Mode" Text="@GetMode()" T="string" ReadOnly=true />
                            <MudTextField Label="Path" Text="@Image.Path" T="string" ReadOnly=true />
                            <MudTextField Label="Created Date" Text="@Image.DateCreated.ToString()" T="string" ReadOnly=true />
                        </MudStack>
                    </MudTabPanel>
                    @if (_webuiInfoParams != null)
                    {
                        <MudTabPanel Text="Info Table">
                            <MudTable Items=_webuiInfoParams Style="max-height: 40vh; overflow: scroll;" Hover=true>
                                <HeaderContent>
                                    <MudTh>Parameter</MudTh>
                                    <MudTh>Value</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Parameter">@context.Key</MudTd>
                                    <MudTd DataLabel="Value">@context.Value</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudTabPanel>
                    }
                    else if (_comfyuiInfoParams != null)
                    {
                        <MudTabPanel Text="Workflow Info">
                            <MudPaper Style="max-height:70vh;overflow:auto;">
                                <MudTreeView T="JsonTreeNode" Dense=true>
                                    <JsonTreeView Node="_comfyuiInfoParams" />
                                </MudTreeView>
                            </MudPaper>
                        </MudTabPanel>
                    }
                </MudTabs>
            }
            else
            {
                <MudTextField Label="Details" Text="@_metadataInfo" Lines=3 T="string" ReadOnly=true />
                <div class="spacer" />
                <MudStack AlignItems="AlignItems.Center" Row=true>
                    <MudField Label="Width" Class="copy-btns">
                        @Image.Width.ToString() px
                        <ImageInfoCopyParameterButtons Property="@nameof(SharedParameters.Width)" OnTxt2ImgClicked="(e) => SetParameter(e, isImg2Img: false)" OnImg2ImgClicked="(e) => SetParameter(e, isImg2Img: true)" />
                    </MudField>
                    <MudField Label="Height" Class="copy-btns">
                        @Image.Height.ToString() px
                        <ImageInfoCopyParameterButtons Property="@nameof(SharedParameters.Height)" OnTxt2ImgClicked="(e) => SetParameter(e, isImg2Img: false)" OnImg2ImgClicked="(e) => SetParameter(e, isImg2Img: true)" />
                    </MudField>
                </MudStack>
                <div class="spacer" />
                <MudStack AlignItems="AlignItems.Center" Row=true>
                    <MudTextField Label="Mode" Text="@GetMode()" T="string" ReadOnly=true />
                    <MudTextField Label="Path" Text="@Image.Path" T="string" ReadOnly=true />
                    <MudTextField Label="Created Date" Text="@Image.DateCreated.ToString()" T="string" ReadOnly=true />
                </MudStack>
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => MudDialog.Cancel()">Close</MudButton>
            @if (Image.ModeId != 3)
            {
                <MudButtonGroup Class="m-2" OverrideStyles=false>
                    <MudButton Class="px-4" OnClick="() => LoadParameters(ModeType.Txt2Img)" StartIcon="fa-solid fa-pen-to-square" Color="Color.Warning">Load Txt2Img</MudButton>
                    <MudButton Class="px-4" OnClick="() => LoadParameters(ModeType.Img2Img)" StartIcon="fa-solid fa-square-pen" Color="Color.Warning">Load Img2Img</MudButton>
                    <MudButton Class="px-4" OnClick=ShowPromptDialog StartIcon="fa-solid fa-floppy-disk" Color="Color.Tertiary">Save Prompt</MudButton>
                </MudButtonGroup>
            }
        </DialogActions>
    </MudDialog>
</div>

@code {
    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Image Image { get; set; }

    private Dictionary<string, string>? _webuiInfoParams;
    private JsonTreeNode? _comfyuiInfoParams;
    private string _modelName = string.Empty;
    private string _metadataInfo = string.Empty;

    protected async override Task OnInitializedAsync()
    {
        // Read metadata from file
        _metadataInfo = await IO.ReadMetadata(Image.Path);
        if (string.IsNullOrWhiteSpace(_metadataInfo)) return;

        if(_metadataInfo.StartsWith("parameters", StringComparison.InvariantCultureIgnoreCase))
            await LoadInfoWebUI();

        if (_metadataInfo.StartsWith("prompt", StringComparison.InvariantCultureIgnoreCase))
            await LoadInfoComfyUI();
    }

    private async Task LoadInfoComfyUI()
    {
        var saveImage = false;
        var infoJson = _metadataInfo.Replace("prompt: ", "");
        _comfyuiInfoParams = Parser.ParseComfyUIInfoParameters(infoJson);

        using var doc = JsonDocument.Parse(infoJson);

        var scheduler = Parser.FindJsonValueByKey<string>(doc.RootElement, "scheduler");
        if (!string.IsNullOrWhiteSpace(scheduler) && Image.Scheduler != scheduler)
        {
            Image.Scheduler = scheduler;
            saveImage = true;
        }
        var sampler = Parser.FindJsonValueByKey<string>(doc.RootElement, "sampler_name");
        if (!string.IsNullOrWhiteSpace(sampler))
        {
            var samplerId = await DB.GetSamplerIdByName(sampler);
            if (samplerId != Image.SamplerId)
            {
                Image.SamplerId = samplerId;
                saveImage = true;
            }
        }
        var seed = Parser.FindJsonValueByKey<long>(doc.RootElement, "seed");
        if(seed > 0 && Image.Seed != seed)
        {
            Image.Seed = seed;
            saveImage = true;
        }
        if (Image.Model == null)
        {
            _modelName = Parser.FindJsonValueByKey<string>(doc.RootElement, "ckpt_name");  // Search for checkpoint
            if (string.IsNullOrWhiteSpace(_modelName))
                _modelName = Parser.FindJsonValueByKey<string>(doc.RootElement, "unet_name"); // Search for diffusion model

            if (!string.IsNullOrWhiteSpace(_modelName))
            {
                Image.Model = await DB.GetResourceByFilename(_modelName);
                saveImage = true;
            }
        }
        if(saveImage)
            await DB.UpdateImage(Image);
    }

    private async Task LoadInfoWebUI()
    {
        var saveImage = false;
        _webuiInfoParams = Parser.ParseWebUIInfoParameters(_metadataInfo);
        if (_webuiInfoParams.ContainsKey("Seed") && !string.IsNullOrWhiteSpace(_webuiInfoParams["Seed"]) && Image.Seed != long.Parse(_webuiInfoParams["Seed"]))
        {
            Image.Seed = long.Parse(_webuiInfoParams["Seed"]);
            saveImage = true;
        }
        if (_webuiInfoParams.ContainsKey("Schedule type") && !string.IsNullOrWhiteSpace(_webuiInfoParams["Schedule type"]) && Image.Scheduler != _webuiInfoParams["Schedule type"])
        {
            Image.Scheduler = _webuiInfoParams["Schedule type"];
            saveImage = true;
        }
        if (_webuiInfoParams.ContainsKey("Model") && !string.IsNullOrWhiteSpace(_webuiInfoParams["Model"]) && Image.Model == null)
        {
            _modelName = _webuiInfoParams["Model"];
            Image.Model = await DB.GetResourceByFilename(_modelName);
            saveImage = true;
        }
        if(saveImage)
            await DB.UpdateImage(Image);
    }

    private async Task ShowPromptDialog()
    {
        var prompt = new PromptResource() { Positive = Image.Prompt, Negative = Image.NegativePrompt };
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium };
        var param = new DialogParameters();
        param.Add("Prompt", prompt);
        var dialog = await DialogService.ShowAsync<PromptDialog>("", param, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await DB.CreatePrompt(new(prompt));
        }
    }

    private async Task LoadParameters(ModeType mode)
    {
        // Use StateService for parameter loading
        await State.LoadParametersFromImage(Image, mode);
        
        // Clean prompts using OrchestratorService
        bool isImg2Img = mode == ModeType.Img2Img;
        if (isImg2Img)
        {
            State.ParametersImg2Img.Prompt = M.ParseAndCleanCopiedPrompt(State.ParametersImg2Img.Prompt ?? string.Empty, false, isImg2Img);
            State.ParametersImg2Img.NegativePrompt = M.ParseAndCleanCopiedPrompt(State.ParametersImg2Img.NegativePrompt ?? string.Empty, true, isImg2Img);
        }
        else
        {
            State.ParametersTxt2Img.Prompt = M.ParseAndCleanCopiedPrompt(State.ParametersTxt2Img.Prompt ?? string.Empty, false, isImg2Img);
            State.ParametersTxt2Img.NegativePrompt = M.ParseAndCleanCopiedPrompt(State.ParametersTxt2Img.NegativePrompt ?? string.Empty, true, isImg2Img);
        }
        
        Snackbar.Add($"All parameters copied to {(mode == ModeType.Img2Img ? "Img2Img" : "Txt2Img")}.");
        MudDialog.Cancel();
    }

    private void SetParameter(string parameter, bool isImg2Img)
    {
        ModeType mode = isImg2Img ? ModeType.Img2Img : ModeType.Txt2Img;
        
        // Use StateService for parameter setting
        State.SetParameterFromImage(Image, parameter, mode);
        
        // Clean prompts if needed using OrchestratorService
        if (parameter == nameof(SharedParameters.Prompt))
        {
            if (isImg2Img)
                State.ParametersImg2Img.Prompt = M.ParseAndCleanCopiedPrompt(State.ParametersImg2Img.Prompt ?? string.Empty, false, isImg2Img);
            else
                State.ParametersTxt2Img.Prompt = M.ParseAndCleanCopiedPrompt(State.ParametersTxt2Img.Prompt ?? string.Empty, false, isImg2Img);
        }
        else if (parameter == nameof(SharedParameters.NegativePrompt))
        {
            if (isImg2Img)
                State.ParametersImg2Img.NegativePrompt = M.ParseAndCleanCopiedPrompt(State.ParametersImg2Img.NegativePrompt ?? string.Empty, true, isImg2Img);
            else
                State.ParametersTxt2Img.NegativePrompt = M.ParseAndCleanCopiedPrompt(State.ParametersTxt2Img.NegativePrompt ?? string.Empty, true, isImg2Img);
        }
        
        Snackbar.Add($"{parameter} copied to {(isImg2Img ? "Img2Img" : "Txt2Img")}.", Severity.Info);
    }

    private string GetSampler() => DB.GetSampler(Image.SamplerId).Result;

    private string GetMode()
    {
        return Image.ModeId switch
        {
            1 => "Txt2Img",
            2 => "Img2Img",
            3 => "Upscale",
            _ => "Unknown"
        };
    }
}
