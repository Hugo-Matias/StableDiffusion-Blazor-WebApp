@using BlazorWebApp.Events
@inject IStateService State
@inject ISettingsService Settings
@inject CivitaiService Api
@inject IDatabaseService DB
@inject IDialogService DialogService
@inject IEventService Events
@implements IDisposable

<TwoColumnLayout Collapsible="true"
                 @bind-Collapsed="State.State.Civitai.SidebarCollapsed"
                 SidebarTitle="Filters">
    <Sidebar>
        <EditForm Model="Request" OnSubmit="Search">
            <MudStack Spacing="2">
                <MudTextField @bind-Value="Request.Query" Label="Title" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable />

                <MudDivider Class="my-1" />

                <MudSelect T="string" Label="Base Model" MultiSelection Class="base-model-select"
                           SelectedValues="_selectedBaseModels" SelectedValuesChanged="HandleBaseModelsChanged"
                           AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" MaxHeight="400"
                           MultiSelectionTextFunc="@(selected => !selected.Any() || selected.Contains("All") ? "All" : string.Join(", ", selected))">
                    <MudSelectItem Value=@("All")>All</MudSelectItem>
                    @{
                        var disabledFamilies = Settings.Settings.Resources.Civitai.DisabledFamilies;
                        var disabledModels = Settings.Settings.Resources.Civitai.DisabledModels;
                        var visibleModels = Api.BaseModelsData.Models
                            .Where(m => m.Hidden != true)
                            .Where(m => !disabledModels.Contains(m.Name))
                            .Where(m => string.IsNullOrEmpty(m.Family) || !disabledFamilies.Contains(m.Family))
                            .ToList();
                        var familyGroups = visibleModels
                            .Where(m => !string.IsNullOrEmpty(m.FamilyDisplayName))
                            .GroupBy(m => m.FamilyDisplayName)
                            .OrderBy(g => g.Key);
                        var ungroupedModels = visibleModels.Where(m => string.IsNullOrEmpty(m.FamilyDisplayName));
                    }
                    @foreach (var group in familyGroups)
                    {
                        <MudSelectItem T="string" Disabled Value=@($"__header_{group.Key}")>
                            <div class="base-model-group-header">@group.Key</div>
                        </MudSelectItem>
                        @foreach (var model in group)
                        {
                            <MudSelectItem Value="@model.Name">@model.Name</MudSelectItem>
                        }
                    }
                    @if (ungroupedModels.Any())
                    {
                        <MudSelectItem T="string" Disabled Value=@("__header_Other")>
                            <div class="base-model-group-header">Other</div>
                        </MudSelectItem>
                        @foreach (var model in ungroupedModels)
                        {
                            <MudSelectItem Value="@model.Name">@model.Name</MudSelectItem>
                        }
                    }
                </MudSelect>

                <MudSelect @bind-Value="Request.Type" Label="Type" AnchorOrigin="Origin.BottomLeft"
                           TransformOrigin="Origin.TopLeft" MaxHeight="400">
                    @foreach (CivitaiModelType? modelType in Enum.GetValues(typeof(CivitaiModelType)))
                    {
                        <MudSelectItem Value="@modelType">@modelType</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect @bind-Value="Request.Sort" Label="Sort" AnchorOrigin="Origin.BottomLeft"
                           TransformOrigin="Origin.TopLeft">
                    @foreach (CivitaiSort? sort in Enum.GetValues(typeof(CivitaiSort)))
                    {
                        <MudSelectItem Value="@sort">@sort.ToString().Replace("_", " ")</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect @bind-Value="Request.Period" Label="Period" AnchorOrigin="Origin.BottomLeft"
                           TransformOrigin="Origin.TopLeft">
                    @foreach (CivitaiPeriod? period in Enum.GetValues(typeof(CivitaiPeriod)))
                    {
                        <MudSelectItem Value="@period">@period</MudSelectItem>
                    }
                </MudSelect>

                <MudDivider Class="my-1" />

                <MudTextField @bind-Value="Request.Username" Label="Username" Adornment="Adornment.Start"
                              AdornmentIcon="fa-solid fa-user" Clearable />
                <MudTextField @bind-Value="Request.Tag" Label="Tag" Adornment="Adornment.Start"
                              AdornmentIcon="fa-solid fa-tag" Clearable />

                <MudTextField @bind-Value="Request.Hash" Label="Hash" Adornment="Adornment.Start"
                              AdornmentIcon="fa-solid fa-hashtag" Clearable />

                <MudSlider @bind-Value="Request.Limit"
                           Min="Settings.Settings.Resources.Civitai.Limit.Min"
                           Max="Settings.Settings.Resources.Civitai.Limit.Max"
                           Step="Settings.Settings.Resources.Civitai.Limit.Step">
                    <small>Quantity:</small> @Request.Limit
                </MudSlider>
                <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center">
                    <MudTooltip Text="@($"Card size: {State.State.Civitai.CardSize}")">
                        <MudIconButton Icon="@GetCardSizeIcon()"
                                       Color="Color.Primary"
                                       OnClick="CycleCardSize"
                                       Size="Size.Medium" />
                    </MudTooltip>
                </MudStack>

                <MudDivider Class="my-1" />

                <MudButton ButtonType="ButtonType.Submit" Color="Color.Success" FullWidth="true"
                           Class="mt-3">Search</MudButton>
            </MudStack>
        </EditForm>
    </Sidebar>
    <Content>
        @if (_isSearching)
        {
            <LoadingSpinner />
        }
        else if (_models != null)
        {
            @if (_models.Metadata.TotalPages > 1)
            {
                <div class="d-flex flex-column align-center pb-2">
                    <MudPagination SelectedChanged="HandlePageSelected" Selected="(int)Request.Page" BoundaryCount="2" MiddleCount="5"
                                   Count="_models.Metadata.TotalPages" />
                </div>
            }

            <div class="civitai-scroll-container">
                <MudGrid Spacing="1" Justify="Justify.Center">
                    @foreach (var model in _models.Models)
                    {
                        <CivitaiResourceCard
                            Title="@model.Name"
                            ImageSrc="@GetModelImage(model)"
                            Type="@model.Type"
                            Width="@CardWidth"
                            HoverColor="@(Parser.ParseCivitaiResourceColorAsString((CivitaiModelType)Enum.Parse(typeof(CivitaiModelType), model.Type)))"
                            OnLoad="@(async () => await ShowInfo(model))"
                            Opacity="CheckModelExists(model).Result"
                            Filter="@CheckVersionImagesExist(model).Result"
                            CreatorUsername="@model.Creator?.Username"
                            CreatorImage="@model.Creator?.Image"
                            IsNsfw="@model.Nsfw"
                            IsEarlyAccess="@(model.ModelVersions?.Count > 0 && model.ModelVersions[0].Images?.Count > 0 && model.ModelVersions[0].Images[0].Availability == "EarlyAccess")"
                            DownloadCount="0"
                            FavoriteCount="0"
                            CommentCount="0"
                            Rating="0"
                            RatingCount="0"
                            ShowStats="false" />
                    }
                </MudGrid>
            </div>

            @if (_models.Metadata.TotalPages > 1)
            {
                <div class="d-flex flex-column align-center pt-2">
                    <MudPagination SelectedChanged="HandlePageSelected" Selected="(int)Request.Page" BoundaryCount="2" MiddleCount="5"
                                   Count="_models.Metadata.TotalPages" />
                </div>
            }

            <div class="d-flex flex-column align-center pa-2">
                @if (!string.IsNullOrWhiteSpace(_models.Metadata.NextPage))
                {
                    <MudButton Class="w-50" OnClick=@(() => LoadMore(_models.Metadata.NextPage)) ButtonType="ButtonType.Button"
                               Color="Color.Primary" Variant="Variant.Outlined">Load More</MudButton>
                }
            </div>
        }
    </Content>
</TwoColumnLayout>

@code {
    public CivitaiModelsRequest Request { get; set; }
    private bool _isSearching;
    private CivitaiModelsDto _models;
    private IEnumerable<string> _selectedBaseModels = new List<string> { "All" };

    public void Dispose()
    {
        Events.Unsubscribe<CivitaiSettingsChangedEventArgs>(OnCivitaiSettingsChanged);
    }

    private void OnCivitaiSettingsChanged(CivitaiSettingsChangedEventArgs args)
    {
        InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        Events.Subscribe<CivitaiSettingsChangedEventArgs>(OnCivitaiSettingsChanged);
        LoadState();
    }

    private string CardWidth => State.State.Civitai.CardSize switch
    {
        ResourceCardSize.Small => "12rem",
        ResourceCardSize.Large => "22rem",
        _ => "16rem"
    };

    private void CycleCardSize()
    {
        State.State.Civitai.CardSize = State.State.Civitai.CardSize switch
        {
            ResourceCardSize.Small => ResourceCardSize.Medium,
            ResourceCardSize.Medium => ResourceCardSize.Large,
            _ => ResourceCardSize.Small
        };
        StateHasChanged();
    }

    private string GetCardSizeIcon() => State.State.Civitai.CardSize switch
    {
        ResourceCardSize.Small => "fa-solid fa-grip",
        ResourceCardSize.Large => "fa-solid fa-square",
        _ => "fa-solid fa-table-cells-large"
    };

    private async Task Search()
    {
        _isSearching = true;
        SetState();
        _models = await Api.GetModels(Request);
        await State.SaveState();
        _isSearching = false;
    }

    private string? GetModelImage(CivitaiModelsModelDto model)
    {
        if (model.ModelVersions?.Count > 0 && model.ModelVersions[0].Images?.Count > 0)
        {
            return model.ModelVersions[0].Images[0].Url;
        }
        return null;
    }

    private async Task ShowInfo(CivitaiModelsModelDto modelsModel)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large };
        var dialogParam = new DialogParameters();
        var model = await Api.GetModel(modelsModel.Id);
        dialogParam.Add("Model", model);
        var dialog = await DialogService.ShowAsync<CivitaiModelInfoDialog>("Model", dialogParam, options);
        var result = await dialog.Result;
    }

    private async Task HandlePageSelected(int selection)
    {
        // Pagination components somehow call this method in an endless loop if the page number is higher than 1.
        if (Request.Page != selection)
        {
            Request.Page = selection;
            await Search();
        }
    }

    private async Task LoadMore(string url)
    {
        var content = await Api.GetModelsFromUrl(url);
        _models.Metadata = content.Metadata;
        _models.Models.AddRange(content.Models);
    }

    private async Task<float> CheckModelExists(CivitaiModelsModelDto model)
    {
        var modelExists = await DB.CheckResourceExistsByModelId(model.Id);
        if (!modelExists) return 1f;
        else
        {
            // If the first (usually latest) version exists in the database we consider it to be updated and reflect that by
            // lowering the resource button opacity
            var versionExists = await DB.CheckResourceExistsByModelVersionId(model.ModelVersions[0].Id);
            return versionExists ? Settings.Settings.Resources.Civitai.ExistsButtonOpacity : 1f;
        }
    }

    private async Task<string> CheckVersionImagesExist(CivitaiModelsModelDto model)
    {
        if (model.ModelVersions.Count == 0) return string.Empty;
        var versionId = model.ModelVersions[0].Id;
        var versionExists = await DB.CheckResourceExistsByModelVersionId(versionId);
        if (versionExists)
        {
            var versionImageCount = model.ModelVersions[0].Images.Count;
            var dbImageCount = await DB.ResourceImageByModelVersionIdCount(versionId);

            if (dbImageCount == 0) return Settings.Settings.Resources.Civitai.ImageNoneFilter;
            else if (versionImageCount > dbImageCount) return Settings.Settings.Resources.Civitai.ImageMissingFilter;
            else if (versionImageCount < dbImageCount) return Settings.Settings.Resources.Civitai.ImageExtraFilter;
            else return Settings.Settings.Resources.Civitai.ImageOkFilter;
        }
        return string.Empty;
    }

    private void HandleBaseModelsChanged(IEnumerable<string> values)
    {
        var selected = values.ToList();
        var previouslyHadAll = _selectedBaseModels.Contains("All");

        if (selected.Contains("All") && !previouslyHadAll)
        {
            // User just clicked "All" — clear everything else
            _selectedBaseModels = new List<string> { "All" };
        }
        else if (selected.Contains("All") && selected.Count > 1)
        {
            // User picked a specific model while "All" was selected — remove "All"
            _selectedBaseModels = selected.Where(s => s != "All").ToList();
        }
        else if (!selected.Any())
        {
            // Nothing selected — default to "All"
            _selectedBaseModels = new List<string> { "All" };
        }
        else
        {
            _selectedBaseModels = selected;
        }

        // Sync to request: when "All" is selected, send empty list (no filter)
        Request.BaseModels = _selectedBaseModels.Contains("All")
            ? Enumerable.Empty<string>()
            : _selectedBaseModels;
    }

    private void LoadState()
    {
        Request = new();
        Request.Query = State.State.Civitai.Models.Shared.Query;
        Request.Limit = State.State.Civitai.Models.Shared.Limit;
        Request.Page = State.State.Civitai.Models.Shared.Page;
        Request.Username = State.State.Civitai.Models.Username;
        Request.Tag = State.State.Civitai.Models.Tag;
        Request.Type = State.State.Civitai.Models.Type;
        Request.Sort = State.State.Civitai.Models.Sort;
        var savedModels = State.State.Civitai.Models.BaseModels?.ToList() ?? new List<string>();
        _selectedBaseModels = savedModels.Any() ? savedModels : new List<string> { "All" };
        Request.BaseModels = _selectedBaseModels.Contains("All") ? Enumerable.Empty<string>() : _selectedBaseModels;
        Request.Period = State.State.Civitai.Models.Period;
        Request.Rating = State.State.Civitai.Models.Rating;
        Request.Favorites = State.State.Civitai.Models.Favorites;
        Request.Hidden = State.State.Civitai.Models.Hidden;
        Request.IsPrimaryFileOnly = State.State.Civitai.Models.IsPrimaryFileOnly;
        Request.Hash = State.State.Civitai.Models.Hash;
    }

    private void SetState()
    {
        State.State.Civitai.Models.Shared.Query = Request.Query;
        State.State.Civitai.Models.Shared.Limit = (int)Request.Limit;
        State.State.Civitai.Models.Shared.Page = (int)Request.Page;
        State.State.Civitai.Models.Username = Request.Username;
        State.State.Civitai.Models.Tag = Request.Tag;
        State.State.Civitai.Models.Type = Request.Type;
        State.State.Civitai.Models.Sort = (CivitaiSort)Request.Sort;
        State.State.Civitai.Models.BaseModels = _selectedBaseModels.ToList();
        State.State.Civitai.Models.Period = (CivitaiPeriod)Request.Period;
        State.State.Civitai.Models.Rating = (int)Request.Rating;
        State.State.Civitai.Models.Favorites = (bool)Request.Favorites;
        State.State.Civitai.Models.Hidden = (bool)Request.Hidden;
        State.State.Civitai.Models.IsPrimaryFileOnly = (bool)Request.IsPrimaryFileOnly;
        State.State.Civitai.Models.Hash = Request.Hash;
    }
}
