@inject IDatabaseService DB
@inject IOService IO
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="@GetCardClasses()" @onmouseenter="() => _isHovered = true" @onmouseleave="() => _isHovered = false">
    <div class="image-wrapper">
        @if (IsVideo())
        {
            @* Video content *@
            <video class="card-video" autoplay loop muted playsinline>
                <source src="@Image.Url" />
            </video>
        }
        else
        {
            <img src="@Image.Url" 
                 alt="Civitai image" 
                 class="card-image" 
                 loading="lazy"
                 @onerror="HandleImageError" />
        }
        
        @* Fallback for failed images *@
        @if (_imageError)
        {
            <div class="image-fallback">
                <i class="fa-solid fa-image"></i>
                <span>Image unavailable</span>
            </div>
        }
        
        @* Hover Overlay *@
        <div class="hover-overlay @(_isHovered ? "visible" : "")">
            @* Top Section - Sampler Badge *@
            <div class="overlay-top @(_isHovered ? "visible" : "")">
                @if (Image.Meta != null && !string.IsNullOrWhiteSpace(Image.Meta.Sampler))
                {
                    <div class="sampler-badge" style="@GetSamplerBadgeStyle()">
                        @Image.Meta.Sampler
                    </div>
                }
                else
                {
                    <div></div>
                }
                @if (IsVideo())
                {
                    <div class="video-badge">
                        <i class="fa-solid fa-video"></i>
                    </div>
                }
            </div>
            
            @* Center Section - Quick Actions *@
            <div class="overlay-center @(_isHovered ? "visible" : "")">
                <div class="quick-actions">
                    <button class="action-btn" @onclick="@(() => SendTo(true))" title="Send to Img2Img">
                        <i class="fa-solid fa-file-image"></i>
                    </button>
                    <button class="action-btn" @onclick="@(() => SendTo(false))" title="Send to Upscale">
                        <i class="fa-solid fa-panorama"></i>
                    </button>
                    @if (Image.Meta != null)
                    {
                        <button class="action-btn primary" @onclick="ShowImageInfoDialog" title="View Info">
                            <i class="fa-solid fa-info"></i>
                        </button>
                    }
                </div>
            </div>
            
            @* Bottom Section - Metadata Info *@
            <div class="overlay-bottom @(_isHovered ? "visible" : "")">
                @if (Image.Meta != null)
                {
                    <div class="info-row">
                        <span class="info-item">
                            <i class="fa-solid fa-seedling"></i>
                            @Image.Meta.Seed
                        </span>
                        <span class="info-item">
                            <i class="fa-solid fa-stairs"></i>
                            @Image.Meta.Steps
                        </span>
                        <span class="info-item">
                            <i class="fa-solid fa-scale-unbalanced"></i>
                            @Image.Meta.CfgScale
                        </span>
                        @if (Image.Meta.DenoisingStrength != null)
                        {
                            <span class="info-item">
                                <i class="fa-solid fa-braille"></i>
                                @Image.Meta.DenoisingStrength
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="info-row">
                        <span class="info-item no-meta">No metadata</span>
                    </div>
                }
            </div>
        </div>
        
        @* Persistent Sampler Indicator *@
        @if (!_isHovered && Image.Meta != null && !string.IsNullOrWhiteSpace(Image.Meta.Sampler))
        {
            <div class="sampler-indicator" style="@GetSamplerBadgeStyle()">
                @GetSamplerAbbrev()
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public CivitaiImageDto Image { get; set; }
    [Parameter] public EventCallback OnSaveImage { get; set; }

    private bool _isHovered;
    private bool _imageError;

    private string GetCardClasses()
    {
        var classes = "civitai-card";
        if (_isHovered) classes += " hovered";
        if (_imageError) classes += " error";
        return classes;
    }

    private bool IsVideo()
    {
        // Check by ImageType bytes (first byte is 0 for video)
        if (Image.ImageType != null && Image.ImageType.Length > 0 && Image.ImageType[0] == 0)
            return true;
        
        // Also check URL extension as fallback
        if (!string.IsNullOrWhiteSpace(Image.Url))
        {
            var url = Image.Url.ToLowerInvariant();
            return url.Contains(".mp4") || url.Contains(".webm") || url.Contains(".webp") || url.Contains(".gif");
        }
        
        return false;
    }

    private void HandleImageError()
    {
        _imageError = true;
        StateHasChanged();
    }

    private void SendTo(bool img2img)
    {
        // var data = $"data:image/png;base64,{IO.GetBase64FromFile(Image.Path)}";
        // if (img2img) M.CanvasImageData = data;
        // else M.UpscaleImageData = data;
    }

    private string GetSamplerBadgeStyle()
    {
        var color = GetSamplerColor();
        return $"background: {color};";
    }

    private string GetSamplerColor()
    {
        if (Image.Meta?.Sampler == null) return "rgba(158, 158, 158, 0.8)";
        
        return Image.Meta.Sampler switch
        {
            "Euler" or "Euler a" => "rgba(76, 175, 80, 0.85)",
            "Heun" => "rgba(156, 39, 176, 0.85)",
            "DDIM" => "rgba(66, 66, 66, 0.85)",
            "DPM2" or "DPM2 a" => "rgba(255, 152, 0, 0.85)",
            "LMS" or "PLMS" => "rgba(244, 67, 54, 0.85)",
            "DPM++ 2S a" or "DPM++ 2M" or "DPM fast" or "DPM adaptive" => "rgba(0, 150, 136, 0.85)",
            _ => "rgba(33, 150, 243, 0.85)"
        };
    }

    private string GetSamplerAbbrev()
    {
        if (Image.Meta?.Sampler == null) return "?";
        var sampler = Image.Meta.Sampler;
        if (sampler.Length <= 3) return sampler;
        return sampler.Length > 6 ? sampler[..3] : sampler[..Math.Min(4, sampler.Length)];
    }

    private void ShowImageInfoDialog()
    {
        var param = new DialogParameters();
        param.Add("Image", Image);
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        DialogService.Show<CivitaiImageDialog>("Image Info", param, options);
    }
}
