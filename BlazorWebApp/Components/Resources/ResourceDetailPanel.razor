    private static bool IsVideo(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return false;
        var lower = path.ToLowerInvariant();
        return lower.Contains(".mp4") || lower.Contains(".webm") || lower.Contains(".mov") || lower.Contains(".m4v");
    }

