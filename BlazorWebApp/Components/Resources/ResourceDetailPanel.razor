    private void QueueCheckpointForWorkflow(LocalResourceFile file, Workflow workflow)
    {
        if (workflow.Assets == null) return;
        var checkpointAsset = workflow.Assets.FirstOrDefault(a =>
            a.Type == AssetType.DiffusionModel ||
            a.Type == AssetType.CheckpointModel);
        if (checkpointAsset == null) return;
        ParameterService.QueuePendingAsset(checkpointAsset.Parameter, file.Filename);
    }

    private async Task QueueLoraForGenerate(LocalResourceFile file, string resourceType)
    {
        var path = await ResolveBackendLoraPath(file, resourceType);
        var filename = Path.GetFileNameWithoutExtension(path);
        var weight = State.State.Resources.Weight;

        var newLora = new Lora { Name = filename, Path = path, Strength = weight, IsNegative = false, IsEnabled = true };
        ParameterService.QueuePendingLora(newLora);
    }

    private async Task<string> ResolveBackendLoraPath(LocalResourceFile file, string resourceType)
    {
        var candidates = BuildLoraPathCandidates(file, resourceType);

        try
        {
            var available = (await Router.SearchLoras(BlazorWebApp.Data.Enums.Backend.ComfyUI, string.Empty)).ToList();
            var exact = available.FirstOrDefault(path => candidates.Contains(NormalizeModelPath(path)));
            if (!string.IsNullOrWhiteSpace(exact)) return exact;

            var filename = file.File.Name;
            var byFilename = available.FirstOrDefault(path => Path.GetFileName(path).Equals(filename,
StringComparison.InvariantCultureIgnoreCase));
            if (!string.IsNullOrWhiteSpace(byFilename)) return byFilename;
        }
        catch
        {
        }

        return candidates.FirstOrDefault(path => !path.Equals(file.File.Name, StringComparison.InvariantCultureIgnoreCase)) ??
file.File.Name;
    }

    private HashSet<string> BuildLoraPathCandidates(LocalResourceFile file, string resourceType)
    {
        var comp = StringComparison.InvariantCultureIgnoreCase;
        var candidates = new HashSet<string>(StringComparer.InvariantCultureIgnoreCase)
        {
            NormalizeModelPath(file.File.Name)
        };

        var resourcesPath = Configuration["ResourcesPath"];
        if (string.IsNullOrWhiteSpace(resourcesPath)) return candidates;

        foreach (var folder in new[] { "LORA", resourceType }.Distinct(StringComparer.InvariantCultureIgnoreCase))
        {
            var basePath = Path.Combine(resourcesPath, folder);
            var fullPath = file.File.FullName;
            if (!fullPath.StartsWith(basePath, comp)) continue;

            var relative = fullPath.Substring(basePath.Length).TrimStart(Path.DirectorySeparatorChar,
Path.AltDirectorySeparatorChar);
            if (!string.IsNullOrWhiteSpace(relative)) candidates.Add(NormalizeModelPath(relative));
        }

        return candidates;
    }

    private static string NormalizeModelPath(string path)
        => path.Replace(Path.DirectorySeparatorChar, '/').Replace(Path.AltDirectorySeparatorChar, '/');

    private void QueueTriggerWords(List<string> triggerWords)
    {
        if (triggerWords.Count == 0) return;
        ParameterService.QueuePendingPromptAppend(string.Join(", ", triggerWords));
    }

    private void ToggleTriggerWord(string word)
    {
        if (_selectedTriggerWords.Contains(word)) _selectedTriggerWords.Remove(word);
        else _selectedTriggerWords.Add(word);
    }

    private void SoloTriggerWord(string word)
    {
        _selectedTriggerWords = _selectedTriggerWords.Count == 1 && _selectedTriggerWords.Contains(word)
            ? new List<string>(_selectedFile?.TriggerWords ?? new List<string>())
            : new List<string> { word };
    }

