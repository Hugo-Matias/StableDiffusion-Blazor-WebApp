@inject IStateService State
@inject ISettingsService Settings
@inject IIOService IO
@inject IDatabaseService DB
@inject IResourcesService ResourcesService
@inject IConfiguration Configuration
@inject IDialogService DialogService
@inject IBackendService Backend

<MudDialog Class="pa-4">
    <TitleContent>
        <MudStack Row=true>
            <MudStack>
                <MudText Typo="Typo.h6">@Resource.Title</MudText>
                @if (Resource.CivitaiId != null)
                {
                    <MudLink Target="_blank" Href=@($"https://civitai.com/models/{Resource.CivitaiId}") Color="Color.Info"
                             Typo="Typo.caption" Style="opacity: 0.3; font-size:0.7rem; margin-top: -1.2rem;">@($"Model:    {Resource.CivitaiId}{(File.CivitaiId != null ? $" | File: {File.CivitaiId}" : "")}")</MudLink>
                }
            </MudStack>
            <MudSpacer />
            <MudChip Text="@Resource.Type.Name"
                     Color="Enum.TryParse<CivitaiModelType>(Resource.Type.Name, out var modelType) ? Parser.ParseCivitaiResourceColorAsColor(modelType) : Color.Default"
                     Label=true />
            @if (Resource.SubType != null)
            {
                <MudChip Text="@Resource.SubType.Name" Color="Color.Tertiary" Label=true />
            }
            @if (!string.IsNullOrWhiteSpace(Resource.BaseModel))
            {
                <MudChip Color="Color.Info" Text="@Resource.BaseModel" Label=true />
            }
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudTabs Elevation="0" PanelClass="mt-4" Rounded Centered>
            <MudTabPanel Text="Data">
                <MudText Class="mb-4" Style="text-align:center;" Color="Color.Primary" Typo="Typo.button">@File.Filename
                    @((File.SizeKb != 0 ? $"({Parser.ParseSizeKb(File.SizeKb)})" : ""))</MudText>
                    @if (File.Description != null)
                    {
                        <MudContainer Class="my-4" Style="max-height: 200px; overflow: scroll;">
                            @((MarkupString)File.Description)
                        </MudContainer>
                    }
                    <MudChipSet ReadOnly=true>
                        @foreach (var tag in Resource.Tags)
                        {
                            <MudChip Variant="Variant.Text" Text="@tag" Label=true />
                        }
                    </MudChipSet>
                    @if (File.TriggerWords != null && File.TriggerWords.Count >= 1)
                    {
                        <MudStack Row=true Class="align-center flex-wrap">
                            <MudText Typo="Typo.caption" Class="me-2">Trigger Words</MudText>
                            @foreach (var word in File.TriggerWords)
                            {
                                var w = word;
                                var isSelected = _selectedTriggerWords.Contains(w);
                                <span @ondblclick="@(() => SoloTriggerWord(w))" @ondblclick:preventDefault @ondblclick:stopPropagation>
                                    <MudChip Color="@(isSelected ? Color.Primary : Color.Default)" Label=true
                                             Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                             Style="@($"max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;{(!isSelected ? " opacity:0.5; text-decoration:line-through;" : "")}")"
                                             title="@w" OnClick="@(() => ToggleTriggerWord(w))">@w</MudChip>
                                </span>
                            }
                        </MudStack>
                    }
                    @if (Resource.Type.Name.Equals("Checkpoint", StringComparison.InvariantCultureIgnoreCase))
                    {
                        @if (_compatibleWorkflows.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mt-4 mb-2">Send to workflow:</MudText>
                            <MudStack Spacing="1">
                                @foreach (var workflow in _compatibleWorkflows)
                                {
                                    var wf = workflow;
                                    <MudButton Class="w-100" OnClick="@(() => MudDialog.Close(("SendToWorkflow", wf)))"
                                               Color="Color.Success" ButtonType="ButtonType.Button"
                                               Disabled="@(!Backend.IsBackendAvailable || !File.IsEnabled)" Variant="Variant.Outlined">
                                        @wf.Title (@wf.Base)
                                    </MudButton>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-4">No compatible workflows found for this
                                model.</MudText>
                            }
                        }
                else
                        {
                            <MudSlider T="float" ValueChanged=@((value) => HandleResourceWeightChanged(value))
                                       Value=State.State.Resources.Weight Min="Settings.Settings.Resources.Weight.Min"
                                       Max="Settings.Settings.Resources.Weight.Max" Step="Settings.Settings.Resources.Weight.Step"
                                       ValueLabel><small>Resource Weight: </small> @State.State.Resources.Weight</MudSlider>
                        }
                        @if (!(Resource.Type.Name.Equals("Checkpoint", StringComparison.InvariantCultureIgnoreCase) &&
                                        (File.TriggerWords == null || File.TriggerWords.Count == 0)))
                        {
                            @if (_isLoraType)
                            {
                                @if (_compatibleWorkflows.Count > 0)
                                {
                                    <MudText Typo="Typo.caption" Class="mt-4 mb-2">Add LoRA to workflow:</MudText>
                                    <MudStack Spacing="1">
                                        @foreach (var workflow in _compatibleWorkflows)
                                        {
                                            var wf = workflow;
                                            <MudButton Class="w-100" OnClick="@(() => AddLoraToWorkflow(wf))" Color="Color.Success"
                                                       ButtonType="ButtonType.Button" Disabled="@(!Backend.IsBackendAvailable || !File.IsEnabled)"
                                                       Variant="Variant.Outlined">
                                                <MudIcon Icon="fa-solid fa-plus" Class="me-2" /> @wf.Title (@wf.Base)
                                            </MudButton>
                                        }
                                    </MudStack>
                                }
                                else
                                {
                                    <MudStack Class="align-items-center justify-content-center mt-4 mb-2" Row=true>
                                        <MudButton OnClick="@(() => AddLoraToLoader(false))" ButtonType="ButtonType.Button"
                                                   Color="Color.Success" Variant="Variant.Filled"
                                                   Disabled="@(!Backend.IsBackendAvailable || !File.IsEnabled)" FullWidth="true">
                                            <MudIcon Icon="fa-solid fa-plus" Class="me-2" /> Add to LoRA Loader
                                        </MudButton>
                                    </MudStack>
                                }
                            }
                            else
                            {
                                <MudStack Class="align-items-center justify-content-center mt-4 mb-2" Row=true>
                                    <MudButton OnClick="@(() => LoadResource(true))" ButtonType="ButtonType.Button"
                                               Color="Color.Success" Variant="Variant.Filled"
                                               Disabled="@(!Backend.IsBackendAvailable || !File.IsEnabled)">Prompt</MudButton>
                                    <MudButton OnClick="@(() => LoadResource(false))" ButtonType="ButtonType.Button" Color="Color.Error"
                                               Variant="Variant.Filled" Disabled="@(!Backend.IsBackendAvailable || !File.IsEnabled)">Negative
                                        Prompt</MudButton>
                                    </MudStack>
                                }
                            }
                        </MudTabPanel>
                        <MudTabPanel Text="Images">
                            <MudGrid Style="width: 100%; max-height:80vh; overflow: scroll; justify-content:center !important;">
                                @foreach (var image in _images)
                                {
                                    <ResourceImageCard Image="image" />
                                }
                            </MudGrid>
                        </MudTabPanel>
                    </MudTabs>
                </DialogContent>
                <DialogActions>
                    <MudButton Variant="Variant.Filled" IconColor=@(File.IsEnabled? Color.Success: Color.Error)
                               StartIcon=@(File.IsEnabled ? "fa-solid fa-circle" : "fa-solid fa-circle-dot") Color=Color.Dark
                               OnClick="ToggleFile">@(File.IsEnabled ? "Disable" : "Enable")</MudButton>
                    <MudButton Variant=Variant.Filled Color=Color.Primary OnClick=@(() => MudDialog.Close("Edit"))>Edit</MudButton>
                </DialogActions>
            </MudDialog>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public LocalResource Resource { get; set; }
    [Parameter] public LocalResourceFile File { get; set; }

    private List<ResourceImage> _images;
    private List<Workflow> _compatibleWorkflows = new();
    private bool _isLoraType;
    private List<string> _selectedTriggerWords = new();

    protected async override Task OnInitializedAsync()
    {
        _images = File.CivitaiId != null ? await DB.GetResourceImages((int)File.CivitaiId) : new();

        var comp = StringComparison.InvariantCultureIgnoreCase;
        _isLoraType = Resource.Type.Name.Equals("LORA", comp) || Resource.Type.Name.Equals("LoCon", comp);

        // Initialize all trigger words as selected
        if (File.TriggerWords != null && File.TriggerWords.Count > 0)
            _selectedTriggerWords = new List<string>(File.TriggerWords);

        // Build compatible workflows list for checkpoints and LoRAs
        if (!string.IsNullOrWhiteSpace(Resource.BaseModel))
        {
            var allWorkflows = State.State?.Generation?.Workflows;
            if (allWorkflows != null)
            {
                _compatibleWorkflows = allWorkflows
                    .Where(w => w.CompatibleResourceBaseModels != null &&
                                w.CompatibleResourceBaseModels.Any(b => b.Equals(Resource.BaseModel, comp)))
                    .ToList();
            }
        }
    }

    private void LoadResource(bool isPrompt) => MudDialog.Close(isPrompt);

    private void AddLoraToLoader(bool isNegative) => MudDialog.Close(("AddLora", isNegative, _selectedTriggerWords));

    private void AddLoraToWorkflow(Workflow workflow) => MudDialog.Close(("AddLoraToWorkflow", workflow, _selectedTriggerWords));

    private void ToggleTriggerWord(string word)
    {
        if (_selectedTriggerWords.Contains(word))
            _selectedTriggerWords.Remove(word);
        else
            _selectedTriggerWords.Add(word);
    }

    private void SoloTriggerWord(string word)
    {
        if (_selectedTriggerWords.Count == 1 && _selectedTriggerWords.Contains(word))
            _selectedTriggerWords = new List<string>(File.TriggerWords);
        else
            _selectedTriggerWords = new List<string> { word };
    }

    private void HandleResourceWeightChanged(float value)
    {
        State.State.Resources.Weight = value;
        Settings.SaveSettings();
    }

    private async Task ToggleFile()
    {
        await ResourcesService.ToggleResource(Resource, File);
        MudDialog.Close("Toggle");
    }
}
