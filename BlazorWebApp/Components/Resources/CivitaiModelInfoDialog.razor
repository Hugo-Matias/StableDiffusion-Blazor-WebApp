@inject IStateService State
@inject IDatabaseService DB
@using BlazorWebApp.Data.Dtos

<MudDialog Class="civitai-model-dialog">
    <TitleContent>
        <CivitaiModelHeader Model="Model" OnClose="Close" />
    </TitleContent>
    <DialogContent>
        <div class="civitai-model-dialog__body">
            @if (Model.ModelVersions != null && Model.ModelVersions.Count > 1)
            {
                <CivitaiVersionSelector Versions="Model.ModelVersions" ActiveVersion="_activeVersion"
                                        ActiveVersionChanged="HandleVersionChanged" />
            }

            @if (_activeVersion != null)
            {
                <div class="civitai-model-dialog__layout">
                    <div class="civitai-model-dialog__hero">
                        <CivitaiModelHero Model="Model" Version="_activeVersion" />
                    </div>
                    <div class="civitai-model-dialog__spec">
                        <CivitaiModelSpecCard Model="Model" Version="_activeVersion" Tags="Model.Tags" />
                    </div>
                </div>
            }

            <MudExpansionPanels Class="civitai-model-dialog__description" MultiExpansion="false" Elevation="0">
                <MudExpansionPanel Text="Description" Dense>
                    <div class="civitai-model-dialog__description-body">
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            @((MarkupString)Model.Description)
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">No description provided.</MudText>
                        }
                    </div>
                </MudExpansionPanel>
                @if (_activeVersion != null && !string.IsNullOrWhiteSpace(_activeVersion.Description))
                {
                    <MudExpansionPanel Text="@($"Version notes - {_activeVersion.Name}")" Dense>
                        <div class="civitai-model-dialog__description-body">
                            @((MarkupString)_activeVersion.Description)
                        </div>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public CivitaiModelDto Model { get; set; } = default!;

    private CivitaiModelVersionDto? _activeVersion;

    protected override void OnParametersSet()
    {
        // Phase 4: default to the first / primary version on first load; the user can
        // switch via CivitaiVersionSelector. ActiveVersion changes propagate via
        // HandleVersionChanged, which keeps the same Model reference but swaps the
        // sub-aggregate. ModelVersions list is otherwise immutable for the dialog's lifetime.
        if (_activeVersion == null && Model?.ModelVersions != null && Model.ModelVersions.Count > 0)
        {
            _activeVersion = Model.ModelVersions[0];
        }
    }

    private void HandleVersionChanged(CivitaiModelVersionDto version)
    {
        if (version == null) return;
        _activeVersion = version;
    }

    protected override async Task OnInitializedAsync()
    {
        if (Model == null) return;
        var entity = await DB.GetResourceByCivitaiModelId(Model.Id);
        if (entity != null)
        {
            State.State.Civitai.ResourceSubtype = entity.SubType != null ? entity.SubType.Name : string.Empty;
        }
    }

    private void Close() => MudDialog.Close();
}
