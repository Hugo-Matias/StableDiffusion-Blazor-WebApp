@inject IStateService State
@inject ISettingsService Settings
@inject CivitaiService Api

<TwoColumnLayout Collapsible="true"
                 @bind-Collapsed="State.State.Civitai.SidebarCollapsed"
                 SidebarTitle="Filters">
    <Sidebar>
        <EditForm Model="Request" OnSubmit="Search">
            <MudStack Spacing="2">
                <MudTextField @bind-Value="Request.Query" Label="Search" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable />
                <MudSlider @bind-Value="Request.Limit"
                           Min="Settings.Settings.Resources.Civitai.Limit.Min"
                           Max="Settings.Settings.Resources.Civitai.Limit.Max"
                           Step="Settings.Settings.Resources.Civitai.Limit.Step">
                    <small>Quantity:</small> @Request.Limit
                </MudSlider>
                <MudNumericField @bind-Value="Request.Page" Label="Page" Variant="Variant.Text" Min="1" />

                <MudButton ButtonType="ButtonType.Submit" Color="Color.Success" FullWidth="true"
                           Class="mt-3">Search</MudButton>
            </MudStack>
        </EditForm>
    </Sidebar>
    <Content>
        @if (_creators != null)
        {
            <div class="civitai-scroll-container">
                <MudTable Items="@_creators.Creators" Loading="_isSearching" Dense Hover>
                    <HeaderContent>
                        <MudTh>Username</MudTh>
                        <MudTh>Model Count</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Username</MudTd>
                        <MudTd>@context.ModelCount</MudTd>
                        <MudTd><MudIconButton OnClick=@(async () => await OnSearchCreator.InvokeAsync(context.Username)) Icon="@Icons.Material.Filled.Search" /></MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <div class="d-flex flex-column align-center pa-3">
                            <MudPagination SelectedChanged="HandlePageSelected" Selected="(int)Request.Page" BoundaryCount="2" MiddleCount="5" Count="_creators.Metadata.TotalPages" />
                        </div>
                    </PagerContent>
                </MudTable>
            </div>
        }
        else if (_creators == null && _isSearching)
        {
            <LoadingSpinner />
        }
    </Content>
</TwoColumnLayout>

@code {
    [Parameter] public EventCallback<string> OnSearchCreator { get; set; }
    public CivitaiBaseRequest Request { get; set; }
    private bool _isSearching;
    private CivitaiCreatorsDto _creators;

    protected override void OnInitialized()
    {
        LoadState();
    }

    private async Task HandlePageSelected(int selection)
    {
        Request.Page = selection;
        await Search();
    }

    private async Task Search()
    {
        _isSearching = true;
        SetState();
        _creators = await Api.GetCreators(Request);
        _isSearching = false;
    }

    private void LoadState()
    {
        Request = new();
        Request.Query = State.State.Civitai.Creators.Shared.Query;
        Request.Limit = State.State.Civitai.Creators.Shared.Limit;
        Request.Page = State.State.Civitai.Creators.Shared.Page;
    }

    private void SetState()
    {
        State.State.Civitai.Creators.Shared.Query = Request.Query;
        State.State.Civitai.Creators.Shared.Limit = (int)Request.Limit;
        State.State.Civitai.Creators.Shared.Page = (int)Request.Page;
    }
}
