@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="@GetCardClasses()" @onmouseenter="HandleMouseEnter" @onmouseleave="HandleMouseLeave">
    <div class="image-wrapper">
        @if (Post.IsVideo)
        {
            <video id="@_videoId"
                   src="@Post.SampleUrl"
                   poster="@Post.PreviewUrl"
                   class="card-media"
                   muted
                   loop
                   playsinline
                   preload="metadata" />
        }
        else
        {
            <img src="@Post.SampleUrl" 
                 alt="Danbooru post" 
                 class="card-image" 
                 loading="lazy" />
        }
        
        @* Hover Overlay *@
        <div class="hover-overlay @(_isHovered ? "visible" : "")">
            @* Top Section - Rating Badge *@
            <div class="overlay-top @(_isHovered ? "visible" : "")">
                <div class="rating-badge @GetRatingClass()">
                    @SetBadgeRating()
                </div>
                @if (Post.IsVideo)
                {
                    <div class="video-badge">
                        <i class="fa-solid fa-video"></i>
                    </div>
                }
            </div>
            
            @* Center Section - Quick Actions *@
            <div class="overlay-center @(_isHovered ? "visible" : "")">
                <div class="quick-actions">
                    <button class="action-btn" @onclick="@(() => SendTags(false))" @onclick:stopPropagation title="Copy Tags">
                        <i class="fa-solid fa-file-lines"></i>
                    </button>
                    <button class="action-btn" @onclick="@(() => SendTags(true))" @onclick:stopPropagation title="Send to Img2Img">
                        <i class="fa-solid fa-file-image"></i>
                    </button>
                    <button class="action-btn primary" @onclick="ShowImage" @onclick:stopPropagation title="View Fullscreen">
                        <i class="fa-solid fa-expand"></i>
                    </button>
                </div>
            </div>
            
            @* Bottom Section - Info *@
            <div class="overlay-bottom @(_isHovered ? "visible" : "")">
                <div class="info-row">
                    <span class="info-item">
                        <i class="fa-solid fa-star"></i>
                        @Post.Score
                    </span>
                    <span class="info-item">
                        <i class="fa-solid fa-expand-alt"></i>
                        @($"{Post.Width}×{Post.Height}")
                    </span>
                    <span class="info-item">
                        @Post.Extension.ToUpper()
                    </span>
                </div>
            </div>
        </div>
        
        @* Persistent Rating Indicator *@
        @if (!_isHovered)
        {
            <div class="rating-indicator @GetRatingClass()">
                @SetBadgeRating()[0]
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public DanbooruPost Post { get; set; }
    [Parameter] public EventCallback<bool> OnSendTags { get; set; }
    [Parameter] public EventCallback OnShowImage { get; set; }

    private IJSObjectReference? _jsModule;
    private string _videoId = $"danbooru-video-{Guid.NewGuid():N}";
    private bool _isHovered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Post.IsVideo)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/VideoCard.js");
        }
    }

    private string GetCardClasses()
    {
        var classes = "danbooru-card";
        if (_isHovered) classes += " hovered";
        return classes;
    }

    private async Task HandleMouseEnter()
    {
        _isHovered = true;
        if (Post.IsVideo && _jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("playVideo", _videoId);
            }
            catch { }
        }
    }

    private async Task HandleMouseLeave()
    {
        _isHovered = false;
        if (Post.IsVideo && _jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("pauseVideo", _videoId);
            }
            catch { }
        }
    }

    private async Task SendTags(bool isImg2Img) => await OnSendTags.InvokeAsync(isImg2Img);
    private async Task ShowImage() => await OnShowImage.InvokeAsync();

    private string SetBadgeRating()
    {
        return Post.Rating switch
        {
            "g" => "General",
            "s" => "Sensitive",
            "q" => "Questionable",
            "e" => "Explicit",
            _ => "None"
        };
    }

    private string GetRatingClass()
    {
        return Post.Rating switch
        {
            "g" => "rating-general",
            "s" => "rating-sensitive",
            "q" => "rating-questionable",
            "e" => "rating-explicit",
            _ => "rating-none"
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch { }
        }
    }
}
