@inject CivitaiService Civitai
<div>
    <MudButton OnClick=ShowImage Class="image-btn">
        @if (IsVideo())
        {
            <video style="width:100%; object-fit:cover;" loop muted playsinline preload="metadata"
                   onmouseenter="this.play()" onmouseleave="this.pause();this.currentTime=0;">
                <source src="@Image.Url" />
            </video>
        }
        else
        {
            <MudImage Src="@Image.Url" ObjectFit="ObjectFit.Cover" Elevation="4" Fluid />
        }
    </MudButton>
</div>

@code {
    [Parameter] public CivitaiImageDto Image { get; set; }
    [Parameter] public EventCallback OnSaveImage { get; set; }
    [Parameter] public int ModelVersionId { get; set; }
    /// <summary>
    /// Raised when the user clicks the card to view the image in the panel-owned AssetViewer.
    /// The host panel is responsible for locating the (possibly mutated) DTO in its collection.
    /// </summary>
    [Parameter] public EventCallback<CivitaiImageDto> OnView { get; set; }

    private bool IsVideo()
    {
        if (Image.ImageType != null && Image.ImageType.Length > 0 && Image.ImageType[0] == 0)
            return true;

        if (!string.IsNullOrWhiteSpace(Image.Url))
        {
            var url = Image.Url.ToLowerInvariant();
            return url.Contains(".mp4") || url.Contains(".webm");
        }

        return false;
    }

    private async Task ShowImage()
    {
        if (string.IsNullOrWhiteSpace(Image.Hash))
        {
            var newImage = await Civitai.GetImageByModelVersionId(ModelVersionId, Image);
            if (newImage == null)
                newImage = new()
                {
                    Id = Image.Id,
                    Url = Image.Url
                };
            Image = newImage;
        }
        if (OnView.HasDelegate)
        {
            await OnView.InvokeAsync(Image);
        }
    }
}
