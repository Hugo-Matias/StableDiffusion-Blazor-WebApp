@inject IStateService State
@inject CivitaiService Api

<TwoColumnLayout Collapsible="true"
                 @bind-Collapsed="State.State.Civitai.SidebarCollapsed"
                 SidebarTitle="Filters">
    <Sidebar>
        <EditForm Model="Request" OnSubmit="Search">
            <MudStack Spacing="2">
                <MudTextField @bind-Value="Request.Username" Label="Username" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable />

                <MudDivider Class="my-1" />

               <MudSelect @bind-Value="Request.Sort" Label="Sort" AnchorOrigin="Origin.BottomLeft"
                           TransformOrigin="Origin.TopLeft" MaxHeight="400">
                    @foreach (CivitaiImageSort? sort in Enum.GetValues(typeof(CivitaiImageSort)))
                    {
                        <MudSelectItem Value="@sort">@sort.ToString().Replace("_", " ")</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect @bind-Value="Request.Period" Label="Period" AnchorOrigin="Origin.BottomLeft"
                           TransformOrigin="Origin.TopLeft" MaxHeight="400">
                    @foreach (CivitaiPeriod? period in Enum.GetValues(typeof(CivitaiPeriod)))
                    {
                        <MudSelectItem Value="@period">@period</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect @bind-Value="Request.Nsfw" Label="NSFW" AnchorOrigin="Origin.BottomLeft"
                           TransformOrigin="Origin.TopLeft" MaxHeight="400">
                    @foreach (CivitaiNsfw? nsfw in Enum.GetValues(typeof(CivitaiNsfw)))
                    {
                        <MudSelectItem Value="@nsfw">@nsfw</MudSelectItem>
                    }
                </MudSelect>
                <MudDivider Class="my-1" />
                <MudNumericField @bind-Value="Request.PostId" Label="Post ID" Variant="Variant.Text" Min="0" />
                <MudNumericField @bind-Value="Request.ModelId" Label="Model ID" Variant="Variant.Text" Min="0" />
                <MudNumericField @bind-Value="Request.ModelVersionId" Label="Model Version ID" Variant="Variant.Text" Min="0" />

                <MudDivider Class="my-1" />
                
                <MudNumericField @bind-Value="Request.Page" Label="Page" Variant="Variant.Text" Min="1" />

                <MudSlider @bind-Value="Request.Limit" Min="8" Max="200" Step="8">
                    <small>Limit:</small> @Request.Limit
                </MudSlider>
                <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center">
                    <MudTooltip Text="@($"Card size: {State.State.Civitai.CardSize}")">
                        <MudIconButton Icon="@GetCardSizeIcon()"
                                       Color="Color.Primary"
                                       OnClick="CycleCardSize"
                                       Size="Size.Medium" />
                    </MudTooltip>
                </MudStack>

                <MudDivider Class="my-1" />
                
                <MudButton ButtonType="ButtonType.Submit" Color="Color.Success" FullWidth="true"
                           Class="mt-3">Search</MudButton>

            </MudStack>
        </EditForm>
    </Sidebar>
    <Content>
        @if (_isSearching)
        {
            <LoadingSpinner />
        }
        else if (_images != null && _images.Images != null && _images.Images.Count > 0)
        {
            <div class="civitai-scroll-container" style="@($"--civitai-card-width: {CardWidth};")">
                <MudGrid Class="images-container">
                    @foreach (var img in _images.Images)
                    {
                        <CivitaiImageCard Image="img" OnSaveImage="SaveImage" />
                    }
                </MudGrid>
            </div>
        }
    </Content>
</TwoColumnLayout>

@code {
    public CivitaiImagesRequest Request { get; set; }
    private bool _isSearching;
    private CivitaiImagesDto _images;

    protected override void OnInitialized()
    {
        LoadState();
    }

    private string CardWidth => State.State.Civitai.CardSize switch
    {
        ResourceCardSize.Small => "10rem",
        ResourceCardSize.Large => "20rem",
        _ => "14rem"
    };

    private void CycleCardSize()
    {
        State.State.Civitai.CardSize = State.State.Civitai.CardSize switch
        {
            ResourceCardSize.Small => ResourceCardSize.Medium,
            ResourceCardSize.Medium => ResourceCardSize.Large,
            _ => ResourceCardSize.Small
        };
        StateHasChanged();
    }

    private string GetCardSizeIcon() => State.State.Civitai.CardSize switch
    {
        ResourceCardSize.Small => "fa-solid fa-grip",
        ResourceCardSize.Large => "fa-solid fa-square",
        _ => "fa-solid fa-table-cells-large"
    };

    private async Task Search()
    {
        _isSearching = true;
        SetState();
        _images = await Api.GetImages(Request);
        await State.SaveState();
        _isSearching = false;
    }

    private void SaveImage()
    {
        // TODO
    }

    private void LoadState()
    {
        Request = new();
        Request.Limit = State.State.Civitai.Images.Limit;
        Request.PostId = State.State.Civitai.Images.PostId;
        Request.ModelId = State.State.Civitai.Images.ModelId;
        Request.ModelVersionId = State.State.Civitai.Images.ModelVersionId;
        Request.Username = State.State.Civitai.Images.Username;
        Request.Nsfw = State.State.Civitai.Images.Nsfw;
        Request.Sort = State.State.Civitai.Images.Sort;
        Request.Period = State.State.Civitai.Images.Period;
        Request.Page = State.State.Civitai.Images.Page;
    }

    private void SetState()
    {
        State.State.Civitai.Images.Limit = Request.Limit;
        State.State.Civitai.Images.PostId = (int)Request.PostId;
        State.State.Civitai.Images.ModelId = (int)Request.ModelId;
        State.State.Civitai.Images.ModelVersionId = (int)Request.ModelVersionId;
        State.State.Civitai.Images.Username = Request.Username;
        State.State.Civitai.Images.Nsfw = (CivitaiNsfw)Request.Nsfw;
        State.State.Civitai.Images.Sort = (CivitaiImageSort)Request.Sort;
        State.State.Civitai.Images.Period = (CivitaiPeriod)Request.Period;
        State.State.Civitai.Images.Page = Request.Page;
    }
}
