@inject IStateService State
@inject ISettingsService Settings

@if (Resources != null)
{
    <TwoColumnLayout Collapsible="true"
                     @bind-Collapsed="State.State.Resources.SidebarCollapsed"
                     SidebarTitle="Filters">
        <Sidebar>
            <MudStack Spacing="2">
                <MudTextField Label="Title"
                              Value="State.State.Resources.Title"
                              ValueChanged="HandleSearchTitle"
                              T="string"
                              Adornment="Adornment.End"
                              AdornmentIcon="fa-solid fa-magnifying-glass"
                              Clearable
                              Immediate />
                <MudAutocomplete T="string"
                                 Value="State.State.Resources.Tag"
                                 ValueChanged="HandleSearchTag"
                                 SearchFunc="GetTags"
                                 Label="Tag"
                                 MaxItems="100"
                                 MaxHeight="900"
                                 Adornment="Adornment.End"
                                 AdornmentIcon="fa-solid fa-tag"
                                 AdornmentColor=@(State.State.Resources.IsInclusive ? Color.Success : Color.Error)
                                 OnAdornmentClick="HandleTagInclusiveChanged"
                                 ResetValueOnEmptyText
                                 Clearable
                                 Dense />
                <MudAutocomplete T="string"
                                 Value="State.State.Resources.Subtype"
                                 ValueChanged="HandleSearchSubtype"
                                 SearchFunc="GetSubtypes"
                                 Label="Sub-Type"
                                 MaxItems="100"
                                 MaxHeight="1200"
                                 Adornment="Adornment.End"
                                 AdornmentIcon="fa-solid fa-list"
                                 ResetValueOnEmptyText
                                 Clearable
                                 Dense />
                <MudAutocomplete T="string"
                                 Value="State.State.Resources.BaseModel"
                                 ValueChanged="HandleSearchBaseModel"
                                 SearchFunc="GetBaseModels"
                                 Label="Base Model"
                                 MaxItems="100"
                                 MaxHeight="900"
                                 Adornment="Adornment.End"
                                 AdornmentIcon="fa-solid fa-cube"
                                 ResetValueOnEmptyText
                                 Clearable
                                 Dense />

                <MudDivider Class="my-1" />

                @* Order By + Asc/Desc toggle inline *@
                <MudStack Row="true" AlignItems="AlignItems.End" Spacing="1">
                    <MudSelect Label="Order By"
                               Value="State.State.Resources.OrderBy"
                               ValueChanged="HandleOrderChanged"
                               T="string"
                               Class="flex-grow-1">
                        @foreach (var option in Settings.Settings.Resources.OrderByOptions)
                        {
                            <MudSelectItem Value="option" />
                        }
                    </MudSelect>
                    <MudTooltip Text="@(State.State.Resources.OrderByDescending ? "Descending" : "Ascending")">
                        <MudIconButton Icon="@(State.State.Resources.OrderByDescending ? "fa-solid fa-arrow-down-wide-short" : "fa-solid fa-arrow-down-short-wide")"
                                       OnClick="@(() => HandleOrderDescendingChanged(!State.State.Resources.OrderByDescending))"
                                       Size="Size.Small" />
                    </MudTooltip>
                </MudStack>
                <ResourceTemplatesBar />

                <MudDivider Class="my-1" />
                <MudSlider T="int"
                           ValueChanged="@(v => HandleLimitChanged(v))"
                           Value="State.State.Resources.Limit"
                           Min="4"
                           Max="100"
                           Step="4"><small>Quantity:</small> @State.State.Resources.Limit</MudSlider>



                @* Active tri-state + Card size tri-state inline *@
                <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="4">
                    <MudCheckBox T="bool?"
                                 Checked="State.State.Resources.ResourceIsEnabledFilter"
                                 CheckedChanged="@(v => HandleEnabledChecked(v))"
                                 Color=@(State.State.Resources.ResourceIsEnabledFilter == null ? Color.Default : (bool)State.State.Resources.ResourceIsEnabledFilter ? Color.Success : Color.Error)
                                 TriState="true">@GetEnabledFilterLabel()</MudCheckBox>
                    <MudTooltip Text="@($"Card size: {State.State.Resources.CardSize}")">
                        <MudIconButton Icon="@GetCardSizeIcon()"
                                       Color="Color.Primary"
                                       OnClick="CycleCardSize"
                                       Size="Size.Medium" />
                    </MudTooltip>
                </MudStack>

                <MudButton OnClick="Search"
                           Color="Color.Success"
                           FullWidth="true"
                           Class="mt-3">Search</MudButton>
            </MudStack>
        </Sidebar>
        <Content>
            @if (State.State.Resources.TotalPages > 1)
            {
                <div class="d-flex flex-column align-center pb-2">
                    <MudPagination SelectedChanged="HandlePageSelected" Selected="State.State.Resources.Page" BoundaryCount="2" MiddleCount="5" Count="State.State.Resources.TotalPages" />
                </div>
            }
            <div class="resources-scroll-container">
                <MudGrid Spacing="1" Justify="Justify.Center">
                    @foreach (var resource in _filteredResources)
                    {
                        <ResourceCard Resource="resource" Width="@CardWidth" OnLoad="@(async () => await OnLoad.InvokeAsync(resource))" />
                    }
                </MudGrid>
            </div>
            @if (State.State.Resources.TotalPages > 1)
            {
                <div class="d-flex flex-column align-center pt-2">
                    <MudPagination SelectedChanged="HandlePageSelected" Selected="State.State.Resources.Page" BoundaryCount="2" MiddleCount="5" Count="State.State.Resources.TotalPages" />
                </div>
            }
        </Content>
    </TwoColumnLayout>
}

@code {
    [Parameter] public List<LocalResource> Resources { get; set; }
    [Parameter] public EventCallback<LocalResource> OnLoad { get; set; }

    private List<LocalResource> _filteredResources;

    private string CardWidth => State.State.Resources.CardSize switch
    {
        ResourceCardSize.Small => "11rem",
        ResourceCardSize.Large => "22rem",
        _ => "16rem"
    };

    private string GetEnabledFilterLabel() => State.State.Resources.ResourceIsEnabledFilter switch
    {
        true => "Active",
        false => "Inactive",
        _ => "All"
    };

    private void HandleCardSizeChanged(ResourceCardSize size)
    {
        State.State.Resources.CardSize = size;
        StateHasChanged();
    }

    private void CycleCardSize()
    {
        State.State.Resources.CardSize = State.State.Resources.CardSize switch
        {
            ResourceCardSize.Small => ResourceCardSize.Medium,
            ResourceCardSize.Medium => ResourceCardSize.Large,
            _ => ResourceCardSize.Small
        };
        StateHasChanged();
    }

    private string GetCardSizeIcon() => State.State.Resources.CardSize switch
    {
        ResourceCardSize.Small => "fa-solid fa-grip",
        ResourceCardSize.Large => "fa-solid fa-square",
        _ => "fa-solid fa-table-cells-large"
    };

    protected override void OnParametersSet()
    {
        Search();
    }

    private async Task<IEnumerable<string>> GetSubtypes(string value)
    {
        var query = Resources.Where(r => r.SubType != null).Select(r => r.SubType.Name).Distinct();
        if (!string.IsNullOrWhiteSpace(value)) query = query.Where(t => t.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        return query.OrderBy(t => t);
    }

    private async Task<IEnumerable<string>> GetBaseModels(string value)
    {
        var query = Resources.Where(r => !string.IsNullOrEmpty(r.BaseModel)).Select(r => r.BaseModel).Distinct();
        if (!string.IsNullOrWhiteSpace(value)) query = query.Where(b => b.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        return query.OrderBy(b => b);
    }

    private async Task<IEnumerable<string>> GetTags(string value)
    {
        var subtypes = _filteredResources.Select(r => r.SubType).Distinct();
        var query = Resources.Where(r => subtypes.Contains(r.SubType)).SelectMany(r => r.Tags).Distinct();
        if (!string.IsNullOrWhiteSpace(value)) query = query.Where(t => t.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        return query.OrderBy(t => t);
    }

    private async Task HandleSearchTitle(string value)
    {
        State.State.Resources.Title = value;
        State.State.Resources.Page = 1;
        await Search();
    }

    private async Task HandleSearchSubtype(string value)
    {
        State.State.Resources.Subtype = value;
        State.State.Resources.Page = 1;
        await Search();
    }

    private async Task HandleSearchBaseModel(string value)
    {
        State.State.Resources.BaseModel = value;
        State.State.Resources.Page = 1;
        await Search();
    }

    private async Task HandleSearchTag(string value)
    {
        State.State.Resources.Tag = value;
        State.State.Resources.Page = 1;
        await Search();
    }

    private async Task HandleTagInclusiveChanged()
    {
        State.State.Resources.IsInclusive = !State.State.Resources.IsInclusive;
        State.State.Resources.Page = 1;
        await Search();
    }

    private async Task HandleLimitChanged(int value)
    {
        State.State.Resources.Limit = value;
        State.State.Resources.Page = 1;
        await Search();
    }

    private async Task HandleEnabledChecked(bool? value)
    {
        State.State.Resources.ResourceIsEnabledFilter = value;
        State.State.Resources.Page = 1;
        await Search();
    }

    private async Task HandlePageSelected(int value)
    {
        State.State.Resources.Page = value;
        await Search();
    }

    private async Task HandleOrderChanged(string value)
    {
        State.State.Resources.OrderBy = value;
        await Search();
    }

    private async Task HandleOrderDescendingChanged(bool value)
    {
        State.State.Resources.OrderByDescending = value;
        await Search();
    }

    private async Task Search()
    {
        var query = Resources.AsQueryable();
        if (!string.IsNullOrWhiteSpace(State.State.Resources.Title)) query = query.Where(r => r.Title.Contains(State.State.Resources.Title, StringComparison.InvariantCultureIgnoreCase));
        if (!string.IsNullOrWhiteSpace(State.State.Resources.Subtype)) query = query.Where(r => r.SubType != null && r.SubType.Name.Equals(State.State.Resources.Subtype, StringComparison.InvariantCultureIgnoreCase));
        if (!string.IsNullOrWhiteSpace(State.State.Resources.BaseModel)) query = query.Where(r => r.BaseModel != null && r.BaseModel.Equals(State.State.Resources.BaseModel, StringComparison.InvariantCultureIgnoreCase));
        if (!string.IsNullOrWhiteSpace(State.State.Resources.Tag))
        {
            if (State.State.Resources.IsInclusive) query = query.Where(r => r.Tags != null && r.Tags.Contains(State.State.Resources.Tag));
            else query = query.Where(r => r.Tags == null || !r.Tags.Contains(State.State.Resources.Tag));
        }
        if (State.State.Resources.ResourceIsEnabledFilter != null) query = query.Where(r => r.Files.Any(f => f.IsEnabled == State.State.Resources.ResourceIsEnabledFilter));
        switch (State.State.Resources.OrderBy)
        {
            case "Title":
                query = query.OrderBy(r => r.Title);
                break;
            case "Author":
                query = query.OrderBy(r => r.Author);
                break;
            case "Creation Date":
                query = query.OrderBy(r => r.CreatedDate);
                break;
            case "Load Date":
                query = query.OrderBy(r => r.LastLoadedDate);
                break;
            case "Random":
                query = query.OrderBy(r => Guid.NewGuid());
                break;
        }
        var result = State.State.Resources.OrderByDescending ? query.Reverse().ToArray() : query.ToArray();
        PaginateResults(result);
        await State.SaveState();
    }

    private void PaginateResults(LocalResource[] resources)
    {
        var limit = State.State.Resources.Limit;
        State.State.Resources.TotalPages = (int)((resources.Length + limit) / limit);
        _filteredResources = resources.Skip(limit * (State.State.Resources.Page - 1)).Take(limit).ToList();
    }
}
