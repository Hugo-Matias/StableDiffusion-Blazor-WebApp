@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="@GetCardClasses()" @onmouseenter="HandleMouseEnter" @onmouseleave="HandleMouseLeave">
    <div class="image-wrapper">
        @if (Media.IsVideo)
        {
            <video id="@_videoId" src="/files/danbooru/@Media.FilePath" poster="@Media.PreviewUrl" class="card-media" muted
                   loop playsinline preload="metadata" />
        }
        else
        {
            <img src="/files/danbooru/@Media.FilePath" alt="Saved Danbooru media" class="card-image" loading="lazy" />
        }

        @* Hover Overlay *@
        <div class="hover-overlay @(_isHovered ? "visible" : "")">
            @* Top Section - Rating Badge *@
            <div class="overlay-top @(_isHovered ? "visible" : "")">
                <div class="rating-badge @GetRatingClass()">
                    @SetBadgeRating()
                </div>
                @if (Media.IsVideo)
                {
                    <div class="video-badge">
                        <i class="fa-solid fa-video"></i>
                    </div>
                }
            </div>

            @* Center Section - Quick Actions *@
            <div class="overlay-center @(_isHovered ? "visible" : "")">
                <div class="quick-actions">
                    <button class="action-btn" @onclick="HandleCopyTags" @onclick:stopPropagation title="Copy Tags">
                        <i class="fa-solid fa-file-lines"></i>
                    </button>
                    <MediaSendToDropdown Asset="@BuildMediaAsset()"
                                         MediaType="@(Media.IsVideo ? SendToMediaType.Video : SendToMediaType.Image)"
                                         RenderAsActionButton="true" />
                    <button class="action-btn primary" @onclick="HandleShowImage" @onclick:stopPropagation
                            title="View Fullscreen">
                        <i class="fa-solid fa-expand"></i>
                    </button>
                    <button class="action-btn" @onclick="HandleOpenSource" @onclick:stopPropagation title="Open Source">
                        <i class="fa-solid fa-external-link-alt"></i>
                    </button>
                    <button class="action-btn danger" @onclick="HandleDelete" @onclick:stopPropagation
                            title="Delete from Library">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            </div>

            @* Bottom Section - Info *@
            <div class="overlay-bottom @(_isHovered ? "visible" : "")">
                <div class="info-row">
                    <span class="info-item">
                        <i class="fa-solid fa-star"></i>
                        @Media.Score
                    </span>
                    <span class="info-item">
                        <i class="fa-solid fa-expand-alt"></i>
                        @($"{Media.Width}×{Media.Height}")
                    </span>
                    <span class="info-item">
                        @Media.Extension.ToUpper()
                    </span>
                </div>
            </div>
        </div>

        @* Persistent Rating Indicator *@
        @if (!_isHovered)
        {
            <div class="rating-indicator @GetRatingClass()">
                @SetBadgeRating()[0]
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public SavedDanbooruMedia Media { get; set; } = default!;
    [Parameter] public EventCallback OnCopyTags { get; set; }
    [Parameter] public EventCallback OnShowImage { get; set; }
    [Parameter] public EventCallback OnOpenSource { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private IJSObjectReference? _jsModule;
    private string _videoId = $"library-video-{Guid.NewGuid():N}";
    private bool _isHovered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Media.IsVideo)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/VideoCard.js");
        }
    }

    private string GetCardClasses()
    {
        var classes = "danbooru-card";
        if (_isHovered) classes += " hovered";
        return classes;
    }

    private async Task HandleMouseEnter()
    {
        _isHovered = true;
        if (Media.IsVideo && _jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("playVideo", _videoId);
            }
            catch { }
        }
    }

    private async Task HandleMouseLeave()
    {
        _isHovered = false;
        if (Media.IsVideo && _jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("pauseVideo", _videoId);
            }
            catch { }
        }
    }

    private async Task HandleCopyTags() => await OnCopyTags.InvokeAsync();
    private async Task HandleShowImage() => await OnShowImage.InvokeAsync();
    private async Task HandleOpenSource() => await OnOpenSource.InvokeAsync();
    private async Task HandleDelete() => await OnDelete.InvokeAsync();

    private BlazorWebApp.Data.Entities.Image BuildMediaAsset()
    {
        return new BlazorWebApp.Data.Entities.Image
        {
            Id = Media.Id,
            Path = $"/files/danbooru/{Media.FilePath}",
            Prompt = BuildPrompt(),
            Width = Media.Width,
            Height = Media.Height,
            DateCreated = Media.DateCreated,
            Scheduler = string.Empty
        };
    }

    private string BuildPrompt()
    {
        var tags = new List<string>();
        tags.AddRange(Media.TagsBundle.Artist);
        tags.AddRange(Media.TagsBundle.Character);
        tags.AddRange(Media.TagsBundle.General);
        return string.Join(", ", tags);
    }

    private string SetBadgeRating()
    {
        return Media.Rating switch
        {
            "g" => "General",
            "s" => "Sensitive",
            "q" => "Questionable",
            "e" => "Explicit",
            _ => "None"
        };
    }

    private string GetRatingClass()
    {
        return Media.Rating switch
        {
            "g" => "rating-general",
            "s" => "rating-sensitive",
            "q" => "rating-questionable",
            "e" => "rating-explicit",
            _ => "rating-none"
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch { }
        }
    }
}
