@using System.Text.Json
@using BlazorWebApp.Data.Dtos.ComfyUI.Workflow
@using static BlazorWebApp.Data.Enums
@inject ManagerService M

<div style="margin-bottom:15rem;">
    <EditForm Model="@Parameters">
        <MudGrid Class="pa-5">
            <MudItem xs="12">
                <LoraForm Loras="Parameters.Loras" Backend="Backend.ComfyUI"/>
            </MudItem>
            <MudItem xs="6">
                <MudSelect T="string" Label="Sampler" @bind-Value=Parameters.SamplerName AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                    @if (M.Samplers != null)
                    {
                        @foreach (var sampler in M.Samplers)
                        {
                            <MudSelectItem Value=@sampler.Name />
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6">
                <MudSelect T="string" Label="Scheduler" @bind-Value=Parameters.Scheduler AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                    @if (M.Schedulers != null)
                    {
                        @foreach (var scheduler in M.Schedulers)
                        {
                            <MudSelectItem Value=@scheduler.Name />
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6">
                <MudSlider @bind-Value=Parameters.Steps Min=M.Settings.Generation.Shared.Steps.Min Max=M.Settings.Generation.Shared.Steps.Max Step=M.Settings.Generation.Shared.Steps.Step Variant="Variant.Filled" ValueLabel><small>Steps:</small> @Parameters.Steps</MudSlider>
            </MudItem>
            <MudItem xs="5">
                <MudNumericField @bind-Value=Parameters.Seed Label="Seed" Min="-1" Max="long.MaxValue" />
            </MudItem>
            <MudItem xs="1">
                <MudButtonGroup Variant="Variant.Text" VerticalAlign>
                    <MudIconButton OnClick=SetRandomSeed Icon="fa-solid fa-shuffle" ButtonType="ButtonType.Button" Class="icon" />
                    <MudIconButton OnClick=RestoreSeed Icon="fa-solid fa-rotate-left" ButtonType="ButtonType.Button" Class="icon" />
                </MudButtonGroup>
            </MudItem>
            @if (_guidanceBases.Contains(M.State.Generation.WorkflowBase))
            {
                <MudItem xs="6">
                    <MudSlider @bind-Value=Parameters.DistilledCfgScale Min=M.Settings.Generation.Shared.DistilledCfg.Min Max=M.Settings.Generation.Shared.DistilledCfg.Max Step=M.Settings.Generation.Shared.DistilledCfg.Step Variant="Variant.Filled" ValueLabel TickMarks><small>Guidance:</small> @Parameters.DistilledCfgScale</MudSlider>
                </MudItem>
            }
            else
            {
                <MudItem xs="6">
                    <MudSlider @bind-Value=Parameters.CfgScale Min=M.Settings.Generation.Shared.CfgScale.Min Max=M.Settings.Generation.Shared.CfgScale.Max Step=M.Settings.Generation.Shared.CfgScale.Step Variant="Variant.Filled" ValueLabel TickMarks><small>CFG Scale:</small> @Parameters.CfgScale</MudSlider>
                </MudItem>
            }
            <MudItem xs="6">
                <MudSlider @bind-Value=Parameters.BatchSize Min=M.Settings.Generation.Shared.Batch.Size.Min Max=M.Settings.Generation.Shared.Batch.Size.Max Step=M.Settings.Generation.Shared.Batch.Size.Step Variant="Variant.Filled" ValueLabel TickMarks><small>Batch Size:</small> @Parameters.BatchSize</MudSlider>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Class="mb-4">Quick Resolution:</MudText>
                <MudGrid Spacing="2">
                    @foreach (var res in M.Settings.Generation.Shared.QuickResolutions)
                    {
                        <MudItem xs="6" sm="4" md="3" lg="2">
                            <MudButton OnClick="@(() => SetResolution(res.Width, res.Height))"
                                       Variant="Variant.Text"
                                       Color="Color.Primary"
                                       FullWidth
                                       Size="Size.Small">
                                @res.Label
                            </MudButton>
                        </MudItem>
                    }
                    <MudItem xs="12" Class="mt-2">
                        <MudButton OnClick="@(() => SetResolution((int)Parameters.Height, (int)Parameters.Width))"
                                   StartIcon="fa-solid fa-image-portrait"
                                   Variant="Variant.Text"
                                   Color="Color.Primary"
                                   FullWidth
                                   Size="Size.Small">
                            Rotate
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="6">
                <MudSlider T="int?" ValueChanged=@((v) => HandleResolutionChanged((int)v, isWidth: true)) Value=Parameters.Width Min=M.Settings.Generation.Shared.Resolution.Min Max=M.Settings.Generation.Shared.Resolution.Max Step=M.Settings.Generation.Shared.Resolution.Step Variant="Variant.Filled" ValueLabel TickMarks><small>Width:</small> @(Parameters.Width)px</MudSlider>
            </MudItem>
            <MudItem xs="6">
                <MudSlider T="int?" ValueChanged=@((v) => HandleResolutionChanged((int)v, isWidth: false)) Value=Parameters.Height Min=M.Settings.Generation.Shared.Resolution.Min Max=M.Settings.Generation.Shared.Resolution.Max Step=M.Settings.Generation.Shared.Resolution.Step Variant="Variant.Filled" ValueLabel TickMarks><small>Height:</small> @(Parameters.Height)px</MudSlider>
            </MudItem>
            <MudItem xs="12">
                <MudChipSet SelectedChipsChanged="HandleParameterChecked" MultiSelection Filter>
                    <MudChip Text="ADetailer" Default="Parameters.Scripts.ADetailer.IsEnabled" Variant="Variant.Text" Color="Color.Primary">ADetailer</MudChip>
                    <MudChip Text="Upscale" Default="Parameters.EnableHR" Variant="Variant.Text" Color="Color.Primary">Upscale</MudChip>
                    <MudChip Text="SeedVR2" Default="Parameters.SeedVR2?.IsActive" Variant="Variant.Text" Color="Color.Primary">SeedVR2 Upscale</MudChip>
                    <MudChip Text="Conditioning Variation" Default="Parameters.ConditioningVariation.IsActive" Variant="Variant.Text" Color="Color.Primary">Conditioning Variation</MudChip>
                </MudChipSet>
            </MudItem>
            <MudItem xs="12" Class="@($"collapse {(Parameters.Scripts.ADetailer.IsEnabled ? "show" : "")}")">
                    <ADetailerForm Parameters=Parameters.Scripts.ADetailer Mode="ModeType.Txt2Img" />
            </MudItem>
            <MudItem xs="12">
                <MudGrid Class=@($"collapse {(Parameters.EnableHR == true ? "show" : "")}")>
                    <MudText Typo="Typo.button" Style="opacity:0.2;">Upscale</MudText>
                    <MudItem xs="12" Class="align-items-center justify-content-center d-flex mt-n3">
                        <MudText Typo="Typo.overline">@_resizeInfo</MudText>
                    </MudItem>
                    <MudItem xs="4">
                        <MudSelect T="string" Label="Upscaler" @bind-Value=Parameters.HRUpscaler AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                            @if (M.Upscalers != null && M.Upscalers.Count > 0)
                            {
                                @foreach (var upscaler in M.Upscalers)
                                {
                                    <MudSelectItem Value=@(upscaler.Name) />
                                }
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="4">
                        <MudSlider @bind-Value=Parameters.HRSecondPassSteps Min=M.Settings.Generation.Txt2Img.HighRes.SecondPassSteps.Min Max=M.Settings.Generation.Txt2Img.HighRes.SecondPassSteps.Max Step=M.Settings.Generation.Txt2Img.HighRes.SecondPassSteps.Step Variant="Variant.Filled" ValueLabel><small>Steps:</small> @($"{(Parameters.HRSecondPassSteps > 0 ? Parameters.HRSecondPassSteps : $"Original ({Parameters.Steps})")}")</MudSlider>
                        </MudItem>
                        <MudItem xs="4">
                            <MudSlider @bind-Value=Parameters.DenoisingStrength Min=M.Settings.Generation.Shared.Denoising.Min Max=M.Settings.Generation.Shared.Denoising.Max Step=M.Settings.Generation.Shared.Denoising.Step Variant="Variant.Filled" ValueLabel><small>Denoising:</small> @Parameters.DenoisingStrength</MudSlider>
                    </MudItem>
                    <MudItem xs="4">
                        <MudSlider T="double" ValueChanged=HandleHRScaleChanged Value=Parameters.HRScale Min=M.Settings.Generation.Txt2Img.HighRes.Scale.Min Max=M.Settings.Generation.Txt2Img.HighRes.Scale.Max Step=M.Settings.Generation.Txt2Img.HighRes.Scale.Step Variant="Variant.Filled" ValueLabel><small>Scale Multiplier:</small> @(Parameters.HRScale)x</MudSlider>
                    </MudItem>
                    <MudItem xs="4">
                        <MudSlider T="int" ValueChanged=@((v) => HandleHRResolutionChanged(v, isWidth: true)) Value=Parameters.HRWidth Min=M.Settings.Generation.Txt2Img.HighRes.Resolution.Min Max=M.Settings.Generation.Txt2Img.HighRes.Resolution.Max Step=M.Settings.Generation.Txt2Img.HighRes.Resolution.Step Variant="Variant.Filled" ValueLabel><small>Width:</small> @(Parameters.HRWidth)px</MudSlider>
                    </MudItem>
                    <MudItem xs="4">
                        <MudSlider T="int" ValueChanged=@((v) => HandleHRResolutionChanged(v, isWidth: false)) Value=Parameters.HRHeight Min=M.Settings.Generation.Txt2Img.HighRes.Resolution.Min Max=M.Settings.Generation.Txt2Img.HighRes.Resolution.Max Step=M.Settings.Generation.Txt2Img.HighRes.Resolution.Step Variant="Variant.Filled" ValueLabel><small>Height:</small> @(Parameters.HRHeight)px</MudSlider>
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="12">
                <MudGrid Class=@($"collapse {(Parameters.SeedVR2?.IsActive == true ? "show" : "")}")>
                    <MudText Typo="Typo.button" Style="opacity:0.2;">SeedVR2 Upscaler</MudText>
                    <MudItem xs="12" Class="align-items-center justify-content-center d-flex mt-n3">
                        <MudText Typo="Typo.overline">@_seedVR2ResizeInfo</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudTextField @bind-Value=Parameters.SeedVR2.Model Label="Model" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudSlider T="double" ValueChanged=HandleSeedVR2ScaleChanged Value=(double)Parameters.SeedVR2.Scale Min=1.0 Max=8.0 Step=0.1 Variant="Variant.Filled" ValueLabel><small>Scale Multiplier:</small> @(Parameters.SeedVR2.Scale)x</MudSlider>
                    </MudItem>
                    <MudItem xs="2">
                        <MudNumericField @bind-Value=Parameters.SeedVR2.BatchSize 
                           Label="Batch Size" 
                           Min=M.Settings.Generation.Txt2Img.SeedVR2.BatchSize.Min 
                           Max=M.Settings.Generation.Txt2Img.SeedVR2.BatchSize.Max 
                           Step=M.Settings.Generation.Txt2Img.SeedVR2.BatchSize.Step />
                    </MudItem>
                    <MudItem xs="4">
                        <MudNumericField @bind-Value=Parameters.SeedVR2.BlocksToSwap 
                           Label="Blocks to Swap" 
                           Min=M.Settings.Generation.Txt2Img.SeedVR2.BlocksToSwap.Min 
                           Max=M.Settings.Generation.Txt2Img.SeedVR2.BlocksToSwap.Max 
                           Step=M.Settings.Generation.Txt2Img.SeedVR2.BlocksToSwap.Step />
                    </MudItem>
                    <MudItem xs="4">
                        <MudNumericField @bind-Value=Parameters.SeedVR2.VaeTileSize 
                           Label="VAE Tile Size" 
                           Min=M.Settings.Generation.Txt2Img.SeedVR2.VaeTileSize.Min 
                           Max=M.Settings.Generation.Txt2Img.SeedVR2.VaeTileSize.Max 
                           Step=M.Settings.Generation.Txt2Img.SeedVR2.VaeTileSize.Step />
                    </MudItem>
                    <MudItem xs="4">
                        <MudNumericField @bind-Value=Parameters.SeedVR2.VaeTileOverlap 
                           Label="VAE Tile Overlap" 
                           Min=M.Settings.Generation.Txt2Img.SeedVR2.VaeTileOverlap.Min 
                           Max=M.Settings.Generation.Txt2Img.SeedVR2.VaeTileOverlap.Max 
                           Step=M.Settings.Generation.Txt2Img.SeedVR2.VaeTileOverlap.Step />
                    </MudItem>
                    <MudItem xs="6">
                        <MudSlider @bind-Value=Parameters.SeedVR2.InputNoiseScale 
                     Min=M.Settings.Generation.Txt2Img.SeedVR2.InputNoiseScale.Min 
                     Max=M.Settings.Generation.Txt2Img.SeedVR2.InputNoiseScale.Max 
                     Step=M.Settings.Generation.Txt2Img.SeedVR2.InputNoiseScale.Step 
                     Variant="Variant.Filled" 
                     ValueLabel><small>Input Noise Scale:</small> @(Parameters.SeedVR2.InputNoiseScale?.ToString("F2") ?? "0.00")</MudSlider>
                    </MudItem>
                    <MudItem xs="6">
                        <MudSlider @bind-Value=Parameters.SeedVR2.LatentNoiseScale 
                     Min=M.Settings.Generation.Txt2Img.SeedVR2.LatentNoiseScale.Min 
                     Max=M.Settings.Generation.Txt2Img.SeedVR2.LatentNoiseScale.Max 
                     Step=M.Settings.Generation.Txt2Img.SeedVR2.LatentNoiseScale.Step 
                     Variant="Variant.Filled" 
                     ValueLabel><small>Latent Noise Scale:</small> @(Parameters.SeedVR2.LatentNoiseScale?.ToString("F2") ?? "0.00")</MudSlider>
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="12" Class="@($"collapse {(Parameters.ConditioningVariation.IsActive.Value ? "show" : "")}")">
                <ConditioningVariationForm Parameters=Parameters.ConditioningVariation />
            </MudItem>
        </MudGrid>
    </EditForm>
</div>

@code {
    [Parameter] public Txt2ImgParameters Parameters { get; set; }
    [Parameter] public EventCallback<Txt2ImgParameters> ParametersChanged { get; set; }

    private Options _options;
    private MarkupString _resizeInfo;
    private MarkupString _seedVR2ResizeInfo;
    private List<ModelBase> _guidanceBases = new() { ModelBase.Flux };

    protected async override Task OnInitializedAsync()
    {
        _options = M.Options;
        if (M.Upscalers == null || M.Upscalers.Count == 0) await M.GetUpscalers();
        if (Parameters.Loras == null) Parameters.Loras = new List<Lora>();
        if (Parameters.SeedVR2 == null) Parameters.SeedVR2 = new SeedVR2Parameters();
        // if (Parameters.ConditioningVariation == null) Parameters.ConditioningVariation = new ConditioningVariationParameters();
        
        // Initialize the scale multiplier from existing resolution if available
        if (Parameters.SeedVR2.Resolution > 0 && Parameters.Width > 0 && Parameters.Height > 0)
        {
            var smallestSide = Math.Min((int)Parameters.Width, (int)Parameters.Height);
            if (smallestSide > 0)
            {
                Parameters.SeedVR2.Scale = Math.Round((double)Parameters.SeedVR2.Resolution / smallestSide, 2);
            }
        }
        
        RefreshHighresInfo();
        RefreshSeedVR2Info();
    }

    private void SetRandomSeed() => Parameters.Seed = -1;

    private void RestoreSeed()
    {
        if (M.IsComfyUIUp)
        {
            var info = M.ImagesInfo.InfoTexts[0];
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(info);
                var root = doc.RootElement;

                // ComfyUI stores the workflow as a flat object where each key is a node ID
                // We need to search through all nodes for one that has a "seed" input
                foreach (var nodeProperty in root.EnumerateObject())
                {
                    if (nodeProperty.Value.ValueKind == JsonValueKind.Object &&
                        nodeProperty.Value.TryGetProperty("inputs", out var inputs) &&
                        inputs.TryGetProperty("seed", out var seedEl))
                    {
                        if (seedEl.ValueKind == JsonValueKind.Number && seedEl.TryGetInt64(out var seedValue))
                        {
                            Parameters.Seed = seedValue;
                            break; // Found the seed, stop searching
                        }
                    }
                }
            }
            catch
            {
                // If parsing fails, do nothing
            }
        }
        else if (M.IsWebuiUp)
        {
            if (M.ImagesInfo != null && M.ImagesInfo.Seed != null)
                Parameters.Seed = M.ImagesInfo.Seed;
        }
    }

    private void HandleParameterChecked(MudChip[] checkboxes)
    {
        Parameters.Scripts.ADetailer.IsEnabled = false;
        Parameters.EnableHR = false;
        if (Parameters.SeedVR2 != null) Parameters.SeedVR2.IsActive = false;
        if (Parameters.ConditioningVariation != null) Parameters.ConditioningVariation.IsActive = false;
        
        if (checkboxes == null || checkboxes.Count() == 0) return;

        foreach (var check in checkboxes)
        {
            switch (check.Text)
            {
                case "ADetailer":
                    Parameters.Scripts.ADetailer.IsEnabled = true;
                    break;
                case "Upscale":
                    Parameters.EnableHR = true;
                    break;
                case "SeedVR2":
                    if (Parameters.SeedVR2 == null) Parameters.SeedVR2 = new SeedVR2Parameters();
                    Parameters.SeedVR2.IsActive = true;
                    break;
                case "Conditioning Variation":
                    if (Parameters.ConditioningVariation == null) Parameters.ConditioningVariation = new ConditioningVariationParameters();
                    Parameters.ConditioningVariation.IsActive = true;
                    break;
            }
        }
    }

    private void HandleResolutionChanged(int value, bool isWidth)
    {
        if (isWidth) Parameters.Width = value;
        else Parameters.Height = value;
        RefreshHighresInfo();
        RefreshSeedVR2Info();
    }

    private void HandleHRResolutionChanged(int value, bool isWidth)
    {
        if (isWidth) Parameters.HRWidth = value;
        else Parameters.HRHeight = value;
        RefreshHighresInfo();
    }

    private void HandleHRScaleChanged(double value)
    {
        Parameters.HRScale = value;
        RefreshHighresInfo();
    }

    private void HandleSeedVR2ScaleChanged(double value)
    {
        Parameters.SeedVR2.Scale = value;
        RefreshSeedVR2Info();
    }

    private void SetResolution(int width, int height)
    {
        Parameters.Width = width;
        Parameters.Height = height;
        RefreshHighresInfo();
        RefreshSeedVR2Info();
    }

    private void RefreshHighresInfo() => _resizeInfo = Parser.ParseHighresFixResizeInfo(Parameters);

    private void RefreshSeedVR2Info()
    {
        if (Parameters.SeedVR2 == null || Parameters.Width == null || Parameters.Height == null)
        {
            _seedVR2ResizeInfo = new MarkupString(string.Empty);
            return;
        }

        var currentRes = $"{Parameters.Width}x{Parameters.Height} px";
        var (targetWidth, targetHeight, smallestSide) = CalculateSeedVR2Resolution((int)Parameters.Width, (int)Parameters.Height, (double)Parameters.SeedVR2.Scale);
        
        Parameters.SeedVR2.Resolution = smallestSide;
        
        _seedVR2ResizeInfo = new MarkupString($"From: {currentRes} | To: <strong>{targetWidth}x{targetHeight} px</strong> (Smallest side: {smallestSide}px)");
    }

    private (int width, int height, int smallestSide) CalculateSeedVR2Resolution(int width, int height, double scale)
    {
        var targetWidth = (int)(width * scale);
        var targetHeight = (int)(height * scale);
        
        // ComfyUI SeedVR2 expects the size of the smallest side
        // It will maintain the aspect ratio automatically
        var smallestSide = Math.Min(targetWidth, targetHeight);
        
        return (targetWidth, targetHeight, smallestSide);
    }
}