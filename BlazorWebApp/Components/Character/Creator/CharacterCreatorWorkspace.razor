    private string ResolveRegionLabel(string regionId)
    {
        return Catalog.Regions.FirstOrDefault(region => string.Equals(region.Id, regionId, StringComparison.Ordinal))?.Label ??
regionId;
    }

    private string ResolveTraitLabel(string traitId)
    {
        return Catalog.TraitDefinitions.FirstOrDefault(trait => string.Equals(trait.Id, traitId,
StringComparison.Ordinal))?.Label ?? traitId;
    }

    private string GetTraitValue(CharacterTraitDefinition trait)
    {
        var region = GetRegionState(SelectedRegion?.Id ?? SelectedRegionId);
        return region?.SelectedTraits.TryGetValue(trait.Id, out var value) == true ? value.Value : string.Empty;
    }

    private async Task SetTraitValue(CharacterTraitDefinition trait, string? value)
    {
        var region = GetOrCreateRegionState(SelectedRegion?.Id ?? SelectedRegionId);
        if (string.IsNullOrWhiteSpace(value))
        {
            region.SelectedTraits.Remove(trait.Id);
        }
        else
        {
            region.SelectedTraits[trait.Id] = new CharacterTraitValue
            {
                TraitId = trait.Id,
                Value = value.Trim(),
                Locked = trait.LockedByDefault
            };
        }

        await OnChanged.InvokeAsync();
    }

    private async Task SetSelectedRegionNotes(string value)
    {
        GetOrCreateRegionState(SelectedRegion?.Id ?? SelectedRegionId).FreeformNotes = value ?? string.Empty;
        await OnChanged.InvokeAsync();
    }

    private CharacterRegionState? GetRegionState(string regionId)
    {
        if (string.IsNullOrWhiteSpace(regionId))
        {
            return null;
        }

        return Character.Body.Regions.TryGetValue(regionId, out var region) ? region : null;
    }

    private CharacterRegionState GetOrCreateRegionState(string regionId)
    {
        if (string.IsNullOrWhiteSpace(regionId))
        {
            regionId = "body";
        }

        if (!Character.Body.Regions.TryGetValue(regionId, out var region))
        {
            region = new CharacterRegionState { RegionId = regionId };
            Character.Body.Regions[regionId] = region;
        }

        return region;
    }
