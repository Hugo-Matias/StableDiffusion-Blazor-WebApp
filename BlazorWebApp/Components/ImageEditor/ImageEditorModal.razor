        if (_editorInstance == null) return;
        
        await _editorInstance.InvokeVoidAsync("updateLayer", args.layerId, new { locked = args.locked });
        
        var layer = _state.Layers.FirstOrDefault(l => l.Id == args.layerId);
        if (layer != null)
        {
            layer.IsLocked = args.locked;
            StateHasChanged();
        }
    }
    
    private async Task HandleLayerOpacityChanged((string layerId, float opacity) args)
    {
        if (_editorInstance == null) return;
        
        await _editorInstance.InvokeVoidAsync("updateLayer", args.layerId, new { opacity = args.opacity });
        
        var layer = _state.Layers.FirstOrDefault(l => l.Id == args.layerId);
        if (layer != null)
        {
            layer.Opacity = args.opacity;
            StateHasChanged();
        }
    }
    
    private async Task HandleLayerRename((string layerId, string name) args)
    {
        if (_editorInstance == null) return;
        
        await _editorInstance.InvokeVoidAsync("updateLayer", args.layerId, new { name = args.name });
        
        var layer = _state.Layers.FirstOrDefault(l => l.Id == args.layerId);
        if (layer != null)
        {
            layer.Name = args.name;
            _state.IsDirty = true;
            StateHasChanged();
        }
    }
    
    private async Task HandleLayerReorder((string layerId, int direction) args)
    {
        if (_editorInstance == null) 
        {
            Logger.LogWarning("Cannot reorder layer - editor instance is null");
            return;
        }
        
        Logger.LogInformation("Reordering layer {LayerId} in direction {Direction}", args.layerId, args.direction);
        
        var success = await _editorInstance.InvokeAsync<bool>("reorderLayer", args.layerId, args.direction);
        
        Logger.LogInformation("Reorder result: {Success}", success);
        
        if (success)
        {
            _state.IsDirty = true;
        }
    }
    
    private void HandleOverlayClick()
    {
        // Do nothing - user must click Cancel or Apply to close
    }
    
    // ==================== Cleanup ====================
    
    public async ValueTask DisposeAsync()
    {
        await CleanupEditorAsync();
        
        try
        {
            if (_jsModule != null)
            {
                await _jsModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit disconnected, ignore
        }
        
        _dotNetRef?.Dispose();
    }
}
