    private async Task ApplyCrop()
    {
        if (_editorInstance == null || !_state.HasCropRegion)
        {
            return;
        }

        try
        {
            Logger.LogInformation("Cropping edited image (flattening crop region to new source)...");

            var cropResult = await _editorInstance.InvokeAsync<JsonElement?>("applyCrop");
            if (!cropResult.HasValue)
            {
                Logger.LogWarning("Crop did not produce an image result");
                return;
            }

            var result = cropResult.Value;
            if (!result.TryGetProperty("image", out var imageElement))
            {
                Logger.LogWarning("Crop result did not contain image data");
                return;
            }

            var imageData = imageElement.GetString();
            if (string.IsNullOrWhiteSpace(imageData))
            {
                Logger.LogWarning("Cropped image data is empty");
                return;
            }

            var width = result.TryGetProperty("width", out var widthElement) ? widthElement.GetInt32() : 0;
            var height = result.TryGetProperty("height", out var heightElement) ? heightElement.GetInt32() : 0;

            _state.ResetLayersToBase();
            _state.BaseImageData = imageData;
            _state.BaseImageWidth = width;
            _state.BaseImageHeight = height;
            _state.IsBlankCanvas = false;
            _state.CanvasJson = null;
            _state.HasCropRegion = false;
            _state.HasMask = false;
            _state.MaskData = null;
            Session.ImageEditorState = _state;

            await CleanupEditorAsync();

            _isVisible = false;
            StateHasChanged();

            await OnApply.InvokeAsync((imageData, null));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to crop image");
        }
    }

