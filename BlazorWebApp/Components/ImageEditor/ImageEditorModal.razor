    private async Task CycleOrSetSelectionTool()
    {
        var isSelectionTool = _state.CurrentTool == ImageEditorTool.SelectRect 
            || _state.CurrentTool == ImageEditorTool.SelectEllipse 
            || _state.CurrentTool == ImageEditorTool.SelectLasso;
        
        if (isSelectionTool)
        {
            // Cycle to next selection type
            var nextType = _state.ActiveSelectionType switch
            {
                "rect" => "ellipse",
                "ellipse" => "lasso",
                "lasso" => "rect",
                _ => "rect"
            };
            await SetSelectionTool(nextType);
        }
        else
        {
