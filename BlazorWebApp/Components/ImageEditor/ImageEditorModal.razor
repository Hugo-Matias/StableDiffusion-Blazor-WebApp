@using BlazorWebApp.Models
@using System.Text.Json
@inject IJSRuntime JS
@inject ISessionService Session
@inject ILogger<ImageEditorModal> Logger
@implements IAsyncDisposable

@if (_isVisible)
{
    <div class="image-editor-overlay" @onclick="HandleOverlayClick" @onclick:stopPropagation="true">
        <div class="image-editor-modal" @onclick:stopPropagation="true">
            @* Title Bar *@
            <div class="image-editor-titlebar">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                        <MudText Typo="Typo.h6">Image Editor</MudText>
                        @if (_state.IsDirty)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Unsaved</MudChip>
                        }
                        @if (_state.HasMask)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">Mask</MudChip>
                        }
                        @if (_state.HasSelection)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Selection</MudChip>
                        }
                    </MudStack>
                    <MudStack Row Spacing="1">
                        <MudTooltip Text="Fit to View (Ctrl+0)">
                            <MudIconButton Icon="@Icons.Material.Filled.FitScreen" Size="Size.Small" OnClick="FitToView" />
                        </MudTooltip>
                        <MudTooltip Text="Actual Size (Ctrl+1)">
                            <MudIconButton Icon="@Icons.Material.Filled.AspectRatio" Size="Size.Small" OnClick="ZoomToActual" />
                        </MudTooltip>
                        <MudText Typo="Typo.body2" Class="align-self-center px-2">@($"{(_state.ZoomLevel * 100):F0}%")</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Cancel" />
                    </MudStack>
                </MudStack>
            </div>
            
            <div class="image-editor-container" @ref="_containerRef">
                @* Toolbar *@
                <div class="image-editor-toolbar">
                    <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                        @* Drawing Tools *@
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudTooltip Text="Brush (B)">
                                <MudIconButton Icon="@Icons.Material.Filled.Brush" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.Brush ? Color.Primary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.Brush))" />
                            </MudTooltip>
                            <MudTooltip Text="Eraser (E)">
                                <MudIconButton Icon="@Icons.Material.Filled.AutoFixOff" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.Eraser ? Color.Primary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.Eraser))" />
                            </MudTooltip>
                            <MudTooltip Text="Color Picker (I)">
                                <MudIconButton Icon="@Icons.Material.Filled.Colorize" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.ColorPicker ? Color.Primary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.ColorPicker))" />
                            </MudTooltip>
                            <MudTooltip Text="Select (V)">
                                <MudIconButton Icon="@Icons.Material.Filled.OpenWith" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.Select ? Color.Primary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.Select))" />
                            </MudTooltip>
                            <MudTooltip Text="Crop (C)">
                                <MudIconButton Icon="@Icons.Material.Filled.Crop" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.Crop ? Color.Error : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.Crop))" />
                            </MudTooltip>
                            <MudTooltip Text="Pan (Hold Space)">
                                <MudIconButton Icon="@Icons.Material.Filled.PanTool" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.Pan ? Color.Primary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.Pan))" />
                            </MudTooltip>
                        </MudButtonGroup>
                        
                        <MudDivider Vertical FlexItem Class="mx-2" />
                        
                        @* Mask Tools *@
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudTooltip Text="Mask Brush (M) - Draw inpainting mask">
                                <MudIconButton Icon="@Icons.Material.Filled.FormatColorFill" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.MaskBrush ? Color.Secondary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.MaskBrush))" />
                            </MudTooltip>
                            <MudTooltip Text="Mask Eraser - Erase from mask">
                                <MudIconButton Icon="@Icons.Material.Filled.DoNotDisturb" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.MaskEraser ? Color.Secondary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.MaskEraser))" />
                            </MudTooltip>
                        </MudButtonGroup>
                        
                        <MudDivider Vertical FlexItem Class="mx-2" />
                        
                        @* Selection Tools *@
                        @{
                            var isSelectionTool = _state.CurrentTool == ImageEditorTool.SelectRect 
                                || _state.CurrentTool == ImageEditorTool.SelectEllipse 
                                || _state.CurrentTool == ImageEditorTool.SelectLasso;
                            var currentSelectionTool = _state.CurrentTool switch
                            {
                                ImageEditorTool.SelectEllipse => ImageEditorTool.SelectEllipse,
                                ImageEditorTool.SelectLasso => ImageEditorTool.SelectLasso,
                                _ => ImageEditorTool.SelectRect
                            };
                            var selectionIcon = _state.ActiveSelectionType switch
                            {
                                "ellipse" => Icons.Material.Filled.RadioButtonUnchecked,
                                "lasso" => Icons.Material.Filled.Gesture,
                                _ => Icons.Material.Filled.CropSquare
                            };
                            var selectionTooltip = _state.ActiveSelectionType switch
                            {
                                "ellipse" => "Ellipse Selection (O)",
                                "lasso" => "Lasso Selection (L)",
                                _ => "Rectangle Selection (R)"
                            };
                        }
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudTooltip Text="@selectionTooltip">
                                <MudIconButton Icon="@selectionIcon" 
                                               Color="@(isSelectionTool ? Color.Info : Color.Default)"
                                               OnClick="CycleOrSetSelectionTool" />
                            </MudTooltip>
                            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Dense>
                                <MudMenuItem Icon="@Icons.Material.Filled.CropSquare" 
                                             OnClick="@(() => SetSelectionTool("rect"))">
                                    Rectangle (R)
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.RadioButtonUnchecked" 
                                             OnClick="@(() => SetSelectionTool("ellipse"))">
                                    Ellipse (O)
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Gesture" 
                                             OnClick="@(() => SetSelectionTool("lasso"))">
                                    Lasso (L)
                                </MudMenuItem>
                            </MudMenu>
                        </MudButtonGroup>
                        
                        @* Selection Actions (when selection exists) *@
                        @if (_state.HasSelection)
                        {
                            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                                <MudTooltip Text="Add Selection to Mask (Enter)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                                   Color="Color.Secondary"
                                                   OnClick="AddSelectionToMask" />
                                </MudTooltip>
                                <MudTooltip Text="Subtract Selection from Mask (Shift+Enter)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" 
                                                   Color="Color.Secondary"
                                                   OnClick="SubtractSelectionFromMask" />
                                </MudTooltip>
                                <MudTooltip Text="Clear Selection (Escape)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" 
                                                   OnClick="ClearSelection" />
                                </MudTooltip>
                                <MudTooltip Text="Invert Selection (Ctrl+Shift+I)">
                                    <MudIconButton Icon="@Icons.Material.Filled.InvertColors" 
                                                   OnClick="InvertSelection" />
                                </MudTooltip>
                            </MudButtonGroup>
                        }

                        @if (_state.CurrentTool == ImageEditorTool.Crop)
                        {
                            <MudDivider Vertical FlexItem Class="mx-2" />
                            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                                <MudTooltip Text="Crop to Region">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Crop"
                                               Disabled="@(!_state.HasCropRegion)"
                                               OnClick="ApplyCrop">
                                        Crop
                                    </MudButton>
                                </MudTooltip>
                                <MudTooltip Text="Clear Crop Region (Escape)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Disabled="@(!_state.HasCropRegion)"
                                                   OnClick="ClearCrop" />
                                </MudTooltip>
                            </MudButtonGroup>
                        }
                        
                        @* Brush Settings - Contextual based on tool *@
                        @{
                            var showColorPicker = _state.CurrentTool == ImageEditorTool.Brush 
                                || _state.CurrentTool == ImageEditorTool.MaskBrush 
                                || _state.CurrentTool == ImageEditorTool.ColorPicker;
                            var showBrushSize = _state.CurrentTool == ImageEditorTool.Brush 
                                || _state.CurrentTool == ImageEditorTool.Eraser
                                || _state.CurrentTool == ImageEditorTool.MaskBrush 
                                || _state.CurrentTool == ImageEditorTool.MaskEraser;
                            var isMaskTool = _state.CurrentTool == ImageEditorTool.MaskBrush || _state.CurrentTool == ImageEditorTool.MaskEraser;
                            var showBrushSettings = showColorPicker || showBrushSize;
                        }
                        
                        @if (showBrushSettings)
                        {
                            <MudDivider Vertical FlexItem Class="mx-2" />
                            
                            @* Color Picker - for brush tools and color picker tool *@
                            @if (showColorPicker)
                            {
                                var currentColor = isMaskTool ? _state.MaskOverlayColor : _state.BrushColor;
                                var colorTooltip = isMaskTool ? "Mask Overlay Color" : "Brush Color";
                                
                                <MudTooltip Text="@colorTooltip">
                                    <div class="color-picker-wrapper" style="background-color: @currentColor;">
                                        <input type="color" 
                                               value="@currentColor" 
                                               @onchange="HandleColorChange"
                                               class="color-picker-input" />
                                    </div>
                                </MudTooltip>
                            }
                            
                            @* Brush Size - for all brush/eraser tools *@
                            @if (showBrushSize)
                            {
                                <MudTooltip Text="Brush Size ([ / ])">
                                    <MudStack Row Spacing="1" AlignItems="AlignItems.Center" Class="brush-size-control">
                                        <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" />
                                        <MudSlider T="int" 
                                                   Value="_state.BrushSize" 
                                                   ValueChanged="HandleBrushSizeChange"
                                                   Min="1" 
                                                   Max="200" 
                                                   Step="1"
                                                   Style="width: 120px;" />
                                        <MudText Typo="Typo.caption" Style="min-width: 35px;">@(_state.BrushSize)px</MudText>
                                    </MudStack>
                                </MudTooltip>
                            }
                        }
                        
                        <MudDivider Vertical FlexItem Class="mx-2" />
                        
                        @* Undo/Redo *@
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudTooltip Text="Undo (Ctrl+Z)">
                                <MudIconButton Icon="@Icons.Material.Filled.Undo" 
                                               Disabled="@(!_state.CanUndo)"
                                               OnClick="Undo" />
                            </MudTooltip>
                            <MudTooltip Text="Redo (Ctrl+Y)">
                                <MudIconButton Icon="@Icons.Material.Filled.Redo" 
                                               Disabled="@(!_state.CanRedo)"
                                               OnClick="Redo" />
                            </MudTooltip>
                        </MudButtonGroup>
                        
                        @* Import Image *@
                        <MudTooltip Text="Import Image (Drag & Drop, Paste, or Click)">
                            <MudFileUpload T="IBrowserFile" 
                                           Accept="image/*" 
                                           FilesChanged="HandleFileImport"
                                           MaximumFileCount="1"
                                           Class="import-button-wrapper">
                                <ButtonTemplate>
                                    <MudIconButton HtmlTag="label"
                                                   Icon="@Icons.Material.Filled.AddPhotoAlternate" 
                                                   Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Default"
                                                   for="@context" />
                                </ButtonTemplate>
                            </MudFileUpload>
                        </MudTooltip>
                        
                        @* Clear Actions *@
                        <MudMenu Icon="@Icons.Material.Filled.LayersClear" Size="Size.Small" Variant="Variant.Outlined">
                            <MudMenuItem Icon="@Icons.Material.Filled.Brush" OnClick="ClearDrawing">Clear Drawing</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.FormatColorFill" OnClick="ClearMask" Disabled="@(!_state.HasMask)">Clear Mask</MudMenuItem>
                        </MudMenu>
                        
                        @* Object Actions (when in Select mode) *@
                        @if (_state.CurrentTool == ImageEditorTool.Select)
                        {
                            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                                <MudTooltip Text="Flip Horizontal (Ctrl+Shift+H)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Flip" 
                                                   OnClick="FlipHorizontal" />
                                </MudTooltip>
                                <MudTooltip Text="Flip Vertical (Ctrl+Shift+V)">
                                    <MudIconButton OnClick="FlipVertical">
                                        <MudIcon Icon="@Icons.Material.Filled.Flip" Style="transform: rotate(90deg);" />
                                    </MudIconButton>
                                </MudTooltip>
                                <MudTooltip Text="Duplicate (Ctrl+D)">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" 
                                                   OnClick="DuplicateSelection" />
                                </MudTooltip>
                                <MudTooltip Text="Delete (Del)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                   OnClick="DeleteSelection" />
                                </MudTooltip>
                            </MudButtonGroup>
                        }
                        
                        <MudSpacer />
                        
                        @* Layer Controls (Right side) *@
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            @if (_state.HasMask)
                            {
                                var previewIcon = _state.MaskPreviewMode switch
                                {
                                    MaskPreviewMode.Binary => Icons.Material.Filled.Gradient,
                                    MaskPreviewMode.MarchingAnts => Icons.Material.Filled.BorderStyle,
                                    MaskPreviewMode.Blackout => Icons.Material.Filled.DarkMode,
                                    MaskPreviewMode.Whiteout => Icons.Material.Filled.LightMode,
                                    _ => Icons.Material.Filled.Layers
                                };
                                var previewTooltip = _state.MaskPreviewMode switch
                                {
                                    MaskPreviewMode.Binary => "Binary (B/W API preview)",
                                    MaskPreviewMode.MarchingAnts => "Dashed (outline)",
                                    MaskPreviewMode.Blackout => "Blackout (show masked areas)",
                                    MaskPreviewMode.Whiteout => "Whiteout (highlight changes)",
                                    _ => "Overlay (colored stripes)"
                                };
                                
                                @* Mask Preview Mode - Dropdown with cycling *@
                                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                                    <MudTooltip Text="@($"Mask Preview: {previewTooltip} - Click to cycle")">
                                        <MudIconButton Icon="@previewIcon" 
                                                       Size="Size.Small"
                                                       Color="Color.Secondary"
                                                       OnClick="CycleMaskPreviewMode" />
                                    </MudTooltip>
                                    <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Dense>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Layers" 
                                                     OnClick="@(() => SetMaskPreviewMode(MaskPreviewMode.Overlay))">
                                            Overlay (colored stripes)
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Gradient" 
                                                     OnClick="@(() => SetMaskPreviewMode(MaskPreviewMode.Binary))">
                                            Binary (B/W API preview)
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.BorderStyle" 
                                                     OnClick="@(() => SetMaskPreviewMode(MaskPreviewMode.MarchingAnts))">
                                            Dashed (outline)
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.DarkMode" 
                                                     OnClick="@(() => SetMaskPreviewMode(MaskPreviewMode.Blackout))">
                                            Blackout (show masked areas)
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.LightMode" 
                                                     OnClick="@(() => SetMaskPreviewMode(MaskPreviewMode.Whiteout))">
                                            Whiteout (highlight changes)
                                        </MudMenuItem>
                                    </MudMenu>
                                </MudButtonGroup>
                                
                                <MudTooltip Text="Toggle Mask Visibility">
                                    <MudIconButton Icon="@(_state.MaskVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)" 
                                                   Size="Size.Small"
                                                   Color="Color.Secondary"
                                                   OnClick="ToggleMaskVisibility" />
                                </MudTooltip>
                                <MudTooltip Text="Mask Opacity">
                                    <MudSlider T="float" 
                                               Value="_state.MaskOpacity" 
                                               ValueChanged="HandleMaskOpacityChange"
                                               Min="0.1f" 
                                               Max="1.0f" 
                                               Step="0.1f"
                                               Style="width: 80px;" />
                                </MudTooltip>
                            }
                        </MudStack>
                        
                        @* Image Info *@
                        @if (_state.GetCanvasWidth() > 0)
                        {
                            <MudText Typo="Typo.caption" Class="text-muted">
                                @(_state.GetCanvasWidth()) x @(_state.GetCanvasHeight()) px
                            </MudText>
                        }
                    </MudStack>
                </div>
                
                @* Canvas Area with Layer Panel *@
                <div class="image-editor-canvas-area">
                    <div class="image-editor-canvas-main" id="canvas-wrapper-@_sessionId">
                        <canvas @key="_canvasId" id="@_canvasId"></canvas>
                        
                        @if (_isLoading)
                        {
                            <div class="canvas-loading-overlay">
                                <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Large" />
                                <MudText Typo="Typo.body1" Class="mt-3">Loading editor...</MudText>
                            </div>
                        }
                        
                        @* Layer Panel *@
                        <LayerPanel Layers="_state.Layers"
                                    ActiveLayerId=@(_state.ActiveLayerId)
                                    MaxLayerCount="@ImageEditorState.MaxLayerCount"
                                    OnLayerSelected="HandleLayerSelected"
                                    OnAddLayer="HandleAddLayer"
                                    OnDeleteLayer="HandleDeleteLayer"
                                    OnVisibilityChanged="HandleLayerVisibilityChanged"
                                    OnLockChanged="HandleLayerLockChanged"
                                    OnOpacityChanged="HandleLayerOpacityChanged"
                                    OnRename="HandleLayerRename"
                                    OnReorder="HandleLayerReorder" />
                    </div>
                </div>
                
                @* Footer / Status Bar *@
                <div class="image-editor-footer">
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="w-100">
                        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                            @* Zoom Controls *@
                            <MudSlider T="float" 
                                       Value="_state.ZoomLevel" 
                                       ValueChanged="HandleZoomSliderChange"
                                       Min="0.1f" 
                                       Max="5.0f" 
                                       Step="0.1f"
                                       Style="width: 150px;" />
                            
                            @if (_cursorX >= 0 && _cursorY >= 0)
                            {
                                <MudText Typo="Typo.caption" Class="text-muted">
                                    X: @_cursorX, Y: @_cursorY
                                </MudText>
                            }
                            
                            @* Tool indicator *@
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@GetToolColor()">
                                @GetToolDisplayName()
                            </MudChip>
                            
                            @* Active layer indicator *@
                            @if (_state.ActiveLayer != null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                                    @_state.ActiveLayer.Name
                                </MudChip>
                            }
                        </MudStack>
                        
                        <MudStack Row Spacing="2">
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Default" 
                                       OnClick="Cancel">
                                Cancel
                            </MudButton>
                            <MudTooltip Text="Save current edits and close. Preserves layers for further editing. The original base image remains unchanged." Delay="600" Duration="1000">
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Primary" 
                                           OnClick="Save"
                                           StartIcon="@Icons.Material.Filled.Save">
                                    Save
                                </MudButton>
                            </MudTooltip>
                            <MudTooltip Text="Flatten all visible layers into a new image and apply as the new base. This commits all edits permanently." Delay="600" Duration="1000">
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Primary" 
                                           OnClick="Apply"
                                           StartIcon="@Icons.Material.Filled.Check">
                                    Apply
                                </MudButton>
                            </MudTooltip>
                        </MudStack>
                    </MudStack>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<(string image, string? mask)> OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    
    // Private state
    private bool _isVisible;
    private bool _isLoading;
    private bool _isInitialized;
    private bool _isInitializing;
    private string _sessionId = "";
    private string _canvasId = "";
    private ImageEditorState _state = new();
    private int _cursorX = -1;
    private int _cursorY = -1;
    
    // Pending image data
    private string? _pendingImageData;
    private int _pendingWidth;
    private int _pendingHeight;
    private bool _pendingIsBlank;
    
    // Element references
    private ElementReference _containerRef;

    private const string ImageEditorModuleVersion = "20260506-crop-tool-v5";
    
    // JS Interop
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _editorInstance;
    private DotNetObjectReference<ImageEditorModal>? _dotNetRef;
    
    private static int _instanceCounter = 0;
    
    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isVisible && _isLoading && !_isInitialized)
        {
            await InitializeEditorAsync();
        }
    }
    
    public async Task Open(string? imageData = null)
    {
        Logger.LogInformation("Opening image editor with image: {HasImage}", !string.IsNullOrWhiteSpace(imageData));
        
        await CleanupEditorAsync();
        
        _instanceCounter++;
        _sessionId = $"{DateTime.Now.Ticks}-{_instanceCounter}";
        _canvasId = $"editor-canvas-{_sessionId}";
        
        _isVisible = true;
        _isLoading = true;
        _isInitialized = false;
        
        // Check if we should restore previous state (has saved canvas with layers)
        if (Session.ImageEditorState != null && Session.ImageEditorState.CanvasJson != null && Session.ImageEditorState.Layers.Count > 0)
        {
            // Restore previous session - use the PRESERVED base image, not the input
            _state = Session.ImageEditorState;
            _pendingImageData = _state.BaseImageData; // Use the original base, not the new input
            _pendingIsBlank = _state.IsBlankCanvas;
            _pendingWidth = _state.BlankCanvasWidth;
            _pendingHeight = _state.BlankCanvasHeight;
            Logger.LogInformation("Restoring previous editor state with {LayerCount} layers, using preserved base image", _state.Layers.Count);
        }
        else
        {
            // Fresh session - use the provided image data
            _state.Reset();
            _pendingImageData = imageData;
            _pendingIsBlank = string.IsNullOrWhiteSpace(imageData);
            _pendingWidth = 1024;
            _pendingHeight = 1024;
            
            // Store the original base image
            if (!_pendingIsBlank)
            {
                _state.BaseImageData = imageData;
            }
        }
        
        StateHasChanged();
    }
    
    public async Task OpenBlank(int width = 1024, int height = 1024)
    {
        Logger.LogInformation("Opening blank canvas: {Width}x{Height}", width, height);
        
        await CleanupEditorAsync();
        
        _instanceCounter++;
        _sessionId = $"{DateTime.Now.Ticks}-{_instanceCounter}";
        _canvasId = $"editor-canvas-{_sessionId}";
        
        _isVisible = true;
        _isLoading = true;
        _isInitialized = false;
        
        // Check if we should restore previous state (has saved canvas with layers)
        if (Session.ImageEditorState != null && Session.ImageEditorState.CanvasJson != null && Session.ImageEditorState.Layers.Count > 0 && Session.ImageEditorState.IsBlankCanvas)
        {
            // Restore previous blank canvas session
            _state = Session.ImageEditorState;
            _pendingImageData = null;
            _pendingIsBlank = true;
            _pendingWidth = _state.BlankCanvasWidth;
            _pendingHeight = _state.BlankCanvasHeight;
            Logger.LogInformation("Restoring previous blank canvas state with {LayerCount} layers", _state.Layers.Count);
        }
        else
        {
            // Fresh blank canvas
            _state.Reset();
            _state.IsBlankCanvas = true;
            _state.BlankCanvasWidth = width;
            _state.BlankCanvasHeight = height;
            _pendingImageData = null;
            _pendingIsBlank = true;
            _pendingWidth = width;
            _pendingHeight = height;
        }
        
        StateHasChanged();
    }
    
    private async Task InitializeEditorAsync()
    {
        if (_isInitialized || _isInitializing) return;
        _isInitializing = true;
        
        try
        {
            await Task.Delay(200);
            
            var canvasExists = await JS.InvokeAsync<bool>("eval", $"document.getElementById('{_canvasId}') !== null");
            if (!canvasExists)
            {
                Logger.LogWarning("Canvas element {CanvasId} not found in DOM, waiting longer...", _canvasId);
                await Task.Delay(200);
            }
            
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", $"./js/ImageEditor/ImageEditor.js?v={ImageEditorModuleVersion}");
            
            _editorInstance = await _jsModule.InvokeAsync<IJSObjectReference>(
                "init", 
                _canvasId, 
                _dotNetRef,
                new { 
                    maxCanvasSize = 4096,
                    maxHistorySize = _state.MaxHistorySize,
                    defaultBrushSize = _state.BrushSize,
                    defaultBrushColor = _state.BrushColor,
                    maskColor = _state.MaskOverlayColor,
                    maskOpacity = _state.MaskOpacity
                }
            );
            
            _isInitialized = true;
            
            await ResizeCanvasAsync();
            
            if (_pendingIsBlank)
            {
                await CreateBlankCanvasAsync(_pendingWidth, _pendingHeight);
            }
            else if (!string.IsNullOrWhiteSpace(_pendingImageData))
            {
                await LoadImageAsync(_pendingImageData);
            }
            
            // Restore layer state if available
            if (_state.CanvasJson != null && _editorInstance != null)
            {
                await _editorInstance.InvokeVoidAsync("loadState", _state.CanvasJson);
            }
            
            // Sync the current tool with JS (ensures cursor matches tool button state)
            if (_editorInstance != null)
            {
                await _editorInstance.InvokeVoidAsync("setTool", GetJsToolName(_state.CurrentTool));
            }
            
            Logger.LogInformation("Image editor initialized successfully with {LayerCount} layers", _state.Layers.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize ImageEditor");
        }
        finally
        {
            _isInitializing = false;
            _isLoading = false;
            StateHasChanged();
        }
    }
    
    private async Task ResizeCanvasAsync()
    {
        if (_editorInstance == null) return;
        
        try
        {
            var dimensions = await JS.InvokeAsync<int[]>("eval", $@"
                (function() {{
                    var el = document.getElementById('canvas-wrapper-{_sessionId}');
                    if (el) {{
                        return [el.clientWidth || 800, el.clientHeight || 600];
                    }}
                    return [800, 600];
                }})()
            ");
            
            await _editorInstance.InvokeVoidAsync("resize", dimensions[0], dimensions[1]);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to resize canvas");
        }
    }
    
    private async Task LoadImageAsync(string imageData)
    {
        if (_editorInstance == null) return;
        
        // Only update BaseImageData if this is a fresh session (not restoring)
        // When restoring, BaseImageData is already set correctly
        if (string.IsNullOrWhiteSpace(_state.BaseImageData))
        {
            _state.BaseImageData = imageData;
        }
        _state.IsBlankCanvas = false;
        
        try
        {
            await _editorInstance.InvokeAsync<object>("loadImage", imageData);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load image into canvas");
            throw;
        }
    }
    
