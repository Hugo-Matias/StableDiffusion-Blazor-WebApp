@using BlazorWebApp.Models
@inject IJSRuntime JS
@inject ManagerService M
@inject ILogger<ImageEditorModal> Logger
@implements IAsyncDisposable

@if (_isVisible)
{
    <div class="image-editor-overlay" @onclick="HandleOverlayClick" @onclick:stopPropagation="true">
        <div class="image-editor-modal" @onclick:stopPropagation="true">
            @* Title Bar *@
            <div class="image-editor-titlebar">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                        <MudText Typo="Typo.h6">Image Editor</MudText>
                        @if (_state.IsDirty)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Unsaved</MudChip>
                        }
                        @if (_state.HasMask)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">Mask</MudChip>
                        }
                    </MudStack>
                    <MudStack Row Spacing="1">
                        <MudTooltip Text="Fit to View (Ctrl+0)">
                            <MudIconButton Icon="@Icons.Material.Filled.FitScreen" Size="Size.Small" OnClick="FitToView" />
                        </MudTooltip>
                        <MudTooltip Text="Actual Size (Ctrl+1)">
                            <MudIconButton Icon="@Icons.Material.Filled.AspectRatio" Size="Size.Small" OnClick="ZoomToActual" />
                        </MudTooltip>
                        <MudText Typo="Typo.body2" Class="align-self-center px-2">@($"{(_state.ZoomLevel * 100):F0}%")</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Cancel" />
                    </MudStack>
                </MudStack>
            </div>
            
            <div class="image-editor-container" @ref="_containerRef">
                @* Toolbar *@
                <div class="image-editor-toolbar">
                    <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                        @* Drawing Tools *@
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudTooltip Text="Brush (B)">
                                <MudIconButton Icon="@Icons.Material.Filled.Brush" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.Brush ? Color.Primary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.Brush))" />
                            </MudTooltip>
                            <MudTooltip Text="Eraser (E)">
                                <MudIconButton Icon="@Icons.Material.Filled.AutoFixOff" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.Eraser ? Color.Primary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.Eraser))" />
                            </MudTooltip>
                            <MudTooltip Text="Color Picker (I)">
                                <MudIconButton Icon="@Icons.Material.Filled.Colorize" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.ColorPicker ? Color.Primary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.ColorPicker))" />
                            </MudTooltip>
                            <MudTooltip Text="Pan (Hold Space)">
                                <MudIconButton Icon="@Icons.Material.Filled.PanTool" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.Pan ? Color.Primary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.Pan))" />
                            </MudTooltip>
                        </MudButtonGroup>
                        
                        <MudDivider Vertical FlexItem Class="mx-2" />
                        
                        @* Mask Tools *@
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudTooltip Text="Mask Brush (M) - Draw inpainting mask">
                                <MudIconButton Icon="@Icons.Material.Filled.FormatColorFill" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.MaskBrush ? Color.Secondary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.MaskBrush))" />
                            </MudTooltip>
                            <MudTooltip Text="Mask Eraser - Erase from mask">
                                <MudIconButton Icon="@Icons.Material.Filled.DoNotDisturb" 
                                               Color="@(_state.CurrentTool == ImageEditorTool.MaskEraser ? Color.Secondary : Color.Default)"
                                               OnClick="@(() => SetTool(ImageEditorTool.MaskEraser))" />
                            </MudTooltip>
                        </MudButtonGroup>
                        
                        <MudDivider Vertical FlexItem Class="mx-2" />
                        
                        @* Color Picker - simplified *@
                        <MudTooltip Text="Brush Color">
                            <div class="color-picker-wrapper" style="background-color: @_state.BrushColor;">
                                <input type="color" 
                                       value="@_state.BrushColor" 
                                       @onchange="HandleColorChange"
                                       class="color-picker-input" />
                            </div>
                        </MudTooltip>
                        
                        @* Brush Size *@
                        <MudTooltip Text="Brush Size ([ / ])">
                            <MudStack Row Spacing="1" AlignItems="AlignItems.Center" Class="brush-size-control">
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" />
                                <MudSlider T="int" 
                                           Value="_state.BrushSize" 
                                           ValueChanged="HandleBrushSizeChange"
                                           Min="1" 
                                           Max="200" 
                                           Step="1"
                                           Style="width: 120px;" />
                                <MudText Typo="Typo.caption" Style="min-width: 35px;">@(_state.BrushSize)px</MudText>
                            </MudStack>
                        </MudTooltip>
                        
                        <MudDivider Vertical FlexItem Class="mx-2" />
                        
                        @* Undo/Redo *@
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudTooltip Text="Undo (Ctrl+Z)">
                                <MudIconButton Icon="@Icons.Material.Filled.Undo" 
                                               Disabled="@(!_state.CanUndo)"
                                               OnClick="Undo" />
                            </MudTooltip>
                            <MudTooltip Text="Redo (Ctrl+Y)">
                                <MudIconButton Icon="@Icons.Material.Filled.Redo" 
                                               Disabled="@(!_state.CanRedo)"
                                               OnClick="Redo" />
                            </MudTooltip>
                        </MudButtonGroup>
                        
                        @* Clear Actions *@
                        <MudMenu Icon="@Icons.Material.Filled.LayersClear" Size="Size.Small" Variant="Variant.Outlined">
                            <MudMenuItem Icon="@Icons.Material.Filled.Brush" OnClick="ClearDrawing">Clear Drawing</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.FormatColorFill" OnClick="ClearMask" Disabled="@(!_state.HasMask)">Clear Mask</MudMenuItem>
                        </MudMenu>
                        
                        <MudSpacer />
                        
                        @* Layer Controls (Right side) *@
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            @if (_state.HasMask)
                            {
                                <MudTooltip Text="Toggle Mask Visibility">
                                    <MudIconButton Icon="@(_state.MaskVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)" 
                                                   Size="Size.Small"
                                                   Color="Color.Secondary"
                                                   OnClick="ToggleMaskVisibility" />
                                </MudTooltip>
                                <MudTooltip Text="Mask Opacity">
                                    <MudSlider T="float" 
                                               Value="_state.MaskOpacity" 
                                               ValueChanged="HandleMaskOpacityChange"
                                               Min="0.1f" 
                                               Max="1.0f" 
                                               Step="0.1f"
                                               Style="width: 80px;" />
                                </MudTooltip>
                            }
                        </MudStack>
                        
                        @* Image Info *@
                        @if (_state.GetCanvasWidth() > 0)
                        {
                            <MudText Typo="Typo.caption" Class="text-muted">
                                @(_state.GetCanvasWidth()) x @(_state.GetCanvasHeight()) px
                            </MudText>
                        }
                    </MudStack>
                </div>
                
                @* Canvas Area *@
                <div class="image-editor-canvas-wrapper" id="canvas-wrapper-@_sessionId">
                    <canvas @key="_canvasId" id="@_canvasId"></canvas>
                    
                    @if (_isLoading)
                    {
                        <div class="canvas-loading-overlay">
                            <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Large" />
                            <MudText Typo="Typo.body1" Class="mt-3">Loading editor...</MudText>
                        </div>
                    }
                </div>
                
                @* Footer / Status Bar *@
                <div class="image-editor-footer">
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="w-100">
                        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                            @* Zoom Controls *@
                            <MudSlider T="float" 
                                       Value="_state.ZoomLevel" 
                                       ValueChanged="HandleZoomSliderChange"
                                       Min="0.1f" 
                                       Max="5.0f" 
                                       Step="0.1f"
                                       Style="width: 150px;" />
                            
                            @if (_cursorX >= 0 && _cursorY >= 0)
                            {
                                <MudText Typo="Typo.caption" Class="text-muted">
                                    X: @_cursorX, Y: @_cursorY
                                </MudText>
                            }
                            
                            @* Tool indicator *@
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@GetToolColor()">
                                @GetToolDisplayName()
                            </MudChip>
                        </MudStack>
                        
                        <MudStack Row Spacing="2">
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Default" 
                                       OnClick="Cancel">
                                Cancel
                            </MudButton>
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       OnClick="Apply"
                                       StartIcon="@Icons.Material.Filled.Check">
                                Apply
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<(string image, string? mask)> OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    
    // Private state
    private bool _isVisible;
    private bool _isLoading;
    private bool _isInitialized;
    private bool _isInitializing;
    private string _sessionId = "";
    private string _canvasId = "";
    private ImageEditorState _state = new();
    private int _cursorX = -1;
    private int _cursorY = -1;
    
    // Pending image data
    private string? _pendingImageData;
    private int _pendingWidth;
    private int _pendingHeight;
    private bool _pendingIsBlank;
    
    // Element references
    private ElementReference _containerRef;
    
    // JS Interop
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _editorInstance;
    private DotNetObjectReference<ImageEditorModal>? _dotNetRef;
    
    private static int _instanceCounter = 0;
    
    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isVisible && _isLoading && !_isInitialized)
        {
            await InitializeEditorAsync();
        }
    }
    
    public async Task Open(string? imageData = null)
    {
        Logger.LogInformation("Opening image editor with image: {HasImage}", !string.IsNullOrWhiteSpace(imageData));
        
        await CleanupEditorAsync();
        
        _instanceCounter++;
        _sessionId = $"{DateTime.Now.Ticks}-{_instanceCounter}";
        _canvasId = $"editor-canvas-{_sessionId}";
        
        _pendingImageData = imageData;
        _pendingIsBlank = string.IsNullOrWhiteSpace(imageData);
        _pendingWidth = 1024;
        _pendingHeight = 1024;
        
        _isVisible = true;
        _isLoading = true;
        _isInitialized = false;
        _state.Reset();
        
        StateHasChanged();
    }
    
    public async Task OpenBlank(int width = 1024, int height = 1024)
    {
        Logger.LogInformation("Opening blank canvas: {Width}x{Height}", width, height);
        
        await CleanupEditorAsync();
        
        _instanceCounter++;
        _sessionId = $"{DateTime.Now.Ticks}-{_instanceCounter}";
        _canvasId = $"editor-canvas-{_sessionId}";
        
        _pendingImageData = null;
        _pendingIsBlank = true;
        _pendingWidth = width;
        _pendingHeight = height;
        
        _isVisible = true;
        _isLoading = true;
        _isInitialized = false;
        _state.Reset();
        _state.IsBlankCanvas = true;
        _state.BlankCanvasWidth = width;
        _state.BlankCanvasHeight = height;
        
        StateHasChanged();
    }
    
    private async Task InitializeEditorAsync()
    {
        if (_isInitialized || _isInitializing) return;
        _isInitializing = true;
        
        try
        {
            await Task.Delay(200);
            
            var canvasExists = await JS.InvokeAsync<bool>("eval", $"document.getElementById('{_canvasId}') !== null");
            if (!canvasExists)
            {
                Logger.LogWarning("Canvas element {CanvasId} not found in DOM, waiting longer...", _canvasId);
                await Task.Delay(200);
            }
            
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ImageEditor.js");
            
            _editorInstance = await _jsModule.InvokeAsync<IJSObjectReference>(
                "init", 
                _canvasId, 
                _dotNetRef,
                new { 
                    maxCanvasSize = 4096,
                    maxHistorySize = _state.MaxHistorySize,
                    defaultBrushSize = _state.BrushSize,
                    defaultBrushColor = _state.BrushColor,
                    maskColor = _state.MaskOverlayColor,
                    maskOpacity = _state.MaskOpacity
                }
            );
            
            _isInitialized = true;
            
            await ResizeCanvasAsync();
            
            if (_pendingIsBlank)
            {
                await CreateBlankCanvasAsync(_pendingWidth, _pendingHeight);
            }
            else if (!string.IsNullOrWhiteSpace(_pendingImageData))
            {
                await LoadImageAsync(_pendingImageData);
            }
            
            Logger.LogInformation("Image editor initialized successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize ImageEditor");
        }
        finally
        {
            _isInitializing = false;
            _isLoading = false;
            StateHasChanged();
        }
    }
    
    private async Task ResizeCanvasAsync()
    {
        if (_editorInstance == null) return;
        
        try
        {
            var dimensions = await JS.InvokeAsync<int[]>("eval", $@"
                (function() {{
                    var el = document.getElementById('canvas-wrapper-{_sessionId}');
                    if (el) {{
                        return [el.clientWidth || 800, el.clientHeight || 600];
                    }}
                    return [800, 600];
                }})()
            ");
            
            await _editorInstance.InvokeVoidAsync("resize", dimensions[0], dimensions[1]);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to resize canvas");
        }
    }
    
    private async Task LoadImageAsync(string imageData)
    {
        if (_editorInstance == null) return;
        
        _state.BaseImageData = imageData;
        _state.IsBlankCanvas = false;
        
        try
        {
            await _editorInstance.InvokeAsync<object>("loadImage", imageData);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load image into canvas");
            throw;
        }
    }
    
    private async Task CreateBlankCanvasAsync(int width, int height)
    {
        if (_editorInstance == null) return;
        
        _state.IsBlankCanvas = true;
        _state.BlankCanvasWidth = width;
        _state.BlankCanvasHeight = height;
        
        await _editorInstance.InvokeVoidAsync("createBlankCanvas", width, height, "#FFFFFF");
    }
    
    // ==================== Tool Methods ====================
    
    private async Task SetTool(ImageEditorTool tool)
    {
        _state.CurrentTool = tool;
        
        if (_editorInstance != null)
        {
            await _editorInstance.InvokeVoidAsync("setTool", tool.ToString().ToLowerInvariant());
        }
        
        StateHasChanged();
    }
    
    private string GetToolDisplayName() => _state.CurrentTool switch
    {
        ImageEditorTool.Brush => "Brush",
        ImageEditorTool.Eraser => "Eraser",
        ImageEditorTool.ColorPicker => "Color Picker",
        ImageEditorTool.Pan => "Pan",
        ImageEditorTool.MaskBrush => "Mask Brush",
        ImageEditorTool.MaskEraser => "Mask Eraser",
        ImageEditorTool.Fill => "Fill",
        _ => "Unknown"
    };
    
    private Color GetToolColor() => _state.CurrentTool switch
    {
        ImageEditorTool.MaskBrush or ImageEditorTool.MaskEraser => Color.Secondary,
        _ => Color.Primary
    };
    
    private async Task HandleColorChange(ChangeEventArgs e)
    {
        var color = e.Value?.ToString() ?? "#FFFFFF";
        _state.BrushColor = color;
        
        if (_editorInstance != null)
        {
            await _editorInstance.InvokeVoidAsync("setBrush", new { color });
        }
    }
    
    private async Task HandleBrushSizeChange(int size)
    {
        _state.BrushSize = size;
        
        if (_editorInstance != null)
        {
            await _editorInstance.InvokeVoidAsync("setBrush", new { size });
        }
    }
    
    private async Task HandleMaskOpacityChange(float opacity)
    {
        _state.MaskOpacity = opacity;
        
        if (_editorInstance != null)
        {
            await _editorInstance.InvokeVoidAsync("setMaskSettings", new { opacity });
        }
    }
    
    private async Task ToggleMaskVisibility()
    {
        _state.MaskVisible = !_state.MaskVisible;
        
        if (_editorInstance != null)
        {
            await _editorInstance.InvokeVoidAsync("setMaskSettings", new { visible = _state.MaskVisible });
        }
        
        StateHasChanged();
    }
    
    private async Task HandleZoomSliderChange(float zoom)
    {
        _state.ZoomLevel = zoom;
        
        if (_editorInstance != null)
        {
            await _editorInstance.InvokeVoidAsync("setZoom", zoom);
        }
    }
    
    private async Task FitToView()
    {
        if (_editorInstance != null)
        {
            await _editorInstance.InvokeVoidAsync("fitToView");
        }
    }
    
    private async Task ZoomToActual()
    {
        if (_editorInstance != null)
        {
            await _editorInstance.InvokeVoidAsync("zoomToActual");
        }
    }
    
    private async Task Undo()
    {
        if (_editorInstance == null || !_state.CanUndo) return;
        
        var currentState = await _editorInstance.InvokeAsync<string>("getState");
        var previousState = _state.PopUndoState(currentState);
        
        if (previousState != null)
        {
            await _editorInstance.InvokeVoidAsync("loadState", previousState);
        }
        
        StateHasChanged();
    }
    
    private async Task Redo()
    {
        if (_editorInstance == null || !_state.CanRedo) return;
        
        var currentState = await _editorInstance.InvokeAsync<string>("getState");
        var nextState = _state.PopRedoState(currentState);
        
        if (nextState != null)
        {
            await _editorInstance.InvokeVoidAsync("loadState", nextState);
        }
        
        StateHasChanged();
    }
    
    private async Task ClearDrawing()
    {
        if (_editorInstance != null)
        {
            await _editorInstance.InvokeVoidAsync("clearDrawing");
        }
    }
    
    private async Task ClearMask()
    {
        if (_editorInstance != null)
        {
            await _editorInstance.InvokeVoidAsync("clearMask");
            _state.HasMask = false;
            StateHasChanged();
        }
    }
    
    // ==================== Actions ====================
    
    private async Task Apply()
    {
        if (_editorInstance == null) 
        {
            Logger.LogWarning("Cannot apply - editor instance is null");
            return;
        }
        
        try
        {
            Logger.LogInformation("Exporting edited image...");
            
            var imageData = await _editorInstance.InvokeAsync<string>("exportImage", true);
            var maskData = await _editorInstance.InvokeAsync<string?>("exportMask");
            
            Logger.LogInformation("Export complete. Image data length: {ImageLength}, Mask: {HasMask}", 
                imageData?.Length ?? 0, 
                !string.IsNullOrWhiteSpace(maskData));
            
            if (string.IsNullOrWhiteSpace(imageData))
            {
                Logger.LogWarning("Exported image data is empty");
                return;
            }
            
            // Store mask data in state
            if (!string.IsNullOrWhiteSpace(maskData))
            {
                _state.MaskData = maskData;
            }
            
            M.ImageEditorState = _state;
            
            await CleanupEditorAsync();
            
            _isVisible = false;
            StateHasChanged();
            
            await OnApply.InvokeAsync((imageData, maskData));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export image");
        }
    }
    
    private async Task Cancel()
    {
        await CleanupEditorAsync();
        
        _isVisible = false;
        StateHasChanged();
        await OnCancel.InvokeAsync();
    }
    
    private async Task CleanupEditorAsync()
    {
        if (_editorInstance != null)
        {
            try
            {
                await _editorInstance.InvokeVoidAsync("dispose");
                await _editorInstance.DisposeAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error during editor cleanup");
            }
            finally
            {
                _editorInstance = null;
            }
        }
        
        _isInitialized = false;
    }
    
    // ==================== JS Callbacks ====================
    
    [JSInvokable]
    public void OnImageLoaded(int width, int height)
    {
        _state.BaseImageWidth = width;
        _state.BaseImageHeight = height;
        InvokeAsync(StateHasChanged);
    }
    
    [JSInvokable]
    public void OnZoomChanged(float zoom)
    {
        _state.ZoomLevel = zoom;
        InvokeAsync(StateHasChanged);
    }
    
    [JSInvokable]
    public void OnColorPicked(string color)
    {
        _state.BrushColor = color;
        InvokeAsync(async () =>
        {
            if (_editorInstance != null)
            {
                await _editorInstance.InvokeVoidAsync("setBrush", new { color });
            }
            StateHasChanged();
        });
    }
    
    [JSInvokable]
    public void OnToolChangeRequested(string tool)
    {
        if (Enum.TryParse<ImageEditorTool>(tool, true, out var parsedTool))
        {
            InvokeAsync(() => SetTool(parsedTool));
        }
    }
    
    [JSInvokable]
    public void OnBrushSizeChangeRequested(int delta)
    {
        var newSize = Math.Clamp(_state.BrushSize + delta, 1, 200);
        _state.BrushSize = newSize;
        
        InvokeAsync(async () => 
        {
            if (_editorInstance != null)
            {
                await _editorInstance.InvokeVoidAsync("setBrush", new { size = newSize });
            }
            StateHasChanged();
        });
    }
    
    [JSInvokable]
    public void OnCursorPositionChanged(int x, int y)
    {
        _cursorX = x;
        _cursorY = y;
        // Throttle UI updates for cursor position
        InvokeAsync(StateHasChanged);
    }
    
    [JSInvokable]
    public void OnSaveState(string state)
    {
        _state.PushUndoState(state);
        InvokeAsync(StateHasChanged);
    }
    
    [JSInvokable]
    public async Task OnUndoRequested()
    {
        await Undo();
    }
    
    [JSInvokable]
    public async Task OnRedoRequested()
    {
        await Redo();
    }
    
    [JSInvokable]
    public void OnMaskChanged(bool hasMask)
    {
        _state.HasMask = hasMask;
        InvokeAsync(StateHasChanged);
    }
    
    [JSInvokable]
    public void OnCanvasModified()
    {
        _state.IsDirty = true;
        InvokeAsync(StateHasChanged);
    }
    
    private void HandleOverlayClick()
    {
        // Do nothing - user must click Cancel or Apply to close
    }
    
    // ==================== Cleanup ====================
    
    public async ValueTask DisposeAsync()
    {
        await CleanupEditorAsync();
        
        try
        {
            if (_jsModule != null)
            {
                await _jsModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit disconnected, ignore
        }
        
        _dotNetRef?.Dispose();
    }
}
