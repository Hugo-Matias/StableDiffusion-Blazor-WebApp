    private async Task HandleFileImport(IBrowserFile? file)
    {
        if (file == null || _editorInstance == null) return;
        
        try
        {
            // Validate file type
            if (!file.ContentType.StartsWith("image/"))
            {
                Logger.LogWarning("Invalid file type for import: {ContentType}", file.ContentType);
                return;
            }
            
            // Limit file size to 10MB
            const long maxSize = 10 * 1024 * 1024;
            if (file.Size > maxSize)
            {
                Logger.LogWarning("File too large for import: {Size} bytes", file.Size);
                return;
            }
            
            // Read file as data URL
            using var stream = file.OpenReadStream(maxSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var bytes = memoryStream.ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var dataUrl = $"data:{file.ContentType};base64,{base64}";
            
            // Import via JavaScript
            await _editorInstance.InvokeVoidAsync("importImage", dataUrl);
            
            Logger.LogInformation("Imported image file: {FileName}", file.Name);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to import image file");
        }
    }
    
    // ==================== Actions ====================
    
    /// <summary>
    /// Save: Exports flattened image for use, but preserves original base image and layer state for re-editing
    /// </summary>
    private async Task Save()
    {
        if (_editorInstance == null) 
        {
            Logger.LogWarning("Cannot save - editor instance is null");
            return;
        }
        
        try
        {
            Logger.LogInformation("Saving edited image (preserving layers and original base)...");
            
            // Export the flattened visible image
            var imageData = await _editorInstance.InvokeAsync<string>("exportImage", true);
            var maskData = await _editorInstance.InvokeAsync<string?>("exportMask");
            
            Logger.LogInformation("Export complete. Image data length: {ImageLength}, Mask: {HasMask}", 
                imageData?.Length ?? 0, 
                !string.IsNullOrWhiteSpace(maskData));
            
            if (string.IsNullOrWhiteSpace(imageData))
            {
                Logger.LogWarning("Exported image data is empty");
                return;
            }
            
            // Store mask data in state
            if (!string.IsNullOrWhiteSpace(maskData))
            {
                _state.MaskData = maskData;
            }
            
            // Save canvas state for re-editing - but keep the ORIGINAL base image
            _state.CanvasJson = await _editorInstance.InvokeAsync<string>("getState");
            // Note: BaseImageData stays as the original, not the flattened export
            _state.IsDirty = false;
            Session.ImageEditorState = _state;
            Logger.LogInformation("Saved editor state with {LayerCount} layers, original base preserved", _state.Layers.Count);
            
            await CleanupEditorAsync();
            
            _isVisible = false;
            StateHasChanged();
            
            // Send the flattened image for use (but original base is preserved in state)
            await OnApply.InvokeAsync((imageData, maskData));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save image");
        }
    }
    
    /// <summary>
    /// Apply: Flattens all layers into a new base image, resets layer state
    /// </summary>
    private async Task Apply()
    {
        if (_editorInstance == null) 
        {
            Logger.LogWarning("Cannot apply - editor instance is null");
            return;
        }
        
        try
        {
            Logger.LogInformation("Applying edited image (flattening to new base)...");
            
            var imageData = await _editorInstance.InvokeAsync<string>("exportImage", true);
            var maskData = await _editorInstance.InvokeAsync<string?>("exportMask");
            
            Logger.LogInformation("Export complete. Image data length: {ImageLength}, Mask: {HasMask}", 
                imageData?.Length ?? 0, 
                !string.IsNullOrWhiteSpace(maskData));
            
            if (string.IsNullOrWhiteSpace(imageData))
            {
                Logger.LogWarning("Exported image data is empty");
                return;
            }
            
            // Store mask data
            if (!string.IsNullOrWhiteSpace(maskData))
            {
                _state.MaskData = maskData;
            }
            
            // Flatten & Apply - reset layers, use exported image as new base
            _state.ResetLayersToBase();
            _state.BaseImageData = imageData; // NEW base image is the flattened result
            _state.CanvasJson = null; // Clear saved state
            Session.ImageEditorState = _state;
            Logger.LogInformation("Applied and flattened - new base image created");
            
            await CleanupEditorAsync();
            
            _isVisible = false;
            StateHasChanged();
            
            await OnApply.InvokeAsync((imageData, maskData));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to apply image");
        }
    }
    
    private async Task Cancel()
    {
        await CleanupEditorAsync();
        
        _isVisible = false;
        StateHasChanged();
        await OnCancel.InvokeAsync();
    }
    
    private async Task CleanupEditorAsync()
    {
        if (_editorInstance != null)
        {
            try
            {
                await _editorInstance.InvokeVoidAsync("dispose");
                await _editorInstance.DisposeAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error during editor cleanup");
            }
            finally
            {
                _editorInstance = null;
            }
        }
        
        _isInitialized = false;
    }
    
