    [JSInvokable]
    public void OnLayerChanged(JsonElement layerState)
    {
        try
        {
            // Update layers from JS state
            if (layerState.TryGetProperty("layers", out var layersElement))
            {
                _state.Layers.Clear();
                foreach (var layerJson in layersElement.EnumerateArray())
                {
                    var layer = new LayerInfo
                    {
                        Id = layerJson.GetProperty("id").GetString() ?? "",
                        Name = layerJson.GetProperty("name").GetString() ?? "Layer",
                        IsVisible = layerJson.GetProperty("visible").GetBoolean(),
                        IsLocked = layerJson.GetProperty("locked").GetBoolean(),
                        Opacity = (float)layerJson.GetProperty("opacity").GetDouble(),
                        Order = layerJson.GetProperty("order").GetInt32(),
                        LayerType = Enum.TryParse<LayerType>(layerJson.GetProperty("type").GetString(), true, out var lt) ? lt : LayerType.Drawing
                    };
                    _state.Layers.Add(layer);
                }
            }
            
            if (layerState.TryGetProperty("activeLayerId", out var activeIdElement))
            {
                _state.ActiveLayerId = activeIdElement.GetString();
            }
            
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to parse layer state from JS");
        }
    }
    
