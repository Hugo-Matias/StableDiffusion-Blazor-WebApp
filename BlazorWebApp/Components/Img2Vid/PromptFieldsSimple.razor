@using static BlazorWebApp.Data.Enums
@using BlazorWebApp.Events
@inject IEventService Events
@inject IProgressService Progress
@implements IDisposable

<MudPaper Class="pa-6 mb-5">
    <MudGrid>
        <MudItem xs="9">
            <MudStack>
                <MudTextField Value="@Prompt"
                              ValueChanged="@((string v) => HandlePromptChanged(v))"
                              Label="Prompt"
                              Lines="3"
                              Variant="Variant.Outlined"
                              Class="prompt-input"
                              Placeholder="Describe the motion or action for the video..."
                              T="string" />
                <MudTextField Value="@NegativePrompt"
                              ValueChanged="@((string v) => HandleNegativePromptChanged(v))"
                              Label="Negative Prompt"
                              Lines="2"
                              Variant="Variant.Outlined"
                              Class="negative-prompt-input"
                              Placeholder="What to avoid in the video..."
                              Disabled="@DisableNegativePrompt"
                              T="string" />
            </MudStack>
        </MudItem>
        <MudItem xs="3">
            <MudStack Class="h-100 justify-content-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Size="Size.Large"
                           Disabled="@(_isConverging || IsGenerateDisabled)"
                           OnClick="HandleGenerate"
                           FullWidth
                           Class="generate-btn">
                    @if (_isConverging)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate Class="mr-2" />
                        <span>Generating...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Class="mr-2" />
                        <span>Generate</span>
                    }
                </MudButton>
                <MudStack Row Justify="Justify.Center">
                    <MudTooltip Text="Skip current generation">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   Disabled="@(!_isConverging)"
                                   OnClick="HandleSkip">
                            Skip
                        </MudButton>
                    </MudTooltip>
                    <MudTooltip Text="Interrupt/Cancel generation">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@(!_isConverging)"
                                   OnClick="HandleInterrupt">
                            Cancel
                        </MudButton>
                    </MudTooltip>
                </MudStack>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter] public string Prompt { get; set; }
    [Parameter] public EventCallback<string> PromptChanged { get; set; }
    [Parameter] public string NegativePrompt { get; set; }
    [Parameter] public EventCallback<string> NegativePromptChanged { get; set; }
    [Parameter] public EventCallback OnGenerate { get; set; }
    [Parameter] public EventCallback OnSkip { get; set; }
    [Parameter] public EventCallback OnInterrupt { get; set; }
    [Parameter] public bool IsGenerateDisabled { get; set; }
    [Parameter] public bool DisableNegativePrompt { get; set; }

    private bool _isConverging = false;

    protected override void OnInitialized()
    {
        // Initialize from current progress state - critical for page navigation during generation
        _isConverging = Progress.IsConverging;
        
        Events.Subscribe<ConvergingChangedEventArgs>(OnConvergingChanged);
    }

    private void OnConvergingChanged(ConvergingChangedEventArgs args)
    {
        _isConverging = args.IsConverging;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandlePromptChanged(string value)
    {
        Prompt = value;
        await PromptChanged.InvokeAsync(value);
    }

    private async Task HandleNegativePromptChanged(string value)
    {
        NegativePrompt = value;
        await NegativePromptChanged.InvokeAsync(value);
    }

    private async Task HandleGenerate() => await OnGenerate.InvokeAsync();
    private async Task HandleSkip() => await OnSkip.InvokeAsync();
    private async Task HandleInterrupt() => await OnInterrupt.InvokeAsync();

    public void Dispose()
    {
        Events.Unsubscribe<ConvergingChangedEventArgs>(OnConvergingChanged);
    }
}
