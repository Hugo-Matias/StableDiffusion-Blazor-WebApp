@using BlazorWebApp.Data.Dtos.ComfyUI.Workflow
@using static BlazorWebApp.Data.Enums
@inject ManagerService M

@if (M.ParametersImg2Vid != null)
{
<div style="margin-bottom:15rem;">
    <EditForm Model="@M.ParametersImg2Vid">
        <MudGrid Class="pa-5">
            @* LoRA Support *@
            <MudItem xs="12">
                <LoraForm Loras="M.ParametersImg2Vid.Loras" Backend="Backend.ComfyUI" />
            </MudItem>

            @* Sampling Settings *@
            <MudItem xs="6">
                <MudSelect T="string" Label="Sampler" Value="M.ParametersImg2Vid.SamplerName" 
                           ValueChanged="@((string v) => { M.ParametersImg2Vid.SamplerName = v; NotifyChanged(); })"
                           AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                    @if (M.Samplers != null)
                    {
                        @foreach (var sampler in M.Samplers)
                        {
                            <MudSelectItem Value="@sampler.Name" />
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6">
                <MudSelect T="string" Label="Scheduler" Value="M.ParametersImg2Vid.Scheduler" 
                           ValueChanged="@((string v) => { M.ParametersImg2Vid.Scheduler = v; NotifyChanged(); })"
                           AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                    @if (M.Schedulers != null)
                    {
                        @foreach (var scheduler in M.Schedulers)
                        {
                            <MudSelectItem Value="@scheduler.Name" />
                        }
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="4">
                <MudSlider T="int?" Value="M.ParametersImg2Vid.Steps" 
                           ValueChanged="@((int? v) => { M.ParametersImg2Vid.Steps = v; NotifyChanged(); })"
                           Min="GetStepsSettings().Min" 
                           Max="GetStepsSettings().Max" 
                           Step="GetStepsSettings().Step" 
                           Variant="Variant.Filled" ValueLabel>
                    <small>Steps:</small> @M.ParametersImg2Vid.Steps
                </MudSlider>
            </MudItem>
            <MudItem xs="4">
                <MudSlider T="float?" Value="M.ParametersImg2Vid.CfgScale" 
                           ValueChanged="@((float? v) => { M.ParametersImg2Vid.CfgScale = v; NotifyChanged(); })"
                           Min="GetCfgSettings().Min" 
                           Max="GetCfgSettings().Max" 
                           Step="GetCfgSettings().Step" 
                           Variant="Variant.Filled" ValueLabel>
                    <small>CFG Scale:</small> @M.ParametersImg2Vid.CfgScale
                </MudSlider>
            </MudItem>
            <MudItem xs="4">
                <MudSlider T="int?" Value="M.ParametersImg2Vid.Shift" 
                           ValueChanged="@((int? v) => { M.ParametersImg2Vid.Shift = v; NotifyChanged(); })"
                           Min="GetShiftSettings().Min" 
                           Max="GetShiftSettings().Max" 
                           Step="GetShiftSettings().Step" 
                           Variant="Variant.Filled" ValueLabel>
                    <small>Shift:</small> @M.ParametersImg2Vid.Shift
                </MudSlider>
            </MudItem>

            @* Seed *@
            <MudItem xs="5">
                <MudNumericField T="long?" Value="M.ParametersImg2Vid.Seed" 
                                 ValueChanged="@((long? v) => { M.ParametersImg2Vid.Seed = v; NotifyChanged(); })"
                                 Label="Seed" Min="-1" Max="long.MaxValue" />
            </MudItem>
            <MudItem xs="1">
                <MudButtonGroup Variant="Variant.Text" VerticalAlign>
                    <MudIconButton OnClick="SetRandomSeed" Icon="fa-solid fa-shuffle" ButtonType="ButtonType.Button" Class="icon" />
                    <MudIconButton OnClick="RestoreSeed" Icon="fa-solid fa-rotate-left" ButtonType="ButtonType.Button" Class="icon" />
                </MudButtonGroup>
            </MudItem>

            @* Video Settings *@
            <MudItem xs="12">
                <MudText Typo="Typo.overline" Class="mt-2">Video Settings</MudText>
            </MudItem>
            
            <MudItem xs="4">
                <MudSlider T="int?" Value="M.ParametersImg2Vid.Length" 
                           ValueChanged="@((int? v) => { M.ParametersImg2Vid.Length = v; NotifyChanged(); })"
                           Min="GetLengthSettings().Min" 
                           Max="GetLengthSettings().Max" 
                           Step="GetLengthSettings().Step" 
                           Variant="Variant.Filled" ValueLabel>
                    <small>Frames:</small> @M.ParametersImg2Vid.Length (@(GetVideoDuration())s)
                </MudSlider>
            </MudItem>
            <MudItem xs="4">
                <MudSlider T="int?" Value="M.ParametersImg2Vid.FrameRate" 
                           ValueChanged="@((int? v) => { M.ParametersImg2Vid.FrameRate = v; NotifyChanged(); })"
                           Min="GetFrameRateSettings().Min" 
                           Max="GetFrameRateSettings().Max" 
                           Step="GetFrameRateSettings().Step" 
                           Variant="Variant.Filled" ValueLabel>
                    <small>Frame Rate:</small> @M.ParametersImg2Vid.FrameRate fps
                </MudSlider>
            </MudItem>
            <MudItem xs="4">
                <MudSlider T="float?" Value="M.ParametersImg2Vid.MotionAmplitude" 
                           ValueChanged="@((float? v) => { M.ParametersImg2Vid.MotionAmplitude = v; NotifyChanged(); })"
                           Min="GetMotionSettings().Min" 
                           Max="GetMotionSettings().Max" 
                           Step="GetMotionSettings().Step" 
                           Variant="Variant.Filled" ValueLabel>
                    <small>Motion:</small> @M.ParametersImg2Vid.MotionAmplitude?.ToString("F1")
                </MudSlider>
            </MudItem>

            @* Resolution *@
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Class="mb-2">Quick Resolution:</MudText>
                <MudGrid Spacing="2" Justify="Justify.Center">
                    @foreach (var res in M.Settings.Generation.Shared.QuickResolutions)
                    {
                        <MudItem xs="6" sm="4" md="3" lg="2">
                            <MudButton OnClick="@(() => SetResolution(res.Width, res.Height))"
                                       Variant="Variant.Text"
                                       Color="Color.Primary"
                                       FullWidth
                                       Size="Size.Small">
                                @res.Label
                            </MudButton>
                        </MudItem>
                    }
                </MudGrid>
                <div class="d-flex justify-center mt-3">
                    <MudButtonGroup Variant="Variant.Text" Color="Color.Primary">
                        <MudButton OnClick="@(() => ScaleResolution(0.5))"
                                   StartIcon="fa-solid fa-compress"
                                   Size="Size.Small">
                            x0.5
                        </MudButton>
                        <MudButton OnClick="@(() => SetResolution((int)(M.ParametersImg2Vid.Height ?? 768), (int)(M.ParametersImg2Vid.Width ?? 768)))"
                                   StartIcon="fa-solid fa-image-portrait"
                                   Size="Size.Small">
                            Rotate
                        </MudButton>
                        <MudButton OnClick="@(() => ScaleResolution(2.0))"
                                   StartIcon="fa-solid fa-expand"
                                   Size="Size.Small">
                            x2
                        </MudButton>
                    </MudButtonGroup>
                </div>
            </MudItem>
            <MudItem xs="6">
                <MudSlider T="int?" Value="M.ParametersImg2Vid.Width" 
                           ValueChanged="@((int? v) => { M.ParametersImg2Vid.Width = v; NotifyChanged(); })"
                           Min="GetResolutionSettings().Min" 
                           Max="GetResolutionSettings().Max" 
                           Step="GetResolutionSettings().Step" 
                           Variant="Variant.Filled" ValueLabel>
                    <small>Width:</small> @(M.ParametersImg2Vid.Width)px
                </MudSlider>
            </MudItem>
            <MudItem xs="6">
                <MudSlider T="int?" Value="M.ParametersImg2Vid.Height" 
                           ValueChanged="@((int? v) => { M.ParametersImg2Vid.Height = v; NotifyChanged(); })"
                           Min="GetResolutionSettings().Min" 
                           Max="GetResolutionSettings().Max" 
                           Step="GetResolutionSettings().Step" 
                           Variant="Variant.Filled" ValueLabel>
                    <small>Height:</small> @(M.ParametersImg2Vid.Height)px
                </MudSlider>
            </MudItem>

            @* Frame Interpolation Toggle *@
            <MudItem xs="12">
                <MudSwitch T="bool" 
                           Checked="@GetFrameInterpolationEnabled()" 
                           CheckedChanged="HandleFrameInterpolationToggle"
                           Color="Color.Primary"
                           Label="Frame Interpolation (RIFE)" />
            </MudItem>

            @* Frame Interpolation Settings *@
            @if (GetFrameInterpolationEnabled())
            {
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="12" Class="align-items-center justify-content-center d-flex">
                            <MudText Typo="Typo.overline">@GetInterpolationInfo()</MudText>
                        </MudItem>
                        <MudItem xs="4">
                            <MudSlider T="double"
                                       Value="@(M.ParametersImg2Vid.FrameInterpolation?.ScaleBy ?? 2.0)" 
                                       ValueChanged="@((double v) => { EnsureFrameInterpolation(); M.ParametersImg2Vid.FrameInterpolation.ScaleBy = v; NotifyChanged(); })"
                                       Min="GetScaleBySettings().Min" 
                                       Max="GetScaleBySettings().Max" 
                                       Step="GetScaleBySettings().Step" 
                                       Variant="Variant.Filled" ValueLabel>
                                <small>Upscale:</small> @((M.ParametersImg2Vid.FrameInterpolation?.ScaleBy ?? 2.0).ToString("F1"))x
                            </MudSlider>
                        </MudItem>
                        <MudItem xs="4">
                            <MudSlider T="int"
                                       Value="@(M.ParametersImg2Vid.FrameInterpolation?.Multiplier ?? 2)"
                                       ValueChanged="@((int v) => { EnsureFrameInterpolation(); M.ParametersImg2Vid.FrameInterpolation.Multiplier = v; NotifyChanged(); })"
                                       Min="GetMultiplierSettings().Min" 
                                       Max="GetMultiplierSettings().Max" 
                                       Step="GetMultiplierSettings().Step" 
                                       Variant="Variant.Filled" ValueLabel>
                                <small>Frame Mult:</small> @(M.ParametersImg2Vid.FrameInterpolation?.Multiplier ?? 2)x
                            </MudSlider>
                        </MudItem>
                        <MudItem xs="4">
                            <MudSelect T="string" Label="RIFE Model" 
                                       Value="@(M.ParametersImg2Vid.FrameInterpolation?.RifeModel ?? "rife49.pth")"
                                       ValueChanged="@((string v) => { EnsureFrameInterpolation(); M.ParametersImg2Vid.FrameInterpolation.RifeModel = v; NotifyChanged(); })"
                                       AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                                @foreach (var model in GetRifeModels())
                                {
                                    <MudSelectItem Value="@model" />
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            }

            @* Model Settings (Collapsible Advanced Section) *@
            <MudItem xs="12">
                <MudExpansionPanels Elevation="0">
                    <MudExpansionPanel Text="Model Settings" IsInitiallyExpanded="false" Class="mt-3">
                        <MudGrid>
                            <MudItem xs="6">
                                <MudTextField T="string" Value="M.ParametersImg2Vid.HighModel" 
                                              ValueChanged="@((string v) => { M.ParametersImg2Vid.HighModel = v; NotifyChanged(); })"
                                              Label="High Noise Model" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField T="string" Value="M.ParametersImg2Vid.LowModel" 
                                              ValueChanged="@((string v) => { M.ParametersImg2Vid.LowModel = v; NotifyChanged(); })"
                                              Label="Low Noise Model" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField T="string" Value="M.ParametersImg2Vid.Clip" 
                                              ValueChanged="@((string v) => { M.ParametersImg2Vid.Clip = v; NotifyChanged(); })"
                                              Label="CLIP" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField T="string" Value="M.ParametersImg2Vid.ClipVision" 
                                              ValueChanged="@((string v) => { M.ParametersImg2Vid.ClipVision = v; NotifyChanged(); })"
                                              Label="CLIP Vision" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField T="string" Value="M.ParametersImg2Vid.Vae" 
                                              ValueChanged="@((string v) => { M.ParametersImg2Vid.Vae = v; NotifyChanged(); })"
                                              Label="VAE" />
                            </MudItem>
                        </MudGrid>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudItem>
        </MudGrid>
    </EditForm>
</div>
}
else
{
    <MudStack AlignItems="AlignItems.Center" Class="pa-4">
        <MudProgressCircular Indeterminate Color="Color.Primary" />
        <MudText Typo="Typo.caption" Class="mt-2">Loading settings...</MudText>
    </MudStack>
}

@code {
    protected override void OnInitialized()
    {
        EnsureFrameInterpolation();
    }

    // Settings getters with fallback defaults
    private IntRange GetStepsSettings() => M.Settings?.Generation?.Img2Vid?.Sampling?.Steps ?? new IntRange { Min = 1, Max = 50, Step = 1 };
    private FloatRange GetCfgSettings() => M.Settings?.Generation?.Img2Vid?.Sampling?.CfgScale ?? new FloatRange { Min = 1.0f, Max = 15.0f, Step = 0.5f };
    private IntRange GetShiftSettings() => M.Settings?.Generation?.Img2Vid?.Sampling?.Shift ?? new IntRange { Min = 1, Max = 20, Step = 1 };
    private IntRange GetLengthSettings() => M.Settings?.Generation?.Img2Vid?.Video?.Length ?? new IntRange { Min = 17, Max = 257, Step = 8 };
    private IntRange GetFrameRateSettings() => M.Settings?.Generation?.Img2Vid?.Video?.FrameRate ?? new IntRange { Min = 8, Max = 60, Step = 1 };
    private FloatRange GetMotionSettings() => M.Settings?.Generation?.Img2Vid?.Video?.MotionAmplitude ?? new FloatRange { Min = 0.1f, Max = 3.0f, Step = 0.1f };
    private ResolutionSettingsModel GetResolutionSettings() => M.Settings?.Generation?.Shared?.Resolution ?? new ResolutionSettingsModel { Min = 64, Max = 2048, Step = 32 };
    private DoubleRange GetScaleBySettings() => M.Settings?.Generation?.Img2Vid?.FrameInterpolation?.ScaleBy ?? new DoubleRange { Min = 1.0, Max = 4.0, Step = 0.5 };
    private IntRange GetMultiplierSettings() => M.Settings?.Generation?.Img2Vid?.FrameInterpolation?.Multiplier ?? new IntRange { Min = 1, Max = 8, Step = 1 };
    private List<string> GetRifeModels() => M.Settings?.Generation?.Img2Vid?.FrameInterpolation?.RifeModels ?? new List<string> { "rife49.pth", "rife48.pth", "rife47.pth", "rife46.pth" };

    private bool GetFrameInterpolationEnabled()
    {
        return M.ParametersImg2Vid?.FrameInterpolation?.IsActive ?? false;
    }

    private void EnsureFrameInterpolation()
    {
        if (M.ParametersImg2Vid == null) return;
        
        var interpSettings = M.Settings?.Generation?.Img2Vid?.FrameInterpolation;
        M.ParametersImg2Vid.FrameInterpolation ??= new FrameInterpolationParameters
        {
            IsActive = interpSettings?.Enabled ?? true,
            ScaleBy = interpSettings?.ScaleBy?.Value ?? 2.0,
            Multiplier = interpSettings?.Multiplier?.Value ?? 2,
            RifeModel = interpSettings?.RifeModel ?? "rife49.pth"
        };
    }

    private void NotifyChanged()
    {
        StateHasChanged();
    }

    private void HandleFrameInterpolationToggle(bool enabled)
    {
        EnsureFrameInterpolation();
        M.ParametersImg2Vid.FrameInterpolation.IsActive = enabled;
        NotifyChanged();
    }

    private void SetRandomSeed()
    {
        M.ParametersImg2Vid.Seed = -1;
        NotifyChanged();
    }

    private void RestoreSeed()
    {
        if (M.State?.Generation?.Seed > 0)
        {
            M.ParametersImg2Vid.Seed = M.State.Generation.Seed;
            NotifyChanged();
        }
    }

    private void SetResolution(int width, int height)
    {
        M.ParametersImg2Vid.Width = width;
        M.ParametersImg2Vid.Height = height;
        NotifyChanged();
    }

    private void ScaleResolution(double scale)
    {
        var currentWidth = M.ParametersImg2Vid.Width ?? 768;
        var currentHeight = M.ParametersImg2Vid.Height ?? 768;
        var step = GetResolutionSettings().Step;
        
        // Scale and round to nearest step
        var newWidth = (int)(Math.Round(currentWidth * scale / step) * step);
        var newHeight = (int)(Math.Round(currentHeight * scale / step) * step);
        
        // Clamp to min/max
        var min = GetResolutionSettings().Min;
        var max = GetResolutionSettings().Max;
        newWidth = Math.Clamp(newWidth, min, max);
        newHeight = Math.Clamp(newHeight, min, max);
        
        M.ParametersImg2Vid.Width = newWidth;
        M.ParametersImg2Vid.Height = newHeight;
        NotifyChanged();
    }

    private string GetVideoDuration()
    {
        if (M.ParametersImg2Vid?.FrameRate == null || M.ParametersImg2Vid.FrameRate == 0 || M.ParametersImg2Vid?.Length == null)
            return "0";
        
        var baseFrameRate = M.ParametersImg2Vid.FrameRate ?? 16;
        var frames = M.ParametersImg2Vid.Length ?? 81;
        var duration = (double)frames / baseFrameRate;
        
        return duration.ToString("F1");
    }

    private string GetInterpolationInfo()
    {
        var baseFrames = M.ParametersImg2Vid?.Length ?? 81;
        var baseFrameRate = M.ParametersImg2Vid?.FrameRate ?? 16;
        var multiplier = M.ParametersImg2Vid?.FrameInterpolation?.Multiplier ?? 2;
        var scaleBy = M.ParametersImg2Vid?.FrameInterpolation?.ScaleBy ?? 2.0;
        
        var finalFrames = baseFrames * multiplier;
        var finalFrameRate = baseFrameRate * multiplier;
        var duration = (double)baseFrames / baseFrameRate;
        
        var baseWidth = M.ParametersImg2Vid?.Width ?? 768;
        var baseHeight = M.ParametersImg2Vid?.Height ?? 768;
        var finalWidth = (int)(baseWidth * scaleBy);
        var finalHeight = (int)(baseHeight * scaleBy);

        return $"{baseWidth}x{baseHeight} -> {finalWidth}x{finalHeight} | {baseFrames} frames @ {baseFrameRate}fps -> {finalFrames} frames @ {finalFrameRate}fps ({duration:F1}s)";
    }
}
