{
  "Title": "Txt2Img",
  "Base": "ZImage",
  "Mode": "txt2img",
  "Assets": [
    { "parameter": "Model", "label": "Model", "type": "DiffusionModel", "default": "z_image_turbo_bf16.safetensors", "order": 1, "columnSize": 4 },
    { "parameter": "Clip", "label": "CLIP", "type": "Clip", "default": "qwen_3_4b.safetensors", "order": 2, "columnSize": 4 },
    { "parameter": "Vae", "label": "VAE", "type": "Vae", "default": "ae.safetensors", "order": 3, "columnSize": 4 }
  ],
  "Pipeline": [
    {
      "id": "loader_zimage",
      "fragment": "load-diffusion.sbn",
      "parameters": {
        "unet_name": {{ Model | json }},
        "clip_name": {{ Clip | json }},
        "clip_type": "lumina2",
        "vae_name": {{ Vae | json }}
      }
    },
    {
      "id": "latent",
      "fragment": "empty-latent.sbn",
      "parameters": {
        "width": {{ width ?? 872 | json }},
        "height": {{ height ?? 1248 | json }},
        "batch_size": {{ batch_size ?? 1 | json }},
        "latent_class": "EmptySD3LatentImage"
      }
    },
    {{~ if Loras && Loras.size > 0 ~}}
    {{~ for lora in Loras ~}}
    {
      "id": "lora_{{ for.index }}",
      "fragment": "lora-loader.sbn",
      "parameters": {
        "lora_loader_id": "lora_loader_{{ for.index }}",
        "lora_name": {{ lora.Name | json }},
        "lora_path": {{ lora.Path | json }},
        "lora_strength": {{ lora.Strength | json }}
      }
    }{{ if !for.last }},{{ end }}
    {{~ end ~}}
    ,
    {{~ end ~}}
    {
      "id": "prompts",
      "fragment": "prompts.sbn",
      "parameters": {
        "positive": {{ positive | json }},
        "negative": {{ negative | json }}
      }
    },
    {
      "id": "seed_variance_enhancer",
      "fragment": "seed-variance-enhancer.sbn",
      "parameters": {
        "randomize_percent": {{ seed_variance_enhancer_randomize_percent ?? 50 | json }},
        "strength": {{ seed_variance_enhancer_strength ?? 20 | json }},
        "noise_insert": {{ seed_variance_enhancer_noise_insert ?? "noise on beginning steps" | json }},
        "steps_switchover_percent": {{ seed_variance_enhancer_steps_switchover_percent ?? 20 | json }},
        "seed": {{ seed_variance_enhancer_seed ?? 0 | json }},
        "mask_starts_at": {{ seed_variance_enhancer_mask_starts_at ?? "beginning" | json }},
        "mask_percent": {{ seed_variance_enhancer_mask_percent ?? 0 | json }},
        "log_to_console": {{ seed_variance_enhancer_log_to_console ?? false | json }}
      }
    },
    {
      "id": "conditioning_variation",
      "fragment": "conditioning-variation.sbn",
      "parameters": {
        "switch_point": {{ conditioning_variation_switch_point ?? 0.2 | json }}
      }
    },   
    {
      "id": "main_sampler",
      "fragment": "sampler.sbn",
      "parameters": {
        "title": "Main Sampler",
        "sampler_id": "sampler_main",
        "sampler_name": {{ sampler_name ?? "linear/euler" | json }},
        "scheduler": {{ scheduler ?? "simple" | json }},
        "steps": {{ steps ?? 9 | json }},
        "cfg": {{ cfg ?? 1 | json }},
        "seed": {{ seed ?? 42 | json }}
       }
     },
     {
       "id": "vae_decode",
       "fragment": "vae-decode.sbn",
       "parameters": {}
     },
    {
      "id": "seed_vr2",
      "fragment": "upscale-seedvr2.sbn",
      "parameters": {
        "seedvr2_model": {{ seed_vr2_model ?? "seedvr2_ema_7b-Q4_K_M.gguf" | json }},
        "seedvr2_vae_model": {{ seed_vr2_vae_model ?? "ema_vae_fp16.safetensors" | json }},
        "seedvr2_seed": {{ seed ?? 42 | json }},
        "seedvr2_resolution": {{ seed_vr2_resolution ?? 2048 | json }},
        "seedvr2_batch_size": {{ seed_vr2_batch_size ?? 1 | json }},
        "seedvr2_input_noise_scale": {{ seed_vr2_input_noise_scale ?? 0.0 | json }},
        "seedvr2_latent_noise_scale": {{ seed_vr2_latent_noise_scale ?? 0.0 | json }},
        "blocks_to_swap": {{ seed_vr2_blocks_to_swap ?? 36 | json }},
        "vae_tile_size": {{ seed_vr2_vae_tile_size ?? 1024 | json }},
        "vae_tile_overlap": {{ seed_vr2_vae_tile_overlap ?? 128 | json }}
      }
    },
    {
      "id": "loader_detailer",
      "fragment": "load-diffusion-w-prompts.sbn",
      "parameters": {
        "scope": "detailer_",
        "scope_title": "Detailer ",
        "latent_id": "latent_image",
        "unet_name": {{ detailer_checkpoint ?? Model ?? "z_image_turbo_bf16.safetensors" | json }},
        "clip_name": {{ Clip ?? "qwen_3_4b.safetensors" | json }},
        "clip_type": "lumina2",
        "vae_name": {{ Vae ?? "ae.safetensors" | json }},
        "positive": {{ detailer_prompt ?? positive | json }},
        "negative": {{ detailer_negative_prompt ?? negative | json }},
        "width": {{ width ?? 872 | json }},
        "height": {{ height ?? 1248 | json }},
        "batch_size": {{ batch_size ?? 1 | json }}
      }
    },
    {
      "id": "detailer",
      "fragment": "detailer-core.sbn",
      "parameters": {
        "scope": "detailer_",
        "detailer_detection_model": {{ detailer_model ?? "bbox/face_yolov8m.pt" | json }},
        "detailer_sampler": {{ detailer_sampler ?? "dpmpp_2m" | json }},
        "detailer_scheduler": {{ detailer_scheduler ?? "beta" | json }},
        "detailer_seed": {{ detailer_seed ?? seed ?? 42 | json }},
        "detailer_steps": {{ detailer_steps ?? 20 | json }},
        "detailer_cfg": {{ detailer_cfg ?? 8 | json }},
        "detailer_denoise": {{ detailer_denoise ?? 0.65 | json }},
        "detailer_feather": {{ detailer_feather ?? 5 | json }},
        "detailer_bbox_threshold": {{ detailer_bbox_threshold ?? 0.7 | json }},
        "detailer_bbox_dilation": {{ detailer_bbox_dilation ?? 10 | json }},
        "detailer_bbox_crop_factor": {{ detailer_bbox_crop_factor ?? 3 | json }},
        "detailer_drop_size": {{ detailer_drop_size ?? 70 | json }},
        "detailer_guide_size": {{ detailer_guide_size ?? 512 | json }},
        "detailer_max_size": {{ detailer_max_size ?? 1024 | json }},
        "detailer_cycle": {{ detailer_cycle ?? 1 | json }}
      }
    },
    {
      "id": "save",
      "fragment": "save.sbn",
      "parameters": {}
    }
  ]
}