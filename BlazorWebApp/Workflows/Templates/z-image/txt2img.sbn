{
  "Title": "Txt2Img",
  "Base": "ZImage",
  "Mode": "txt2img",
  "Assets": [
    { "parameter": "Model", "label": "Model", "type": "DiffusionModel", "default": "z_image_turbo_bf16.safetensors", "order": 1, "columnSize": 4 },
    { "parameter": "Clip", "label": "CLIP", "type": "Clip", "default": "qwen_3_4b.safetensors", "order": 2, "columnSize": 4 },
    { "parameter": "Vae", "label": "VAE", "type": "Vae", "default": "ae.safetensors", "order": 3, "columnSize": 4 }
  ],
  "Pipeline": [
    {
      "id": "loader_zimage",
      "fragment": "load-diffusion.sbn",
      "parameters": {
        "unet_name": {{ Model | json }},
        "clip_name": {{ Clip | json }},
        "clip_type": "lumina2",
        "vae_name": {{ Vae | json }}
      }
    },
    {
      "id": "latent",
      "fragment": "empty-latent.sbn",
      "parameters": {
        "width": {{ Width ?? 872 | json }},
        "height": {{ Height ?? 1248 | json }},
        "batch_size": {{ BatchSize ?? 1 | json }},
        "latent_class": "EmptySD3LatentImage"
      }
    },
    {{~ if Loras && Loras.size > 0 ~}}
    {{~ for lora in Loras ~}}
    {
      "id": "lora_{{ for.index }}",
      "fragment": "lora-loader.sbn",
      "parameters": {
        "lora_loader_id": "lora_loader_{{ for.index }}",
        "lora_name": {{ lora.Name | json }},
        "lora_path": {{ lora.Path | json }},
        "lora_strength": {{ lora.Strength | json }}
      }
    }{{ if !for.last }},{{ end }}
    {{~ end ~}}
    ,
    {{~ end ~}}
    {
      "id": "prompts",
      "fragment": "prompts.sbn",
      "parameters": {
        "positive": {{ Prompt | json }},
        "negative": {{ NegativePrompt | json }}
      }
    },
    {
      "id": "seed_variance_enhancer",
      "fragment": "seed-variance-enhancer.sbn",
      "parameters": {
        "randomize_percent": {{ SeedVarianceEnhancer.RandomizePercent ?? 50 | json }},
        "strength": {{ SeedVarianceEnhancer.Strength ?? 20 | json }},
        "noise_insert": {{ SeedVarianceEnhancer.NoiseInsert ?? "noise on beginning steps" | json }},
        "steps_switchover_percent": {{ SeedVarianceEnhancer.StepsSwitchoverPercent ?? 20 | json }},
        "seed": {{ SeedVarianceEnhancer.Seed ?? 0 | json }},
        "mask_starts_at": {{ SeedVarianceEnhancer.MaskStartsAt ?? "beginning" | json }},
        "mask_percent": {{ SeedVarianceEnhancer.MaskPercent ?? 0 | json }},
        "log_to_console": {{ SeedVarianceEnhancer.LogToConsole ?? false | json }}
      }
    },
    {
      "id": "conditioning_variation",
      "fragment": "conditioning-variation.sbn",
      "parameters": {
        "switch_point": {{ ConditioningVariation.SwitchPoint ?? 0.2 | json }}
      }
    },   
    {
      "id": "main_sampler",
      "fragment": "sampler.sbn",
      "parameters": {
        "title": "Main Sampler",
        "sampler_id": "sampler_main",
        "sampler_name": {{ SamplerName ?? "linear/euler" | json }},
        "scheduler": {{ Scheduler ?? "simple" | json }},
        "steps": {{ Steps ?? 9 | json }},
        "cfg": {{ CfgScale ?? 1 | json }},
        "seed": {{ Seed ?? 42 | json }}
       }
     },
     {
       "id": "vae_decode",
       "fragment": "vae-decode.sbn",
       "parameters": {}
     },
    {
      "id": "seed_vr2",
      "fragment": "upscale-seedvr2.sbn",
      "parameters": {
        "seedvr2_model": {{ SeedVR2.Model ?? "seedvr2_ema_7b-Q4_K_M.gguf" | json }},
        "seedvr2_vae_model": {{ SeedVR2.VaeModel ?? "ema_vae_fp16.safetensors" | json }},
        "seedvr2_seed": {{ Seed ?? 42 | json }},
        "seedvr2_resolution": {{ SeedVR2.Resolution ?? 2048 | json }},
        "seedvr2_batch_size": {{ SeedVR2.BatchSize ?? 1 | json }},
        "seedvr2_input_noise_scale": {{ SeedVR2.InputNoiseScale ?? 0.0 | json }},
        "seedvr2_latent_noise_scale": {{ SeedVR2.LatentNoiseScale ?? 0.0 | json }},
        "blocks_to_swap": {{ SeedVR2.BlocksToSwap ?? 36 | json }},
        "vae_tile_size": {{ SeedVR2.VaeTileSize ?? 1024 | json }},
        "vae_tile_overlap": {{ SeedVR2.VaeTileOverlap ?? 128 | json }}
      }
    },
    {
      "id": "loader_detailer",
      "fragment": "load-diffusion-w-prompts.sbn",
      "parameters": {
        "scope": "detailer_",
        "scope_title": "Detailer ",
        "latent_id": "latent_image",
        "unet_name": {{ Detailer.Checkpoint ?? Model ?? "z_image_turbo_bf16.safetensors" | json }},
        "clip_name": {{ Clip ?? "qwen_3_4b.safetensors" | json }},
        "clip_type": "lumina2",
        "vae_name": {{ Vae ?? "ae.safetensors" | json }},
        "positive": {{ Detailer.Prompt ?? Prompt | json }},
        "negative": {{ Detailer.NegativePrompt ?? NegativePrompt | json }},
        "width": {{ Width ?? 872 | json }},
        "height": {{ Height ?? 1248 | json }},
        "batch_size": {{ BatchSize ?? 1 | json }}
      }
    },
    {
      "id": "detailer",
      "fragment": "detailer-core.sbn",
      "parameters": {
        "scope": "detailer_",
        "detailer_detection_model": {{ Detailer.Model ?? "bbox/face_yolov8m.pt" | json }},
        "detailer_sampler": {{ Detailer.Sampler ?? "dpmpp_2m" | json }},
        "detailer_scheduler": {{ Detailer.Scheduler ?? "beta" | json }},
        "detailer_seed": {{ Detailer.Seed ?? Seed ?? 42 | json }},
        "detailer_steps": {{ Detailer.Steps ?? 20 | json }},
        "detailer_cfg": {{ Detailer.CfgScale ?? 8 | json }},
        "detailer_denoise": {{ Detailer.Denoise ?? 0.65 | json }},
        "detailer_feather": {{ Detailer.Feather ?? 5 | json }},
        "detailer_bbox_threshold": {{ Detailer.BBoxThreshold ?? 0.7 | json }},
        "detailer_bbox_dilation": {{ Detailer.BBoxDilation ?? 10 | json }},
        "detailer_bbox_crop_factor": {{ Detailer.BBoxCropFactor ?? 3 | json }},
        "detailer_drop_size": {{ Detailer.DropSize ?? 70 | json }},
        "detailer_guide_size": {{ Detailer.GuideSize ?? 512 | json }},
        "detailer_max_size": {{ Detailer.MaxSize ?? 1024 | json }},
        "detailer_cycle": {{ Detailer.Cycle ?? 1 | json }}
      }
    },
    {
      "id": "save",
      "fragment": "save.sbn",
      "parameters": {}
    }
  ]
}