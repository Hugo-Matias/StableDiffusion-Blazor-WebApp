{
  "Title": "Txt2Img",
  "Base": "Flux",
  "Mode": "txt2img",
  "Assets": [
    { "parameter": "Model", "label": "Model", "type": "DiffusionModel", "default": "flux1-krea-dev_fp8_scaled.safetensors", "order": 1, "columnSize": 3 },
    { "parameter": "Clip1", "label": "CLIP T5", "type": "Clip", "default": "t5xxl_fp8_e4m3fn_scaled.safetensors", "order": 2, "columnSize": 3 },
    { "parameter": "Clip2", "label": "CLIP ViT", "type": "Clip", "default": "ViT-L-14-BEST-smooth-GmP-TE-only-HF-format.safetensors", "order": 3, "columnSize": 3 },
    { "parameter": "VAE", "label": "VAE", "type": "Vae", "default": "ae.safetensors", "order": 4, "columnSize": 3 }
  ],
  "Pipeline": [
    {
      "fragment": "flux/load-flux.sbn",
      "parameters": {
        "unet_name": {{ Model ?? "flux1-krea-dev_fp8_scaled.safetensors" | json }},
        "clip_name1": {{ Clip1 ?? "t5xxl_fp8_e4m3fn_scaled.safetensors" | json }},
        "clip_name2": {{ Clip2 ?? "ViT-L-14-BEST-smooth-GmP-TE-only-HF-format.safetensors" | json }},
        "vae_name": {{ VAE ?? "ae.safetensors" | json }},
        "positive": {{ Prompt | json }},
        "guidance": {{ DistilledCfgScale ?? 3.5 | json }},
        "reflux_enabled": true,
        "scaling": "exponential",
        "max_shift": 1.35,
        "base_shift": 0.85,
        "width": {{ Width ?? 872 | json }},
        "height": {{ Height ?? 1248 | json }},
        "batch_size": {{ BatchSize ?? 1 | json }}
      }
    },
    {
      "fragment": "sampler.sbn",
      "parameters": {
        "title": "Main Sampler",
        "sampler_id": "sampler_main",
        "sampler_name": {{ SamplerName ?? "multistep/res_2m" | json }},
        "scheduler": {{ Scheduler ?? "beta" | json }},
        "steps": {{ Steps ?? 20 | json }},
        "cfg": 1,
        "seed": {{ Seed ?? 42 | json }}
      }
    },
    {
      "fragment": "upscale.sbn",
      "parameters": {
        "upscale_model": {{ Upscale.Model ?? "4x-UltraSharpV2.safetensors" | json }},
        "upscale_width": {{ Upscale.Width ?? 1744 | json }},
        "upscale_height": {{ Upscale.Height ?? 2496 | json }},
        "upscale_steps": {{ Upscale.Steps ?? 20 | json }},
        "upscale_denoise": {{ Upscale.Denoise ?? 1 | json }},
        "sampler_name": {{ SamplerName ?? "multistep/res_2m" | json }},
        "scheduler": {{ Scheduler ?? "beta" | json }},
        "seed": {{ Seed ?? 42 | json }},
        "cfg": 1
      }
    },
    {
      "fragment": "vae-decode.sbn",
      "parameters": {}
    },
    {
      "fragment": "flux/load-flux.sbn",
      "parameters": {
        "scope": "detailer_",
        "scope_title": "Detailer ",
        "unet_name": {{ Detailer.Checkpoint ?? Model ?? "flux1-krea-dev_fp8_scaled.safetensors" | json }},
        "clip_name1": {{ Clip1 ?? "t5xxl_fp8_e4m3fn_scaled.safetensors" | json }},
        "clip_name2": {{ Clip2 ?? "ViT-L-14-BEST-smooth-GmP-TE-only-HF-format.safetensors" | json }},
        "vae_name": {{ VAE ?? "ae.safetensors" | json }},
        "positive": {{ Detailer.Prompt ?? Prompt | json }},
        "guidance": {{ DistilledCfgScale ?? 3.5 | json }},
        "reflux_enabled": true,
        "scaling": "exponential",
        "max_shift": 1.35,
        "base_shift": 0.85,
        "width": {{ Width ?? 872 | json }},
        "height": {{ Height ?? 1248 | json }},
        "batch_size": {{ BatchSize ?? 1 | json }}
      }
    },
    {
      "fragment": "detailer-core.sbn",
      "parameters": {
        "scope": "detailer_",
        "detailer_detection_model": {{ Detailer.Model ?? "bbox/face_yolov8m.pt" | json }},
        "detailer_sampler": {{ Detailer.Sampler ?? "dpmpp_2m" | json }},
        "detailer_scheduler": {{ Detailer.Scheduler ?? "beta" | json }},
        "detailer_seed": {{ Detailer.Seed ?? Seed ?? 42 | json }},
        "detailer_steps": {{ Detailer.Steps ?? 20 | json }},
        "detailer_cfg": {{ Detailer.CfgScale ?? 1 | json }},
        "detailer_denoise": {{ Detailer.Denoise ?? 0.65 | json }},
        "detailer_feather": {{ Detailer.Feather ?? 5 | json }},
        "detailer_bbox_threshold": {{ Detailer.BBoxThreshold ?? 0.7 | json }},
        "detailer_bbox_dilation": {{ Detailer.BBoxDilation ?? 10 | json }},
        "detailer_bbox_crop_factor": {{ Detailer.BBoxCropFactor ?? 3 | json }},
        "detailer_drop_size": {{ Detailer.DropSize ?? 70 | json }},
        "detailer_guide_size": {{ Detailer.GuideSize ?? 512 | json }},
        "detailer_max_size": {{ Detailer.MaxSize ?? 1024 | json }},
        "detailer_cycle": {{ Detailer.Cycle ?? 1 | json }}
      }
    },
    {
      "fragment": "save.sbn",
      "parameters": {}
    }
  ]
}
