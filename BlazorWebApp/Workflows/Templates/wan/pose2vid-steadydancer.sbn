{
  "Title": "SteadyDancer",
  "Base": "Wan",
  "Mode": "Img2Vid",
  "Assets": [
    { "parameter": "Model", "label": "Model", "type": "DiffusionModel", "default": "Wan21_SteadyDancer_fp8_e4m3fn_scaled_KJ.safetensors", "order": 1, "columnSize": 4 },
    { "parameter": "Vae", "label": "VAE", "type": "Vae", "default": "wan_2.1_vae.safetensors", "order": 2, "columnSize": 4 },
    { "parameter": "ClipVision", "label": "CLIP Vision", "type": "ClipVision", "default": "clip_vision_h.safetensors", "order": 3, "columnSize": 4 },
    { "parameter": "TextEncoder", "label": "Text Encoder", "type": "Clip", "default": "umt5_xxl_fp16.safetensors", "order": 4, "columnSize": 4 },
    { "parameter": "SpeedLora", "label": "Speed LoRA", "type": "Lora", "default": "Speed/lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors", "order": 5, "columnSize": 4 }
  ],
  "Sources": [
    { "id": "source_video", "label": "Source Video", "type": "video", "required": true },
    { "id": "reference_image", "label": "Reference Image", "type": "image", "required": false }
  ],
  "Pipeline": [
    {
      "id": "load_video",
      "fragment": "load-video.liquid",
      "parameters": {
        "video": {{ video | json }},
        "force_rate": {{ video_force_rate ?? 16 | json }},
        "custom_width": {{ video_width ?? 480 | json }},
        "custom_height": {{ video_height ?? 832 | json }},
        "frame_load_cap": {{ frame_load_cap ?? 176 | json }},
        "skip_first_frames": {{ skip_first_frames ?? 0 | json }},
        "select_every_nth": {{ select_every_nth ?? 1 | json }}
      }
    },
    {
      "id": "get_image_size",
      "fragment": "get-image-size.liquid",
      "parameters": {
        "image_ref": "video_frames"
      }
    },
    {
      "id": "load_image",
      "fragment": "load-image.liquid",
      "parameters": {
        "image": {{ image | json }}
      }
    },
    {
      "id": "resize_subject",
      "fragment": "resize-image-kj.liquid",
      "parameters": {
        "node_id": "resize_subject",
        "image_ref": "image_input",
        "title": "Resize Subject Image"
      }
    },
    {
      "id": "loader_wan",
      "fragment": "wan/load-wan-model.liquid",
      "parameters": {
        "model_name": {{ Model | json }},
        "lora_name": {{ SpeedLora | json }},
        "lora_strength": {{ lora_strength ?? 1 | json }}
      }
    },
    {
      "id": "loader_vae",
      "fragment": "wan/load-wan-vae.liquid",
      "parameters": {
        "vae_name": {{ Vae | json }}
      }
    },
    {
      "id": "clip_vision",
      "fragment": "load-clip-vision.liquid",
      "parameters": {
        "clip_vision_name": {{ ClipVision | json }}
      }
    },
    {
      "id": "prompts",
      "fragment": "wan/text-encode-wan.liquid",
      "parameters": {
        "text_encoder_name": {{ TextEncoder | json }},
        "positive": {{ positive | json }},
        "negative": {{ negative ?? "" | json }}
      }
    },
    {
      "id": "pose_detection",
      "fragment": "wan/pose-detection.liquid",
      "parameters": {}
    },
    {
      "id": "i2v_encode",
      "fragment": "wan/i2v-encode.liquid",
      "parameters": {
        "resized_image_ref": "resized_image"
      }
    },
    {
      "id": "steadydancer_embeds",
      "fragment": "wan/steadydancer-embeds.liquid",
      "parameters": {
        "pose_strength_spatial": {{ pose_strength_spatial ?? 1 | json }},
        "pose_strength_temporal": {{ pose_strength_temporal ?? 1 | json }}
      }
    },
    {
      "id": "context_options",
      "fragment": "wan/context-options.liquid",
      "parameters": {
        "context_frames": {{ context_frames ?? 81 | json }},
        "context_overlap": {{ context_overlap ?? 16 | json }}
      }
    },
    {
      "id": "main_sampler",
      "fragment": "wan/sampler-wan.liquid",
      "parameters": {
        "steps": {{ steps ?? 4 | json }},
        "cfg": {{ cfg ?? 1 | json }},
        "shift": {{ shift ?? 5 | json }},
        "seed": {{ seed ?? 42 | json }},
        "scheduler": {{ scheduler ?? "dpm++_sde" | json }}
      }
    },
    {
      "id": "vae_decode",
      "fragment": "wan/decode-wan.liquid",
      "parameters": {}
    },
    {
      "id": "concat_preview",
      "fragment": "concat-preview.liquid",
      "parameters": {}
    },
    {
      "id": "video_save",
      "fragment": "save-video.liquid",
      "parameters": {
        "frame_rate": {{ output_frame_rate ?? 24 | json }},
        {{~ if append_preview ~}}
        "image_input_name": "preview_concat"
        {{~ else ~}}
        "image_input_name": "image_output"
        {{~ end ~}}
      }
    }
  ]
}
