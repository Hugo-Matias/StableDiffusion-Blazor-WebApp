{
  "Title": "Img2Vid",
  "Base": "Wan",
  "Mode": "img2vid",
  "Assets": [
    { "parameter": "HighModel", "label": "High Model", "type": "DiffusionModel", "default": "wan22RemixT2VI2V_i2vHighV20.safetensors", "order": 1, "columnSize": 3 },
    { "parameter": "LowModel", "label": "Low Model", "type": "DiffusionModel", "default": "wan22RemixT2VI2V_i2vLowV20.safetensors", "order": 2, "columnSize": 3 },
    { "parameter": "Clip", "label": "CLIP", "type": "Clip", "default": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "order": 3, "columnSize": 2 },
    { "parameter": "ClipVision", "label": "CLIP Vision", "type": "ClipVision", "default": "clip_vision_h.safetensors", "order": 4, "columnSize": 2 },
    { "parameter": "Vae", "label": "VAE", "type": "Vae", "default": "wan_2.1_vae.safetensors", "order": 5, "columnSize": 2 }
  ],
  "Sources": [
    { "id": "source_image", "label": "Source Image", "type": "image", "required": true }
  ],
  "Pipeline": [
    {
      "id": "loader_high",
      "fragment": "wan/load-model-sage.liquid",
      "parameters": {
        "model_name": {{ HighModel | json }},
        "node_prefix": "high",
        "model_output_name": "high_model_output",
        "loader_title": "Load High Noise Model"
      }
    },
    {
      "id": "loader_low",
      "fragment": "wan/load-model-sage.liquid",
      "parameters": {
        "model_name": {{ LowModel | json }},
        "node_prefix": "low",
        "model_output_name": "low_model_output",
        "loader_title": "Load Low Noise Model"
      }
    },
    {
      "id": "loader_clip_vae",
      "fragment": "wan/load-clip-vae.liquid",
      "parameters": {
        "clip_name": {{ Clip | json }},
        "vae_name": {{ Vae | json }}
      }
    },
    {
      "$foreach": "HighLoras",
      "$as": "lora",
      "$template": {
        "id": "lora_high_{{ $index }}",
        "fragment": "wan/lora-loader-model-only.liquid",
        "parameters": {
          "lora_loader_id": "high_lora_loader_{{ $index }}",
          "lora_name": "{{ lora.Name }}",
          "lora_path": "{{ lora.HighPath }}",
          "lora_strength": "{{ lora.Strength }}",
          "model_input_name": "high_model_output",
          "model_output_name": "high_lora_model_output",
          "title": "LoRA (High) {{ $index }}"
        }
      }
    },
    {
      "$foreach": "LowLoras",
      "$as": "lora",
      "$template": {
        "id": "lora_low_{{ $index }}",
        "fragment": "wan/lora-loader-model-only.liquid",
        "parameters": {
          "lora_loader_id": "low_lora_loader_{{ $index }}",
          "lora_name": "{{ lora.Name }}",
          "lora_path": "{{ lora.LowPath }}",
          "lora_strength": "{{ lora.Strength }}",
          "model_input_name": "low_model_output",
          "model_output_name": "low_lora_model_output",
          "title": "LoRA (Low) {{ $index }}"
        }
      }
    },
    {
      "id": "model_sampling_high",
      "fragment": "wan/model-sampling-sd3.liquid",
      "parameters": {
        "sampler_id": "high_model_sampling",
        "shift": {{ shift | default: 5 | json }},
        "model_input_name": "$compute:high_model_input",
        "model_output_name": "high_sampled_model_output",
        "title": "ModelSamplingSD3 (High)"
      }
    },
    {
      "id": "model_sampling_low",
      "fragment": "wan/model-sampling-sd3.liquid",
      "parameters": {
        "sampler_id": "low_model_sampling",
        "shift": {{ shift | default: 5 | json }},
        "model_input_name": "$compute:low_model_input",
        "model_output_name": "low_sampled_model_output",
        "title": "ModelSamplingSD3 (Low)"
      }
    },
    {
      "id": "load_image",
      "fragment": "wan/load-image.liquid",
      "parameters": {
        "image_path": {{ image | json }},
        "width": {{ width | default: 768 | json }},
        "height": {{ height | default: 768 | json }}
      }
    },
    {
      "id": "clip_vision",
      "fragment": "wan/clip-vision.liquid",
      "parameters": {
        "clip_vision_name": {{ ClipVision | json }}
      }
    },
    {
      "id": "prompts",
      "fragment": "wan/prompts.liquid",
      "parameters": {
        "positive": {{ positive | json }},
        "negative": {{ negative | json }}
      }
    },
    {
      "id": "video_settings",
      "fragment": "wan/painter-i2v.liquid",
      "parameters": {
        "length": {{ video_length | default: 81 | json }},
        "batch_size": {{ batch_size | default: 1 | json }},
        "motion_amplitude": {{ motion_amplitude | default: 1.1 | json }}
      }
    },
    {
      "id": "sampler_high",
      "fragment": "wan/sampler-advanced.liquid",
      "parameters": {
        "sampler_id": "sampler_high",
        "seed": {{ seed | default: 42 | json }},
        "steps": {{ steps | default: 8 | json }},
        "cfg": {{ cfg | default: 1 | json }},
        "sampler_name": {{ sampler_name | default: "euler" | json }},
        "scheduler": {{ scheduler | default: "simple" | json }},
        "start_at_step": 0,
        "end_at_step": "$compute:half_steps",
        "add_noise": "enable",
        "return_with_leftover_noise": "enable",
        "model_input_name": "high_sampled_model_output",
        "title": "KSampler High Noise"
      }
    },
    {
      "id": "sampler_low",
      "fragment": "wan/sampler-advanced.liquid",
      "parameters": {
        "with_ui": false,
        "sampler_id": "sampler_low",
        "seed": 0,
        "steps": {{ steps | default: 8 | json }},
        "cfg": {{ cfg | default: 1 | json }},
        "sampler_name": {{ sampler_name | default: "euler" | json }},
        "scheduler": {{ scheduler | default: "simple" | json }},
        "start_at_step": "$compute:half_steps",
        "end_at_step": 10000,
        "add_noise": "disable",
        "return_with_leftover_noise": "disable",
        "model_input_name": "low_sampled_model_output",
        "latent_input_name": "latent_output",
        "title": "KSampler Low Noise"
      }
    },
    {
      "id": "clean_vram",
      "fragment": "clean-vram.liquid",
      "parameters": {
        "node_id": "clean_sampler",
        "input_name": "latent_output",
        "output_name": "cleaned_latent_output",
        "title": "Clean VRAM (Sampler)"
      }
    },
    {
      "id": "vae_decode",
      "fragment": "vae-decode.liquid",
      "parameters": {
        "latent_input_name": "cleaned_latent_output"
      }
    },
    {
      "$if": "frame_interpolation.IsActive",
      "id": "frame_interpolation",
      "fragment": "wan/frame-interpolation.liquid",
      "parameters": {
        "scale_by": {{ frame_interpolation_scale_by | default: 2.0 | json }},
        "frame_multiplier": {{ frame_interpolation_multiplier | default: 2 | json }},
        "rife_model": {{ frame_interpolation_rife_model | default: "rife49.pth" | json }}
      }
    },
    {
      "id": "video_save",
      "fragment": "save-video.liquid",
      "parameters": {
        "node_id": "video_output",
        "frame_rate": "$compute:output_frame_rate",
        "image_input_name": "$compute:video_save_input"
      }
    }
  ]
}
