{
  "Title": "Img2Vid",
  "Base": "Wan",
  "Mode": "img2vid",
  "Assets": [
    { "parameter": "HighModel", "label": "High Model", "type": "DiffusionModel", "default": "wan22RemixT2VI2V_i2vHighV20.safetensors", "order": 1, "columnSize": 3 },
    { "parameter": "LowModel", "label": "Low Model", "type": "DiffusionModel", "default": "wan22RemixT2VI2V_i2vLowV20.safetensors", "order": 2, "columnSize": 3 },
    { "parameter": "Clip", "label": "CLIP", "type": "Clip", "default": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "order": 3, "columnSize": 2 },
    { "parameter": "ClipVision", "label": "CLIP Vision", "type": "ClipVision", "default": "clip_vision_h.safetensors", "order": 4, "columnSize": 2 },
    { "parameter": "Vae", "label": "VAE", "type": "Vae", "default": "wan_2.1_vae.safetensors", "order": 5, "columnSize": 2 }
  ],
  "Sources": [
    { "id": "source_image", "label": "Source Image", "type": "image", "required": true }
  ],
  "Pipeline": [
    {
      "id": "loader_high",
      "fragment": "wan/load-model-sage.sbn",
      "parameters": {
        "model_name": {{ HighModel | json }},
        "node_prefix": "high",
        "model_output_name": "high_model_output",
        "loader_title": "Load High Noise Model"
      }
    },
    {
      "id": "loader_low",
      "fragment": "wan/load-model-sage.sbn",
      "parameters": {
        "model_name": {{ LowModel | json }},
        "node_prefix": "low",
        "model_output_name": "low_model_output",
        "loader_title": "Load Low Noise Model"
      }
    },
    {
      "id": "loader_clip_vae",
      "fragment": "wan/load-clip-vae.sbn",
      "parameters": {
        "clip_name": {{ Clip | json }},
        "vae_name": {{ Vae | json }}
      }
    },
    {{~ if Loras && Loras.size > 0 ~}}
    {{~ for lora in Loras ~}}
    {{~ if lora.HighPath && lora.HighPath != "" ~}}
    {
      "id": "lora_high_{{ for.index }}",
      "fragment": "wan/lora-loader-model-only.sbn",
      "parameters": {
        "lora_loader_id": "high_lora_loader_{{ for.index }}",
        "lora_name": {{ lora.Name | json }},
        "lora_path": {{ lora.HighPath | json }},
        "lora_strength": {{ lora.Strength | json }},
        "model_input_name": "high_model_output",
        "model_output_name": "high_lora_model_output",
        "title": "LoRA (High) {{ for.index }}"
      }
    },
    {{~ end ~}}
    {{~ if lora.LowPath && lora.LowPath != "" ~}}
    {
      "id": "lora_low_{{ for.index }}",
      "fragment": "wan/lora-loader-model-only.sbn",
      "parameters": {
        "lora_loader_id": "low_lora_loader_{{ for.index }}",
        "lora_name": {{ lora.Name | json }},
        "lora_path": {{ lora.LowPath | json }},
        "lora_strength": {{ lora.Strength | json }},
        "model_input_name": "low_model_output",
        "model_output_name": "low_lora_model_output",
        "title": "LoRA (Low) {{ for.index }}"
      }
    },
    {{~ end ~}}
    {{~ end ~}}
    {{~ end ~}}
    {
      "id": "model_sampling_high",
      "fragment": "wan/model-sampling-sd3.sbn",
      "parameters": {
        "sampler_id": "high_model_sampling",
        "shift": {{ shift ?? 5 | json }},
        {{~ has_high_lora = false ~}}
        {{~ if Loras && Loras.size > 0 ~}}
        {{~ for lora in Loras ~}}
        {{~ if lora.HighPath && lora.HighPath != "" ~}}
        {{~ has_high_lora = true ~}}
        {{~ end ~}}
        {{~ end ~}}
        {{~ end ~}}
        {{~ if has_high_lora ~}}
        "model_input_name": "high_lora_model_output",
        {{~ else ~}}
        "model_input_name": "high_model_output",
        {{~ end ~}}
        "model_output_name": "high_sampled_model_output",
        "title": "ModelSamplingSD3 (High)"
      }
    },
    {
      "id": "model_sampling_low",
      "fragment": "wan/model-sampling-sd3.sbn",
      "parameters": {
        "sampler_id": "low_model_sampling",
        "shift": {{ shift ?? 5 | json }},
        {{~ has_low_lora = false ~}}
        {{~ if Loras && Loras.size > 0 ~}}
        {{~ for lora in Loras ~}}
        {{~ if lora.LowPath && lora.LowPath != "" ~}}
        {{~ has_low_lora = true ~}}
        {{~ end ~}}
        {{~ end ~}}
        {{~ end ~}}
        {{~ if has_low_lora ~}}
        "model_input_name": "low_lora_model_output",
        {{~ else ~}}
        "model_input_name": "low_model_output",
        {{~ end ~}}
        "model_output_name": "low_sampled_model_output",
        "title": "ModelSamplingSD3 (Low)"
      }
    },
    {
      "id": "load_image",
      "fragment": "wan/load-image.sbn",
      "parameters": {
        "image_path": {{ image | json }},
        "width": {{ width ?? 768 | json }},
        "height": {{ height ?? 768 | json }}
      }
    },
    {
      "id": "clip_vision",
      "fragment": "wan/clip-vision.sbn",
      "parameters": {
        "clip_vision_name": {{ ClipVision | json }}
      }
    },
    {
      "id": "prompts",
      "fragment": "wan/prompts.sbn",
      "parameters": {
        "positive": {{ positive | json }},
        "negative": {{ negative ?? "???,????,??,??,??,??,??,??,??,??,??,??,??,??,??,??,JPEG??,????,???,???,??,??,??,??,????,????,????" | json }}
      }
    },
    {
      "id": "video_settings",
      "fragment": "wan/painter-i2v.sbn",
      "parameters": {
        "length": {{ video_length ?? 81 | json }},
        "batch_size": {{ batch_size ?? 1 | json }},
        "motion_amplitude": {{ motion_amplitude ?? 1.1 | json }}
      }
    },
    {
      "id": "sampler_high",
      "fragment": "wan/sampler-advanced.sbn",
      "parameters": {
        "sampler_id": "sampler_high",
        "seed": {{ seed ?? 42 | json }},
        "steps": {{ steps ?? 8 | json }},
        "cfg": {{ cfg ?? 1 | json }},
        "sampler_name": {{ sampler_name ?? "euler" | json }},
        "scheduler": {{ scheduler ?? "simple" | json }},
        "start_at_step": 0,
        "end_at_step": {{ (steps ?? 8) / 2 | math.round | json }},
        "add_noise": "enable",
        "return_with_leftover_noise": "enable",
        "model_input_name": "high_sampled_model_output",
        "title": "KSampler High Noise"
      }
    },
    {
      "id": "sampler_low",
      "fragment": "wan/sampler-advanced.sbn",
      "parameters": {
        "sampler_id": "sampler_low",
        "seed": 0,
        "steps": {{ steps ?? 8 | json }},
        "cfg": {{ cfg ?? 1 | json }},
        "sampler_name": {{ sampler_name ?? "euler" | json }},
        "scheduler": {{ scheduler ?? "simple" | json }},
        "start_at_step": {{ (steps ?? 8) / 2 | math.round | json }},
        "end_at_step": 10000,
        "add_noise": "disable",
        "return_with_leftover_noise": "disable",
        "model_input_name": "low_sampled_model_output",
        "latent_input_name": "latent_output",
        "title": "KSampler Low Noise"
      }
    },
    {
      "id": "clean_vram",
      "fragment": "clean-vram.sbn",
      "parameters": {
        "node_id": "clean_sampler",
        "input_name": "latent_output",
        "output_name": "cleaned_latent_output",
        "title": "Clean VRAM (Sampler)"
      }
    },
    {
      "id": "vae_decode",
      "fragment": "vae-decode.sbn",
      "parameters": {
        "latent_input_name": "cleaned_latent_output"
      }
    },
    {
      "id": "frame_interpolation",
      "fragment": "wan/frame-interpolation.sbn",
      "parameters": {
        "scale_by": {{ frame_interpolation_scale_by ?? 2.0 | json }},
        "frame_multiplier": {{ frame_interpolation_multiplier ?? 2 | json }},
        "rife_model": {{ frame_interpolation_rife_model ?? "rife49.pth" | json }}
      }
    },
    {
      "id": "video_save",
      "fragment": "video-save.sbn",
      "parameters": {
        "node_id": "video_output",
        {{~ if frame_interpolation_is_active ~}}
        "frame_rate": {{ (frame_rate ?? 16) * (frame_interpolation_multiplier ?? 2) | json }},
        "image_input_name": "frames_output",
        {{~ else ~}}
        "frame_rate": {{ frame_rate ?? 16 | json }},
        "image_input_name": "image_output",
        {{~ end ~}}
        "filename_prefix": "tmp/vid",
        "save_metadata": true,
        "save_output": true
      }
    }
  ]
}
