{
  "Title": "Txt2Img",
  "Base": "Qwen",
  "Mode": "txt2img",
  "Assets": [
    { "parameter": "Model", "label": "Model", "type": "DiffusionModel", "default": "qwen_image_fp8_e4m3fn.safetensors", "order": 1, "columnSize": 4 },
    { "parameter": "Clip", "label": "CLIP", "type": "Clip", "default": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "order": 2, "columnSize": 4 },
    { "parameter": "Vae", "label": "VAE", "type": "Vae", "default": "qwen_image_vae.safetensors", "order": 3, "columnSize": 4 }
  ],
  "Pipeline": [
    {
      "fragment": "load-diffusion-w-prompts.sbn",
      "parameters": {
        "latent_id": "latent_image",
        "unet_name": {{ Model ?? "qwen_image_fp8_e4m3fn.safetensors" | json }},
        "clip_name": {{ Clip ?? "qwen_2.5_vl_7b_fp8_scaled.safetensors" | json }},
        "clip_type": "qwen_image",
        "vae_name": {{ Vae ?? "qwen_image_vae.safetensors" | json }},
        "positive": {{ Prompt | json }},
        "negative": {{ NegativePrompt | json }},
        "width": {{ Width ?? 872 | json }},
        "height": {{ Height ?? 1248 | json }},
        "batch_size": {{ BatchSize ?? 1 | json }}
      }
    },
    {
      "fragment": "model-sampling-auraflow.sbn",
      "parameters": {
        "model_shift": {{ ModelShift ?? 3.10 | json }}
      }
    },
    {
      "fragment": "sampler.sbn",
      "parameters": {
        "title": "Main Sampler",
        "sampler_id": "sampler_main",
        "sampler_name": {{ SamplerName ?? "linear/euler" | json }},
        "scheduler": {{ Scheduler ?? "simple" | json }},
        "steps": {{ Steps ?? 4 | json }},
        "cfg": {{ CfgScale ?? 1 | json }},
        "seed": {{ Seed ?? 42 | json }}
       }
     },
     {
       "fragment": "vae-decode.sbn",
       "parameters": {}
     },
    {
      "fragment": "upscale-seedvr2.sbn",
      "parameters": {
        "seedvr2_model": {{ SeedVR2.Model ?? "seedvr2_ema_7b-Q4_K_M.gguf" | json }},
        "seedvr2_seed": {{ Seed ?? 42 | json }},
        "seedvr2_resolution": {{ SeedVR2.Resolution ?? 2048 | json }},
        "seedvr2_batch_size": {{ SeedVR2.BatchSize ?? 1 | json }},
        "seedvr2_input_noise_scale": {{ SeedVR2.InputNoiseScale ?? 0.0 | json }},
        "seedvr2_latent_noise_scale": {{ SeedVR2.LatentNoiseScale ?? 0.0 | json }},
        "blocks_to_swap": {{ SeedVR2.BlocksToSwap ?? 36 | json }},
        "vae_tile_size": {{ SeedVR2.VaeTileSize ?? 1024 | json }},
        "vae_tile_overlap": {{ SeedVR2.VaeTileOverlap ?? 128 | json }}
      }
    },
    {
      "fragment": "load-diffusion-w-prompts.sbn",
      "parameters": {
        "scope": "detailer_",
        "scope_title": "Detailer ",
        "latent_id": "latent_image",
        "unet_name": {{ Detailer.Checkpoint ?? Model ?? "qwen_image_fp8_e4m3fn.safetensors" | json }},
        "clip_name": {{ Clip ?? "qwen_2.5_vl_7b_fp8_scaled.safetensors" | json }},
        "clip_type": "qwen_image",
        "vae_name": {{ Vae ?? "qwen_image_vae.safetensors" | json }},
        "positive": {{ Detailer.Prompt ?? Prompt | json }},
        "negative": {{ Detailer.NegativePrompt ?? NegativePrompt | json }},
        "width": {{ Width ?? 872 | json }},
        "height": {{ Height ?? 1248 | json }},
        "batch_size": {{ BatchSize ?? 1 | json }}
      }
    },
    {
      "fragment": "detailer-core.sbn",
      "parameters": {
        "scope": "detailer_",
        "detailer_detection_model": {{ Detailer.Model ?? "bbox/face_yolov8m.pt" | json }},
        "detailer_sampler": {{ Detailer.Sampler ?? "dpmpp_2m" | json }},
        "detailer_scheduler": {{ Detailer.Scheduler ?? "beta" | json }},
        "detailer_seed": {{ Detailer.Seed ?? Seed ?? 42 | json }},
        "detailer_steps": {{ Detailer.Steps ?? 20 | json }},
        "detailer_cfg": {{ Detailer.CfgScale ?? 8 | json }},
        "detailer_denoise": {{ Detailer.Denoise ?? 0.65 | json }},
        "detailer_feather": {{ Detailer.Feather ?? 5 | json }},
        "detailer_bbox_threshold": {{ Detailer.BBoxThreshold ?? 0.7 | json }},
        "detailer_bbox_dilation": {{ Detailer.BBoxDilation ?? 10 | json }},
        "detailer_bbox_crop_factor": {{ Detailer.BBoxCropFactor ?? 3 | json }},
        "detailer_drop_size": {{ Detailer.DropSize ?? 70 | json }},
        "detailer_guide_size": {{ Detailer.GuideSize ?? 512 | json }},
        "detailer_max_size": {{ Detailer.MaxSize ?? 1024 | json }},
        "detailer_cycle": {{ Detailer.Cycle ?? 1 | json }}
      }
    },
    {
      "fragment": "save.sbn",
      "parameters": {}
    }
  ]
}