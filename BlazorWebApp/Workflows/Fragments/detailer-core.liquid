{% meta %}
{
  "outputs": {
    "image_output": { "node": "detailer", "index": 0 }
  },
  "conditions": {
    "required": ["detailer.IsActive"]
  },
  "ui": {
    "type": "enhancement",
    "component": "DetailerForm",
    "title": "Detailer",
    "icon": "fa-solid fa-face-smile",
    "order": 120,
    "collapsible": true,
    "defaultCollapsed": true,
    "chainable": true,
    "parameters": {
      "detailer_detection_model": { "source": "Backend.DetectionModels" },
      "detailer_sampler": { "source": "Backend.DetailerSamplers" },
      "detailer_scheduler": { "source": "Backend.DetailerSchedulers" },
      "detailer_seed": { "min": -1 },
      "detailer_steps": { "min": 1, "max": 100, "step": 1 },
      "detailer_cfg": { "min": 1, "max": 30, "step": 0.5 },
      "detailer_denoise": { "min": 0, "max": 1, "step": 0.01 },
      "detailer_feather": { "min": 0, "max": 100, "step": 1 },
      "detailer_bbox_threshold": { "min": 0, "max": 1, "step": 0.01 },
      "detailer_bbox_dilation": { "min": 0, "max": 100, "step": 1 },
      "detailer_bbox_crop_factor": { "min": 1, "max": 10, "step": 0.1 },
      "detailer_drop_size": { "min": 1, "max": 200, "step": 1 },
      "detailer_guide_size": { "min": 64, "max": 2048, "step": 64 },
      "detailer_max_size": { "min": 256, "max": 4096, "step": 64 },
      "detailer_cycle": { "min": 1, "max": 10, "step": 1 }
    }
  }
}
{% endmeta %}

{
  "detailer_bbox_provider": {
    "inputs": {
      "model_name": {{ detailer_detection_model | default: "bbox/face_yolov8m.pt" | json }}
    },
    "class_type": "UltralyticsDetectorProvider",
    "_meta": {
      "title": "Detailer BBox Detector Provider"
    }
  },
  "detailer": {
    "inputs": {
      "guide_size": {{ detailer_guide_size | default: 512 | json }},
      "guide_size_for": true,
      "max_size": {{ detailer_max_size | default: 1024 | json }},
      "seed": {{ detailer_seed | default: 42 | json }},
      "steps": {{ detailer_steps | default: 20 | json }},
      "cfg": {{ detailer_cfg | default: 8 | json }},
      "sampler_name": {{ detailer_sampler | default: "dpmpp_2m" | json }},
      "scheduler": {{ detailer_scheduler | default: "beta" | json }},
      "denoise": {{ detailer_denoise | default: 0.65 | json }},
      "feather": {{ detailer_feather | default: 5 | json }},
      "noise_mask": true,
      "force_inpaint": true,
      "bbox_threshold": {{ detailer_bbox_threshold | default: 0.7 | json }},
      "bbox_dilation": {{ detailer_bbox_dilation | default: 10 | json }},
      "bbox_crop_factor": {{ detailer_bbox_crop_factor | default: 3 | json }},
      "sam_detection_hint": "center-1",
      "sam_dilation": 0,
      "sam_threshold": 0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False",
      "drop_size": {{ detailer_drop_size | default: 70 | json }},
      "wildcard": "",
      "cycle": {{ detailer_cycle | default: 1 | json }},
      "inpaint_model": false,
      "noise_mask_feather": 20,
      "tiled_encode": false,
      "tiled_decode": false,
      "image": {% get_ref "image_output" %},
      "model": {% assign model_key = scope | default: "detailer_" | append: "model_output" %}{% get_ref model_key %},
      "clip": {% assign clip_key = scope | default: "detailer_" | append: "clip_output" %}{% get_ref clip_key %},
      "vae": {% assign vae_key = scope | default: "detailer_" | append: "vae_output" %}{% get_ref vae_key %},
      "positive": {% assign pos_key = scope | default: "detailer_" | append: "positive_output" %}{% get_ref pos_key %},
      "negative": {% assign neg_key = scope | default: "detailer_" | append: "negative_output" %}{% get_ref neg_key %},
      "bbox_detector": ["detailer_bbox_provider", 0]
    },
    "class_type": "FaceDetailer",
    "_meta": {
      "title": "FaceDetailer"
    }
  }
}
