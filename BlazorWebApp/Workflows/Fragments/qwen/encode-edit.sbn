#meta
{
  "outputs": {
    "positive_output": { "node": "{{ scope ?? '' }}encode_positive", "index": 0 },
    "negative_output": { "node": "{{ scope ?? '' }}encode_negative", "index": 0 }
  }
}
#end

{
  "{{ scope ?? '' }}encode_positive": {
    "inputs": {
      "prompt": {{ positive | json }},
      "clip": {{ get_ref ((scope ?? "") + "clip_output") }},
      "vae": {{ get_ref ((scope ?? "") + "vae_output") }},
      "image1": {{ get_ref (image_ref ?? "image_input") }}
    },
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Encode Positive (Qwen Edit)"
    }
  },
  "{{ scope ?? '' }}encode_negative": {
    "inputs": {
      "prompt": {{ negative ?? "" | json }},
      "clip": {{ get_ref ((scope ?? "") + "clip_output") }},
      "vae": {{ get_ref ((scope ?? "") + "vae_output") }},
      "image1": {{ get_ref (image_ref ?? "image_input") }}
    },
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Encode Negative (Qwen Edit)"
    }
  }
}
