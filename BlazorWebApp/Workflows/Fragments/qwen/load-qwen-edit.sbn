#meta
{
  "outputs": {
    "{{ scope ?? '' }}model_output": { "node": "{{ scope ?? '' }}cfg_norm", "index": 0 },
    "{{ scope ?? '' }}clip_output": { "node": "{{ scope ?? '' }}clip_loader", "index": 0 },
    "{{ scope ?? '' }}vae_output": { "node": "{{ scope ?? '' }}vae_loader", "index": 0 }
  }
}
#end

{
  "{{ scope ?? '' }}unet_loader": {
    "inputs": {
      "unet_name": {{ unet_name | json }},
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Load Diffusion Model"
    }
  },
  "{{ scope ?? '' }}clip_loader": {
    "inputs": {
      "clip_name": {{ clip_name | json }},
      "type": "qwen_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Load CLIP"
    }
  },
  "{{ scope ?? '' }}vae_loader": {
    "inputs": {
      "vae_name": {{ vae_name | json }}
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Load VAE"
    }
  },
  "{{ scope ?? '' }}lora_loader": {
    "inputs": {
      "lora_name": {{ lora_name ?? "Speed/Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors" | json }},
      "strength_model": {{ lora_strength ?? 1 | json }},
      "model": ["{{ scope ?? '' }}unet_loader", 0]
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "{{ scope_title ?? '' }}LoRA Loader (Lightning)"
    }
  },
  "{{ scope ?? '' }}model_sampling": {
    "inputs": {
      "shift": {{ model_shift ?? 3 | json }},
      "model": ["{{ scope ?? '' }}lora_loader", 0]
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "{{ scope_title ?? '' }}ModelSamplingAuraFlow"
    }
  },
  "{{ scope ?? '' }}cfg_norm": {
    "inputs": {
      "strength": {{ cfg_norm_strength ?? 1 | json }},
      "model": ["{{ scope ?? '' }}model_sampling", 0]
    },
    "class_type": "CFGNorm",
    "_meta": {
      "title": "{{ scope_title ?? '' }}CFGNorm"
    }
  }
}
