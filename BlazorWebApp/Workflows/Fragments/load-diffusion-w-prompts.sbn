#meta
{
  "outputs": {
    "{{ if scope }}{{ scope }}{{ end }}model_output": { "node": "{{ if scope }}{{ scope }}{{ end }}lora_positive", "index": 0 },
    "{{ if scope }}{{ scope }}{{ end }}clip_output": { "node": "{{ if scope }}{{ scope }}{{ end }}lora_positive", "index": 1 },
    "{{ if scope }}{{ scope }}{{ end }}vae_output": { "node": "{{ if scope }}{{ scope }}{{ end }}vae_loader", "index": 0 },
    "{{ if scope }}{{ scope }}{{ end }}positive_output": { "node": "{{ if scope }}{{ scope }}{{ end }}encode_positive", "index": 0 },
    "{{ if scope }}{{ scope }}{{ end }}negative_output": { "node": "{{ if scope }}{{ scope }}{{ end }}encode_negative", "index": 0 }
  }{{~ if scope && string_contains scope "detailer" ~}},
  "conditions": {
    "required": ["detailer.IsActive"]
  }{{~ end ~}}
}
#end

{
  "{{ if scope }}{{ scope }}{{ end }}unet_loader": {
    "inputs": {
      "unet_name": {{ unet_name | json }},
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}Load Diffusion Model"
    }
  },
  "{{ if scope }}{{ scope }}{{ end }}clip_loader": {
    "inputs": {
      "clip_name": {{ clip_name | json }},
      "type": {{ clip_type | json }},
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}Load CLIP"
    }
  },
  "{{ if scope }}{{ scope }}{{ end }}vae_loader": {
    "inputs": {
      "vae_name": {{ vae_name | json }}
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}Load VAE"
    }
  },
  "{{ if scope }}{{ scope }}{{ end }}text_positive": {
    "inputs": {
      "value": {{ positive | json }}
    },
    "class_type": "PrimitiveStringMultiline",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}Prompt"
    }
  },
  "{{ if scope }}{{ scope }}{{ end }}text_negative": {
    "inputs": {
      "value": {{ negative | json }}
    },
    "class_type": "PrimitiveStringMultiline",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}Negative Prompt"
    }
  },
  "{{ if scope }}{{ scope }}{{ end }}lora_positive": {
    "inputs": {
      "text": ["{{ if scope }}{{ scope }}{{ end }}text_positive", 0],
      "model": ["{{ if scope }}{{ scope }}{{ end }}unet_loader", 0],
      "clip": ["{{ if scope }}{{ scope }}{{ end }}clip_loader", 0]
    },
    "class_type": "PCLazyLoraLoader",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}LoRAs (Positive)"
    }
  },
  "{{ if scope }}{{ scope }}{{ end }}lora_negative": {
    "inputs": {
      "text": ["{{ if scope }}{{ scope }}{{ end }}text_negative", 0],
      "model": ["{{ if scope }}{{ scope }}{{ end }}unet_loader", 0],
      "clip": ["{{ if scope }}{{ scope }}{{ end }}clip_loader", 0]
    },
    "class_type": "PCLazyLoraLoader",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}LoRAs (Negative)"
    }
  },
  "{{ if scope }}{{ scope }}{{ end }}encode_positive": {
    "inputs": {
      "text": ["{{ if scope }}{{ scope }}{{ end }}text_positive", 0],
      "clip": ["{{ if scope }}{{ scope }}{{ end }}lora_positive", 1]
    },
    "class_type": "PCLazyTextEncode",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}Encode Positive"
    }
  },
  "{{ if scope }}{{ scope }}{{ end }}encode_negative": {
    "inputs": {
      "text": ["{{ if scope }}{{ scope }}{{ end }}text_negative", 0],
      "clip": ["{{ if scope }}{{ scope }}{{ end }}lora_negative", 1]
    },
    "class_type": "PCLazyTextEncode",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}Encode Negative"
    }
  }
}