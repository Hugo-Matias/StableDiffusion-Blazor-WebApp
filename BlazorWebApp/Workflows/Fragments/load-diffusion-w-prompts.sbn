#meta
{
  "outputs": {
    "{{ scope ?? '' }}model_output": { "node": "{{ scope ?? '' }}lora_positive", "index": 0 },
    "{{ scope ?? '' }}clip_output": { "node": "{{ scope ?? '' }}lora_positive", "index": 1 },
    "{{ scope ?? '' }}vae_output": { "node": "{{ scope ?? '' }}vae_loader", "index": 0 },
    "{{ scope ?? '' }}latent_output": { "node": "{{ scope ?? '' }}{{ latent_id }}", "index": 0 },
    "{{ scope ?? '' }}positive_output": { "node": "{{ scope ?? '' }}encode_positive", "index": 0 },
    "{{ scope ?? '' }}negative_output": { "node": "{{ scope ?? '' }}encode_negative", "index": 0 }
  }
}
#end

{
  "{{ scope ?? '' }}unet_loader": {
    "inputs": {
      "unet_name": {{ unet_name | json }},
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Load Diffusion Model"
    }
  },
  "{{ scope ?? '' }}clip_loader": {
    "inputs": {
      "clip_name": {{ clip_name | json }},
      "type": {{ clip_type | json }},
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Load CLIP"
    }
  },
  "{{ scope ?? '' }}vae_loader": {
    "inputs": {
      "vae_name": {{ vae_name | json }}
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Load VAE"
    }
  },
  "{{ scope ?? '' }}text_positive": {
    "inputs": {
      "value": {{ positive | json }}
    },
    "class_type": "PrimitiveStringMultiline",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Prompt"
    }
  },
  "{{ scope ?? '' }}text_negative": {
    "inputs": {
      "value": {{ negative | json }}
    },
    "class_type": "PrimitiveStringMultiline",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Negative Prompt"
    }
  },
  "{{ scope ?? '' }}lora_positive": {
    "inputs": {
      "text": ["{{ scope ?? '' }}text_positive", 0],
      "model": ["{{ scope ?? '' }}unet_loader", 0],
      "clip": ["{{ scope ?? '' }}clip_loader", 0]
    },
    "class_type": "PCLazyLoraLoader",
    "_meta": {
      "title": "{{ scope_title ?? '' }}LoRAs (Positive)"
    }
  },
  "{{ scope ?? '' }}lora_negative": {
    "inputs": {
      "text": ["{{ scope ?? '' }}text_negative", 0],
      "model": ["{{ scope ?? '' }}unet_loader", 0],
      "clip": ["{{ scope ?? '' }}clip_loader", 0]
    },
    "class_type": "PCLazyLoraLoader",
    "_meta": {
      "title": "{{ scope_title ?? '' }}LoRAs (Negative)"
    }
  },
  "{{ scope ?? '' }}encode_positive": {
    "inputs": {
      "text": ["{{ scope ?? '' }}text_positive", 0],
      "clip": ["{{ scope ?? '' }}lora_positive", 1]
    },
    "class_type": "PCLazyTextEncode",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Encode Positive"
    }
  },
  "{{ scope ?? '' }}encode_negative": {
    "inputs": {
      "text": ["{{ scope ?? '' }}text_negative", 0],
      "clip": ["{{ scope ?? '' }}lora_negative", 1]
    },
    "class_type": "PCLazyTextEncode",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Encode Negative"
    }
  },
  "{{ scope ?? '' }}{{ latent_id }}": {
    "inputs": {
      "width": {{ width | json }},
      "height": {{ height | json }},
      "batch_size": {{ batch_size | json }}
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Empty Latent Image"
    }
  }
}