#meta
{
  "outputs": {
    "model_output": { "node": "{{ lora_loader_id }}", "index": 0 },
    "clip_output": { "node": "{{ lora_loader_id }}", "index": 1 }
  }
}
#end

{
  "{{ lora_loader_id }}": {
    "inputs": {
      "lora_name": {{ (lora_path ?? lora_name) | json }},
      "strength_model": {{ lora_strength | json }},
      "strength_clip": {{ lora_strength_clip ?? 1.0 | json }},
      "model": {{ get_ref ((scope ?? "") + "model_output") }},
      "clip": {{ get_ref ((scope ?? "") + "clip_output") }}
    },
    "class_type": "LoraLoader",
    "_meta": {
      "title": "LoRA Loader"
    }
  }
}