#meta
{
  "outputs": {
    "preview_concat": { "node": "concat_final", "index": 0 }
  },
  "conditions": {
    "required": ["append_preview"]
  }
}
#end

{
  "concat_source_pose": {
    "inputs": {
      "inputcount": 2,
      "direction": "down",
      "match_image_size": false,
      "Update inputs": "",
      "image_1": {{ get_ref "resized_image" }},
      "image_2": {{ get_ref "pose_images" }}
    },
    "class_type": "ImageConcatMulti",
    "_meta": {
      "title": "Concat Source + Pose"
    }
  },
  "concat_final": {
    "inputs": {
      "inputcount": 2,
      "direction": "left",
      "match_image_size": true,
      "Update inputs": "",
      "image_1": {{ get_ref "image_output" }},
      "image_2": ["concat_source_pose", 0]
    },
    "class_type": "ImageConcatMulti",
    "_meta": {
      "title": "Concat Output + Preview"
    }
  }
}
