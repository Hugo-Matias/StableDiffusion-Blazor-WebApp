#meta
{
  "outputs": {
    "positive_output": { "node": "positive_encode", "index": 0 },
    "negative_output": { "node": "negative_encode", "index": 0 }
  },
  "ui": {
    "component": "PromptsForm",
    "title": "Prompts",
    "order": 10,
    "collapsible": false,
    "parameters": {
      "positive": { },
      "negative": { }
    }
  }
}
#end

{
  "positive_encode": {
    "inputs": {
      "text": {{ positive | json }},
      "clip": {{ get_ref ((scope ?? "") + "clip_output") }}
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode-Positive"
    }
  },
  "negative_encode": {
    "inputs": {
      "text": {{ negative ?? "" | json }},
      "clip": {{ get_ref ((scope ?? "") + "clip_output") }}
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode-Negative"
    }
  }
}