#meta
{
  "outputs": {
    "positive_output": { "node": "positive_encode", "index": 0 },
    "negative_output": { "node": "negative_encode", "index": 0 }
  },
}
#end

{
  "positive_encode": {
    "inputs": {
      "text": {{ positive | json }},
      "clip": {{ get_ref "clip_output" }}
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode-Positive"
    }
  },
  "negative_encode": {
    "inputs": {
      "text": {{ negative | json }},
      "clip": {{ get_ref "clip_output" }}
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode-Negative"
    }
  }
}