#meta
{
  "outputs": {
    "model_output": { "node": "unet_loader", "index": 0 },
    "clip_output": { "node": "clip_loader", "index": 0 },
    "vae_output": { "node": "vae_loader", "index": 0 },
    "latent_output": { "node": {{ latent_id | json }}, "index": 0 },
  }
}
#end

{
  "unet_loader": {
    "inputs": {
      "unet_name": {{ unet_name | json }},
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "clip_loader": {
    "inputs": {
      "clip_name": {{ clip_name | json }},
      "type": {{ clip_type | json }},
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP"
    }
  },
  "vae_loader": {
    "inputs": {
      "vae_name": {{ vae_name | json }}
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    }
  },
  "{{ latent_id }}": {
    "inputs": {
      "width": {{ width | json }},
      "height": {{ height | json }},
      "batch_size": {{ batch_size | json }}
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "Empty Latent Image"
    }
  }
}