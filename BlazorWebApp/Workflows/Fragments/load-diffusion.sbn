#meta
{
  "outputs": {
    "{{ if scope }}{{ scope }}{{ end }}model_output": { "node": "{{ if scope }}{{ scope }}{{ end }}unet_loader", "index": 0 },
    "{{ if scope }}{{ scope }}{{ end }}clip_output": { "node": "{{ if scope }}{{ scope }}{{ end }}clip_loader", "index": 0 },
    "{{ if scope }}{{ scope }}{{ end }}vae_output": { "node": "{{ if scope }}{{ scope }}{{ end }}vae_loader", "index": 0 }
  }
}
#end

{
  "{{ if scope }}{{ scope }}{{ end }}unet_loader": {
    "inputs": {
      "unet_name": {{ unet_name | json }},
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}Load Diffusion Model"
    }
  },
  "{{ if scope }}{{ scope }}{{ end }}clip_loader": {
    "inputs": {
      "clip_name": {{ clip_name | json }},
      "type": {{ clip_type | json }},
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}Load CLIP"
    }
  },
  "{{ if scope }}{{ scope }}{{ end }}vae_loader": {
    "inputs": {
      "vae_name": {{ vae_name | json }}
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}Load VAE"
    }
  }
}