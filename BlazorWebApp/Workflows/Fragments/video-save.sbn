{
  "{{ node_id ?? 'video_save' }}": {
    "inputs": {
      "frame_rate": {{ frame_rate ?? 16 | json }},
      "loop_count": 0,
      "filename_prefix": {{ filename_prefix ?? "tmp/vid" | json }},
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": {{ crf ?? 19 | json }},
      "save_metadata": {{ save_metadata ?? true | json }},
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": {{ save_output ?? true | json }},
      "images": {{ get_ref (image_input_name ?? "image_output") }}
    },
    "class_type": "VHS_VideoCombine",
    "_meta": {
      "title": "Video Combine"
    }
  }
}
