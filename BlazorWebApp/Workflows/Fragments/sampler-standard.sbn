#meta
{
  "outputs": {
    "latent_output": {"node": "{{ sampler_id ?? 'sampler' }}", "index": 0}
  }
}
#end

{
  "{{ sampler_id ?? 'sampler' }}": {
    "inputs": {
      "seed": {{ seed | json }},
      "steps": {{ steps | json }},
      "cfg": {{ cfg | json }},
      "sampler_name": {{ sampler_name | json }},
      "scheduler": {{ scheduler | json }},
      "denoise": {{ denoise ?? 1 | json }},
      "model": {{ get_ref ((scope ?? "") + "model_output") }},
      "positive": {{ get_ref "positive_output" }},
      "negative": {{ get_ref "negative_output" }},
      "latent_image": {{ get_ref "latent_output" }}
    },
    "class_type": "KSampler",
    "_meta": {
      "title": {{ title ?? "KSampler" | json }}
    }
  }
}
