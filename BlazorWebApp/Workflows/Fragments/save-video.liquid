{% meta %}
{
  "outputs": {
    "video_save_node": { "node": "{{ node_id | default: 'video_save' }}", "index": 0 }
  },
  "ui": {
    "type": "utility",
    "title": "Save Video",
    "description": "Combines frames and saves video to disk"
  }
}
{% endmeta %}

{% assign save_id = node_id | default: "video_save" %}

{
  {{ save_id | json }}: {
    "inputs": {
      "frame_rate": {{ frame_rate | default: 16 | json }},
      "loop_count": 0,
      "filename_prefix": "tmp/vid",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true,
      "images": {% assign img_key = image_input_name | default: "image_output" %}{% get_ref img_key %}
    },
    "class_type": "VHS_VideoCombine",
    "_meta": {
      "title": "Video Combine"
    }
  }
}
