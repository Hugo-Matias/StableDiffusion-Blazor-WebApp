#meta
{
  "outputs": {
    "@{output_name}": { "node": "@{node_id}", "index": 0 }
  }
}
#end

{{~ clean_id = node_id ?? "clean_vram" ~}}

{
  {{ clean_id | json }}: {
    "inputs": {
      "anything": {{ get_ref (input_name ?? "latent_output") }}
    },
    "class_type": "easy cleanGpuUsed",
    "_meta": {
      "title": {{ title ?? "Clean VRAM Used" | json }}
    }
  }
}
