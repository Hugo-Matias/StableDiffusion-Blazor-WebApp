#meta
{
  "outputs": {
    "video_save_node": { "node": "{{ node_id ?? 'video_save' }}", "index": 0 }
  },
  "ui": {
    "type": "utility",
    "title": "Save Video",
    "description": "Combines frames and saves video to disk"
  }
}
#end

{
  "{{ node_id ?? 'video_save' }}": {
    "inputs": {
      "frame_rate": {{ frame_rate ?? 16 | json }},
      "loop_count": 0,
      "filename_prefix": "tmp/vid",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true,
      "images": {{ get_ref (image_input_name ?? "image_output") }}
    },
    "class_type": "VHS_VideoCombine",
    "_meta": {
      "title": "Video Combine"
    }
  }
}
