#meta
{
  "outputs": {
    "image_size_info": { "node": "get_size", "index": 0 },
    "width": { "node": "get_size", "index": 1 },
    "height": { "node": "get_size", "index": 2 },
    "num_frames": { "node": "get_size", "index": 3 }
