#meta
{
  "outputs": {
    "latent_output": {"node": "{{ sampler_id }}", "index": 0}
  },
  "ui": {
    "component": "SamplerForm",
    "title": "Sampler",
    "icon": "fa-solid fa-dice",
    "order": 50,
    "collapsible": true,
    "chainable": true,
    "parameters": {
      "sampler_name": { "source": "Backend.Samplers" },
      "scheduler": { "source": "Backend.Schedulers" },
      "steps": { "min": 1, "max": 150, "step": 1 },
      "cfg": { "min": 1, "max": 30, "step": 0.5 },
      "denoise": { "min": 0, "max": 1, "step": 0.01 },
      "eta": { "min": 0, "max": 1, "step": 0.01 },
      "seed": { "min": -1 }
    }
  }
}
#end

{
  "{{ sampler_id }}": {
    "inputs": {
      "eta": {{ eta ?? 0.5 | json }},
      "sampler_name": {{ sampler_name | json }},
      "scheduler": {{ scheduler | json }},
      "steps": {{ steps | json }},
      "steps_to_run": {{ steps_to_run ?? -1 | json }},
      "denoise": {{ denoise ?? 1 | json }},
      "cfg": {{ cfg | json }},
      "seed": {{ seed | json }},
      "sampler_mode": {{ sampler_mode ?? "standard" | json }},
      "bongmath": true,
      "model": {{ get_ref ((scope ?? "") + "model_output") }},
      "positive": {{ get_ref ((scope ?? "") + "positive_output") }},
      "negative": {{ get_ref ((scope ?? "") + "negative_output") }},
      "latent_image": {{ get_ref ((scope ?? "") + "latent_output") }}
    },
    "class_type": {{ class_type ?? "ClownsharKSampler_Beta" | json }},
    "_meta": {
      "title": {{ title ?? "Sampler" | json }}
    }
  }
}