{% meta %}
{
  "outputs": {
    "image_embeds": { "node": "i2v_encode", "index": 0 }
  }
}
{% endmeta %}

{
  "clip_vision_encode": {
    "inputs": {
      "strength_1": {{ clip_strength | default: 1 | json }},
      "strength_2": 1,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": true,
      "tiles": 0,
      "ratio": 0.2,
      "clip_vision": {% assign cv_key = scope | default: "" | append: "clip_vision_output" %}{% get_ref cv_key %},
      "image_1": {% get_ref "resized_image" }}
    },
    "class_type": "WanVideoClipVisionEncode",
    "_meta": {
      "title": "CLIP Vision Encode (Image)"
    }
  },
  "i2v_encode": {
    "inputs": {
      "width": {% get_ref "width" %},
      "height": {% get_ref "height" %},
      "num_frames": {% get_ref "num_frames" %},
      "noise_aug_strength": {{ noise_aug_strength | default: 0 | json }},
      "start_latent_strength": {{ start_latent_strength | default: 1 | json }},
      "end_latent_strength": {{ end_latent_strength | default: 1 | json }},
      "force_offload": true,
      "fun_or_fl2v_model": true,
      "tiled_vae": false,
      "augment_empty_frames": 0,
      "vae": {% assign vae_key = scope | default: "" | append: "vae_output" %}{% get_ref vae_key %},
      "clip_embeds": ["clip_vision_encode", 0],
      "start_image": {% get_ref "resized_image" %}
    },
    "class_type": "WanVideoImageToVideoEncode",
    "_meta": {
      "title": "WanVideo I2V Encode"
    }
  }
}
