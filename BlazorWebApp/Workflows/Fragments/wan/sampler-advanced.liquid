{% meta %}
{
  "outputs": {
    "latent_output": { "node": "{{ sampler_id }}", "index": 0 }
  },
  "ui": {
    "type": "sampler",
    "component": "DoubleSamplerForm",
    "title": "Video Sampling",
    "icon": "fa-solid fa-dice",
    "collapsible": false,
    "order": 35,
    "parameters": {
      "sampler_name": { 
        "source": "KSamplerAdvanced",
        "input_name": "sampler_name"
      },
      "scheduler": { 
        "source": "KSamplerAdvanced",
        "input_name": "scheduler"
      },
      "steps": { "min": 2, "max": 50, "step": 2, "default": 8 },
      "cfg": { "min": 1, "max": 15, "step": 0.5, "default": 1 },
      "seed": { "min": -1, "default": 42 }
    }
  }
}
{% endmeta %}

{
  "{{ sampler_id }}": {
    "inputs": {
      "add_noise": {{ add_noise | default: "enable" | json }},
      "noise_seed": {{ seed | json }},
      "steps": {{ steps | json }},
      "cfg": {{ cfg | json }},
      "sampler_name": {{ sampler_name | json }},
      "scheduler": {{ scheduler | json }},
      "start_at_step": {{ start_at_step | json }},
      "end_at_step": {{ end_at_step | json }},
      "return_with_leftover_noise": {{ return_with_leftover_noise | default: "disable" | json }},
      "model": {% assign model_key = model_input_name | default: "model_output" %}{% get_ref model_key %},
      "positive": {% assign pos_key = positive_input_name | default: "painter_positive_output" %}{% get_ref pos_key %},
      "negative": {% assign neg_key = negative_input_name | default: "painter_negative_output" %}{% get_ref neg_key %},
      "latent_image": {% assign lat_key = latent_input_name | default: "painter_latent_output" %}{% get_ref lat_key %}
    },
    "class_type": "KSamplerAdvanced",
    "_meta": {
      "title": {{ title | default: "KSampler (Advanced)" | json }}
    }
  }
}
