#meta
{
  "outputs": {
    "image_output": { "node": "decode", "index": 0 }
  }
}
#end

{
  "decode": {
    "inputs": {
      "enable_vae_tiling": {{ enable_vae_tiling ?? false | json }},
      "tile_x": {{ tile_x ?? 272 | json }},
      "tile_y": {{ tile_y ?? 272 | json }},
      "tile_stride_x": {{ tile_stride_x ?? 144 | json }},
      "tile_stride_y": {{ tile_stride_y ?? 128 | json }},
      "normalization": "default",
      "vae": {{ get_ref ((scope ?? "") + "vae_output") }},
      "samples": {{ get_ref "latent_output" }}
    },
    "class_type": "WanVideoDecode",
    "_meta": {
      "title": "WanVideo Decode"
    }
  }
}
