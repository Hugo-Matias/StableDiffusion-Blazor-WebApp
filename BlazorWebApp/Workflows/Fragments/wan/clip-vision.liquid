{% meta %}
{
  "outputs": {
    "clip_vision_output": { "node": "clip_vision_encode", "index": 0 }
  }
}
{% endmeta %}

{
  "clip_vision_loader": {
    "inputs": {
      "clip_name": {{ clip_vision_name | default: "clip_vision_h.safetensors" | json }}
    },
    "class_type": "CLIPVisionLoader",
    "_meta": {
      "title": "Load CLIP Vision"
    }
  },
  "clip_vision_encode": {
    "inputs": {
      "crop": "none",
      "clip_vision": ["clip_vision_loader", 0],
      "image": {% get_ref "original_image_output" %}
    },
    "class_type": "CLIPVisionEncode",
    "_meta": {
      "title": "CLIP Vision Encode"
    }
  }
}
