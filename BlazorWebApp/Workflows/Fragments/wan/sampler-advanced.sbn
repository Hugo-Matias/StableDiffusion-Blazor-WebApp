#meta
{
  "outputs": {
    "latent_output": { "node": "{{ sampler_id }}", "index": 0 }
  },
  "ui": {
    "type": "sampler",
    "component": "DoubleSamplerForm",
    "title": "Video Sampling",
    "icon": "fa-solid fa-dice",
    "collapsible": false,
    "order": 35,
    "parameters": {
      "sampler_name": { 
        "source": "KSamplerAdvanced",
        "input_name": "sampler_name"
      },
      "scheduler": { 
        "source": "KSamplerAdvanced",
        "input_name": "scheduler"
      },
      "steps": { "min": 2, "max": 50, "step": 2, "default": 8 },
      "cfg": { "min": 1, "max": 15, "step": 0.5, "default": 1 },
      "seed": { "min": -1, "default": 42 }
    }
  }
}
#end

{
  "{{ sampler_id }}": {
    "inputs": {
      "add_noise": {{ add_noise ?? "enable" | json }},
      "noise_seed": {{ seed | json }},
      "steps": {{ steps | json }},
      "cfg": {{ cfg | json }},
      "sampler_name": {{ sampler_name | json }},
      "scheduler": {{ scheduler | json }},
      "start_at_step": {{ start_at_step | json }},
      "end_at_step": {{ end_at_step | json }},
      "return_with_leftover_noise": {{ return_with_leftover_noise ?? "disable" | json }},
      "model": {{ get_ref (model_input_name ?? "model_output") }},
      "positive": {{ get_ref (positive_input_name ?? "painter_positive_output") }},
      "negative": {{ get_ref (negative_input_name ?? "painter_negative_output") }},
      "latent_image": {{ get_ref (latent_input_name ?? "painter_latent_output") }}
    },
    "class_type": "KSamplerAdvanced",
    "_meta": {
      "title": {{ title ?? "KSampler (Advanced)" | json }}
    }
  }
}
