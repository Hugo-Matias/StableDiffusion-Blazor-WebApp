#meta
{
  "outputs": {
    "@{model_output_name}": { "node": "@{node_prefix}_torch", "index": 0 }
  }
}
#end

{{~ unet_loader_id = (node_prefix ?? "model") + "_unet_loader" ~}}
{{~ sage_id = (node_prefix ?? "model") + "_sage" ~}}
{{~ torch_id = (node_prefix ?? "model") + "_torch" ~}}

{
  {{ unet_loader_id | json }}: {
    "inputs": {
      "unet_name": {{ model_name | json }},
      "weight_dtype": {{ weight_dtype ?? "default" | json }}
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": {{ loader_title ?? "Load Diffusion Model" | json }}
    }
  },
  {{ sage_id | json }}: {
    "inputs": {
      "sage_attention": {{ sage_attention ?? "sageattn_qk_int8_pv_fp16_triton" | json }},
      "model": [{{ unet_loader_id | json }}, 0]
    },
    "class_type": "PathchSageAttentionKJ",
    "_meta": {
      "title": {{ sage_title ?? "Patch Sage Attention" | json }}
    }
  },
  {{ torch_id | json }}: {
    "inputs": {
      "enable_fp16_accumulation": {{ enable_fp16_accumulation ?? true | json }},
      "model": [{{ sage_id | json }}, 0]
    },
    "class_type": "ModelPatchTorchSettings",
    "_meta": {
      "title": {{ torch_title ?? "Model Patch Torch Settings" | json }}
    }
  }
}
