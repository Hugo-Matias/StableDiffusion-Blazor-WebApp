{%- assign _prefix = node_prefix | default: "model" -%}
{%- assign _output_name = model_output_name | default: "model_output" -%}
{%- assign _torch_node = _prefix | append: "_torch" -%}
{%- assign _unet_node = _prefix | append: "_unet_loader" -%}
{%- assign _sage_node = _prefix | append: "_sage" -%}
{% meta %}
{
  "outputs": {
    "{{ _output_name }}": { "node": "{{ _torch_node }}", "index": 0 }
  }
}
{% endmeta %}

{
  "{{ _unet_node }}": {
    "inputs": {
      "unet_name": {{ model_name | json }},
      "weight_dtype": {{ weight_dtype | default: "default" | json }}
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": {{ loader_title | default: "Load Diffusion Model" | json }}
    }
  },
  "{{ _sage_node }}": {
    "inputs": {
      "sage_attention": {{ sage_attention | default: "sageattn_qk_int8_pv_fp16_triton" | json }},
      "model": ["{{ _unet_node }}", 0]
    },
    "class_type": "PathchSageAttentionKJ",
    "_meta": {
      "title": {{ sage_title | default: "Patch Sage Attention" | json }}
    }
  },
  "{{ _torch_node }}": {
    "inputs": {
      "enable_fp16_accumulation": {{ enable_fp16_accumulation | default: true | json }},
      "model": ["{{ _sage_node }}", 0]
    },
    "class_type": "ModelPatchTorchSettings",
    "_meta": {
      "title": {{ torch_title | default: "Model Patch Torch Settings" | json }}
    }
  }
}
