{% meta %}
{
  "outputs": {
    "{{ model_output_name | default: 'model_output' }}": { "node": "{{ lora_loader_id }}", "index": 0 }
  }
}
{% endmeta %}

{
  "{{ lora_loader_id }}": {
    "inputs": {
      "lora_name": {{ lora_path | default: lora_name | json }},
      "strength_model": {{ lora_strength | json }},
      "strength_clip": {{ lora_clip_strength | default: 1 | json }},
      "model": {% assign model_key = model_input_name | default: "model_output" %}{% get_ref model_key %}
    },
    "class_type": "LoraLoader",
    "_meta": {
      "title": {{ title | default: "LoRA Loader" | json }}
    }
  }
}
