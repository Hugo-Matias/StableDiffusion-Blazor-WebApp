#meta
{
  "outputs": {
    "high_model_output": { "node": "high_model_torch", "index": 0 },
    "low_model_output": { "node": "low_model_torch", "index": 0 },
    "clip_output": { "node": "clip_loader", "index": 0 },
    "vae_output": { "node": "vae_loader", "index": 0 }
  }
}
#end

{
  "high_unet_loader": {
    "inputs": {
      "unet_name": {{ high_model_name | json }},
      "weight_dtype": {{ weight_dtype ?? "default" | json }}
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load High Noise Model"
    }
  },
  "low_unet_loader": {
    "inputs": {
      "unet_name": {{ low_model_name | json }},
      "weight_dtype": {{ weight_dtype ?? "default" | json }}
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Low Noise Model"
    }
  },
  "clip_loader": {
    "inputs": {
      "clip_name": {{ clip_name | json }},
      "type": {{ clip_type ?? "wan" | json }},
      "device": {{ clip_device ?? "cpu" | json }}
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP"
    }
  },
  "vae_loader": {
    "inputs": {
      "vae_name": {{ vae_name | json }}
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    }
  },
  "high_model_sage": {
    "inputs": {
      "sage_attention": {{ sage_attention ?? "sageattn_qk_int8_pv_fp16_triton" | json }},
      "model": ["high_unet_loader", 0]
    },
    "class_type": "PathchSageAttentionKJ",
    "_meta": {
      "title": "Patch Sage Attention (High)"
    }
  },
  "low_model_sage": {
    "inputs": {
      "sage_attention": {{ sage_attention ?? "sageattn_qk_int8_pv_fp16_triton" | json }},
      "model": ["low_unet_loader", 0]
    },
    "class_type": "PathchSageAttentionKJ",
    "_meta": {
      "title": "Patch Sage Attention (Low)"
    }
  },
  "high_model_torch": {
    "inputs": {
      "enable_fp16_accumulation": {{ enable_fp16_accumulation ?? true | json }},
      "model": ["high_model_sage", 0]
    },
    "class_type": "ModelPatchTorchSettings",
    "_meta": {
      "title": "Model Patch Torch (High)"
    }
  },
  "low_model_torch": {
    "inputs": {
      "enable_fp16_accumulation": {{ enable_fp16_accumulation ?? true | json }},
      "model": ["low_model_sage", 0]
    },
    "class_type": "ModelPatchTorchSettings",
    "_meta": {
      "title": "Model Patch Torch (Low)"
    }
  }
}
