#meta
{
  "outputs": {
    "{{ if scope }}{{ scope }}{{ end }}clip_vision_output": { "node": "{{ if scope }}{{ scope }}{{ end }}clip_vision_loader", "index": 0 }
  }
}
#end

{
  "{{ if scope }}{{ scope }}{{ end }}clip_vision_loader": {
    "inputs": {
      "clip_name": {{ clip_vision_name | json }}
    },
    "class_type": "CLIPVisionLoader",
    "_meta": {
      "title": "{{ if scope_title }}{{ scope_title }}{{ end }}Load CLIP Vision"
    }
  }
}
