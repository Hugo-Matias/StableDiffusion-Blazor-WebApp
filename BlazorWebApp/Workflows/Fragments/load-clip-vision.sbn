#meta
{
  "outputs": {
    "{{ scope ?? '' }}clip_vision_output": { "node": "{{ scope ?? '' }}clip_vision_loader", "index": 0 }
  }
}
#end

{
  "{{ scope ?? '' }}clip_vision_loader": {
    "inputs": {
      "clip_name": {{ clip_vision_name | json }}
    },
    "class_type": "CLIPVisionLoader",
    "_meta": {
      "title": "{{ scope_title ?? '' }}Load CLIP Vision"
    }
  }
}
