{% meta %}
{
  "outputs": {
    "image_input": { "node": "image_scale", "index": 0 }
  }
}
{% endmeta %}

{
  "image_loader": {
    "inputs": {
      "image": {{ image | json }}
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Load Image"
    }
  },
  "image_scale": {
    "inputs": {
      "upscale_method": {{ upscale_method | default: "lanczos" | json }},
      "megapixels": {{ megapixels | default: 1 | json }},
      "image": ["image_loader", 0]
    },
    "class_type": "ImageScaleToTotalPixels",
    "_meta": {
      "title": "Scale Image"
    }
  }
}
