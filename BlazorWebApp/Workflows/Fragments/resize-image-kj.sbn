#meta
{
  "outputs": {
    "resized_image": { "node": "{{ node_id ?? 'resize_image' }}", "index": 0 }
  }
}
#end

{
  "{{ node_id ?? 'resize_image' }}": {
    "inputs": {
      "width": {{ get_ref (width_ref ?? "width") }},
      "height": {{ get_ref (height_ref ?? "height") }},
      "upscale_method": {{ upscale_method ?? "lanczos" | json }},
      "keep_proportion": {{ keep_proportion ?? "crop" | json }},
      "pad_color": "0, 0, 0",
      "crop_position": {{ crop_position ?? "center" | json }},
      "divisible_by": 16,
      "device": "cpu",
      "image": {{ get_ref (image_ref ?? "image_input") }}
    },
    "class_type": "ImageResizeKJv2",
    "_meta": {
      "title": "{{ title ?? 'Resize Image' }}"
    }
  }
}
