#meta
{
  "outputs": {
    "positive_output": { "node": "seed_variance_enhancer", "index": 0 }
  },
  "conditions": {
    "required": ["SeedVarianceEnhancer.IsActive"]
  }
}
#end

{
  "seed_variance_enhancer": {
    "inputs": {
      "randomize_percent": {{ randomize_percent ?? 50 | json }},
      "strength": {{ strength ?? 20 | json }},
      "noise_insert": {{ noise_insert ?? "noise on beginning steps" | json }},
      "steps_switchover_percent": {{ steps_switchover_percent ?? 20 | json }},
      "seed": {{ seed ?? 0 | json }},
      "mask_starts_at": {{ mask_starts_at ?? "beginning" | json }},
      "mask_percent": {{ mask_percent ?? 0 | json }},
      "log_to_console": {{ log_to_console ?? false | json }},
      "conditioning": {{ get_ref ((scope ?? "") + "positive_output") }}
    },
    "class_type": "SeedVarianceEnhancer",
    "_meta": {
      "title": "SeedVarianceEnhancer"
    }
  }
}
