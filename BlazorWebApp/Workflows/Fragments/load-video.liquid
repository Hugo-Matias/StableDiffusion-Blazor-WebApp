{% meta %}
{
  "outputs": {
    "video_frames": { "node": "load_video", "index": 0 },
    "frame_count": { "node": "load_video", "index": 1 },
    "audio": { "node": "load_video", "index": 2 }
  }
}
{% endmeta %}

{
  "load_video": {
    "inputs": {
      "video": {{ video | json }},
      "force_rate": {{ force_rate | default: 16 | json }},
      "custom_width": {{ custom_width | default: 480 | json }},
      "custom_height": {{ custom_height | default: 832 | json }},
      "frame_load_cap": {{ frame_load_cap | default: 176 | json }},
      "skip_first_frames": {{ skip_first_frames | default: 0 | json }},
      "select_every_nth": {{ select_every_nth | default: 1 | json }},
      "format": "AnimateDiff"
    },
    "class_type": "VHS_LoadVideo",
    "_meta": {
      "title": "Load Video"
    }
  }
}
