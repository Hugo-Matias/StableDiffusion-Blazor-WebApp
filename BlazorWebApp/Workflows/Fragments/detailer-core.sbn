#meta
{
  "outputs": {
    "image_output": { "node": "detailer", "index": 0 }
  },
  "conditions": {
    "required": ["Detailer.IsActive"]
  }
}
#end

{
  "detailer_bbox_provider": {
    "inputs": {
      "model_name": {{ detailer_detection_model ?? "bbox/face_yolov8m.pt" | json }}
    },
    "class_type": "UltralyticsDetectorProvider",
    "_meta": {
      "title": "Detailer BBox Detector Provider"
    }
  },
  "detailer": {
    "inputs": {
      "guide_size": {{ detailer_guide_size ?? 512 | json }},
      "guide_size_for": true,
      "max_size": {{ detailer_max_size ?? 1024 | json }},
      "seed": {{ detailer_seed ?? 42 | json }},
      "steps": {{ detailer_steps ?? 20 | json }},
      "cfg": {{ detailer_cfg ?? 8 | json }},
      "sampler_name": {{ detailer_sampler ?? "dpmpp_2m" | json }},
      "scheduler": {{ detailer_scheduler ?? "beta" | json }},
      "denoise": {{ detailer_denoise ?? 0.65 | json }},
      "feather": {{ detailer_feather ?? 5 | json }},
      "noise_mask": true,
      "force_inpaint": true,
      "bbox_threshold": {{ detailer_bbox_threshold ?? 0.7 | json }},
      "bbox_dilation": {{ detailer_bbox_dilation ?? 10 | json }},
      "bbox_crop_factor": {{ detailer_bbox_crop_factor ?? 3 | json }},
      "sam_detection_hint": "center-1",
      "sam_dilation": 0,
      "sam_threshold": 0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False",
      "drop_size": {{ detailer_drop_size ?? 70 | json }},
      "wildcard": "",
      "cycle": {{ detailer_cycle ?? 1 | json }},
      "inpaint_model": false,
      "noise_mask_feather": 20,
      "tiled_encode": false,
      "tiled_decode": false,
      "image": {{ get_ref "image_output" }},
      "model": {{ get_ref ((scope ?? "detailer_") + "model_output") }},
      "clip": {{ get_ref ((scope ?? "detailer_") + "clip_output") }},
      "vae": {{ get_ref ((scope ?? "detailer_") + "vae_output") }},
      "positive": {{ get_ref ((scope ?? "detailer_") + "positive_output") }},
      "negative": {{ get_ref ((scope ?? "detailer_") + "negative_output") }},
      "bbox_detector": ["detailer_bbox_provider", 0]
    },
    "class_type": "FaceDetailer",
    "_meta": {
      "title": "FaceDetailer"
    }
  }
}
