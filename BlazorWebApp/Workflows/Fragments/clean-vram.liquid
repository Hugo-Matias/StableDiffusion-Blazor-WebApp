{% meta %}
{
  "outputs": {
    "{{ output_name | default: "" }}": { "node": "{{ node_id | default: "" }}", "index": 0 }
  }
}
{% endmeta %}

{
  "{{ node_id | default: "" }}": {
    "inputs": {
      "anything": {% assign input_key = input_name | default: "" %}{% get_ref input_key %}
    },
    "class_type": "easy cleanGpuUsed",
    "_meta": {
      "title": {{ title | default: "" | json }}
    }
  }
}
